<!--pages/login/login.wxml-->
<view class="container">
  <!-- 装饰背景圆 -->
  <view class="decor-circle decor-circle-1"></view>
  <view class="decor-circle decor-circle-2"></view>
  <view class="decor-circle decor-circle-3"></view>

  <view class="header">
    <view class="welcome-text">
      <view class="welcome-title">{{isDev ? '开发者登录' : '欢迎登录'}}</view>
      <view class="welcome-subtitle">{{isDev ? 'Dev 模式 · 选择登录方式' : '授权登录后体验更多精彩功能'}}</view>
    </view>
  </view>

  <!-- ====== 登录方式 radio 选择（支持微信授权与手机号密码双通道） ====== -->
  <view class="login-method-selector">
    <radio-group bindchange="onLoginMethodChange">
      <view class="method-option {{loginMethod === 'wechat' ? 'selected' : ''}}" bindtap="selectWechat">
        <radio value="wechat" checked="{{loginMethod === 'wechat'}}" color="#7c3aed" />
        <view class="method-label">微信授权登录</view>
      </view>
      <view class="method-option {{loginMethod === 'password' ? 'selected' : ''}}" bindtap="selectPassword">
        <radio value="password" checked="{{loginMethod === 'password'}}" color="#7c3aed" />
        <view class="method-label">手机号密码登录</view>
      </view>
    </radio-group>
  </view>

  <!-- ====== 微信授权登录 ====== -->
  <block wx:if="{{loginMethod === 'wechat'}}">
    <view class="auth-section">
      <!-- 头像授权 -->
      <view class="auth-item">
        <view class="auth-title">头像授权</view>
        <view class="auth-content" wx:if="{{avatarUrl}}">
          <view class="user-info">
            <image class="avatar" src="{{avatarUrl}}"></image>
            <view class="nickname">已获取头像</view>
          </view>
          <view class="auth-status success">已完成</view>
        </view>
        <view class="auth-content" wx:else>
          <view class="auth-desc">用于展示您的个人形象</view>
          <button class="pop_avatar" wx:if="{{!avatarUrl}}" open-type="chooseAvatar" bindchooseavatar="getAvatar">获取头像</button>
          <view class="auth-status">待授权</view>
        </view>
      </view>

      <!-- 昵称授权 -->
      <view class="auth-item">
        <view class="auth-title">昵称授权</view>
        <view class="auth-content">
          <input
            type="nickname"
            class="ipu"
            placeholder="点击获取或输入昵称"
            value="{{nickName || ''}}"
            bindinput="getName"
            bindchange="getName"
            bindblur="getName"
          />
          <view class="auth-status success" wx:if="{{hasUserInfo && nickName}}">已完成</view>
          <view class="auth-status" wx:else>待授权</view>
        </view>
      </view>

      <!-- 手机号授权 -->
      <view class="auth-item">
        <view class="auth-title">手机号授权</view>
        <view class="auth-content" wx:if="{{hasPhoneNumber}}">
          <view class="user-info">
            <view class="phone-info">{{phoneNumber}}</view>
          </view>
          <button class="auth-btn auth-btn-sm" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">重新授权</button>
          <view class="auth-status success">已完成</view>
        </view>
        <view class="auth-content" wx:else>
          <view class="auth-desc">{{phoneNumber ? ('当前号码 ' + phoneNumber + '，请点击授权刷新凭证') : '用于接收订单通知'}}</view>
          <button class="auth-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">一键授权</button>
          <view class="auth-status">待授权</view>
        </view>
      </view>
    </view>

    <view class="footer">
      <!-- 隐私政策勾选 -->
      <view class="privacy-checkbox" bindtap="togglePrivacyAgreement">
        <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
          <view class="check-icon" wx:if="{{privacyAgreed}}">✓</view>
        </view>
        <view class="checkbox-text">
          我已阅读并同意
          <text class="link" catchtap="viewAgreement">《用户服务协议》</text>
          和
          <text class="link" catchtap="viewPrivacy">《隐私政策》</text>
        </view>
      </view>
      
      <button class="complete-btn {{privacyAgreed ? 'active' : ''}}" bindtap="completeLogin" disabled="{{!privacyAgreed}}">完成授权并进入</button>
      <view class="login-sub-links">
        <text class="login-sub-link" bindtap="onOpenRegiModal">🌱 新塾员注册申请</text>
        <text class="login-sub-link" bindtap="onOpenResetModal">🔑 忘记密码重置</text>
      </view>
    </view>
  </block>

  <!-- ====== 手机号+密码登录 ====== -->
  <block wx:if="{{loginMethod === 'password'}}">
    <view class="dev-login-form">
      <view class="form-item">
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phoneInput}}"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="form-item">
        <input
          class="form-input"
          type="text"
          password="{{true}}"
          placeholder="请输入密码"
          value="{{pwdInput}}"
          bindinput="onPwdInput"
        />
      </view>

      <!-- 隐私政策勾选 -->
      <view class="privacy-checkbox dev-privacy" bindtap="togglePrivacyAgreement">
        <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
          <view class="check-icon" wx:if="{{privacyAgreed}}">✓</view>
        </view>
        <view class="checkbox-text">
          我已阅读并同意
          <text class="link" catchtap="viewAgreement">《用户服务协议》</text>
          和
          <text class="link" catchtap="viewPrivacy">《隐私政策》</text>
        </view>
      </view>

      <button
        class="dev-login-btn {{canDevLogin && privacyAgreed ? 'active' : ''}}"
        disabled="{{!canDevLogin || !privacyAgreed || submitting}}"
        loading="{{submitting}}"
        bindtap="loginByPassword"
      >{{submitting ? '登录中...' : '密码登录'}}</button>

      <view class="dev-hint">
        <view class="login-sub-links login-sub-links-dev">
          <text class="login-sub-link" bindtap="onOpenRegiModal">🌱 新塾员注册申请</text>
          <text class="login-sub-link" bindtap="onOpenResetModal">🔑 忘记密码重置</text>
        </view>
        <block wx:if="{{isDev}}">
          <button class="guest-btn" bindtap="enterAsGuest">以游客身份进入</button>
          <view class="guest-desc">游客模式仅可查看演示数据</view>
        </block>
      </view>
    </view>
  </block>

  <!-- 101-regi.md: 新塾员注册申请弹窗 -->
  <view
    wx:if="{{showRegiModal}}"
    class="login-sheet-mask"
    bindtap="onCloseRegiModal"
  >
    <view
      class="login-sheet-card"
      catchtap=""
    >
      <view class="login-sheet-header">
        <text class="login-sheet-title">🌱 新塾员入塾注册申请</text>
        <text class="login-sheet-close" bindtap="onCloseRegiModal">✕</text>
      </view>
      <view class="login-sheet-field">
        <input
          class="login-sheet-input"
          placeholder="姓名 / 昵称 *"
          value="{{regiForm.name}}"
          data-field="name"
          bindinput="onRegiFieldInput"
        />
      </view>
      <view class="login-gender-row">
        <view
          wx:for="{{['男','女']}}"
          wx:key="*this"
          data-gender="{{item}}"
          bindtap="onSelectRegiGender"
          class="login-gender-pill {{regiForm.gender === item ? 'active' : ''}}"
        >{{item}}生</view>
      </view>
      <view class="login-sheet-field">
        <input
          class="login-sheet-input"
          type="number"
          maxlength="11"
          placeholder="11位手机号码 *"
          value="{{regiForm.phone}}"
          data-field="phone"
          bindinput="onRegiFieldInput"
        />
      </view>
      <view class="login-sheet-field">
        <input
          class="login-sheet-input"
          placeholder="常用邮箱（选填）"
          value="{{regiForm.email}}"
          data-field="email"
          bindinput="onRegiFieldInput"
        />
      </view>
      <view class="login-sheet-field">
        <input
          class="login-sheet-input"
          password="{{true}}"
          placeholder="设置登录密码（至少4位）*"
          value="{{regiForm.password}}"
          data-field="password"
          bindinput="onRegiFieldInput"
        />
      </view>
      <view class="login-sheet-field login-sheet-field-last">
        <input
          class="login-sheet-input"
          placeholder="入塾初心或共学期待（选填）"
          value="{{regiForm.notes}}"
          data-field="notes"
          bindinput="onRegiFieldInput"
        />
      </view>
      <button
        class="login-sheet-submit"
        bindtap="onSubmitRegister"
      >{{submittingRegi ? '提交中...' : '提交入塾申请'}}</button>
    </view>
  </view>

  <!-- 111-reset-pass.md: 忘记密码重置弹窗 -->
  <view
    wx:if="{{showResetModal}}"
    class="login-sheet-mask"
    bindtap="onCloseResetModal"
  >
    <view
      class="login-sheet-card"
      catchtap=""
    >
      <view class="login-sheet-header">
        <text class="login-sheet-title">🔑 申请重置密码</text>
        <text class="login-sheet-close" bindtap="onCloseResetModal">✕</text>
      </view>
      <view class="login-sheet-field login-sheet-field-last">
        <input
          class="login-sheet-input"
          type="number"
          maxlength="11"
          placeholder="请输入注册时的11位手机号"
          value="{{resetPhone}}"
          bindinput="onResetPhoneInput"
        />
      </view>
      <button
        class="login-sheet-submit"
        bindtap="onSubmitResetPass"
      >{{submittingReset ? '提交中...' : '提交密码重置申请'}}</button>
    </view>
  </view>
</view>
