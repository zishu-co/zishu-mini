<!--pages/login/login.wxml-->
<view class="container">
  <!-- 装饰背景圆 -->
  <view class="decor-circle decor-circle-1"></view>
  <view class="decor-circle decor-circle-2"></view>
  <view class="decor-circle decor-circle-3"></view>

  <view class="header">
    <view class="welcome-text">
      <view class="welcome-title">{{isDev ? '开发者登录' : '欢迎登录'}}</view>
      <view class="welcome-subtitle">{{isDev ? 'Dev 模式 · 选择登录方式' : '授权登录后体验更多精彩功能'}}</view>
    </view>
  </view>

  <!-- ====== Dev 模式：登录方式 radio 选择 ====== -->
  <view class="login-method-selector" wx:if="{{isDev}}">
    <radio-group bindchange="onLoginMethodChange">
      <view class="method-option {{loginMethod === 'wechat' ? 'selected' : ''}}" bindtap="selectWechat">
        <radio value="wechat" checked="{{loginMethod === 'wechat'}}" color="#7c3aed" />
        <view class="method-label">微信授权登录</view>
      </view>
      <view class="method-option {{loginMethod === 'password' ? 'selected' : ''}}" bindtap="selectPassword">
        <radio value="password" checked="{{loginMethod === 'password'}}" color="#7c3aed" />
        <view class="method-label">手机号密码登录</view>
      </view>
    </radio-group>
  </view>

  <!-- ====== 微信授权登录 ====== -->
  <block wx:if="{{!isDev || loginMethod === 'wechat'}}">
    <view class="auth-section">
      <!-- 头像授权（始终最先获取） -->
      <view class="auth-item">
        <view class="auth-title">头像授权</view>
        <view class="auth-content" wx:if="{{avatarUrl}}">
          <view class="user-info">
            <image class="avatar" src="{{avatarUrl}}"></image>
            <view class="nickname">{{nickName || '已获取头像'}}</view>
          </view>
          <view class="auth-status success">已完成</view>
        </view>
        <view class="auth-content" wx:else>
          <view class="auth-desc">用于展示您的个人形象</view>
          <button class="pop_avatar" wx:if="{{!avatarUrl}}" open-type="chooseAvatar" bindchooseavatar="getAvatar">获取头像</button>
          <view class="auth-status">待授权</view>
        </view>
      </view>

      <!-- 手机号授权（先判断用户是否存在） -->
      <view class="auth-item">
        <view class="auth-title">手机号授权</view>
        <view class="auth-content" wx:if="{{hasPhoneNumber}}">
          <view class="user-info">
            <view class="phone-info">{{phoneNumber}}</view>
          </view>
          <view class="auth-status success">已完成</view>
        </view>
        <view class="auth-content" wx:else>
          <view class="auth-desc">用于识别您的身份并登录</view>
          <button class="auth-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">一键授权手机号</button>
          <view class="auth-status">待授权</view>
        </view>
      </view>

      <!-- v2 改造：注册模式 — 完善注册信息（显示在手机号卡片下方，保持风格一致） -->
      <block wx:if="{{mode === 'register'}}">
        <!-- 名字 -->
        <view class="auth-item">
          <view class="auth-title">名字</view>
          <view class="auth-content" wx:if="{{regName && !regNameError && !editName}}" bindtap="onEditName">
            <view class="user-info">
              <view class="phone-info">{{regName}}</view>
            </view>
            <view class="auth-status success">已完成</view>
          </view>
          <view class="auth-content" wx:else style="flex-direction:column;align-items:stretch;">
            <input
              class="reg-input {{regNameError ? 'has-error' : ''}}"
              type="text"
              maxlength="5"
              placeholder="请输入您的名字（2-5字）"
              value="{{regName}}"
              bindinput="onRegNameInput"
              bindblur="onNameBlur"
            />
            <view class="form-error" wx:if="{{regNameError}}">{{regNameError}}</view>
          </view>
        </view>

        <!-- 邮箱 -->
        <view class="auth-item">
          <view class="auth-title">邮箱</view>
          <view class="auth-content" wx:if="{{regEmail && !regEmailError && !editEmail}}" bindtap="onEditEmail">
            <view class="user-info">
              <view class="phone-info">{{regEmail}}</view>
            </view>
            <view class="auth-status success">已完成</view>
          </view>
          <view class="auth-content" wx:else style="flex-direction:column;align-items:stretch;">
            <input
              class="reg-input {{regEmailError ? 'has-error' : ''}}"
              type="text"
              placeholder="请输入邮箱"
              value="{{regEmail}}"
              bindinput="onRegEmailInput"
              bindblur="onEmailBlur"
            />
            <view class="form-error" wx:if="{{regEmailError}}">{{regEmailError}}</view>
          </view>
        </view>

        <!-- 性别 -->
        <view class="auth-item">
          <view class="auth-title">性别</view>
          <view class="auth-content" wx:if="{{regGender && !regGenderError && !editGender}}" bindtap="onEditGender">
            <view class="user-info">
              <view class="phone-info">{{regGender}}</view>
            </view>
            <view class="auth-status success">已完成</view>
          </view>
          <view class="auth-content" wx:else style="flex-direction:column;align-items:stretch;">
            <radio-group class="gender-options" bindchange="onRegGenderChange">
              <label class="gender-option {{regGender === '男' ? 'selected' : ''}}">
                <radio value="男" checked="{{regGender === '男'}}" color="#7c3aed" />
                <view class="gender-label">男</view>
              </label>
              <label class="gender-option {{regGender === '女' ? 'selected' : ''}}">
                <radio value="女" checked="{{regGender === '女'}}" color="#7c3aed" />
                <view class="gender-label">女</view>
              </label>
            </radio-group>
            <view class="form-error" wx:if="{{regGenderError}}">{{regGenderError}}</view>
          </view>
        </view>
      </block>

    </view>

    <view class="footer">
      <!-- 隐私政策勾选 -->
      <view class="privacy-checkbox" bindtap="togglePrivacyAgreement">
        <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
          <view class="check-icon" wx:if="{{privacyAgreed}}">✓</view>
        </view>
        <view class="checkbox-text">
          我已阅读并同意
          <text class="link" catchtap="viewAgreement">《用户服务协议》</text>
          和
          <text class="link" catchtap="viewPrivacy">《隐私政策》</text>
        </view>
      </view>
      
      <!-- 登录模式按钮 -->
      <block wx:if="{{mode === 'login'}}">
        <button class="complete-btn {{privacyAgreed && hasPhoneNumber && avatarUrl ? 'active' : ''}}" bindtap="completeLogin" disabled="{{!privacyAgreed || !hasPhoneNumber || !avatarUrl}}">完成授权并进入</button>
      </block>

      <!-- 注册模式按钮 -->
      <block wx:if="{{mode === 'register'}}">
        <view class="reg-error-msg" wx:if="{{regErrorMsg}}">{{regErrorMsg}}</view>
        <button class="complete-btn {{canRegister ? 'active' : ''}}" disabled="{{!canRegister || regSubmitting}}" bindtap="submitRegister">{{regSubmitting ? '注册中...' : '注册并登录'}}</button>
        <view class="reg-hint">
          <text>已有账号？</text>
          <text class="link" bindtap="onBackToLogin">返回登录</text>
        </view>
      </block>
    </view>
  </block>

  <!-- ====== Dev 模式：手机号+密码登录 ====== -->
  <block wx:if="{{isDev && loginMethod === 'password'}}">
    <view class="dev-login-form">
      <view class="form-item">
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phoneInput}}"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="form-item">
        <input
          class="form-input"
          type="text"
          password="{{true}}"
          placeholder="请输入密码"
          value="{{pwdInput}}"
          bindinput="onPwdInput"
        />
      </view>

      <!-- 隐私政策勾选 -->
      <view class="privacy-checkbox dev-privacy" bindtap="togglePrivacyAgreement">
        <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
          <view class="check-icon" wx:if="{{privacyAgreed}}">✓</view>
        </view>
        <view class="checkbox-text">
          我已阅读并同意
          <text class="link" catchtap="viewAgreement">《用户服务协议》</text>
          和
          <text class="link" catchtap="viewPrivacy">《隐私政策》</text>
        </view>
      </view>

      <button
        class="dev-login-btn {{canDevLogin && privacyAgreed ? 'active' : ''}}"
        disabled="{{!canDevLogin || !privacyAgreed}}"
        bindtap="loginByPassword"
      >密码登录</button>

      <view class="dev-hint">
        <button class="guest-btn" bindtap="enterAsGuest">以游客身份进入</button>
        <view class="guest-desc">游客模式仅可查看演示数据</view>
      </view>
    </view>
  </block>


</view>
