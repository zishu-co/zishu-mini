<!--pages/login/login.wxml-->
<view class="container">
  <!-- 装饰背景圆 -->
  <view class="decor-circle decor-circle-1"></view>
  <view class="decor-circle decor-circle-2"></view>
  <view class="decor-circle decor-circle-3"></view>

  <view class="header">
    <view class="welcome-text">
      <view class="welcome-title">{{isDev ? '开发者登录' : '欢迎登录'}}</view>
      <view class="welcome-subtitle">{{isDev ? 'Dev 模式 · 选择登录方式' : '授权登录后体验更多精彩功能'}}</view>
    </view>
  </view>

  <!-- ====== Dev 模式：登录方式 radio 选择 ====== -->
  <view class="login-method-selector" wx:if="{{isDev}}">
    <radio-group bindchange="onLoginMethodChange">
      <view class="method-option {{loginMethod === 'wechat' ? 'selected' : ''}}" bindtap="selectWechat">
        <radio value="wechat" checked="{{loginMethod === 'wechat'}}" color="#7c3aed" />
        <view class="method-label">微信授权登录</view>
      </view>
      <view class="method-option {{loginMethod === 'password' ? 'selected' : ''}}" bindtap="selectPassword">
        <radio value="password" checked="{{loginMethod === 'password'}}" color="#7c3aed" />
        <view class="method-label">手机号密码登录</view>
      </view>
    </radio-group>
  </view>

  <!-- ====== 微信授权登录 ====== -->
  <block wx:if="{{!isDev || loginMethod === 'wechat'}}">
    <view class="auth-section">
      <!-- 头像授权 -->
      <view class="auth-item">
        <view class="auth-title">头像授权</view>
        <view class="auth-content" wx:if="{{avatarUrl}}">
          <view class="user-info">
            <image class="avatar" src="{{avatarUrl}}"></image>
            <view class="nickname">已获取头像</view>
          </view>
          <view class="auth-status success">已完成</view>
        </view>
        <view class="auth-content" wx:else>
          <view class="auth-desc">用于展示您的个人形象</view>
          <button class="pop_avatar" wx:if="{{!avatarUrl}}" open-type="chooseAvatar" bindchooseavatar="getAvatar">获取头像</button>
          <view class="auth-status">待授权</view>
        </view>
      </view>

      <!-- 昵称授权 -->
      <view class="auth-item">
        <view class="auth-title">昵称授权</view>
        <view class="auth-content">
          <input
            type="nickname"
            class="ipu"
            placeholder="点击获取或输入昵称"
            value="{{nickName || ''}}"
            bindinput="getName"
            bindchange="getName"
            bindblur="getName"
          />
          <view class="auth-status success" wx:if="{{hasUserInfo && nickName}}">已完成</view>
          <view class="auth-status" wx:else>待授权</view>
        </view>
      </view>

      <!-- 手机号授权 -->
      <view class="auth-item">
        <view class="auth-title">手机号授权</view>
        <view class="auth-content" wx:if="{{hasPhoneNumber}}">
          <view class="user-info">
            <view class="phone-info">{{phoneNumber}}</view>
          </view>
          <view class="auth-status success">已完成</view>
        </view>
        <view class="auth-content" wx:else>
          <view class="auth-desc">用于接收订单通知</view>
          <button class="auth-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">一键授权</button>
          <view class="auth-status">待授权</view>
        </view>
      </view>
    </view>

    <view class="footer">
      <!-- 隐私政策勾选 -->
      <view class="privacy-checkbox" bindtap="togglePrivacyAgreement">
        <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
          <view class="check-icon" wx:if="{{privacyAgreed}}">✓</view>
        </view>
        <view class="checkbox-text">
          我已阅读并同意
          <text class="link" catchtap="viewAgreement">《用户服务协议》</text>
          和
          <text class="link" catchtap="viewPrivacy">《隐私政策》</text>
        </view>
      </view>
      
      <button class="complete-btn {{privacyAgreed ? 'active' : ''}}" bindtap="completeLogin" disabled="{{!privacyAgreed}}">完成授权并进入</button>
      <view style="display:flex;justify-content:center;gap:36rpx;margin-top:24rpx;font-size:24rpx;color:#7c3aed;font-weight:600;">
        <text bindtap="onOpenRegiModal">🌱 新塾员注册申请</text>
        <text bindtap="onOpenResetModal">🔑 忘记密码重置</text>
      </view>
    </view>
  </block>

  <!-- ====== Dev 模式：手机号+密码登录 ====== -->
  <block wx:if="{{isDev && loginMethod === 'password'}}">
    <view class="dev-login-form">
      <view class="form-item">
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phoneInput}}"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="form-item">
        <input
          class="form-input"
          type="text"
          password="{{true}}"
          placeholder="请输入密码"
          value="{{pwdInput}}"
          bindinput="onPwdInput"
        />
      </view>

      <!-- 隐私政策勾选 -->
      <view class="privacy-checkbox dev-privacy" bindtap="togglePrivacyAgreement">
        <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
          <view class="check-icon" wx:if="{{privacyAgreed}}">✓</view>
        </view>
        <view class="checkbox-text">
          我已阅读并同意
          <text class="link" catchtap="viewAgreement">《用户服务协议》</text>
          和
          <text class="link" catchtap="viewPrivacy">《隐私政策》</text>
        </view>
      </view>

      <button
        class="dev-login-btn {{canDevLogin && privacyAgreed ? 'active' : ''}}"
        disabled="{{!canDevLogin || !privacyAgreed || submitting}}"
        loading="{{submitting}}"
        bindtap="loginByPassword"
      >{{submitting ? '登录中...' : '密码登录'}}</button>

      <view class="dev-hint">
        <view style="display:flex;justify-content:center;gap:36rpx;margin-bottom:20rpx;font-size:24rpx;color:#7c3aed;font-weight:600;">
          <text bindtap="onOpenRegiModal">🌱 新塾员注册申请</text>
          <text bindtap="onOpenResetModal">🔑 忘记密码重置</text>
        </view>
        <button class="guest-btn" bindtap="enterAsGuest">以游客身份进入</button>
        <view class="guest-desc">游客模式仅可查看演示数据</view>
      </view>
    </view>
  </block>

  <!-- 101-regi.md: 新塾员注册申请弹窗 -->
  <view
    wx:if="{{showRegiModal}}"
    style="position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:999;display:flex;align-items:flex-end;"
    bindtap="onCloseRegiModal"
  >
    <view
      style="width:100%;max-height:85vh;background:#fff;border-radius:32rpx 32rpx 0 0;padding:32rpx;box-sizing:border-box;overflow-y:auto;"
      catchtap=""
    >
      <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx;">
        <text style="font-size:32rpx;font-weight:700;color:#0f172a;">🌱 新塾员入塾注册申请 (101-regi.md)</text>
        <text style="font-size:32rpx;color:#64748b;padding:8rpx;" bindtap="onCloseRegiModal">✕</text>
      </view>
      <view style="margin-bottom:16rpx;">
        <input
          placeholder="姓名 / 昵称 *"
          value="{{regiForm.name}}"
          data-field="name"
          bindinput="onRegiFieldInput"
          style="height:76rpx;background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:14rpx;padding:0 20rpx;font-size:26rpx;"
        />
      </view>
      <view style="display:flex;gap:16rpx;margin-bottom:16rpx;">
        <view
          wx:for="{{['男','女']}}"
          wx:key="*this"
          data-gender="{{item}}"
          bindtap="onSelectRegiGender"
          style="flex:1;height:68rpx;line-height:68rpx;text-align:center;border-radius:14rpx;font-size:26rpx;font-weight:700;{{regiForm.gender === item ? 'background:#7c3aed;color:#fff;' : 'background:#f1f5f9;color:#475569;'}}"
        >{{item}}生</view>
      </view>
      <view style="margin-bottom:16rpx;">
        <input
          type="number"
          maxlength="11"
          placeholder="11位手机号码 *"
          value="{{regiForm.phone}}"
          data-field="phone"
          bindinput="onRegiFieldInput"
          style="height:76rpx;background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:14rpx;padding:0 20rpx;font-size:26rpx;"
        />
      </view>
      <view style="margin-bottom:16rpx;">
        <input
          placeholder="常用邮箱（选填）"
          value="{{regiForm.email}}"
          data-field="email"
          bindinput="onRegiFieldInput"
          style="height:76rpx;background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:14rpx;padding:0 20rpx;font-size:26rpx;"
        />
      </view>
      <view style="margin-bottom:16rpx;">
        <input
          password="{{true}}"
          placeholder="设置登录密码（至少4位）*"
          value="{{regiForm.password}}"
          data-field="password"
          bindinput="onRegiFieldInput"
          style="height:76rpx;background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:14rpx;padding:0 20rpx;font-size:26rpx;"
        />
      </view>
      <view style="margin-bottom:24rpx;">
        <input
          placeholder="入塾初心或共学期待（选填）"
          value="{{regiForm.notes}}"
          data-field="notes"
          bindinput="onRegiFieldInput"
          style="height:76rpx;background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:14rpx;padding:0 20rpx;font-size:26rpx;"
        />
      </view>
      <button
        style="background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;border-radius:999rpx;font-size:28rpx;font-weight:700;"
        bindtap="onSubmitRegister"
      >{{submittingRegi ? '提交中...' : '提交入塾申请'}}</button>
    </view>
  </view>

  <!-- 111-reset-pass.md: 忘记密码重置弹窗 -->
  <view
    wx:if="{{showResetModal}}"
    style="position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:999;display:flex;align-items:flex-end;"
    bindtap="onCloseResetModal"
  >
    <view
      style="width:100%;background:#fff;border-radius:32rpx 32rpx 0 0;padding:32rpx;box-sizing:border-box;"
      catchtap=""
    >
      <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx;">
        <text style="font-size:32rpx;font-weight:700;color:#0f172a;">🔑 申请重置密码 (111-reset-pass.md)</text>
        <text style="font-size:32rpx;color:#64748b;padding:8rpx;" bindtap="onCloseResetModal">✕</text>
      </view>
      <view style="margin-bottom:24rpx;">
        <input
          type="number"
          maxlength="11"
          placeholder="请输入注册时的11位手机号"
          value="{{resetPhone}}"
          bindinput="onResetPhoneInput"
          style="height:80rpx;background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:14rpx;padding:0 20rpx;font-size:26rpx;"
        />
      </view>
      <button
        style="background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;border-radius:999rpx;font-size:28rpx;font-weight:700;"
        bindtap="onSubmitResetPass"
      >{{submittingReset ? '提交中...' : '提交密码重置申请'}}</button>
    </view>
  </view>
</view>
