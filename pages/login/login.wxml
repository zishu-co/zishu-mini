<!--pages/login/login.wxml-->
<view class="container">
  <!-- 装饰背景圆 -->
  <view class="decor-circle decor-circle-1"></view>
  <view class="decor-circle decor-circle-2"></view>
  <view class="decor-circle decor-circle-3"></view>

  <view class="header">
    <view class="welcome-text">
      <view class="welcome-title">{{mode === 'register' ? '完善注册信息' : (isDev ? '开发者登录' : '欢迎登录')}}</view>
      <view class="welcome-subtitle">{{mode === 'register' ? '首次登录 · 补充性别、邮箱与密码即可直接进入' : (isDev ? 'Dev 模式 · 选择登录方式' : '授权头像昵称与手机号，即刻开启共学之旅')}}</view>
    </view>
  </view>

  <!-- ====== 登录方式切换（支持微信授权与手机号密码双通道） ====== -->
  <view class="login-method-selector" wx:if="{{mode === 'login'}}">
    <radio-group bindchange="onLoginMethodChange">
      <view class="method-option {{loginMethod === 'wechat' ? 'selected' : ''}}" bindtap="selectWechat">
        <radio value="wechat" checked="{{loginMethod === 'wechat'}}" color="#7c3aed" />
        <view class="method-label">💬 微信授权登录</view>
      </view>
      <view class="method-option {{loginMethod === 'password' ? 'selected' : ''}}" bindtap="selectPassword">
        <radio value="password" checked="{{loginMethod === 'password'}}" color="#7c3aed" />
        <view class="method-label">🔑 手机号密码登录</view>
      </view>
    </radio-group>
  </view>

  <!-- ====== 微信授权登录 & 新用户原地注册流程 ====== -->
  <block wx:if="{{loginMethod === 'wechat' || mode === 'register'}}">
    <view class="auth-section">
      <!-- 1. 头像授权 -->
      <view class="auth-item">
        <view class="auth-title-row">
          <view class="auth-title">头像授权</view>
          <view class="auth-status success" wx:if="{{avatarUrl}}">已完成</view>
          <view class="auth-status" wx:else>待授权</view>
        </view>
        <view class="auth-content" wx:if="{{avatarUrl}}">
          <view class="user-info">
            <image class="avatar" src="{{avatarUrl}}"></image>
            <view class="nickname">已获取微信头像</view>
          </view>
          <button class="auth-btn auth-btn-sm" open-type="chooseAvatar" bindchooseavatar="getAvatar">更换头像</button>
        </view>
        <view class="auth-content" wx:else>
          <view class="auth-desc">用于展示您的个人形象</view>
          <button class="pop_avatar" open-type="chooseAvatar" bindchooseavatar="getAvatar">📸 获取头像</button>
        </view>
      </view>

      <!-- 1. 昵称授权 -->
      <view class="auth-item">
        <view class="auth-title-row">
          <view class="auth-title">昵称授权</view>
          <view class="auth-status success" wx:if="{{hasNickName && !regNameError}}">已完成</view>
          <view class="auth-status" wx:else>{{mode === 'register' ? '必填' : '待授权'}}</view>
        </view>
        <view class="auth-content auth-content-col">
          <input
            type="nickname"
            maxlength="20"
            class="ipu {{mode === 'register' && regNameError ? 'has-error' : ''}}"
            placeholder="点击获取微信昵称或输入昵称"
            value="{{nickName || ''}}"
            bindinput="getName"
            bindchange="getName"
            bindblur="onNickNameBlur"
          />
          <view class="form-error" wx:if="{{mode === 'register' && regNameError}}">{{regNameError}}</view>
        </view>
      </view>

      <!-- 2. 手机号授权 -->
      <view class="auth-item">
        <view class="auth-title-row">
          <view class="auth-title">手机号授权</view>
          <view class="auth-status success" wx:if="{{hasPhoneNumber}}">已完成</view>
          <view class="auth-status" wx:else>待授权</view>
        </view>
        <view class="auth-content" wx:if="{{hasPhoneNumber}}">
          <view class="user-info">
            <view class="phone-info">{{phoneNumber || '已授权手机号'}}</view>
          </view>
          <button class="auth-btn auth-btn-sm" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">🔄 重新授权</button>
        </view>
        <view class="auth-content" wx:else>
          <view class="auth-desc">{{phoneNumber ? ('当前号码 ' + phoneNumber + '，点击授权登录') : '老用户直接进入，新用户原地注册'}}</view>
          <button class="auth-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">📱 一键授权</button>
        </view>
      </view>

      <!-- 4. 用户不存在时：原地展开性别、邮箱、密码（不提示用户不存在，不弹入塾申请半弹窗） -->
      <block wx:if="{{mode === 'register'}}">
        <!-- 性别 -->
        <view class="auth-item">
          <view class="auth-title-row">
            <view class="auth-title">性别</view>
            <view class="auth-status success" wx:if="{{regGender}}">已完成</view>
            <view class="auth-status" wx:else>必选</view>
          </view>
          <view class="auth-content auth-content-col">
            <view class="gender-options">
              <view
                class="gender-option {{regGender === '男' ? 'selected' : ''}}"
                data-gender="男"
                bindtap="onSelectRegGender"
              >
                <text class="gender-label">🚹 男</text>
              </view>
              <view
                class="gender-option {{regGender === '女' ? 'selected' : ''}}"
                data-gender="女"
                bindtap="onSelectRegGender"
              >
                <text class="gender-label">🚺 女</text>
              </view>
            </view>
            <view class="form-error" wx:if="{{regGenderError}}">{{regGenderError}}</view>
          </view>
        </view>

        <!-- 邮箱 -->
        <view class="auth-item">
          <view class="auth-title-row">
            <view class="auth-title">邮箱</view>
            <view class="auth-status success" wx:if="{{emailValid}}">已完成</view>
            <view class="auth-status" wx:else>必填</view>
          </view>
          <view class="auth-content auth-content-col">
            <input
              class="ipu reg-ipu {{regEmailError ? 'has-error' : ''}}"
              type="text"
              placeholder="请输入常用邮箱（如 name@example.com）"
              value="{{regEmail}}"
              bindinput="onRegEmailInput"
              bindblur="onEmailBlur"
            />
            <view class="form-error" wx:if="{{regEmailError}}">{{regEmailError}}</view>
          </view>
        </view>

        <!-- 密码 -->
        <view class="auth-item">
          <view class="auth-title-row">
            <view class="auth-title">密码</view>
            <view class="auth-status success" wx:if="{{pwdValid}}">已完成</view>
            <view class="auth-status" wx:else>必填</view>
          </view>
          <view class="auth-content auth-content-col">
            <view class="pwd-input-wrap">
              <input
                class="ipu reg-ipu pwd-ipu {{regPasswordError ? 'has-error' : ''}}"
                type="text"
                password="{{!showRegPwd}}"
                placeholder="请设置登录密码（至少6位）"
                value="{{regPassword}}"
                bindinput="onRegPasswordInput"
                bindblur="onPasswordBlur"
              />
              <view class="pwd-toggle" catchtap="toggleShowRegPwd">{{showRegPwd ? '🙈' : '👁️'}}</view>
            </view>
            <view class="form-error" wx:if="{{regPasswordError}}">{{regPasswordError}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="footer">
      <!-- 隐私政策勾选 -->
      <view class="privacy-checkbox" bindtap="togglePrivacyAgreement">
        <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
          <view class="check-icon" wx:if="{{privacyAgreed}}">✓</view>
        </view>
        <view class="checkbox-text">
          我已阅读并同意
          <text class="link" catchtap="viewAgreement">《用户服务协议》</text>
          和
          <text class="link" catchtap="viewPrivacy">《隐私政策》</text>
        </view>
      </view>

      <!-- 登录模式主按钮 -->
      <block wx:if="{{mode === 'login'}}">
        <button
          class="complete-btn {{privacyAgreed && hasPhoneNumber ? 'active' : ''}}"
          bindtap="completeLogin"
        >🚀 完成授权并进入</button>
      </block>

      <!-- 注册模式主按钮：直接注册并登录 -->
      <block wx:if="{{mode === 'register'}}">
        <view class="reg-error-msg" wx:if="{{regErrorMsg}}">{{regErrorMsg}}</view>
        <button
          class="complete-btn {{canRegister ? 'active' : ''}}"
          loading="{{regSubmitting}}"
          disabled="{{regSubmitting}}"
          bindtap="submitRegister"
        >{{regSubmitting ? '⏳ 注册登录中...' : '🚀 注册并登录'}}</button>
        <view class="reg-hint">
          <text>已有其他手机号账号？</text>
          <text class="link" bindtap="onBackToLogin">返回重新登录</text>
        </view>
      </block>
    </view>
  </block>

  <!-- ====== 手机号+密码登录 ====== -->
  <block wx:if="{{mode === 'login' && loginMethod === 'password'}}">
    <view class="dev-login-form">
      <view class="form-item">
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phoneInput}}"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="form-item">
        <input
          class="form-input"
          type="text"
          password="{{true}}"
          placeholder="请输入密码"
          value="{{pwdInput}}"
          bindinput="onPwdInput"
        />
      </view>

      <!-- 隐私政策勾选 -->
      <view class="privacy-checkbox dev-privacy" bindtap="togglePrivacyAgreement">
        <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
          <view class="check-icon" wx:if="{{privacyAgreed}}">✓</view>
        </view>
        <view class="checkbox-text">
          我已阅读并同意
          <text class="link" catchtap="viewAgreement">《用户服务协议》</text>
          和
          <text class="link" catchtap="viewPrivacy">《隐私政策》</text>
        </view>
      </view>

      <button
        class="dev-login-btn {{canDevLogin && privacyAgreed ? 'active' : ''}}"
        disabled="{{!canDevLogin || !privacyAgreed || submitting}}"
        loading="{{submitting}}"
        bindtap="loginByPassword"
      >{{submitting ? '⏳ 登录中...' : '🔑 密码登录'}}</button>

      <view class="dev-hint">
        <view class="login-sub-links login-sub-links-dev">
          <text class="login-sub-link" bindtap="onOpenResetModal">🔑 忘记密码重置</text>
        </view>
        <block wx:if="{{isDev}}">
          <button class="guest-btn" bindtap="enterAsGuest">👀 以游客身份进入</button>
          <view class="guest-desc">游客模式仅可查看演示数据</view>
        </block>
      </view>
    </view>
  </block>

  <!-- 111-reset-pass.md: 忘记密码重置弹窗（catchtap="noop" 阻止点击穿透关闭） -->
  <view
    wx:if="{{showResetModal}}"
    class="login-sheet-mask"
    bindtap="onCloseResetModal"
  >
    <view
      class="login-sheet-card"
      catchtap="noop"
    >
      <view class="login-sheet-header">
        <text class="login-sheet-title">🔑 申请重置密码</text>
        <text class="login-sheet-close" bindtap="onCloseResetModal">✕</text>
      </view>
      <view class="login-sheet-field login-sheet-field-last">
        <input
          class="login-sheet-input"
          type="number"
          maxlength="11"
          placeholder="请输入注册时的11位手机号"
          value="{{resetPhone}}"
          bindinput="onResetPhoneInput"
        />
      </view>
      <button
        class="login-sheet-submit"
        bindtap="onSubmitResetPass"
      >{{submittingReset ? '⏳ 提交中...' : '🔑 提交密码重置申请'}}</button>
    </view>
  </view>
</view>
