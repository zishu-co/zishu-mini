/* pages/login/login.wxss */
page {
  background: linear-gradient(180deg, #f5f3ff 0%, #ede9fe 50%, #e9d5ff 100%);
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 34rpx 48rpx;
  box-sizing: border-box;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

/* 装饰背景圆 */
.decor-circle {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(167, 139, 250, 0.3), rgba(139, 92, 246, 0.1));
  pointer-events: none;
}

.decor-circle-1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -80rpx;
  animation: float 6s ease-in-out infinite;
}

.decor-circle-2 {
  width: 200rpx;
  height: 200rpx;
  top: 200rpx;
  left: -60rpx;
  animation: float 8s ease-in-out infinite reverse;
}

.decor-circle-3 {
  width: 150rpx;
  height: 150rpx;
  bottom: 300rpx;
  right: -40rpx;
  animation: float 5s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.05); }
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 28rpx 0 44rpx;
  width: 100%;
  animation: fadeInDown 0.8s ease-out;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.welcome-text {
  text-align: center;
  margin-top: 12rpx;
  padding: 0 12rpx;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 45%, #7c3aed 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}

.welcome-subtitle {
  font-size: 26rpx;
  color: #7c3aed;
  opacity: 0.85;
  line-height: 1.45;
}

.auth-section {
  width: 100%;
  margin-bottom: 36rpx;
  animation: fadeInUp 0.8s ease-out 0.15s both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.auth-item {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 32rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 22rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.12),
    0 4rpx 12rpx rgba(147, 51, 234, 0.06),
    inset 0 3rpx 0 #ffffff;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(244, 114, 182, 0.28);
  box-sizing: border-box;
}

.auth-item:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.14),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.auth-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
  gap: 16rpx;
}

.auth-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4c1d95;
  display: flex;
  align-items: center;
}

.auth-title::before {
  content: "✨";
  display: inline-block;
  margin-right: 10rpx;
  font-size: 26rpx;
}

.auth-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 76rpx;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.auth-content-col {
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 10rpx;
}

.auth-desc {
  font-size: 26rpx;
  color: #6d28d9;
  opacity: 0.78;
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}

.auth-btn {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  margin: 0;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.28);
  white-space: nowrap;
  flex-shrink: 0;
}

.auth-btn::after {
  border: none;
}

.auth-btn:active {
  transform: scale(0.96);
}

.auth-btn-sm {
  font-size: 23rpx;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.pop_avatar {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  margin: 0;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.28);
  white-space: nowrap;
  flex-shrink: 0;
}

.pop_avatar::after {
  border: none;
}

/* 输入框（昵称 / 邮箱 / 密码统一胶囊框） */
.ipu {
  width: 100%;
  font-size: 28rpx;
  color: #3b0764;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(167, 139, 250, 0.36);
  border-radius: 24rpx;
  padding: 0 26rpx;
  height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
}

.ipu.has-error {
  border-color: #ef4444;
  background: rgba(254, 242, 242, 0.9);
}

.reg-ipu {
  background: rgba(255, 255, 255, 0.96);
}

.pwd-input-wrap {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 12rpx;
  box-sizing: border-box;
}

.pwd-ipu {
  flex: 1;
  min-width: 0;
}

.pwd-toggle {
  width: 72rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: rgba(124, 58, 237, 0.08);
  border: 2rpx solid rgba(167, 139, 250, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

/* 原地注册性别选择胶囊 */
.gender-options {
  display: flex;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.gender-option {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(167, 139, 250, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s ease;
  box-sizing: border-box;
}

.gender-option.selected {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  border-color: #7c3aed;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.28);
}

.gender-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4c1d95;
}

.gender-option.selected .gender-label {
  color: #ffffff;
}

.form-error {
  font-size: 23rpx;
  color: #dc2626;
  padding-left: 8rpx;
  line-height: 1.35;
}

.auth-status {
  font-size: 24rpx;
  color: #9333ea;
  opacity: 0.72;
  display: flex;
  align-items: center;
  white-space: nowrap;
  flex-shrink: 0;
}

.auth-status.success {
  color: #059669;
  opacity: 1;
  font-weight: 600;
}

.auth-status.success::before {
  content: "✓";
  display: inline-block;
  margin-right: 6rpx;
  font-weight: bold;
  font-size: 26rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  border: 3rpx solid rgba(167, 139, 250, 0.35);
  box-shadow: 0 4rpx 12rpx rgba(139, 92, 246, 0.2);
  flex-shrink: 0;
}

.nickname,
.phone-info {
  font-size: 29rpx;
  color: #4c1d95;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.footer {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 24rpx;
  animation: fadeInUp 0.8s ease-out 0.3s both;
}

.complete-btn {
  width: 94%;
  height: 94rpx;
  line-height: 94rpx;
  background: #d8cef0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  position: relative;
  overflow: hidden;
}

.complete-btn.active {
  background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 60%, #5b21b6 100%);
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.34);
}

.complete-btn::after {
  border: none;
}

.complete-btn:active {
  transform: scale(0.98);
}

.reg-error-msg {
  background: rgba(239, 68, 68, 0.10);
  color: #dc2626;
  border: 2rpx solid rgba(239, 68, 68, 0.25);
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  margin-bottom: 22rpx;
  text-align: center;
  width: 94%;
  box-sizing: border-box;
  line-height: 1.45;
}

.reg-hint {
  text-align: center;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #6b7280;
}

.reg-hint .link {
  margin-left: 8rpx;
}

.privacy-checkbox {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding: 0 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.checkbox {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #c4b5fd;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 10rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 3rpx;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  border-color: #7c3aed;
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.checkbox-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  flex: 1;
}

.link {
  color: #7c3aed;
  font-weight: 600;
}

/* ========== 登录方式选择器 ========== */
.login-method-selector {
  width: 100%;
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease-out 0.15s both;
}

.login-method-selector radio-group,
.radio-group {
  display: flex;
  gap: 18rpx;
  width: 100%;
}

.method-option {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 28rpx;
  padding: 24rpx 16rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.28);
  transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.12),
    inset 0 3rpx 0 #ffffff;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}

.method-option:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
}

.method-option.selected {
  border: 3rpx solid #fb923c;
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  box-shadow:
    0 14rpx 32rpx -6rpx rgba(251, 146, 60, 0.25),
    0 0 0 4rpx rgba(251, 146, 60, 0.14),
    inset 0 3rpx 0 #ffffff;
}

.method-label {
  font-size: 25rpx;
  color: #4c1d95;
  font-weight: 600;
  margin-left: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ========== 手机号密码登录表单样式 ========== */
.dev-login-form {
  width: 100%;
  max-width: 640rpx;
  padding: 16rpx 8rpx 32rpx;
  box-sizing: border-box;
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

.dev-privacy {
  margin: 24rpx 0;
}

.form-item {
  margin-bottom: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10), inset 0 3rpx 0 #ffffff;
  box-sizing: border-box;
}

.form-item:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.28);
}

.form-input {
  width: 100%;
  height: 84rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 22rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  color: #1e1b4b;
}

.dev-login-btn {
  width: 100%;
  height: 94rpx;
  line-height: 94rpx;
  background: #e0d4f7;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  margin-top: 28rpx;
  letter-spacing: 2rpx;
}

.dev-login-btn::after {
  border: none;
}

.dev-login-btn.active {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.34);
}

.dev-hint {
  margin-top: 44rpx;
}

.guest-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: transparent;
  border: 2rpx solid #a855f7;
  color: #7c3aed;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 45rpx;
}

.guest-desc {
  text-align: center;
  font-size: 24rpx;
  color: #8b5cf6;
  margin-top: 18rpx;
  opacity: 0.8;
}

/* 密码重置入口 & 底部抽屉弹窗 */
.login-sub-links {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 20rpx;
  font-size: 25rpx;
  color: #7c3aed;
  font-weight: 700;
}

.login-sub-links-dev {
  margin-top: 0;
  margin-bottom: 24rpx;
}

.login-sub-link {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.login-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(36, 16, 68, 0.44);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
}

.login-sheet-card {
  width: 100%;
  max-height: 86vh;
  background:
    radial-gradient(circle at 15% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 85% 0%, rgba(129, 140, 248, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 40%, #f8f7ff 100%);
  border-radius: 48rpx 48rpx 0 0;
  padding: 26rpx 34rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow:
    0 -20rpx 64rpx rgba(109, 40, 217, 0.22),
    inset 0 3rpx 0 #ffffff;
  border-top: 2rpx solid rgba(255, 255, 255, 0.98);
}

.login-sheet-card::before {
  content: '';
  display: block;
  width: 78rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f9a8d4 0%, #c084fc 50%, #818cf8 100%);
  margin: 0 auto 20rpx;
  opacity: 0.9;
}

.login-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.login-sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #3b0764;
}

.login-sheet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  color: #9333ea;
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  font-size: 26rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.login-sheet-field {
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
}

.login-sheet-field-last {
  margin-bottom: 28rpx;
}

.login-sheet-input {
  width: 100%;
  height: 82rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(192, 132, 252, 0.28);
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  box-sizing: border-box;
}

.login-sheet-submit {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 52%, #5b21b6 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0;
}
