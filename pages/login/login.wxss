/* pages/login/login.wxss */
page {
  background: linear-gradient(180deg, #f5f3ff 0%, #ede9fe 50%, #e9d5ff 100%);
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
  box-sizing: border-box;
  min-height: 100vh;
  position: relative;
}

/* 装饰背景圆 */
.decor-circle {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(167, 139, 250, 0.3), rgba(139, 92, 246, 0.1));
}

.decor-circle-1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -80rpx;
  animation: float 6s ease-in-out infinite;
}

.decor-circle-2 {
  width: 200rpx;
  height: 200rpx;
  top: 200rpx;
  left: -60rpx;
  animation: float 8s ease-in-out infinite reverse;
}

.decor-circle-3 {
  width: 150rpx;
  height: 150rpx;
  bottom: 300rpx;
  right: -40rpx;
  animation: float 5s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.05); }
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 40rpx 0 60rpx;
  width: 100%;
  animation: fadeInDown 0.8s ease-out;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}



.welcome-text {
  text-align: center;
  margin-top: 20rpx;
}

.welcome-title {
  font-size: 52rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 45%, #7c3aed 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.welcome-subtitle {
  font-size: 28rpx;
  color: #8b5cf6;
  opacity: 0.8;
}

.auth-section {
  width: 100%;
  margin-bottom: 60rpx;
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.auth-item {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 32rpx;
  padding: 34rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.12),
    0 4rpx 12rpx rgba(147, 51, 234, 0.06),
    inset 0 3rpx 0 #ffffff;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(244, 114, 182, 0.28);
  transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
}

.auth-item:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.14),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.auth-item:active {
  transform: scale(0.985);
}

.auth-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #4c1d95;
  display: flex;
  align-items: center;
}

.auth-title::before {
  content: "✨";
  display: inline-block;
  margin-right: 12rpx;
  font-size: 28rpx;
}

.auth-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 80rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: #7c3aed;
  opacity: 0.7;
  flex: 1;
}

.auth-btn {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  margin: 0;
  font-weight: 500;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.28);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  white-space: nowrap;
  flex-shrink: 0;
}

.auth-btn::after {
  border: none;
}

.auth-btn:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 10rpx rgba(124, 58, 237, 0.2);
}

.auth-btn-sm {
  margin-right: 12rpx;
  font-size: 22rpx;
  padding: 0 22rpx;
  height: 52rpx;
  line-height: 52rpx;
}

/* 获取头像按钮特殊样式 */
.pop_avatar {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.28);
  white-space: nowrap;
  flex-shrink: 0;
}

.pop_avatar::after {
  border: none;
}

/* 昵称输入框 */
.ipu {
  flex: 1;
  font-size: 28rpx;
  color: #4c1d95;
  background: linear-gradient(135deg, rgba(167, 139, 250, 0.1), rgba(139, 92, 246, 0.05));
  border: 2rpx solid rgba(167, 139, 250, 0.3);
  border-radius: 36rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.ipu::placeholder {
  color: #a78bfa;
}

.auth-status {
  font-size: 26rpx;
  color: #a78bfa;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.auth-status.success {
  color: #10b981;
  font-weight: 500;
}

.auth-status.success::before {
  content: "✓";
  display: inline-block;
  margin-right: 8rpx;
  font-weight: bold;
  font-size: 28rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid rgba(167, 139, 250, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(139, 92, 246, 0.2);
}

.nickname,
.phone-info {
  font-size: 30rpx;
  color: #4c1d95;
  font-weight: 500;
}

.footer {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  animation: fadeInUp 0.8s ease-out 0.4s both;
}

.complete-btn {
  width: 90%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 60%, #5b21b6 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.32);
  letter-spacing: 4rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
}

.complete-btn::after {
  border: none;
}

.complete-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.complete-btn:active::before {
  left: 100%;
}

.complete-btn:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(139, 92, 246, 0.3);
}

.privacy-checkbox {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding: 0 20rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  border-color: #7c3aed;
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.checkbox-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  flex: 1;
}

.link {
  color: #7c3aed;
  font-weight: 500;
}

.complete-btn[disabled] {
  background: #e5e7eb !important;
  color: #9ca3af !important;
  box-shadow: none !important;
}

/* ========== Dev 模式登录方式选择器 ========== */
.login-method-selector {
  width: 100%;
  margin-bottom: 40rpx;
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

.login-method-selector radio-group,
.radio-group {
  display: flex;
  gap: 24rpx;
}

.method-option {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 30rpx;
  padding: 28rpx 22rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.28);
  transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.12),
    inset 0 3rpx 0 #ffffff;
  flex: 1;
}

.method-option:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.13),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.method-option.selected {
  border: 3rpx solid #fb923c;
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  box-shadow:
    0 14rpx 32rpx -6rpx rgba(251, 146, 60, 0.25),
    0 0 0 4rpx rgba(251, 146, 60, 0.14),
    inset 0 3rpx 0 #ffffff;
  transform: translateY(-2rpx);
}

.method-label {
  font-size: 28rpx;
  color: #4c1d95;
  font-weight: 600;
  margin-left: 12rpx;
  white-space: nowrap;
}

/* ========== Dev 模式登录表单样式 ========== */
.dev-divider {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 40rpx 0 20rpx;
}

.dev-divider-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.5), transparent);
}

.dev-divider-text {
  padding: 0 24rpx;
  color: #a78bfa;
  font-size: 28rpx;
  white-space: nowrap;
}

.dev-login-form {
  width: 100%;
  max-width: 600rpx;
  padding: 40rpx 32rpx;
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

.dev-privacy {
  margin: 24rpx 0;
}

.form-item {
  margin-bottom: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10), inset 0 3rpx 0 #ffffff;
}

.form-item:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.28);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12), inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 0 30rpx;
  font-size: 29rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  color: #1e1b4b;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.form-input::placeholder {
  color: #a78bfa;
}

.dev-login-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: #e0d4f7;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 24rpx;
  margin-top: 40rpx;
  letter-spacing: 4rpx;
  transition: all 0.3s ease;
}

.dev-login-btn::after {
  border: none;
}

.dev-login-btn.active {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.34);
}

.dev-login-btn.active:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(139, 92, 246, 0.3);
}

.dev-hint {
  margin-top: 60rpx;
}

.hint-divider {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.hint-divider::before,
.hint-divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.5), transparent);
}

.hint-divider text {
  padding: 0 32rpx;
  color: #a78bfa;
  font-size: 28rpx;
}

.guest-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: transparent;
  border: 2rpx solid #a855f7;
  color: #a855f7;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.guest-btn:active {
  background: rgba(168, 85, 247, 0.1);
  transform: scale(0.98);
}

.guest-desc {
  text-align: center;
  font-size: 26rpx;
  color: #a78bfa;
  margin-top: 24rpx;
  opacity: 0.8;
}

/* 注册与密码重置链接 & 底部抽屉弹窗 */
.login-sub-links {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 24rpx;
  font-size: 25rpx;
  color: #7c3aed;
  font-weight: 700;
}

.login-sub-links-dev {
  margin-top: 0;
  margin-bottom: 24rpx;
}

.login-sub-link {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
}

.login-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(36, 16, 68, 0.44);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.login-sheet-card {
  width: 100%;
  max-height: 86vh;
  background:
    radial-gradient(circle at 15% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 85% 0%, rgba(129, 140, 248, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 40%, #f8f7ff 100%);
  border-radius: 48rpx 48rpx 0 0;
  padding: 26rpx 34rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow:
    0 -20rpx 64rpx rgba(109, 40, 217, 0.22),
    inset 0 3rpx 0 #ffffff;
  border-top: 2rpx solid rgba(255, 255, 255, 0.98);
}

.login-sheet-card::before {
  content: '';
  display: block;
  width: 78rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f9a8d4 0%, #c084fc 50%, #818cf8 100%);
  margin: 0 auto 20rpx;
  opacity: 0.9;
}

.login-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.login-sheet-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #3b0764;
}

.login-sheet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  color: #9333ea;
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.12), inset 0 2rpx 0 #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.login-sheet-field {
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow: 0 10rpx 24rpx -8rpx rgba(236, 72, 153, 0.10), inset 0 3rpx 0 #ffffff;
}

.login-sheet-field:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.28);
  box-shadow: 0 10rpx 24rpx -8rpx rgba(99, 102, 241, 0.12), inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.login-sheet-field-last {
  margin-bottom: 28rpx;
}

.login-sheet-input {
  width: 100%;
  height: 82rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(192, 132, 252, 0.28);
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.login-gender-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.login-gender-pill {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  border: 2rpx solid rgba(139, 92, 246, 0.22);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04), inset 0 1rpx 0 #ffffff;
  transition: all 0.18s ease;
}

.login-gender-pill.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.32), inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.login-sheet-submit {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 52%, #5b21b6 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  box-shadow:
    0 12rpx 28rpx rgba(124, 58, 237, 0.30),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}
