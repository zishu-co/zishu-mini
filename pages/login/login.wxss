/* pages/login/login.wxss */
page {
  background: linear-gradient(180deg, #f5f3ff 0%, #ede9fe 50%, #e9d5ff 100%);
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
  box-sizing: border-box;
  min-height: 100vh;
  position: relative;
}

/* 装饰背景圆 */
.decor-circle {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(167, 139, 250, 0.3), rgba(139, 92, 246, 0.1));
}

.decor-circle-1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -80rpx;
  animation: float 6s ease-in-out infinite;
}

.decor-circle-2 {
  width: 200rpx;
  height: 200rpx;
  top: 200rpx;
  left: -60rpx;
  animation: float 8s ease-in-out infinite reverse;
}

.decor-circle-3 {
  width: 150rpx;
  height: 150rpx;
  bottom: 300rpx;
  right: -40rpx;
  animation: float 5s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.05); }
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 40rpx 0 60rpx;
  width: 100%;
  animation: fadeInDown 0.8s ease-out;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}



.welcome-text {
  text-align: center;
  margin-top: 20rpx;
}

.welcome-title {
  font-size: 52rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 55%, #a855f7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.welcome-subtitle {
  font-size: 28rpx;
  color: #8b5cf6;
  opacity: 0.8;
}

.auth-section {
  width: 100%;
  margin-bottom: 60rpx;
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.auth-item {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 92, 246, 0.12);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(167, 139, 250, 0.2);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.auth-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.1);
}

/* 左侧渐变条 */
.auth-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(to bottom, #aa00ff, #7c3aed);
  border-radius: 4rpx 0 0 4rpx;
}

.auth-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #4c1d95;
  display: flex;
  align-items: center;
}

.auth-title::before {
  content: "✨";
  display: inline-block;
  margin-right: 12rpx;
  font-size: 28rpx;
}

.auth-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 80rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: #7c3aed;
  opacity: 0.7;
  flex: 1;
}

.auth-btn {
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  margin: 0;
  font-weight: 500;
  box-shadow: 0 6rpx 20rpx rgba(170, 0, 255, 0.3);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.auth-btn::after {
  border: none;
}

.auth-btn:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 10rpx rgba(170, 0, 255, 0.22);
}

.auth-btn-sm {
  margin-right: 12rpx;
  font-size: 22rpx;
  padding: 0 22rpx;
  height: 52rpx;
  line-height: 52rpx;
}

/* 获取头像按钮特殊样式 */
.pop_avatar {
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 20rpx rgba(170, 0, 255, 0.3);
}

.pop_avatar::after {
  border: none;
}

/* 昵称输入框 */
.ipu {
  flex: 1;
  font-size: 28rpx;
  color: #4c1d95;
  background: linear-gradient(135deg, rgba(167, 139, 250, 0.1), rgba(139, 92, 246, 0.05));
  border: 2rpx solid rgba(167, 139, 250, 0.3);
  border-radius: 36rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.ipu::placeholder {
  color: #a78bfa;
}

.auth-status {
  font-size: 26rpx;
  color: #a78bfa;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.auth-status.success {
  color: #10b981;
  font-weight: 500;
}

.auth-status.success::before {
  content: "✓";
  display: inline-block;
  margin-right: 8rpx;
  font-weight: bold;
  font-size: 28rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid rgba(167, 139, 250, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(139, 92, 246, 0.2);
}

.nickname,
.phone-info {
  font-size: 30rpx;
  color: #4c1d95;
  font-weight: 500;
}

.footer {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  animation: fadeInUp 0.8s ease-out 0.4s both;
}

.complete-btn {
  width: 90%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 60%, #6d28d9 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(170, 0, 255, 0.35);
  letter-spacing: 4rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
}

.complete-btn::after {
  border: none;
}

.complete-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.complete-btn:active::before {
  left: 100%;
}

.complete-btn:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(139, 92, 246, 0.3);
}

.privacy-checkbox {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding: 0 20rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  border-color: #7c3aed;
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.checkbox-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  flex: 1;
}

.link {
  color: #7c3aed;
  font-weight: 500;
}

.complete-btn[disabled] {
  background: #e5e7eb !important;
  color: #9ca3af !important;
  box-shadow: none !important;
}

/* ========== Dev 模式登录方式选择器 ========== */
.login-method-selector {
  width: 100%;
  margin-bottom: 40rpx;
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

.login-method-selector radio-group,
.radio-group {
  display: flex;
  gap: 24rpx;
}

.method-option {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid rgba(167, 139, 250, 0.3);
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.1);
  flex: 1;
}

.method-option.selected {
  border-color: #aa00ff;
  background: rgba(170, 0, 255, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(170, 0, 255, 0.18);
}

.method-label {
  font-size: 28rpx;
  color: #4c1d95;
  font-weight: 600;
  margin-left: 12rpx;
}

/* ========== Dev 模式登录表单样式 ========== */
.dev-divider {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 40rpx 0 20rpx;
}

.dev-divider-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.5), transparent);
}

.dev-divider-text {
  padding: 0 24rpx;
  color: #a78bfa;
  font-size: 28rpx;
}

.dev-login-form {
  width: 100%;
  max-width: 600rpx;
  padding: 40rpx 32rpx;
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

.dev-privacy {
  margin: 24rpx 0;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-input {
  width: 100%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 0 36rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(167, 139, 250, 0.3);
  color: #4c1d95;
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.1);
}

.form-input::placeholder {
  color: #a78bfa;
}

.dev-login-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: #e0d4f7;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 24rpx;
  margin-top: 40rpx;
  letter-spacing: 4rpx;
  transition: all 0.3s ease;
}

.dev-login-btn::after {
  border: none;
}

.dev-login-btn.active {
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  box-shadow: 0 12rpx 32rpx rgba(170, 0, 255, 0.38);
}

.dev-login-btn.active:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(139, 92, 246, 0.3);
}

.dev-hint {
  margin-top: 60rpx;
}

.hint-divider {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.hint-divider::before,
.hint-divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.5), transparent);
}

.hint-divider text {
  padding: 0 32rpx;
  color: #a78bfa;
  font-size: 28rpx;
}

.guest-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: transparent;
  border: 2rpx solid #a855f7;
  color: #a855f7;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.guest-btn:active {
  background: rgba(168, 85, 247, 0.1);
  transform: scale(0.98);
}

.guest-desc {
  text-align: center;
  font-size: 26rpx;
  color: #a78bfa;
  margin-top: 24rpx;
  opacity: 0.8;
}

/* 注册与密码重置链接 & 底部抽屉弹窗 */
.login-sub-links {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 24rpx;
  font-size: 25rpx;
  color: #7c3aed;
  font-weight: 700;
}

.login-sub-links-dev {
  margin-top: 0;
  margin-bottom: 24rpx;
}

.login-sub-link {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
}

.login-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.56);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.login-sheet-card {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow: 0 -16rpx 48rpx rgba(15, 23, 42, 0.16);
}

.login-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
}

.login-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.login-sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  font-size: 28rpx;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-sheet-field {
  margin-bottom: 18rpx;
}

.login-sheet-field-last {
  margin-bottom: 28rpx;
}

.login-sheet-input {
  width: 100%;
  height: 82rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.login-gender-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.login-gender-pill {
  flex: 1;
  height: 74rpx;
  line-height: 74rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: #f1f5f9;
  color: #475569;
  transition: all 0.18s ease;
}

.login-gender-pill.active {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}

.login-sheet-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0;
  box-shadow: 0 10rpx 26rpx rgba(124, 58, 237, 0.3);
}
