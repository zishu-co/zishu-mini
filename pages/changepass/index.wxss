.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding-top: 24rpx;
  padding-bottom: 48rpx;
}

.security-banner {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 24rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.22);
}

.security-icon {
  font-size: 52rpx;
}

.security-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.security-title {
  font-size: 32rpx;
  font-weight: 800;
}

.security-sub {
  font-size: 22rpx;
  opacity: 0.88;
}

.form-card {
  margin: 0 24rpx 24rpx;
  padding: 36rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #334155;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  background: #f8fafc;
}

.form-input.with-toggle {
  padding-right: 110rpx;
}

.form-input:focus {
  border-color: #7c3aed;
  background: #fff;
}

.eye-toggle {
  position: absolute;
  right: 24rpx;
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 600;
  padding: 8rpx;
}

.strength-meter {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.strength-bar {
  flex: 1;
  height: 10rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  overflow: hidden;
}

.strength-fill {
  height: 100%;
  border-radius: 999rpx;
}

.strength-fill.weak {
  background: #ef4444;
}

.strength-fill.medium {
  background: #f59e0b;
}

.strength-fill.strong {
  background: #10b981;
}

.strength-label {
  font-size: 22rpx;
  font-weight: 600;
}

.strength-label.weak {
  color: #ef4444;
}

.strength-label.medium {
  color: #d97706;
}

.strength-label.strong {
  color: #059669;
}

.error-tip {
  padding: 16rpx 0;
  color: #ef4444;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.25);
}

.submit-btn::after {
  border: none;
}

.tips-card {
  margin: 0 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.tips-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #7c3aed;
  margin-bottom: 4rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}