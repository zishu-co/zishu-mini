.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-top: 0;
  padding-bottom: 48rpx;
}

.security-banner {
  position: relative;
  overflow: hidden;
  margin: 0 0 28rpx;
  padding: 36rpx 32rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.security-icon {
  font-size: 52rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.security-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.security-title {
  font-size: 34rpx;
  font-weight: 800;
}

.security-sub {
  font-size: 23rpx;
  opacity: 0.88;
}

.form-card {
  margin: 0 24rpx 24rpx;
  padding: 32rpx 28rpx;
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.14) 0%, transparent 48%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 48%, #faf5ff 100%);
  border-radius: 36rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.24);
  box-shadow:
    0 14rpx 36rpx -10rpx rgba(109, 40, 217, 0.14),
    inset 0 3rpx 0 #ffffff;
}

.form-item {
  margin-bottom: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10), inset 0 3rpx 0 #ffffff;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease, border-color 0.2s ease;
}

.form-item:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.28);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12), inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.form-item:focus-within {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border: 2.5rpx solid #fb923c;
  box-shadow:
    0 14rpx 32rpx -8rpx rgba(251, 146, 60, 0.24),
    0 0 0 6rpx rgba(251, 146, 60, 0.12),
    inset 0 3rpx 0 #ffffff;
  transform: translateY(-2rpx);
}

.form-label {
  display: inline-flex;
  align-items: center;
  font-size: 25rpx;
  color: #581c87;
  margin-bottom: 12rpx;
  font-weight: 800;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 82rpx;
  padding: 0 26rpx;
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 24rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.form-input.with-toggle {
  padding-right: 130rpx;
}

.form-input:focus {
  border-color: #fb923c;
  background: #ffffff;
}

.eye-toggle {
  position: absolute;
  right: 24rpx;
  font-size: 24rpx;
  color: #6d28d9;
  font-weight: 600;
  padding: 8rpx;
  white-space: nowrap;
}

.strength-meter {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.strength-bar {
  flex: 1;
  height: 10rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  overflow: hidden;
}

.strength-fill {
  height: 100%;
  border-radius: 999rpx;
}

.strength-fill.weak {
  background: #ef4444;
}

.strength-fill.medium {
  background: #f59e0b;
}

.strength-fill.strong {
  background: #10b981;
}

.strength-label {
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.strength-label.weak {
  color: #ef4444;
}

.strength-label.medium {
  color: #d97706;
}

.strength-label.strong {
  color: #059669;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.form-label-row .form-label {
  margin-bottom: 0;
}

.gen-pass-chip {
  font-size: 22rpx;
  font-weight: 600;
  color: #6d28d9;
  background: #f5f3ff;
  border: 1rpx solid rgba(124, 58, 237, 0.22);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.match-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.match-hint.match {
  color: #059669;
}

.match-hint.mismatch {
  color: #ef4444;
}

.error-tip {
  padding: 16rpx 0;
  color: #ef4444;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #5b21b6 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.submit-btn::after {
  border: none;
}

.tips-card {
  margin: 0 24rpx;
  padding: 28rpx 30rpx;
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.14) 0%, transparent 48%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 48%, #faf5ff 100%);
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.24);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    inset 0 3rpx 0 #ffffff;
}

.tips-title {
  font-size: 27rpx;
  font-weight: 800;
  color: #581c87;
  margin-bottom: 4rpx;
}

.tips-item {
  font-size: 25rpx;
  color: #334155;
  line-height: 1.55;
  padding: 16rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 1.5rpx solid rgba(244, 114, 182, 0.24);
  box-shadow: inset 0 2rpx 0 #ffffff;
}

.tips-item:nth-child(odd) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.28);
}