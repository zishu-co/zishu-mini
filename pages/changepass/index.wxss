.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-top: 0;
  padding-bottom: 48rpx;
}

.security-banner {
  position: relative;
  overflow: hidden;
  margin: 0 0 28rpx;
  padding: 36rpx 32rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.security-icon {
  font-size: 52rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.security-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.security-title {
  font-size: 34rpx;
  font-weight: 800;
}

.security-sub {
  font-size: 23rpx;
  opacity: 0.88;
}

.form-card {
  margin: 0 24rpx 24rpx;
  padding: 36rpx 30rpx;
  background: #fff;
  border-radius: 28rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #334155;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  font-size: 28rpx;
  background: #f8fafc;
}

.form-input.with-toggle {
  padding-right: 110rpx;
}

.form-input:focus {
  border-color: #7c3aed;
  background: #fff;
}

.eye-toggle {
  position: absolute;
  right: 24rpx;
  font-size: 24rpx;
  color: #6d28d9;
  font-weight: 600;
  padding: 8rpx;
}

.strength-meter {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.strength-bar {
  flex: 1;
  height: 10rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  overflow: hidden;
}

.strength-fill {
  height: 100%;
  border-radius: 999rpx;
}

.strength-fill.weak {
  background: #ef4444;
}

.strength-fill.medium {
  background: #f59e0b;
}

.strength-fill.strong {
  background: #10b981;
}

.strength-label {
  font-size: 22rpx;
  font-weight: 600;
}

.strength-label.weak {
  color: #ef4444;
}

.strength-label.medium {
  color: #d97706;
}

.strength-label.strong {
  color: #059669;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.form-label-row .form-label {
  margin-bottom: 0;
}

.gen-pass-chip {
  font-size: 22rpx;
  font-weight: 600;
  color: #6d28d9;
  background: #f5f3ff;
  border: 1rpx solid rgba(124, 58, 237, 0.22);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

.match-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.match-hint.match {
  color: #059669;
}

.match-hint.mismatch {
  color: #ef4444;
}

.error-tip {
  padding: 16rpx 0;
  color: #ef4444;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #5b21b6 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.submit-btn::after {
  border: none;
}

.tips-card {
  margin: 0 24rpx;
  padding: 28rpx 30rpx;
  background: #ffffff;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.tips-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #6d28d9;
  margin-bottom: 4rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}