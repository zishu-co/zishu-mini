<view class="page">
  <view class="header">
    <text class="title">修改密码</text>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="form-label">新密码</text>
      <input
        class="form-input"
        type="password"
        password
        placeholder="请输入新密码（至少6位）"
        value="{{password}}"
        bindinput="onPasswordInput"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <text class="form-label">确认密码</text>
      <input
        class="form-input"
        type="password"
        password
        placeholder="请再次输入新密码"
        value="{{checkpass}}"
        bindinput="onCheckpassInput"
        maxlength="20"
      />
    </view>

    <view class="error-tip" wx:if="{{errorMsg}}">
      <text>{{errorMsg}}</text>
    </view>

    <button class="submit-btn" bindtap="submitForm">确认修改</button>
  </view>
</view>