<view class="page">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">用户名</text>
      <input
        class="form-input"
        type="text"
        placeholder="请输入用户名"
        value="{{name}}"
        bindinput="onNameInput"
        maxlength="40"
      />
    </view>

    <view class="form-item">
      <text class="form-label">当前密码</text>
      <input
        class="form-input"
        type="text"
        password
        placeholder="请输入当前密码"
        value="{{oldPass}}"
        bindinput="onOldPassInput"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <text class="form-label">新密码</text>
      <input
        class="form-input"
        type="text"
        password
        placeholder="请输入新密码（至少6位）"
        value="{{newPass}}"
        bindinput="onPasswordInput"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <text class="form-label">确认密码</text>
      <input
        class="form-input"
        type="text"
        password
        placeholder="请再次输入新密码"
        value="{{confirmPass}}"
        bindinput="onCheckpassInput"
        maxlength="20"
      />
    </view>

    <view class="error-tip" wx:if="{{errorMsg}}">
      <text>{{errorMsg}}</text>
    </view>

    <button class="submit-btn" disabled="{{submitting}}" bindtap="submitForm">
      {{submitting ? '提交中...' : '确认修改'}}
    </button>
  </view>
</view>