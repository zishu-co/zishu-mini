<view class="page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{pageLoading}}">
    <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
  </view>

  <!-- 顶部区域：搜索 + 轮播图 -->
  <view class="home-page-header" wx:if="{{!pageLoading}}">
    <!-- 顶部品牌标题栏 -->
    <view class="inno-hero-bar">
      <view class="inno-hero-left">
        <text class="inno-hero-title">创新工坊</text>
        <text class="inno-hero-sub">真实场景项目共创 · 赢取塾值赏金</text>
      </view>
      <view class="inno-hero-right">
        <view class="publish-btn" bindtap="onOpenPublishModal">＋ 发布课题</view>
        <view class="mode-switch">
          <view
            class="mode-pill {{viewMode === 'projects' ? 'active' : ''}}"
            data-mode="projects"
            bindtap="onSwitchMode"
          >项目 ({{filteredProjects.length}})</view>
          <view
            class="mode-pill {{viewMode === 'groups' ? 'active' : ''}}"
            data-mode="groups"
            bindtap="onSwitchMode"
          >小组 ({{filteredGroups.length}})</view>
        </view>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-wrap">
      <t-search
        t-class-input="t-search__input"
        t-class-input-container="t-search__input-container"
        placeholder="{{viewMode === 'projects' ? '搜索项目名称、编号或执行人' : '搜索共创小组、方向或导师'}}"
        value="{{searchKeyword}}"
        bind:change="onSearchChange"
        bind:submit="onSearchSubmit"
        bind:clear="onSearchClear"
      >
        <t-icon slot="left-icon" name="search" size="40rpx" color="#bbb" />
      </t-search>
    </view>

    <!-- 轮播图 -->
    <view class="swiper-wrap" wx:if="{{viewMode === 'projects'}}">
      <t-swiper
        wx:if="{{imgSrcs.length > 0}}"
        current="{{current}}"
        autoplay="{{autoplay}}"
        duration="{{duration}}"
        interval="{{interval}}"
        navigation="{{navigation}}"
        imageProps="{{swiperImageProps}}"
        list="{{imgSrcs}}"
        bind:click="navToActivityDetail"
      />
    </view>
  </view>

  <!-- 项目视图 -->
  <block wx:if="{{!pageLoading && viewMode === 'projects'}}">
    <!-- 领域标签栏 -->
    <view class="tab-bar">
      <t-tabs
        t-class="t-tabs"
        t-class-active="tabs-external__active"
        t-class-item="tabs-external__item"
        defaultValue="{{0}}"
        space-evenly="{{false}}"
        bind:change="tabChangeHandle"
      >
        <t-tab-panel
          wx:for="{{tabList}}"
          wx:for-index="index"
          wx:key="index"
          label="{{item.text}}"
          value="{{index}}"
        />
      </t-tabs>
    </view>

    <!-- 状态筛选胶囊 -->
    <view class="status-filter-bar">
      <view
        class="status-pill {{statusFilter === 'all' ? 'active' : ''}}"
        data-status="all"
        bindtap="onStatusFilterTap"
      >全部</view>
      <view
        class="status-pill {{statusFilter === 'pending' ? 'active' : ''}}"
        data-status="pending"
        bindtap="onStatusFilterTap"
      >🔥 招募中</view>
      <view
        class="status-pill {{statusFilter === 'in-progress' ? 'active' : ''}}"
        data-status="in-progress"
        bindtap="onStatusFilterTap"
      >⚡ 进行中</view>
      <view
        class="status-pill {{statusFilter === 'completed' ? 'active' : ''}}"
        data-status="completed"
        bindtap="onStatusFilterTap"
      >✅ 已结项</view>
    </view>

    <!-- 项目列表 -->
    <view class="project-list">
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{filteredProjects.length === 0 && !listLoading}}">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无符合筛选条件的项目</text>
        <view class="reset-filter-btn" bindtap="onResetFilters">重置筛选条件</view>
      </view>

      <!-- 项目卡片 -->
      <view
        class="project-card"
        wx:for="{{filteredProjects}}"
        wx:key="id"
        bindtap="goToProjectDetail"
        data-id="{{item.id}}"
      >
        <!-- 卡片头部 -->
        <view class="card-header">
          <view class="card-header-left">
            <view class="card-serial">{{item.task_serial || '—'}}</view>
            <view class="bounty-pill" wx:if="{{item.bonus > 0}}">💰 {{item.bonus}} 塾值</view>
          </view>
          <view class="card-status status-{{item.statusClass}}">
            {{item.statusText}}
          </view>
        </view>

        <!-- 项目名称 -->
        <view class="card-title">{{item.title || '无标题'}}</view>

        <!-- 描述 -->
        <view class="card-desc" wx:if="{{item.desc}}">{{item.desc}}</view>

        <!-- 底部信息行 + 认领按钮 -->
        <view class="card-footer">
          <view class="card-footer-meta">
            <!-- 执行人 -->
            <view class="footer-item">
              <text class="footer-icon">👤</text>
              <text class="footer-text">{{item.taker || '待认领'}}</text>
            </view>
            <!-- 塾师 -->
            <view class="footer-item" wx:if="{{item.shushi}}">
              <text class="footer-icon">🎓</text>
              <text class="footer-text">{{item.shushi}}</text>
            </view>
            <!-- 截止日期 -->
            <view class="footer-item" wx:if="{{item.deadlineText}}">
              <text class="footer-icon">📅</text>
              <text class="footer-text deadline-{{item.deadlineColor}}">
                {{item.deadlineText}}
              </text>
            </view>
          </view>

          <!-- 认领按钮（未认领时显示） -->
          <view
            class="claim-btn"
            wx:if="{{item.statusClass === 'pending'}}"
            catchtap="claimProject"
            data-id="{{item.id}}"
            data-index="{{index}}"
          >
            {{claimingId === item.id ? '认领中' : '立即认领'}}
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view class="list-loading" wx:if="{{listLoading}}">
        <t-loading theme="circular" size="32rpx" text="加载中..." />
      </view>
    </view>
  </block>

  <!-- 共创小组视图 -->
  <block wx:if="{{!pageLoading && viewMode === 'groups'}}">
    <view class="project-list">
      <view class="empty-state" wx:if="{{filteredGroups.length === 0}}">
        <text class="empty-icon">🤝</text>
        <text class="empty-text">未找到匹配的共创小组</text>
        <view class="reset-filter-btn" bindtap="onResetFilters">清空搜索词</view>
      </view>

      <view
        class="group-card"
        wx:for="{{filteredGroups}}"
        wx:key="key"
        bindtap="onGroupCardTap"
        data-key="{{item.key}}"
      >
        <view class="group-card-top">
          <view class="group-badge">{{item.badge}}</view>
          <view class="group-bounty">累计赏金 💰 {{item.totalBonus}} 塾值</view>
        </view>
        <view class="group-name">{{item.name}}</view>
        <view class="group-desc">{{item.desc}}</view>
        <view class="group-footer">
          <view class="group-stats">
            <text class="group-stat-item">📋 {{item.projectCount}} 个课题</text>
            <text class="group-stat-item">🔥 {{item.openCount}} 个招募中</text>
            <text class="group-stat-item">🎓 领航：{{item.mentor}}</text>
          </view>
          <view class="group-action-btns">
            <view
              class="group-join-btn"
              catchtap="onOpenJoinGroupModal"
              data-group="{{item}}"
            >🤝 申请入组</view>
            <view class="group-enter-btn">课题 ›</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 发布新课题弹窗 -->
  <view class="inno-modal-mask" wx:if="{{showPublishModal}}" bindtap="onCloseInnoModals">
    <view class="inno-modal-card" catchtap="true">
      <view class="inno-modal-title">🚀 发布创新共创课题</view>
      <view class="inno-modal-sub">自动编号：{{publishForm.task_serial}}</view>

      <view class="inno-field-label">课题领域</view>
      <view class="inno-type-chips">
        <view
          class="inno-type-chip {{publishForm.task_type === 'F' ? 'active' : ''}}"
          data-type="F"
          bindtap="onSelectPublishType"
        >F 前端</view>
        <view
          class="inno-type-chip {{publishForm.task_type === 'B' ? 'active' : ''}}"
          data-type="B"
          bindtap="onSelectPublishType"
        >B 后端</view>
        <view
          class="inno-type-chip {{publishForm.task_type === 'D' ? 'active' : ''}}"
          data-type="D"
          bindtap="onSelectPublishType"
        >D 文档</view>
        <view
          class="inno-type-chip {{publishForm.task_type === 'T' ? 'active' : ''}}"
          data-type="T"
          bindtap="onSelectPublishType"
        >T 教程</view>
        <view
          class="inno-type-chip {{publishForm.task_type === 'C' ? 'active' : ''}}"
          data-type="C"
          bindtap="onSelectPublishType"
        >C 课程</view>
      </view>

      <view class="inno-field-label">课题名称</view>
      <input
        class="inno-input"
        value="{{publishForm.title}}"
        placeholder="输入清晰可交付的课题标题..."
        data-field="title"
        bindinput="onPublishFormInput"
      />

      <view class="inno-row-2">
        <view class="inno-col">
          <view class="inno-field-label">悬赏塾值</view>
          <input
            class="inno-input"
            type="digit"
            value="{{publishForm.bonus}}"
            data-field="bonus"
            bindinput="onPublishFormInput"
          />
        </view>
        <view class="inno-col">
          <view class="inno-field-label">计划工时(h)</view>
          <input
            class="inno-input"
            type="digit"
            value="{{publishForm.planed_hour}}"
            data-field="planed_hour"
            bindinput="onPublishFormInput"
          />
        </view>
      </view>

      <view class="inno-field-label">截止日期（YYYY-MM-DD）</view>
      <input
        class="inno-input"
        value="{{publishForm.deadline}}"
        placeholder="2026-11-15"
        data-field="deadline"
        bindinput="onPublishFormInput"
      />

      <view class="inno-field-label">课题描述与验收标准</view>
      <textarea
        class="inno-textarea"
        value="{{publishForm.desc}}"
        placeholder="描述课题背景、交付物要求与参考资料..."
        maxlength="1000"
        data-field="desc"
        bindinput="onPublishFormInput"
      />

      <view class="inno-modal-actions">
        <view class="inno-modal-btn cancel" bindtap="onCloseInnoModals">取消</view>
        <view class="inno-modal-btn confirm" bindtap="onSubmitPublishProject">
          {{submittingPublish ? '发布中...' : '确认发布'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 申请加入创新小组弹窗 -->
  <view class="inno-modal-mask" wx:if="{{showJoinGroupModal}}" bindtap="onCloseInnoModals">
    <view class="inno-modal-card" catchtap="true">
      <view class="inno-modal-title">🤝 申请加入共创小组</view>
      <view class="inno-modal-sub">{{joinGroupForm.groupname}}</view>

      <view class="inno-field-label">申请理由与擅长方向</view>
      <textarea
        class="inno-textarea"
        value="{{joinGroupForm.reason}}"
        placeholder="简单介绍你的已修课程、技术特长与希望参与的课题方向..."
        maxlength="500"
        bindinput="onJoinReasonInput"
      />

      <view class="inno-modal-actions">
        <view class="inno-modal-btn cancel" bindtap="onCloseInnoModals">取消</view>
        <view class="inno-modal-btn confirm" bindtap="onSubmitJoinGroup">
          {{submittingJoinGroup ? '提交中...' : '提交入组申请'}}
        </view>
      </view>
    </view>
  </view>

</view>
