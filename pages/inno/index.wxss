/* pages/inno/index.wxss */
/* 创新页面样式 */

page {
  background-color: #f5f5f5;
}


.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
}


.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}


.home-page-header {
  background: linear-gradient(#fff, #f5f5f5);
  padding: 0 24rpx 0;
}

.search-wrap {
  padding: 16rpx 0 0;
}

.search-wrap .t-search__input-container {
  border-radius: 32rpx !important;
  height: 64rpx !important;
}

.search-wrap .t-search__input {
  font-size: 28rpx !important;
  color: rgb(116, 116, 116) !important;
}

.swiper-wrap {
  margin-top: 12rpx;
}

.swiper-wrap .t-image__swiper {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
}


.tab-bar {
  padding: 0 16rpx;
  background-color: #f5f5f5;
}

.t-tabs.t-tabs--top .t-tabs__scroll {
  border-bottom: none !important;
}

.t-tabs {
  background: #f5f5f5 !important;
}

.t-tabs .t-tabs-nav {
  background-color: transparent;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #333;
}

.t-tabs .t-tabs-scroll {
  border: none !important;
}

.tabs-external__item {
  font-size: 28rpx;
  color: #666;
}

.tabs-external__active {
  font-size: 30rpx;
  font-weight: bold;
  color: #aa00ff !important;
}


.project-list {
  padding: 24rpx 24rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}


.project-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-serial {
  font-size: 26rpx;
  font-weight: bold;
  color: #aa00ff;
  background-color: #f3e8ff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.card-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  color: #fa4126;
  background-color: #fff1ed;
}

.status-in-progress {
  color: #00b42a;
  background-color: #e8ffef;
}

.status-completed {
  color: #999;
  background-color: #f5f5f5;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a2e;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
}

.footer-item {
  display: flex;
  align-items: center;
}

.footer-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1;
}

.footer-text.bonus {
  color: #fa4126;
  font-weight: bold;
}

.footer-text.deadline-red {
  color: #fa4126;
}

.footer-text.deadline- {
  color: #666;
}


.claim-btn {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  background: linear-gradient(135deg, #c6f, #aa00ff);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(170, 0, 255, 0.3);
}


.list-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
}
