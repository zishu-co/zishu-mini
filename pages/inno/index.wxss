/* pages/inno/index.wxss — 创新工坊旗舰视觉 */

page {
  background-color: #f6f5fb;
  color: #0f172a;
}

.page {
  min-height: 100vh;
  background-color: #f6f5fb;
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}

/* 顶部 Hero 区域 */
.home-page-header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  padding: 36rpx 28rpx 28rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 14rpx 36rpx rgba(91, 33, 182, 0.22);
  margin-bottom: 12rpx;
}

.home-page-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.inno-hero-bar {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.inno-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.inno-hero-left {
  display: flex;
  flex-direction: column;
}

.inno-hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.inno-hero-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.mode-switch {
  display: flex;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 999rpx;
  padding: 6rpx;
  gap: 6rpx;
  flex-shrink: 0;
}

.mode-pill {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.88);
  transition: all 0.2s ease;
  white-space: nowrap;
}

.mode-pill.active {
  background: #ffffff;
  color: #6d28d9;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.15);
}

.inno-hero-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.publish-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #6d28d9;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.14);
  transition: transform 0.15s ease;
}

.publish-btn:active {
  transform: scale(0.96);
}

.publish-btn-time {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: none;
}

.search-wrap {
  position: relative;
  z-index: 1;
  padding: 4rpx 0 0;
}

.search-wrap .t-search {
  --td-search-bg-color: rgba(255, 255, 255, 0.96);
}

.search-wrap .t-search__input-container {
  border-radius: 999rpx !important;
  height: 76rpx !important;
  background: rgba(255, 255, 255, 0.96) !important;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.1);
}

.search-wrap .t-search__input {
  font-size: 26rpx !important;
  color: #0f172a !important;
}

.swiper-wrap {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.16);
}

.swiper-wrap .t-image__swiper {
  width: 100%;
  height: 290rpx;
  border-radius: 24rpx;
}

/* 领域标签栏 */
.tab-bar {
  padding: 8rpx 16rpx 0;
  background-color: #f6f5fb;
}

.t-tabs.t-tabs--top .t-tabs__scroll {
  border-bottom: none !important;
}

.t-tabs {
  background: #f6f5fb !important;
}

.t-tabs .t-tabs-nav {
  background-color: transparent;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #475569;
}

.t-tabs .t-tabs-scroll {
  border: none !important;
}

.tabs-external__item {
  font-size: 27rpx;
  color: #64748b;
  font-weight: 500;
}

.tabs-external__active {
  font-size: 29rpx;
  font-weight: 800;
  color: #7c3aed !important;
}

/* 状态筛选胶囊栏 */
.status-filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 28rpx 6rpx;
  overflow-x: auto;
}

.status-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid #e2e8f0;
  white-space: nowrap;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.02);
  transition: all 0.18s ease;
}

.status-pill.active {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  border-color: transparent;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}

.project-list {
  padding: 24rpx 28rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx dashed #cbd5e1;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 28rpx;
}

.reset-filter-btn {
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  background: #f3e8ff;
  color: #7c3aed;
  font-size: 26rpx;
  font-weight: 700;
}

/* 项目卡片 */
.project-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  transition: transform 0.15s ease;
}

.project-card:active {
  transform: scale(0.99);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.card-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-serial {
  font-size: 23rpx;
  font-weight: 800;
  color: #7c3aed;
  background-color: #f3e8ff;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.bounty-pill {
  font-size: 23rpx;
  font-weight: 800;
  color: #ea580c;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border: 1rpx solid rgba(234, 88, 12, 0.18);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.card-status {
  font-size: 23rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.status-pending {
  color: #ea580c;
  background-color: #fff7ed;
}

.status-in-progress {
  color: #059669;
  background-color: #ecfdf5;
}

.status-completed {
  color: #64748b;
  background-color: #f1f5f9;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.45;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f5f9;
}

.card-footer-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.footer-item {
  display: flex;
  align-items: center;
}

.footer-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
  line-height: 1.2;
}

.footer-text.bonus {
  color: #ea580c;
  font-weight: 700;
}

.footer-text.deadline-red,
.footer-text.deadline-overdue {
  color: #ef4444;
  font-weight: 600;
}

.footer-text.deadline-warning {
  color: #f59e0b;
  font-weight: 600;
}

.footer-text.deadline-normal,
.footer-text.deadline- {
  color: #64748b;
}

.claim-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.25);
}

.list-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 36rpx 0;
}

/* 共创小组卡片 — 解决原4按钮与3统计同排挤压问题 */
.group-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(147, 51, 234, 0.1);
  border-left: 8rpx solid #7c3aed;
  transition: transform 0.15s ease;
}

.group-card:active {
  transform: scale(0.99);
}

.group-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.group-badge {
  font-size: 23rpx;
  font-weight: 800;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.group-bounty {
  font-size: 24rpx;
  font-weight: 800;
  color: #ea580c;
  background: #fff7ed;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.group-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 10rpx;
}

.group-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 22rpx;
}

.group-footer {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f5f9;
}

.group-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.group-stat-item {
  font-size: 24rpx;
  font-weight: 500;
  color: #475569;
  background: #f8fafc;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.group-action-btns {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 14rpx;
}

.group-join-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f3e8ff;
  color: #6d28d9;
  font-size: 23rpx;
  font-weight: 700;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
}

.group-enter-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.22);
}

/* 弹窗样式 */
.inno-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.56);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 32rpx;
}

.inno-modal-card {
  width: 100%;
  max-width: 650rpx;
  max-height: 84vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 38rpx 34rpx;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.22);
  border: 1rpx solid rgba(147, 51, 234, 0.12);
}

.inno-modal-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.inno-modal-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.inno-modal-sub {
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.inno-field-label {
  font-size: 25rpx;
  font-weight: 700;
  color: #334155;
  margin: 16rpx 0 10rpx;
}

.inno-field-label-spaced {
  margin-top: 24rpx;
}

.inno-type-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.inno-type-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
}

.inno-type-chip.active {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.22);
}

.inno-row-2 {
  display: flex;
  gap: 16rpx;
}

.inno-col {
  flex: 1;
}

.inno-input {
  width: 100%;
  height: 78rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #0f172a;
}

.inno-textarea {
  width: 100%;
  min-height: 156rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #0f172a;
  line-height: 1.5;
}

.inno-review-divider {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #e2e8f0;
}

.inno-feedback-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.inno-feedback-input {
  flex: 1;
  margin-bottom: 0;
}

.inno-mission-box {
  font-size: 25rpx;
  color: #334155;
  line-height: 1.6;
  background: #f8fafc;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
}

.inno-empty-inline {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 16rpx 0;
}

.inno-list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #e2e8f0;
  font-size: 24rpx;
}

.inno-list-row-main {
  font-weight: 700;
  color: #0f172a;
}

.inno-list-row-sub {
  color: #64748b;
}

.inno-list-row-teal {
  color: #0f766e;
  font-weight: 700;
}

.inno-record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 23rpx;
  color: #475569;
}

.inno-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 28rpx;
}

.inno-modal-btn {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.inno-modal-btn.cancel {
  background: #f1f5f9;
  color: #475569;
}

.inno-modal-btn.confirm {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}
