/* pages/inno/index.wxss */
/* 创新页面样式 */

page {
  background-color: #f5f5f5;
}


.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
}


.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}


.home-page-header {
  background: linear-gradient(180deg, #ffffff 0%, #f5f5f5 100%);
  padding: 20rpx 24rpx 0;
}

.inno-hero-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.inno-hero-left {
  display: flex;
  flex-direction: column;
}

.inno-hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.inno-hero-sub {
  font-size: 24rpx;
  color: #7c3aed;
  margin-top: 4rpx;
}

.mode-switch {
  display: flex;
  background: #f3e8ff;
  border-radius: 32rpx;
  padding: 6rpx;
  gap: 6rpx;
}

.mode-pill {
  padding: 10rpx 24rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #7c3aed;
  transition: all 0.2s;
}

.mode-pill.active {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.25);
}

.search-wrap {
  padding: 8rpx 0 0;
}

.search-wrap .t-search__input-container {
  border-radius: 32rpx !important;
  height: 64rpx !important;
}

.search-wrap .t-search__input {
  font-size: 28rpx !important;
  color: rgb(116, 116, 116) !important;
}

.swiper-wrap {
  margin-top: 12rpx;
}

.swiper-wrap .t-image__swiper {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
}


.tab-bar {
  padding: 0 16rpx;
  background-color: #f5f5f5;
}

.t-tabs.t-tabs--top .t-tabs__scroll {
  border-bottom: none !important;
}

.t-tabs {
  background: #f5f5f5 !important;
}

.t-tabs .t-tabs-nav {
  background-color: transparent;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #333;
}

.t-tabs .t-tabs-scroll {
  border: none !important;
}

.tabs-external__item {
  font-size: 28rpx;
  color: #666;
}

.tabs-external__active {
  font-size: 30rpx;
  font-weight: bold;
  color: #aa00ff !important;
}

/* 状态筛选胶囊栏 */
.status-filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 24rpx 4rpx;
  overflow-x: auto;
}

.status-pill {
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: #ffffff;
  color: #666;
  font-size: 24rpx;
  font-weight: 500;
  border: 2rpx solid #eee;
  white-space: nowrap;
}

.status-pill.active {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.22);
}

.project-list {
  padding: 24rpx 24rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 28rpx;
}

.reset-filter-btn {
  padding: 14rpx 36rpx;
  border-radius: 32rpx;
  background: #f3e8ff;
  color: #7c3aed;
  font-size: 26rpx;
  font-weight: 600;
}


.project-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-serial {
  font-size: 24rpx;
  font-weight: bold;
  color: #7c3aed;
  background-color: #f3e8ff;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.bounty-pill {
  font-size: 24rpx;
  font-weight: 700;
  color: #fa4126;
  background: #fff1ed;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.card-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  color: #fa4126;
  background-color: #fff1ed;
}

.status-in-progress {
  color: #00b42a;
  background-color: #e8ffef;
}

.status-completed {
  color: #999;
  background-color: #f5f5f5;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a2e;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.card-footer-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.footer-item {
  display: flex;
  align-items: center;
}

.footer-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1;
}

.footer-text.bonus {
  color: #fa4126;
  font-weight: bold;
}

.footer-text.deadline-red,
.footer-text.deadline-overdue {
  color: #fa4126;
  font-weight: 500;
}

.footer-text.deadline-warning {
  color: #f59e0b;
  font-weight: 500;
}

.footer-text.deadline-normal,
.footer-text.deadline- {
  color: #666;
}


.claim-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(170, 0, 255, 0.25);
}


.list-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
}

/* 共创小组卡片 */
.group-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
  border-left: 8rpx solid #7c3aed;
}

.group-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.group-badge {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.group-bounty {
  font-size: 24rpx;
  font-weight: 700;
  color: #fa4126;
}

.group-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 10rpx;
}

.group-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.group-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.group-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.group-stat-item {
  font-size: 24rpx;
  color: #6b7280;
}

.group-enter-btn {
  font-size: 26rpx;
  font-weight: 600;
  color: #7c3aed;
  flex-shrink: 0;
}
