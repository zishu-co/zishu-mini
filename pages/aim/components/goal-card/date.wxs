var formatDate = function(dateStr) {
  if (!dateStr) {
    return '未设置';
  }
  // 提取前10个字符 (YYYY-MM-DD)
  if (dateStr.length >= 10) {
    return dateStr.substring(0, 10);
  }
  return dateStr;
};

var getProgressPercent = function(process) {
  if (process === undefined || process === null || isNaN(process)) {
    return 0;
  }
  var num = Number(process);
  if (num < 0) return 0;
  if (num <= 10) {
    return Math.min(Math.round(num * 10), 100);
  }
  return Math.min(Math.round(num), 100);
};

module.exports = {
  formatDate: formatDate,
  formatProgress: getProgressPercent,
  getProgressPercent: getProgressPercent
};
