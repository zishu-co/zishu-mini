<wxs src="./date.wxs" module="dateUtil" />

<view class="goal-card">
  <!-- 卡片头部 -->
  <view class="card-header">
    <view class="card-title">
      <t-icon name="flag" size="40rpx" color="#7c3aed" />
      <text class="card-title-text">当前阶段目标</text>
    </view>
    <view class="card-actions">
      <view wx:if="{{goal}}" class="header-chip" bindtap="onCopyGoal">📋 复制</view>
      <view class="header-chip edit" bindtap="onEdit">✏️ 编辑</view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <t-loading indicator theme="circular" size="40rpx" />
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!goal}}" class="empty-container">
    <t-icon name="flag" size="80rpx" class="empty-icon" />
    <text class="empty-text">暂无目标</text>
    <text class="empty-subtext">点击下方按钮设定本阶段冲刺目标</text>
    <view class="zs-goal-btn primary" bindtap="onCreate">✨ 立即创建目标</view>
  </view>

  <!-- 目标内容 -->
  <view wx:else class="goal-content">
    <!-- 目标文本 -->
    <view class="goal-text">{{goal.content}}</view>

    <!-- 时间阶段 -->
    <view class="goal-phase">
      <t-icon name="calendar" size="28rpx" color="#a0f" />
      <text class="phase-text">
        {{dateUtil.formatDate(goal.start_time)}} 至 {{dateUtil.formatDate(goal.deadline)}}
      </text>
    </view>

    <!-- 进度条与10阶里程碑格 -->
    <view class="progress-section">
      <view class="progress-header">
        <text class="progress-label">目标达成度（10阶里程碑）</text>
        <text class="progress-value">{{dateUtil.getProgressPercent(goal.process)}}%</text>
      </view>
      <t-progress 
        percentage="{{dateUtil.getProgressPercent(goal.process)}}" 
        color="#a0f"
        track-color="#E5E5E5"
        stroke-width="12rpx"
        label="{{false}}"
      />
      <view class="milestone-segments">
        <view
          wx:for="{{steps}}"
          wx:key="*this"
          class="milestone-seg {{item * 10 <= dateUtil.getProgressPercent(goal.process) ? 'active' : ''}}"
        ></view>
      </view>
    </view>

    <!-- 进度更新按钮 -->
    <view class="progress-actions">
      <view class="goal-action-pill ghost" bindtap="onEdit">✏️ 调整目标</view>
      <view class="zs-goal-btn primary" bindtap="onUpdateProgress">⚡ 推进 +10%</view>
    </view>

    <!-- 复盘/回顾 -->
    <view wx:if="{{goal.review}}" class="review-section">
      <view class="review-header">
        <t-icon name="edit" size="28rpx" color="#a0f" />
        <text class="review-title">回顾与复盘</text>
      </view>
      <view class="review-content">{{goal.review}}</view>
    </view>
  </view>
</view>
