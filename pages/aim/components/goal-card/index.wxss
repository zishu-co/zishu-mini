.goal-card {
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.14) 0%, transparent 48%),
    linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.12),
    0 4rpx 12rpx rgba(147, 51, 234, 0.06),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.card-title-text {
  color: #0f172a;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 23rpx;
  font-weight: 700;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  color: #6d28d9;
  border: 1.5rpx solid rgba(124, 58, 237, 0.22);
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.08), inset 0 1rpx 0 #ffffff;
  white-space: nowrap;
  flex-shrink: 0;
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.header-chip:active {
  transform: scale(0.95);
}

.header-chip.edit {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #6d28d9 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  box-shadow:
    0 6rpx 18rpx rgba(124, 58, 237, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.32);
}

.edit-icon {
  color: #7c3aed;
  padding: 8rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
  gap: 16rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #64748b;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
  gap: 12rpx;
}

.empty-icon {
  color: #7c3aed;
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.empty-subtext {
  font-size: 25rpx;
  color: #64748b;
  margin-bottom: 16rpx;
}

/* 目标内容 */
.goal-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.goal-text {
  font-size: 31rpx;
  font-weight: 700;
  color: #1e1b4b;
  line-height: 1.6;
  white-space: pre-wrap;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.28);
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  box-shadow:
    0 10rpx 24rpx -8rpx rgba(236, 72, 153, 0.10),
    inset 0 3rpx 0 #ffffff;
}

/* 时间阶段 */
.goal-phase {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 10rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  border: 1.5rpx solid rgba(192, 132, 252, 0.28);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: inset 0 2rpx 0 #ffffff;
}

.phase-text {
  color: #581c87;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

/* 进度条 */
.progress-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  padding: 26rpx;
  border-radius: 28rpx;
  border: 2rpx solid rgba(129, 140, 248, 0.28);
  box-shadow:
    0 10rpx 24rpx -8rpx rgba(99, 102, 241, 0.10),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
}

.progress-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #7c3aed;
}

/* 10阶里程碑分段格 */
.milestone-segments {
  display: flex;
  gap: 8rpx;
  margin-top: 6rpx;
}

.milestone-seg {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  transition: background 0.25s ease;
}

.milestone-seg.active {
  background: linear-gradient(90deg, #a855f7 0%, #7c3aed 100%);
}

/* 进度更新按钮 */
.progress-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
}

.goal-action-pill.ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  color: #6d28d9;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  border: 1.5rpx solid rgba(124, 58, 237, 0.24);
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.08), inset 0 2rpx 0 #ffffff;
  transition: transform 0.16s ease;
}

.goal-action-pill.ghost:active {
  transform: scale(0.96);
}

.zs-goal-btn.primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 52%, #6d28d9 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.3),
    0 2rpx 6rpx rgba(91, 33, 182, 0.18),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
  letter-spacing: 0.5rpx;
  transition: transform 0.16s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.16s ease;
}

.zs-goal-btn.primary:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.22);
}

/* 复盘/回顾 */
.review-section {
  background: linear-gradient(145deg, #fffbeb 0%, #fef9c3 48%, #ffe4e6 100%);
  border: 2rpx solid rgba(251, 146, 60, 0.30);
  padding: 26rpx;
  border-radius: 28rpx;
  margin-top: 4rpx;
  box-shadow:
    0 10rpx 24rpx -8rpx rgba(251, 146, 60, 0.14),
    inset 0 3rpx 0 #ffffff;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  color: #475569;
}

.review-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
}

.review-content {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.65;
  white-space: pre-wrap;
}
