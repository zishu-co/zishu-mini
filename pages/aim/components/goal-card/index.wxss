.goal-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-chip {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #7c3aed;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
}

.header-chip.edit {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  border: none;
}

.edit-icon {
  color: #a0f;
  padding: 8rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 16rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #909399;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 12rpx;
}

.empty-icon {
  color: #a0f;
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
}

.empty-subtext {
  font-size: 26rpx;
  color: #909399;
  margin-bottom: 16rpx;
}

/* 目标内容 */
.goal-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.goal-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
  background: #f8f9fa;
  padding: 24rpx;
  border-radius: 12rpx;
}

/* 时间阶段 */
.goal-phase {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  color: #666;
}



.phase-text {
  color: #666;
  font-size: 32rpx;
  line-height: 1;
}

/* 进度条 */
.progress-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-label {
  font-size: 28rpx;
  color: #333;
}

.progress-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #a0f;
}

/* 10阶里程碑分段格 */
.milestone-segments {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.milestone-seg {
  flex: 1;
  height: 10rpx;
  border-radius: 6rpx;
  background: #ede9fe;
}

.milestone-seg.active {
  background: linear-gradient(90deg, #a855f7 0%, #7c3aed 100%);
}

/* 进度更新按钮 */
.progress-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
  padding-bottom: constant(safe-area-inset-bottom);
}

.goal-action-pill.ghost {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid rgba(124, 58, 237, 0.22);
}

/* 复盘/回顾 */
.review-section {
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  color: #666;
}

.review-title {
  font-size: 28rpx;
  font-weight: 500;
}

.review-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  white-space: pre-wrap;
}
