<wxs module="recFmt">
function getTypeIcon(type) {
  if (type === 'COURSE_URGENT') return 'book-open';
  if (type === 'COURSE_POPULAR') return 'book';
  if (type === 'TASK_CLAIM') return 'task';
  if (type === 'GOAL_TALK') return 'chat';
  if (type === 'REPORT_TIME') return 'document';
  if (type === 'PROFILE_COMPLETE') return 'user';
  if (type === 'EXAM_PUBLISH') return 'edit';
  if (type === 'COURSE_PUBLISH') return 'video';
  return 'list';
}

function getTypeIconClass(type) {
  if (type === 'COURSE_URGENT' || type === 'COURSE_POPULAR') return 'course-icon';
  if (type === 'TASK_CLAIM') return 'task-icon';
  if (type === 'GOAL_TALK') return 'goal-icon';
  if (type === 'REPORT_TIME') return 'report-icon';
  if (type === 'PROFILE_COMPLETE') return 'profile-icon';
  return 'default-icon';
}

function getUrgencyText(level) {
  if (level === 'critical') return '紧急';
  if (level === 'high') return '高';
  if (level === 'medium') return '中';
  return '低';
}

function formatDeadline(deadline) {
  if (!deadline) return '';
  var date = getDate(deadline);
  var ts = date.getTime();
  if (isNaN(ts)) {
    var norm = ('' + deadline).replace(getRegExp('-', 'g'), '/');
    ts = getDate(norm).getTime();
  }
  if (isNaN(ts)) return deadline;
  var now = getDate().getTime();
  var diffMs = ts - now;
  var diffDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
  if (diffDays === 0) return '今天截止';
  if (diffDays === 1) return '明天截止';
  if (diffDays > 0) return diffDays + '天后截止';
  return '已逾期';
}

module.exports = {
  getTypeIcon: getTypeIcon,
  getTypeIconClass: getTypeIconClass,
  getUrgencyText: getUrgencyText,
  formatDeadline: formatDeadline
};
</wxs>

<view class="recommendation-card">
  <!-- 卡片头部 -->
  <view class="card-header">
    <view class="card-title">
      <t-icon name="aim" size="40rpx" color="#7c3aed" />
      <text class="card-title-text">今日最值得做 (Top 3)</text>
    </view>
    <view class="header-actions">
      <view class="header-pill" bindtap="showAlgorithmInfo">💡 算法</view>
      <view class="header-pill refresh" bindtap="onRefresh">{{refreshing ? '刷新中...' : '🔄 换一批'}}</view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <t-loading indicator theme="circular" size="40rpx" />
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{recommendations.length === 0}}" class="empty-container">
    <t-icon name="check-circle" size="80rpx" class="empty-icon" />
    <text class="empty-text">暂无待办任务</text>
    <text class="empty-subtext">休息一下，明天继续加油</text>
  </view>

  <!-- 推荐列表 -->
  <view wx:else class="recommendation-list">
    <view 
      wx:for="{{recommendations}}"
      wx:key="id"
      class="recommendation-item"
      bindtap="onItemTap"
      data-item="{{item}}"
    >
      <!-- 推荐序号 -->
      <view class="item-index">
        <text class="index-number">{{index + 1}}</text>
        <t-icon 
          name="{{recFmt.getTypeIcon(item.type)}}" 
          size="32rpx" 
          class="type-icon {{recFmt.getTypeIconClass(item.type)}}"
          color="#7c3aed"
        />
      </view>

      <!-- 推荐内容 -->
      <view class="item-content">
        <view class="item-header">
          <text class="item-title">{{item.title}}</text>
          <view class="urgency-tag urgency-{{item.urgency_level}}">
            {{recFmt.getUrgencyText(item.urgency_level)}}
          </view>
        </view>

        <text class="item-description">{{item.description}}</text>

        <view class="item-meta">
          <view class="meta-item">
            <t-icon name="time" size="24rpx" />
            <text>{{item.estimated_time}}</text>
          </view>
          <view wx:if="{{item.deadline}}" class="meta-item">
            <t-icon name="calendar" size="24rpx" />
            <text>{{recFmt.formatDeadline(item.deadline)}}</text>
          </view>
          <view class="meta-item score">
            <t-icon name="chart" size="24rpx" />
            <text>{{item.score}}分</text>
          </view>
        </view>

        <!-- 推荐理由标签 -->
        <view wx:if="{{item.reasons.length > 0}}" class="item-reasons">
          <text 
            wx:for="{{item.reasons}}"
            wx:for-item="reason"
            wx:for-index="reasonIndex"
            wx:key="reasonIndex"
            class="reason-tag"
            wx:if="{{reasonIndex < 2}}"
          >{{reason}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="item-actions">
        <t-button 
          size="small" 
          theme="primary" 
          variant="base"
          color="#fff"
          catchtap="onActionTap"
          data-item="{{item}}"
        >{{item.action_text}}</t-button>
        <view class="micro-action-row">
          <view
            class="micro-btn finish"
            catchtap="onFinishTap"
            data-item="{{item}}"
            data-index="{{index}}"
          >✓ 完成</view>
          <view
            class="micro-btn skip"
            catchtap="onSkipTap"
            data-item="{{item}}"
            data-index="{{index}}"
          >✕ 跳过</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 更新时间 -->
  <view wx:if="{{lastUpdated && !loading}}" class="update-info">
    <text>更新于 {{lastUpdated}}</text>
  </view>
</view>
