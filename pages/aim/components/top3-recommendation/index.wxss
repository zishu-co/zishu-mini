.recommendation-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(147, 51, 234, 0.08);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.card-title-text {
  color: #0f172a;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  color: #6d28d9;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  border: 1.5rpx solid rgba(124, 58, 237, 0.22);
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.08), inset 0 1rpx 0 #ffffff;
  transition: transform 0.16s ease;
}

.header-pill:active {
  transform: scale(0.95);
}

.header-pill.refresh {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #6d28d9 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 6rpx 18rpx rgba(124, 58, 237, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.32);
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
  gap: 16rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #64748b;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
}

.empty-icon {
  color: #10b981;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.empty-subtext {
  font-size: 25rpx;
  color: #64748b;
}

/* 推荐列表 */
.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.recommendation-item {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 18rpx;
  padding: 26rpx;
  background: linear-gradient(180deg, #faf9fe 0%, #f5f3ff 100%);
  border: 1rpx solid rgba(147, 51, 234, 0.12);
  border-radius: 24rpx;
  position: relative;
  transition: transform 0.15s ease;
}

.recommendation-item:active {
  transform: scale(0.99);
}

/* 推荐序号 */
.item-index {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 52rpx;
  flex-shrink: 0;
}

.index-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 10rpx rgba(124, 58, 237, 0.28);
}

.type-icon {
  font-size: 28rpx;
}

.course-icon,
.task-icon,
.goal-icon,
.report-icon,
.profile-icon,
.default-icon {
  color: #7c3aed;
}

/* 推荐内容 */
.item-content {
  flex: 1;
  min-width: 420rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.4;
  flex: 1;
}

/* 紧急度标签 */
.urgency-tag {
  font-size: 21rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.urgency-critical {
  background: #fee2e2;
  color: #dc2626;
}

.urgency-high {
  background: #fef3c7;
  color: #d97706;
}

.urgency-medium {
  background: #dbeafe;
  color: #2563eb;
}

.urgency-low {
  background: #f1f5f9;
  color: #64748b;
}

.item-description {
  display: block;
  font-size: 25rpx;
  color: #475569;
  line-height: 1.55;
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 元信息 */
.item-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 23rpx;
  color: #64748b;
}

.meta-item.score {
  color: #7c3aed;
  font-weight: 700;
}

/* 推荐理由标签 */
.item-reasons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.reason-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  background: #ffffff;
  color: #6d28d9;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 操作按钮底栏 — 独立一行两端对齐，彻底告别窄列挤压 */
.item-actions {
  width: 100%;
  display: flex;
  flex-direction: row-reverse;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
  margin-top: 4rpx;
  border-top: 1rpx solid rgba(147, 51, 234, 0.1);
}

.rec-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 62rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 52%, #6d28d9 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 8rpx 20rpx rgba(124, 58, 237, 0.28),
    0 2rpx 6rpx rgba(91, 33, 182, 0.16),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
  transition: transform 0.16s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.16s ease;
}

.rec-cta-btn:active {
  transform: scale(0.95);
}

.rec-cta-btn__text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.rec-cta-btn__arrow {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  font-weight: 800;
}

.micro-action-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.micro-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  font-size: 22rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  transition: transform 0.15s ease;
}

.micro-btn:active {
  transform: scale(0.95);
}

.micro-btn.finish {
  background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
  color: #047857;
  border: 1.5rpx solid rgba(16, 185, 129, 0.28);
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.08), inset 0 1rpx 0 #ffffff;
}

.micro-btn.skip {
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  color: #64748b;
  border: 1.5rpx solid rgba(148, 163, 184, 0.24);
  box-shadow: inset 0 1rpx 0 #ffffff;
}

/* 更新时间 */
.update-info {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f5f9;
  font-size: 23rpx;
  color: #94a3b8;
  text-align: center;
}
