.recommendation-card {
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.14) 0%, transparent 48%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 48%, #faf5ff 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.24);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.card-title-text {
  color: #0f172a;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  color: #6d28d9;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  border: 1.5rpx solid rgba(124, 58, 237, 0.22);
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.08), inset 0 1rpx 0 #ffffff;
  transition: transform 0.16s ease;
}

.header-pill:active {
  transform: scale(0.95);
}

.header-pill.refresh {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #6d28d9 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 6rpx 18rpx rgba(124, 58, 237, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.32);
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
  gap: 16rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #64748b;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
}

.empty-icon {
  color: #10b981;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.empty-subtext {
  font-size: 25rpx;
  color: #64748b;
}

/* 推荐列表 */
.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.recommendation-item {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 18rpx;
  padding: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  border-radius: 32rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  position: relative;
  transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.18s ease;
}

.recommendation-item.zs-row-odd,
.recommendation-item:nth-child(odd) {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
}

.recommendation-item.zs-row-even,
.recommendation-item:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.13),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.recommendation-item:active {
  transform: scale(0.99);
}

/* 推荐序号 */
.item-index {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 52rpx;
  flex-shrink: 0;
}

.index-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 10rpx rgba(124, 58, 237, 0.28);
}

.type-icon {
  font-size: 28rpx;
}

.course-icon,
.task-icon,
.goal-icon,
.report-icon,
.profile-icon,
.default-icon {
  color: #7c3aed;
}

/* 推荐内容 */
.item-content {
  flex: 1;
  min-width: 420rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.4;
  flex: 1;
}

/* 紧急度标签 */
.urgency-tag {
  font-size: 21rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.urgency-critical {
  background: #fee2e2;
  color: #dc2626;
}

.urgency-high {
  background: #fef3c7;
  color: #d97706;
}

.urgency-medium {
  background: #dbeafe;
  color: #2563eb;
}

.urgency-low {
  background: #f1f5f9;
  color: #64748b;
}

.item-description {
  display: block;
  font-size: 25rpx;
  color: #475569;
  line-height: 1.55;
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 元信息 */
.item-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 23rpx;
  color: #64748b;
}

.meta-item.score {
  color: #7c3aed;
  font-weight: 700;
}

/* 推荐理由标签 */
.item-reasons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.reason-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  background: #ffffff;
  color: #6d28d9;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 操作按钮底栏 — 独立一行两端对齐，彻底告别窄列挤压 */
.item-actions {
  width: 100%;
  display: flex;
  flex-direction: row-reverse;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
  margin-top: 4rpx;
  border-top: 1rpx solid rgba(147, 51, 234, 0.1);
}

.rec-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 62rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 52%, #6d28d9 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 8rpx 20rpx rgba(124, 58, 237, 0.28),
    0 2rpx 6rpx rgba(91, 33, 182, 0.16),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
  transition: transform 0.16s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.16s ease;
}

.rec-cta-btn:active {
  transform: scale(0.95);
}

.rec-cta-btn__text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.rec-cta-btn__arrow {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  font-weight: 800;
}

.micro-action-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.micro-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 60rpx;
  font-size: 23rpx;
  padding: 0 24rpx 0 10rpx;
  border-radius: 999rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.18s ease;
}

.micro-btn:active {
  transform: scale(0.92) translateY(2rpx);
}

.micro-btn__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.micro-btn__text {
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

/* “完成”按钮：薄荷青提 3D 糖果果冻胶囊 */
.micro-btn.finish {
  background: linear-gradient(135deg, #34d399 0%, #10b981 52%, #059669 100%);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  box-shadow:
    0 10rpx 22rpx -4rpx rgba(16, 185, 129, 0.42),
    0 3rpx 8rpx rgba(5, 150, 105, 0.22),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.55);
}

.micro-btn.finish .finish-badge {
  background: rgba(255, 255, 255, 0.28);
  color: #ffffff;
  border: 1.5rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.45);
}

/* “跳过”按钮：蜜桃樱花苏打 3D 马卡龙果冻胶囊 */
.micro-btn.skip {
  background: linear-gradient(135deg, #fff0f6 0%, #ffd6e7 48%, #f3e8ff 100%);
  color: #be185d;
  border: 2rpx solid rgba(244, 114, 182, 0.52);
  box-shadow:
    0 10rpx 22rpx -4rpx rgba(236, 72, 153, 0.26),
    0 3rpx 8rpx rgba(192, 132, 252, 0.16),
    inset 0 3rpx 0 #ffffff;
}

.micro-btn.skip .skip-badge {
  background: linear-gradient(135deg, #f472b6 0%, #c084fc 100%);
  color: #ffffff;
  font-size: 19rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.75);
  box-shadow:
    0 4rpx 10rpx rgba(236, 72, 153, 0.32),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
}

/* 更新时间 */
.update-info {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f5f9;
  font-size: 23rpx;
  color: #94a3b8;
  text-align: center;
}
