.order-group {
  margin-bottom: 24rpx;
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.14) 0%, transparent 48%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 48%, #faf5ff 100%);
  border-radius: 32rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  overflow: hidden;
  padding: 12rpx 16rpx 20rpx;
}
.order-group .order-group__top {
  padding: 20rpx 18rpx 20rpx 20rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: transparent;
}
.order-group__top___title {
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 800;
  color: #3b0764;
}
.order-group__top__note {
  font-size: 26rpx;
  color: #7c3aed;
}
.order-group__content {
  overflow: hidden;
  width: 100%;
  min-height: 164rpx;
  display: flex;
  gap: 14rpx;
  background: transparent;
  border-radius: 24rpx;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}
.order-group__item {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 26rpx !important;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 8rpx 20rpx -6rpx rgba(236, 72, 153, 0.10),
    inset 0 2rpx 0 #ffffff;
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
}
.order-group__item:nth-child(even),
.order-group__item.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 8rpx 20rpx -6rpx rgba(99, 102, 241, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.94);
}
.order-group__item:active {
  transform: scale(0.95);
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border-color: #fb923c;
}
.order-group__item__title {
  font-size: 24rpx;
  font-weight: 700;
  color: #4c1d95;
  line-height: 32rpx;
}
.order-group__item__icon {
  margin-bottom: 14rpx;
  width: 56rpx;
  height: 56rpx;
  position: relative;
}
.order-group__top__title {
  font-weight: 800;
  color: #3b0764;
}
.order-group .order-group__left {
  margin-right: 0;
}
