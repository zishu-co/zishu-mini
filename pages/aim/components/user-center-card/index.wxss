.user-center-card {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 480rpx;
  background:
    radial-gradient(circle at 15% 10%, rgba(244, 114, 182, 0.22) 0%, transparent 48%),
    linear-gradient(145deg, #fffafe 0%, #fff5fa 48%, #f3e8ff 100%);
  background-size: cover;
  background-repeat: no-repeat;
  padding: 0 28rpx;
  border-radius: 0 0 44rpx 44rpx;
  border-bottom: 2rpx solid rgba(244, 114, 182, 0.28);
  box-shadow:
    0 16rpx 40rpx -10rpx rgba(236, 72, 153, 0.14),
    inset 0 -3rpx 0 #ffffff;
  box-sizing: border-box;
}
.user-center-card__header {
  margin-top: 180rpx;
  margin-bottom: 40rpx;
  min-height: 120rpx;
  padding: 18rpx 26rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 12rpx 28rpx -8rpx rgba(236, 72, 153, 0.12),
    inset 0 3rpx 0 #ffffff;
  line-height: 48rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  color: #3b0764;
  position: relative;
}
.user-center-card__header__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 3rpx solid #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.16);
  overflow: hidden;
}

.user-center-card__header__name {
  font-size: 34rpx;
  line-height: 48rpx;
  color: #3b0764;
  font-weight: 800;
  margin-left: 24rpx;
  margin-right: 16rpx;
}
.user-center-card__header__transparent {
  position: absolute;
  left: 0;
  top: 0;
  background-color: transparent;
  height: 100%;
  width: 100%;
}
.user-center-card__icon {
  line-height: 96rpx;
}
