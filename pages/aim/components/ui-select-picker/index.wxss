.city-picker-container {
  opacity: 0;
  position: fixed;
  top: 100vh;
  left: 0;
  right: 0;
  height: 100vh;
  z-index: 100;
}
.city-picker-container.show {
  top: 0;
  opacity: 1;
}
.city-picker-container.show .city-picker-box {
  bottom: 0;
}
.city-picker-shadow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(36, 16, 68, 0.42);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.city-picker-header {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #3b0764;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}
.city-picker-more {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.city-picker-header .btn {
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  color: #6d28d9;
  border: 1.5rpx solid rgba(124, 58, 237, 0.24);
}
.city-picker-header .btn.primary {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.28);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.25);
}
.city-picker-footer {
  height: 112rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}
.city-picker-footer .btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  text-align: center;
  color: #6d28d9;
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  border: 1.5rpx solid rgba(124, 58, 237, 0.28);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  position: relative;
  box-shadow: 0 4rpx 14rpx rgba(124, 58, 237, 0.10), inset 0 2rpx 0 #ffffff;
}
.city-picker-footer .btn__active {
  transform: scale(0.96);
  opacity: 0.9;
}
.city-picker-footer .btn.primary {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.28);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}
.picker-column:not(:first-child) {
  margin-left: 40rpx;
}
.city-picker-box {
  position: absolute;
  bottom: -100%;
  transition: 0.3s bottom ease-in-out;
  left: 0;
  right: 0;
  z-index: 100;
  background:
    radial-gradient(circle at 15% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 85% 0%, rgba(129, 140, 248, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 40%, #f8f7ff 100%);
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  color: #1e1b4b;
  font-size: 32rpx;
  border-radius: 48rpx 48rpx 0 0;
  border-top: 2rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    0 -20rpx 64rpx rgba(109, 40, 217, 0.22),
    inset 0 3rpx 0 #ffffff;
}
.show .city-picker-shadow {
  display: block;
}
.picker {
  height: 320rpx;
  margin: 32rpx 0;
  line-height: 88rpx;
  text-align: center;
}
.picker-row {
  border-radius: 20rpx;
  margin: 0 12rpx;
  font-weight: 700;
  color: #3b0764;
}
.picker-row.zs-row-odd {
  background: rgba(255, 245, 250, 0.65);
}
.picker-row.zs-row-even {
  background: rgba(238, 242, 255, 0.65);
}
/* 似乎小程序picker-view的bug，indicator-class仅height生效，其他诸如line-height、text-align等放到父class中设置 */
.picker-center-row {
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(254, 240, 138, 0.28);
  border: 2rpx solid rgba(251, 146, 60, 0.35);
}
