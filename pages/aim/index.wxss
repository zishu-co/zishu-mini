.aim-page {
  min-height: 100vh;
  background: #f6f5fb;
  padding: 0 28rpx;
  padding-bottom: max(env(safe-area-inset-bottom) + 180rpx, 200rpx);
  box-sizing: border-box;
}

/* 顶部旗舰导航头 */
.aim-header {
  position: relative;
  overflow: hidden;
  margin: 0 -28rpx 28rpx;
  padding: 40rpx 32rpx 44rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  color: #ffffff;
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 16rpx 40rpx rgba(91, 33, 182, 0.25);
}

.aim-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.aim-header-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.aim-header-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  letter-spacing: 1.5rpx;
}

.aim-header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

.streak-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.12);
  white-space: nowrap;
  flex-shrink: 0;
}

.streak-fire {
  font-size: 28rpx;
}

.streak-num {
  font-size: 23rpx;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}

/* 能量充能卡片 */
.energy-dock {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 26rpx;
  padding: 22rpx 26rpx;
}

.energy-dock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.energy-badge {
  font-size: 22rpx;
  font-weight: 800;
  color: #6d28d9;
  background: #ffffff;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.1);
  white-space: nowrap;
  flex-shrink: 0;
}

.energy-pct {
  font-size: 23rpx;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}

.energy-progress-track {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.energy-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #fde047 0%, #34d399 100%);
  border-radius: 999rpx;
  transition: width 0.35s ease;
}

.energy-tip {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.92);
}

/* 交友与伴学快捷入口 */
.social-quick-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 26rpx;
}

.quick-pill {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 18rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(147, 51, 234, 0.08);
  transition: transform 0.15s ease;
}

.quick-pill:active {
  transform: scale(0.97);
  background: #faf5ff;
}

.quick-pill-icon {
  font-size: 30rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quick-pill-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.quick-pill-title {
  font-size: 23rpx;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
}

.quick-pill-sub {
  font-size: 19rpx;
  color: #64748b;
  white-space: nowrap;
  margin-top: 2rpx;
}

/* 额外的底部占位元素，确保内容不被遮挡 */
.aim-page::after {
  content: '';
  display: block;
  height: 40rpx;
}

.section-recommendation {
  margin-bottom: 26rpx;
}

.section-goal {
  margin-bottom: 26rpx;
}

/* 覆盖 TDesign 按钮样式 */
.aim-page .t-button {
  --td-button-primary-color: #7c3aed;
  --td-button-primary-color-hover: #6d28d9;
  --td-button-primary-color-active: #5b21b6;
  --td-button-primary-text-color: #fff;
  --td-button-primary-border-color: #7c3aed;
}

.aim-page .t-button--primary {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%) !important;
  border-color: transparent !important;
  color: var(--td-button-primary-text-color) !important;
  border-radius: 999rpx !important;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}

.aim-page .t-button--primary .t-button__text {
  color: var(--td-button-primary-text-color) !important;
  font-weight: 700;
}

.aim-page .t-button--outline {
  --td-button-default-border-color: #9333ea;
  --td-button-default-text-color: #7c3aed;
  border-color: var(--td-button-default-border-color) !important;
  border-radius: 999rpx !important;
}

.aim-page .t-button--outline .t-button__text {
  color: var(--td-button-default-text-color) !important;
  font-weight: 700;
}

/* Dev 模式提示条 */
.dev-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border: 1rpx solid #f59e0b;
  border-radius: 22rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
}

.dev-banner-text {
  font-size: 25rpx;
  color: #92400e;
  font-weight: 600;
}

.dev-banner-login {
  font-size: 23rpx;
  color: #b45309;
  font-weight: 700;
  padding: 8rpx 22rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 目标编辑/创建弹窗 */
.goal-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.56);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 200;
}

.goal-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 650rpx;
  background: #ffffff;
  border-radius: 36rpx;
  z-index: 201;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.22);
  border: 1rpx solid rgba(147, 51, 234, 0.12);
}

.goal-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 34rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.goal-modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.goal-modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  font-size: 28rpx;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goal-modal-body {
  padding: 28rpx 34rpx 34rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #0f172a;
  background: #f8fafc;
  box-sizing: border-box;
}

.picker-display {
  color: #0f172a;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #0f172a;
  background: #f8fafc;
  box-sizing: border-box;
  line-height: 1.5;
}

.form-textarea.short {
  height: 128rpx;
}

.goal-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 16rpx;
}

.modal-btn {
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.modal-btn.cancel {
  background: #f1f5f9;
  color: #475569;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.25);
}

/* 100% 目标达成通关横幅 */
.goal-achieved-banner {
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border: 2rpx solid #fbbf24;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 10rpx 28rpx rgba(245, 158, 11, 0.14);
}

.achieved-top {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.achieved-badge {
  font-size: 30rpx;
  font-weight: 800;
  color: #b45309;
}

.achieved-sub {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

.achieved-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.achieved-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.achieved-btn.ghost {
  background: rgba(255, 255, 255, 0.9);
  color: #b45309;
  border: 1rpx solid #fbbf24;
}

.achieved-btn.primary {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(217, 119, 6, 0.28);
}
