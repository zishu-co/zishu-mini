.aim-page {
  min-height: 100vh;
  background: var(--bg-page-gradient, linear-gradient(165deg, #fdf2f8 0%, #f3e8ff 38%, #eef2ff 72%, #f0f9ff 100%));
  padding: 0 28rpx;
  padding-bottom: max(env(safe-area-inset-bottom) + 180rpx, 200rpx);
  box-sizing: border-box;
}

/* 顶部旗舰导航头 */
.aim-header {
  position: relative;
  overflow: hidden;
  margin: 0 -28rpx 28rpx;
  padding: 40rpx 32rpx 44rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  color: #ffffff;
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 16rpx 40rpx rgba(91, 33, 182, 0.25);
}

.aim-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.aim-header-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.aim-header-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  letter-spacing: 1.5rpx;
}

.aim-header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

.streak-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.12);
  white-space: nowrap;
  flex-shrink: 0;
}

.streak-fire {
  font-size: 28rpx;
}

.streak-num {
  font-size: 23rpx;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}

/* 能量充能卡片 */
.energy-dock {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 26rpx;
  padding: 22rpx 26rpx;
}

.energy-dock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.energy-badge {
  font-size: 22rpx;
  font-weight: 800;
  color: #6d28d9;
  background: #ffffff;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.1);
  white-space: nowrap;
  flex-shrink: 0;
}

.energy-pct {
  font-size: 23rpx;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}

.energy-progress-track {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.energy-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #fde047 0%, #34d399 100%);
  border-radius: 999rpx;
  transition: width 0.35s ease;
}

.energy-tip {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.92);
}

/* 学习与伴学快捷入口 */
.social-quick-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 26rpx;
}

.quick-pill {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 28rpx;
  padding: 18rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.12),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
}

.quick-pill:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.13),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.quick-pill:active {
  transform: scale(0.96);
  background: var(--row-selected-gradient, linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%));
  border-color: #fb923c;
}

.quick-pill-icon {
  font-size: 30rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quick-pill-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.quick-pill-title {
  font-size: 23rpx;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
}

.quick-pill-sub {
  font-size: 19rpx;
  color: #64748b;
  white-space: nowrap;
  margin-top: 2rpx;
}

/* 额外的底部占位元素，确保内容不被遮挡 */
.aim-page::after {
  content: '';
  display: block;
  height: 40rpx;
}

.section-recommendation {
  margin-bottom: 26rpx;
}

.section-goal {
  margin-bottom: 26rpx;
}

/* 覆盖 TDesign 按钮样式 */
.aim-page .t-button {
  --td-button-primary-color: #7c3aed;
  --td-button-primary-color-hover: #6d28d9;
  --td-button-primary-color-active: #5b21b6;
  --td-button-primary-text-color: #fff;
  --td-button-primary-border-color: #7c3aed;
}

.aim-page .t-button--primary {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%) !important;
  border-color: transparent !important;
  color: var(--td-button-primary-text-color) !important;
  border-radius: 999rpx !important;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}

.aim-page .t-button--primary .t-button__text {
  color: var(--td-button-primary-text-color) !important;
  font-weight: 700;
}

.aim-page .t-button--outline {
  --td-button-default-border-color: #9333ea;
  --td-button-default-text-color: #7c3aed;
  border-color: var(--td-button-default-border-color) !important;
  border-radius: 999rpx !important;
}

.aim-page .t-button--outline .t-button__text {
  color: var(--td-button-default-text-color) !important;
  font-weight: 700;
}

/* Dev 模式提示条 */
.dev-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border: 1rpx solid #f59e0b;
  border-radius: 22rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
}

.dev-banner-text {
  font-size: 25rpx;
  color: #92400e;
  font-weight: 600;
}

.dev-banner-login {
  font-size: 23rpx;
  color: #b45309;
  font-weight: 700;
  padding: 8rpx 22rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 目标编辑/创建弹窗 — Candy Aurora 极光糖果卡片 */
.goal-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(36, 16, 68, 0.42);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 200;
}

.goal-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 660rpx;
  max-height: 84vh;
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 88% 0%, rgba(168, 85, 247, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 42%, #faf7ff 100%);
  border-radius: 44rpx;
  padding: 28rpx 34rpx 36rpx;
  box-sizing: border-box;
  z-index: 201;
  overflow-y: auto;
  box-shadow:
    0 28rpx 72rpx -12rpx rgba(109, 40, 217, 0.26),
    0 10rpx 28rpx -6rpx rgba(236, 72, 153, 0.14),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
}

.goal-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 18rpx;
  margin-bottom: 24rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.goal-modal-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #3b0764;
}

.goal-modal-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  color: #9333ea;
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.12), inset 0 2rpx 0 #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goal-modal-body {
  padding: 0;
}

.form-item {
  margin-bottom: 20rpx;
  padding: 22rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10), inset 0 3rpx 0 #ffffff;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease, border-color 0.2s ease;
}

.form-item:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.28);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12), inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.form-item:focus-within {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border: 2.5rpx solid #fb923c;
  box-shadow:
    0 14rpx 32rpx -8rpx rgba(251, 146, 60, 0.24),
    0 0 0 6rpx rgba(251, 146, 60, 0.12),
    inset 0 3rpx 0 #ffffff;
  transform: translateY(-2rpx);
}

.form-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: #581c87;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  min-height: 82rpx;
  line-height: 82rpx;
  padding: 0 26rpx;
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 24rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.picker-display {
  color: #1e1b4b;
  font-weight: 600;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 26rpx;
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 26rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
  line-height: 1.55;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.form-textarea.short {
  min-height: 128rpx;
}

.goal-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn {
  padding: 18rpx 42rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.modal-btn.cancel {
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  color: #6d28d9;
  border: 1.5rpx solid rgba(124, 58, 237, 0.28);
  box-shadow:
    0 4rpx 14rpx rgba(124, 58, 237, 0.10),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.90);
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 52%, #5b21b6 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.30),
    0 2rpx 6rpx rgba(91, 33, 182, 0.18),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

/* 100% 目标达成通关横幅 */
.goal-achieved-banner {
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border: 2rpx solid #fbbf24;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 10rpx 28rpx rgba(245, 158, 11, 0.14);
}

.achieved-top {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.achieved-badge {
  font-size: 30rpx;
  font-weight: 800;
  color: #b45309;
}

.achieved-sub {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

.achieved-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.achieved-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.achieved-btn.ghost {
  background: rgba(255, 255, 255, 0.9);
  color: #b45309;
  border: 1rpx solid #fbbf24;
}

.achieved-btn.primary {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(217, 119, 6, 0.28);
}
