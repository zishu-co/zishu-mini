.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-top: 0;
  padding-bottom: 60rpx;
}

.hero-stats {
  position: relative;
  overflow: hidden;
  margin: 0 0 24rpx;
  padding: 36rpx 30rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.26);
  color: #fff;
}

.hero-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
  gap: 16rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.hero-sub {
  font-size: 23rpx;
  opacity: 0.9;
}

.hero-tag {
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 26rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow:
    0 10rpx 24rpx rgba(15, 23, 42, 0.10),
    inset 0 2rpx 0 #ffffff;
}

.stat-card:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
  margin-bottom: 4rpx;
}
.stat-num.brand { color: #6d28d9; }
.stat-num.muted { color: #ea580c; }

.stat-label {
  font-size: 22rpx;
  color: #64748b;
  white-space: nowrap;
}

/* 搜索与筛选栏 */
.plaza-controls {
  padding: 0 24rpx 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 76rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid rgba(124, 58, 237, 0.12);
  margin-bottom: 18rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #0f172a;
}

.search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.category-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 10rpx 12rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  border-radius: 28rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.10);
}

.cat-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #4c1d95;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  margin-right: 12rpx;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.cat-tab.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.34), inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
}

.gender-filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  padding: 10rpx 16rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.20);
  border-radius: 26rpx;
}

.filter-hint {
  font-size: 23rpx;
  color: #4c1d95;
  font-weight: 700;
  white-space: nowrap;
}

.gender-pills {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.gender-pill {
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.18s ease;
}

.gender-pill.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.32);
}

.gender-pill.active.female {
  background: #fdf2f8;
  color: #db2777;
  border-color: #f472b6;
}

.gender-pill.active.male {
  background: #eff6ff;
  color: #2563eb;
  border-color: #60a5fa;
}

/* 成员列表 */
.member-list {
  padding: 0 24rpx 48rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 90rpx 32rpx;
  color: #94a3b8;
  font-size: 28rpx;
  background: #fff;
  border-radius: 28rpx;
}

.member-card {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 26rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 32rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
}

.member-card:nth-child(even),
.member-card.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.13),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.member-avatar {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.22);
}

.member-avatar.female {
  background: linear-gradient(135deg, #ec4899 0%, #a855f7 100%);
}

.member-avatar.male {
  background: linear-gradient(135deg, #3b82f6 0%, #7c3aed 100%);
}

.avatar-text {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
}

.avatar-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.member-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #0f172a;
}

.level-pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  background: #f5f3ff;
  color: #6d28d9;
  white-space: nowrap;
  flex-shrink: 0;
}

.level-pill.level-5,
.level-pill.level-4 {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #92400e;
}

.shuzhi-badge {
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  font-size: 21rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}
.shuzhi-badge.active {
  background: rgba(124, 58, 237, 0.1);
  color: #6d28d9;
}
.shuzhi-badge.inactive {
  background: #f1f5f9;
  color: #64748b;
}

.social-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.social-tag {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: #f8fafc;
  color: #475569;
  white-space: nowrap;
  flex-shrink: 0;
}

.social-tag.gender-female {
  background: #fdf2f8;
  color: #be185d;
}

.social-tag.gender-male {
  background: #eff6ff;
  color: #1d4ed8;
}

.social-tag.hot {
  background: #fff7ed;
  color: #ea580c;
  font-weight: 600;
}

.goal-preview {
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  border: 1.5rpx solid rgba(192, 132, 252, 0.28);
  padding: 12rpx 18rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: inset 0 2rpx 0 #ffffff;
}

.goal-preview-text {
  font-size: 23rpx;
  color: #4c1d95;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  flex-wrap: nowrap;
}

.peer-btn {
  flex: 1;
  min-width: 0;
  padding: 10rpx 8rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  flex-shrink: 0;
  box-sizing: border-box;
}

.peer-btn.ghost {
  background: #f8fafc;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}

.peer-btn.primary {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.22);
}

/* 督学沟通弹窗 — Candy Aurora 极光糖果卡片 */
.greet-mask {
  position: fixed;
  inset: 0;
  background: rgba(36, 16, 68, 0.42);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 200;
}

.greet-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 660rpx;
  max-height: 84vh;
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 88% 0%, rgba(168, 85, 247, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 42%, #faf7ff 100%);
  border-radius: 44rpx;
  padding: 28rpx 34rpx 36rpx;
  z-index: 201;
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow:
    0 28rpx 72rpx -12rpx rgba(109, 40, 217, 0.26),
    0 10rpx 28rpx -6rpx rgba(236, 72, 153, 0.14),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
}

.profile-modal {
  border-radius: 44rpx;
}

.greet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.greet-title {
  display: block;
  font-size: 33rpx;
  font-weight: 800;
  color: #3b0764;
  margin-bottom: 6rpx;
}

.greet-sub {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #7c3aed;
}

.greet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  color: #9333ea;
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.12), inset 0 2rpx 0 #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.topic-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 10rpx 24rpx -8rpx rgba(236, 72, 153, 0.10),
    inset 0 3rpx 0 #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  color: #1e1b4b;
}

.topic-item:nth-child(even),
.topic-item.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 10rpx 24rpx -8rpx rgba(99, 102, 241, 0.12),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.topic-item.selected {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%) !important;
  border: 3rpx solid #fb923c !important;
  color: #7c2d12;
  font-weight: 800;
  box-shadow:
    0 14rpx 32rpx -6rpx rgba(251, 146, 60, 0.24),
    0 0 0 4rpx rgba(251, 146, 60, 0.14),
    inset 0 3rpx 0 #ffffff !important;
}

.custom-topic-input {
  width: 100%;
  min-height: 82rpx;
  padding: 0 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  font-size: 27rpx;
  color: #1e1b4b;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.greet-footer {
  display: flex;
  gap: 18rpx;
}

.greet-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  white-space: nowrap;
}

.greet-btn.cancel {
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  color: #6d28d9;
  border: 1.5rpx solid rgba(124, 58, 237, 0.28);
  box-shadow: 0 4rpx 14rpx rgba(124, 58, 237, 0.10), inset 0 2rpx 0 #ffffff;
}

.greet-btn.confirm {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 52%, #5b21b6 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.30),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.profile-head-main {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.profile-stats-grid {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.profile-stat-box {
  flex: 1;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  border-radius: 26rpx;
  padding: 18rpx 10rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx -6rpx rgba(236, 72, 153, 0.10), inset 0 2rpx 0 #ffffff;
}

.profile-stat-box:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
}

.profile-stat-val {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #6d28d9;
}

.profile-stat-lbl {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.profile-goal-box {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow: 0 10rpx 24rpx -8rpx rgba(236, 72, 153, 0.10), inset 0 3rpx 0 #ffffff;
}

.profile-section-title {
  display: block;
  font-size: 23rpx;
  font-weight: 700;
  color: #7c3aed;
  margin-bottom: 8rpx;
}

.profile-goal-text {
  display: block;
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.6;
}

.profile-goal-progress {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6d28d9;
}

.no-perm-desc {
  margin: 16rpx 0 32rpx;
  color: #64748b;
  font-size: 26rpx;
}

.no-perm-btn {
  width: 320rpx;
  margin: 0 auto;
}
