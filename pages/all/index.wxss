.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-top: 0;
  padding-bottom: 60rpx;
}

.hero-stats {
  position: relative;
  overflow: hidden;
  margin: 0 0 24rpx;
  padding: 36rpx 30rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.26);
  color: #fff;
}

.hero-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
  gap: 16rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.hero-sub {
  font-size: 23rpx;
  opacity: 0.9;
}

.hero-tag {
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 22rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.08);
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
  margin-bottom: 4rpx;
}
.stat-num.brand { color: #6d28d9; }
.stat-num.muted { color: #ea580c; }

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

/* 搜索与筛选栏 */
.plaza-controls {
  padding: 0 24rpx 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 76rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid rgba(124, 58, 237, 0.12);
  margin-bottom: 18rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #0f172a;
}

.search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.category-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 10rpx 12rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  border-radius: 28rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.10);
}

.cat-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #4c1d95;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  margin-right: 12rpx;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.cat-tab.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.34), inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
}

.gender-filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  padding: 10rpx 16rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.20);
  border-radius: 26rpx;
}

.filter-hint {
  font-size: 24rpx;
  color: #4c1d95;
  font-weight: 700;
}

.gender-pills {
  display: flex;
  gap: 10rpx;
}

.gender-pill {
  font-size: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  transition: all 0.18s ease;
}

.gender-pill.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.32);
}

.gender-pill.active.female {
  background: #fdf2f8;
  color: #db2777;
  border-color: #f472b6;
}

.gender-pill.active.male {
  background: #eff6ff;
  color: #2563eb;
  border-color: #60a5fa;
}

/* 成员列表 */
.member-list {
  padding: 0 24rpx 48rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 90rpx 32rpx;
  color: #94a3b8;
  font-size: 28rpx;
  background: #fff;
  border-radius: 28rpx;
}

.member-card {
  display: flex;
  gap: 22rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.member-avatar {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.22);
}

.member-avatar.female {
  background: linear-gradient(135deg, #ec4899 0%, #a855f7 100%);
}

.member-avatar.male {
  background: linear-gradient(135deg, #3b82f6 0%, #7c3aed 100%);
}

.avatar-text {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
}

.avatar-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.member-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #0f172a;
}

.level-pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  background: #f5f3ff;
  color: #6d28d9;
}

.level-pill.level-5,
.level-pill.level-4 {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #92400e;
}

.shuzhi-badge {
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  font-size: 21rpx;
  font-weight: 600;
}
.shuzhi-badge.active {
  background: rgba(124, 58, 237, 0.1);
  color: #6d28d9;
}
.shuzhi-badge.inactive {
  background: #f1f5f9;
  color: #64748b;
}

.social-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.social-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: #f8fafc;
  color: #475569;
}

.social-tag.gender-female {
  background: #fdf2f8;
  color: #be185d;
}

.social-tag.gender-male {
  background: #eff6ff;
  color: #1d4ed8;
}

.social-tag.hot {
  background: #fff7ed;
  color: #ea580c;
  font-weight: 600;
}

.goal-preview {
  background: #faf5ff;
  border-left: 6rpx solid #7c3aed;
  padding: 10rpx 16rpx;
  border-radius: 8rpx 14rpx 14rpx 8rpx;
  margin-bottom: 16rpx;
}

.goal-preview-text {
  font-size: 23rpx;
  color: #4c1d95;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}

.peer-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.peer-btn.ghost {
  background: #f8fafc;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}

.peer-btn.primary {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.22);
}

/* 破冰约学弹窗 */
.greet-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(6px);
  z-index: 200;
}

.greet-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  z-index: 201;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(15, 23, 42, 0.22);
}

.profile-modal {
  border-top: 6rpx solid #7c3aed;
}

.greet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.greet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.greet-sub {
  display: block;
  font-size: 23rpx;
  color: #64748b;
}

.greet-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 4rpx 10rpx;
}

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.topic-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 2rpx solid transparent;
  font-size: 25rpx;
  color: #334155;
}

.topic-item.selected {
  background: #f5f3ff;
  border-color: #7c3aed;
  color: #6d28d9;
  font-weight: 700;
}

.custom-topic-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.greet-footer {
  display: flex;
  gap: 16rpx;
}

.greet-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.greet-btn.cancel {
  background: #f1f5f9;
  color: #64748b;
}

.greet-btn.confirm {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.24);
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.profile-head-main {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.profile-stats-grid {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.profile-stat-box {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 16rpx 10rpx;
  text-align: center;
}

.profile-stat-val {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #6d28d9;
}

.profile-stat-lbl {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.profile-goal-box {
  background: #faf5ff;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.14);
}

.profile-section-title {
  display: block;
  font-size: 23rpx;
  font-weight: 700;
  color: #7c3aed;
  margin-bottom: 8rpx;
}

.profile-goal-text {
  display: block;
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.6;
}

.profile-goal-progress {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6d28d9;
}
