<view class="page">
  <!-- 顶部交友广场品牌 Banner + 统计 -->
  <view class="hero-stats">
    <view class="hero-header">
      <view>
        <view class="hero-title">全塾同路人 · 共学交友广场</view>
        <view class="hero-sub">遇见同频男女搭子 · 组方舟 · 约目标面谈</view>
      </view>
      <view class="hero-tag">🔥 {{hot7dCount}} 人本周打卡</view>
    </view>
    <view class="stats-row">
      <view class="stat-card">
        <text class="stat-num">{{totalCount}}</text>
        <text class="stat-label">同路人总数</text>
      </view>
      <view class="stat-card">
        <text class="stat-num brand">{{activeCount}}</text>
        <text class="stat-label">活跃共学者</text>
      </view>
      <view class="stat-card">
        <text class="stat-num muted">{{hot7dCount}}</text>
        <text class="stat-label">7日冲刺榜</text>
      </view>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="plaza-controls">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        type="text"
        placeholder="搜昵称、所在城市、目标方向或段位..."
        value="{{keyword}}"
        bindinput="onKeywordInput"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">✕</text>
    </view>

    <!-- 分类 Tab -->
    <scroll-view class="category-tabs" scroll-x enable-flex>
      <view
        class="cat-tab {{activeCategory === 'all' ? 'active' : ''}}"
        data-cat="all"
        bindtap="onCategoryTap"
      >✨ 全部同路人</view>
      <view
        class="cat-tab {{activeCategory === 'hot' ? 'active' : ''}}"
        data-cat="hot"
        bindtap="onCategoryTap"
      >🔥 7日学霸榜</view>
      <view
        class="cat-tab {{activeCategory === 'buddy' ? 'active' : ''}}"
        data-cat="buddy"
        bindtap="onCategoryTap"
      >🤝 找共学搭子</view>
      <view
        class="cat-tab {{activeCategory === 'mentor' ? 'active' : ''}}"
        data-cat="mentor"
        bindtap="onCategoryTap"
      >💎 领航塾师</view>
    </scroll-view>

    <!-- 性别快速筛选 -->
    <view class="gender-filter-bar">
      <text class="filter-hint">筛选搭子：</text>
      <view class="gender-pills">
        <view
          class="gender-pill {{genderFilter === 'all' ? 'active' : ''}}"
          data-gender="all"
          bindtap="onGenderFilterTap"
        >全部</view>
        <view
          class="gender-pill {{genderFilter === '女' ? 'active female' : ''}}"
          data-gender="女"
          bindtap="onGenderFilterTap"
        >🚺 女生搭子</view>
        <view
          class="gender-pill {{genderFilter === '男' ? 'active male' : ''}}"
          data-gender="男"
          bindtap="onGenderFilterTap"
        >🚹 男生搭子</view>
      </view>
    </view>
  </view>

  <!-- 成员列表 -->
  <view class="member-list">
    <view wx:if="{{loading}}">
      <view class="loading-row"><text>正在寻找同频共学伙伴...</text></view>
    </view>
    <view wx:elif="{{members.length === 0}}">
      <view class="empty-row"><text>暂无符合筛选条件的同路人，换个条件试试吧 ✨</text></view>
    </view>
    <view wx:else>
      <view class="member-card" wx:for="{{members}}" wx:key="id">
        <view
          class="member-avatar {{item._genderClass}}"
          data-item="{{item}}"
          bindtap="onOpenPeerProfile"
        >
          <text class="avatar-text">{{item._avatarChar}}</text>
          <text class="avatar-badge">{{item._levelBadge}}</text>
        </view>
        <view class="member-info">
          <view class="member-top" data-item="{{item}}" bindtap="onOpenPeerProfile">
            <text class="member-name">{{item.username}}</text>
            <view class="level-pill level-{{item._levelNum}}">
              <text>{{item._levelBadge}} {{item._levelTitle}}</text>
            </view>
            <view class="shuzhi-badge {{item._isActive ? 'active' : 'inactive'}}">
              <text>💎 {{item._shuzhiStr}}</text>
            </view>
          </view>

          <!-- 社交与共学标签 -->
          <view class="social-tags-row">
            <text class="social-tag gender-{{item._genderClass}}" wx:if="{{item._genderLabel}}">{{item._genderLabel}}</text>
            <text class="social-tag" wx:if="{{item.location}}">📍 {{item.location}}</text>
            <text class="social-tag">📚 累计 {{item._learnHourStr}}h</text>
            <text class="social-tag hot" wx:if="{{item._hours7dStr}}">🔥 7日 {{item._hours7dStr}}h</text>
          </view>

          <!-- 目标或个人签名 -->
          <view class="goal-preview" wx:if="{{item._goalShort}}">
            <text class="goal-preview-text">🎯 {{item._goalShort}}</text>
          </view>

          <!-- 互动按钮栏 -->
          <view class="member-actions">
            <view
              class="peer-btn ghost"
              bindtap="onOpenPeerProfile"
              data-item="{{item}}"
            >👤 社交名片</view>
            <view
              class="peer-btn ghost"
              bindtap="onViewLearnSheet"
              data-userid="{{item.id}}"
            >📖 看学习单</view>
            <view
              class="peer-btn primary"
              bindtap="onOpenGreetModal"
              data-item="{{item}}"
            >👋 破冰约学</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 破冰约学弹窗 -->
  <view class="greet-mask" wx:if="{{showGreetModal}}" bindtap="onCloseGreetModal"></view>
  <view class="greet-modal" wx:if="{{showGreetModal && greetTarget}}">
    <view class="greet-header">
      <view>
        <text class="greet-title">👋 向 {{greetTarget.username}} 发起破冰约学</text>
        <text class="greet-sub">{{greetTarget._levelBadge}} {{greetTarget._levelTitle}} · 选择一个共学破冰话题</text>
      </view>
      <text class="greet-close" bindtap="onCloseGreetModal">✕</text>
    </view>
    <view class="topic-list">
      <view
        class="topic-item {{selectedTopicIndex === index ? 'selected' : ''}}"
        wx:for="{{icebreakerTopics}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onSelectTopic"
      >
        <text>{{item}}</text>
        <text wx:if="{{selectedTopicIndex === index}}">✓</text>
      </view>
    </view>
    <input
      class="custom-topic-input"
      type="text"
      placeholder="或输入自定义破冰留言（选填）..."
      value="{{customTopic}}"
      bindinput="onCustomTopicInput"
    />
    <view class="greet-footer">
      <view class="greet-btn cancel" bindtap="onCloseGreetModal">取消</view>
      <view class="greet-btn confirm" bindtap="onSendGreet">
        {{greetingSubmitting ? '发送中...' : '🚀 发送共学邀请'}}
      </view>
    </view>
  </view>

  <!-- 101-profile.md: 同路人社交名片弹窗 -->
  <view class="greet-mask" wx:if="{{showProfileModal}}" bindtap="onClosePeerProfile"></view>
  <view class="greet-modal profile-modal" wx:if="{{showProfileModal && profilePeer}}">
    <view class="profile-head">
      <view class="member-avatar {{profilePeer._genderClass}}">
        <text class="avatar-text">{{profilePeer._avatarChar}}</text>
        <text class="avatar-badge">{{profilePeer._levelBadge}}</text>
      </view>
      <view class="profile-head-main">
        <view class="profile-name-row">
          <text class="greet-title">{{profilePeer.username}}</text>
          <view class="level-pill level-{{profilePeer._levelNum}}">
            <text>{{profilePeer._levelBadge}} {{profilePeer._levelTitle}}</text>
          </view>
        </view>
        <text class="greet-sub">
          {{profilePeer._genderLabel || '同频搭子'}} · 📍 {{profilePeer.location || '同城/线上'}}
        </text>
      </view>
      <text class="greet-close" bindtap="onClosePeerProfile">✕</text>
    </view>

    <view class="profile-stats-grid">
      <view class="profile-stat-box">
        <text class="profile-stat-val">💎 {{profilePeer._shuzhiStr}}</text>
        <text class="profile-stat-lbl">当前塾值</text>
      </view>
      <view class="profile-stat-box">
        <text class="profile-stat-val">📚 {{profilePeer._learnHourStr}}h</text>
        <text class="profile-stat-lbl">累计共学</text>
      </view>
      <view class="profile-stat-box">
        <text class="profile-stat-val">🔥 {{profilePeer._hours7dStr || '0'}}h</text>
        <text class="profile-stat-lbl">7日冲刺</text>
      </view>
    </view>

    <view class="profile-goal-box">
      <text class="profile-section-title">🎯 当前冲刺目标</text>
      <text class="profile-goal-text">
        {{profileGoal ? profileGoal.content : (profilePeer.goal || profilePeer.desc || '正在寻找 2男2女诺亚方舟共学搭子，欢迎随时破冰约聊！')}}
      </text>
      <view wx:if="{{profileGoal && profileGoal.process !== undefined}}" class="profile-goal-progress">
        <text>当前进度：{{profileGoal.process || 0}}%</text>
      </view>
    </view>

    <view class="greet-footer">
      <view
        class="greet-btn cancel"
        data-userid="{{profilePeer.id}}"
        bindtap="onViewLearnSheet"
      >📖 查看学习单</view>
      <view class="greet-btn confirm" bindtap="onGreetFromProfile">👋 15分钟破冰约学</view>
    </view>
  </view>
</view>
