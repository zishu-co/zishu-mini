/* pages/privacy/index.wxss */
page {
  background: #f6f5fb;
}

.page {
  padding: 24rpx;
}

.brand-header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  padding: 38rpx 34rpx 44rpx;
  margin: -24rpx -24rpx 28rpx;
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.brand-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.update-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.content,
.zs-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  padding: 36rpx 30rpx;
  box-shadow:
    0 14rpx 36rpx rgba(147, 51, 234, 0.08),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(192, 132, 252, 0.24);
}

.section {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.24);
  box-shadow:
    0 8rpx 22rpx -6rpx rgba(236, 72, 153, 0.09),
    inset 0 2rpx 0 #ffffff;
}

.section:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.28);
  box-shadow:
    0 8rpx 22rpx -6rpx rgba(99, 102, 241, 0.11),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.94);
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #6d28d9;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 27rpx;
  color: #475569;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.section-content:last-child {
  margin-bottom: 0;
}

.bold {
  font-weight: 700;
  color: #1e1b4b;
}

.email-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.28);
  padding: 20rpx 26rpx;
  border-radius: 24rpx;
  color: #7c3aed;
  font-weight: 700;
  box-shadow: inset 0 2rpx 0 #ffffff;
}

.copy-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #7c3aed;
  color: #ffffff;
  white-space: nowrap;
  flex-shrink: 0;
}

.policy-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.policy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  white-space: nowrap;
}

.policy-btn::after {
  border: none;
}

.policy-btn.ghost {
  background: #ffffff;
  color: #7c3aed;
  border: 2rpx solid rgba(124, 58, 237, 0.25);
}

.policy-btn.primary {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.24);
}

.bottom-safe {
  height: 60rpx;
}
