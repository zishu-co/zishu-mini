/* pages/privacy/index.wxss */
page {
  background: #f6f7fb;
}

.page {
  padding: 24rpx;
}

.brand-header {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.24);
}

.brand-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.update-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.content,
.zs-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.section {
  margin-bottom: 40rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #7c3aed;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.section-content:last-child {
  margin-bottom: 0;
}

.bold {
  font-weight: 600;
  color: #334155;
}

.bottom-safe {
  height: 100rpx;
}
