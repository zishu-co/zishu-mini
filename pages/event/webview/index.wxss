/* pages/event/webview/index.wxss */
page {
  background: #f6f5fb;
}

.empty-webview {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.webview-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 32rpx;
  padding: 56rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(124, 58, 237, 0.1), inset 0 2rpx 0 #ffffff;
  border: 1rpx solid rgba(124, 58, 237, 0.12);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 14rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 32rpx;
  text-align: center;
}

.url-preview {
  width: 100%;
  padding: 16rpx 24rpx;
  background: #f5f3ff;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #7c3aed;
  word-break: break-all;
  margin-bottom: 28rpx;
  text-align: center;
}

.webview-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.copy-btn,
.plaza-btn,
.back-btn {
  width: 100%;
  font-size: 28rpx;
  font-weight: 700;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 41rpx;
  border: none;
}

.copy-btn::after,
.plaza-btn::after,
.back-btn::after {
  border: none;
}

.copy-btn {
  background: #ede9fe;
  color: #6d28d9;
}

.plaza-btn {
  background: #f8fafc;
  color: #475569;
  border: 2rpx solid #e2e8f0;
}

.back-btn {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.25), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}
