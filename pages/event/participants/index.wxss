/* pages/event/participants/index.wxss — 活动详情与参与者名录旗舰视觉 */
.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-bottom: calc(env(safe-area-inset-bottom) + 60rpx);
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #64748b;
  font-size: 28rpx;
}

/* 顶部活动信息卡 — 改为上下式全宽海报卡片，彻底解决3按钮窄列挤压 */
.event-header {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  margin: 24rpx 28rpx 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.07), inset 0 2rpx 0 #ffffff;
  border: 1rpx solid rgba(124, 58, 237, 0.1);
}
.event-poster {
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  position: relative;
}
.poster-img {
  width: 100%;
  height: 100%;
  display: block;
}
.poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.92);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  backdrop-filter: blur(8px);
}

.event-info {
  padding: 28rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
}
.info-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.4;
  margin-bottom: 12rpx;
}
.info-meta {
  font-size: 25rpx;
  color: #475569;
  line-height: 1.75;
  font-weight: 500;
}
.info-desc {
  font-size: 25rpx;
  color: #64748b;
  line-height: 1.55;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.info-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-primary,
.btn-secondary {
  flex: 1;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  margin: 0;
  border: none;
}
.btn-primary {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}
.btn-secondary {
  background: #f1f5f9;
  color: #475569;
}
.btn-primary:active,
.btn-secondary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 参与者列表 */
.section {
  margin: 0 28rpx;
}
.section-header {
  padding: 8rpx 0 22rpx;
}
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}
.count-badge {
  font-size: 23rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
}

.participant-search {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 26rpx;
  height: 76rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid rgba(147, 51, 234, 0.1);
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #0f172a;
  height: 76rpx;
}
.search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 6rpx 12rpx;
}

.participant-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}
.participant-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.avatar-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.25);
}
.participant-main {
  flex: 1;
  min-width: 0;
}
.name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 8rpx;
}
.participant-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}
.level-tag {
  font-size: 21rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.city-tag {
  font-size: 21rpx;
  font-weight: 600;
  color: #475569;
  background: #f1f5f9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.join-time-sub {
  font-size: 23rpx;
  color: #64748b;
}
.greet-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 14rpx rgba(124, 58, 237, 0.22);
}
.greet-btn.greeted {
  background: #f3e8ff;
  color: #7c3aed;
  box-shadow: none;
}

.participant-badges {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f5f9;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.tag-success {
  background: #dcfce7;
  color: #15803d;
}
.tag-info {
  background: #f1f5f9;
  color: #64748b;
}
.tag-default {
  background: #fef3c7;
  color: #d97706;
}

.empty {
  text-align: center;
  padding: 88rpx 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx dashed #cbd5e1;
  color: #64748b;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.clear-search-btn {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: #f3e8ff;
  color: #7c3aed;
  font-size: 25rpx;
  font-weight: 700;
}

.safe-bottom {
  height: 40rpx;
}
