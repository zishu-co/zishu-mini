/* pages/event/participants/index.wxss */
.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 40rpx;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 顶部活动信息卡 */
.event-header {
  display: flex;
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.event-poster {
  flex-shrink: 0;
  width: 240rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
  position: relative;
}
.poster-img {
  width: 100%;
  height: 100%;
  display: block;
}
.poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
  background: #ececec;
}

.event-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8rpx;
  word-break: break-all;
}
.info-meta {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}
.info-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.info-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-primary,
.btn-secondary {
  flex: 1;
  border-radius: 12rpx;
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  margin: 0;
  border: none;
}
.btn-primary::after,
.btn-secondary::after {
  border: none;
}
.btn-primary {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
}
.btn-secondary {
  background: #f5f5f5;
  color: #333;
}
.btn-primary:active,
.btn-secondary:active {
  opacity: 0.85;
}

/* 参与者列表 */
.section {
  margin: 0 24rpx;
}
.section-header {
  padding: 20rpx 0 20rpx;
}
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.count-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.participant-search {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 34rpx;
  padding: 0 24rpx;
  height: 68rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a2e;
  height: 68rpx;
}
.search-clear {
  font-size: 26rpx;
  color: #9ca3af;
  padding: 6rpx 12rpx;
}

.participant-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.participant-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.avatar-circle {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.25);
}
.participant-main {
  flex: 1;
  min-width: 0;
}
.name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 6rpx;
}
.participant-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.level-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.city-tag {
  font-size: 20rpx;
  color: #6b7280;
  background: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
.join-time-sub {
  font-size: 22rpx;
  color: #9ca3af;
}
.greet-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.22);
}
.greet-btn.greeted {
  background: #f3e8ff;
  color: #7c3aed;
  box-shadow: none;
}

.participant-badges {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-success {
  background: #e8f8ee;
  color: #16a34a;
}
.tag-info {
  background: #f3f4f6;
  color: #6b7280;
}
.tag-default {
  background: #fff5e8;
  color: #d97c00;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.clear-search-btn {
  padding: 10rpx 32rpx;
  border-radius: 28rpx;
  background: #f3e8ff;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 600;
}

.safe-bottom {
  height: 40rpx;
}
