/* pages/event/participants/index.wxss */
.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 40rpx;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 顶部活动信息卡 */
.event-header {
  display: flex;
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.event-poster {
  flex-shrink: 0;
  width: 240rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
  position: relative;
}
.poster-img {
  width: 100%;
  height: 100%;
  display: block;
}
.poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
  background: #ececec;
}

.event-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8rpx;
  word-break: break-all;
}
.info-meta {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}
.info-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.info-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-primary,
.btn-secondary {
  flex: 1;
  border-radius: 12rpx;
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  margin: 0;
  border: none;
}
.btn-primary::after,
.btn-secondary::after {
  border: none;
}
.btn-primary {
  background: linear-gradient(135deg, #aa00ff 0%, #ff4d8d 100%);
  color: #fff;
}
.btn-secondary {
  background: #f5f5f5;
  color: #333;
}
.btn-primary:active,
.btn-secondary:active {
  opacity: 0.85;
}

/* 参与者列表 */
.section {
  margin: 0 24rpx;
}
.section-header {
  padding: 24rpx 0 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.participant-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}
.participant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.participant-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.participant-row:last-child {
  margin-bottom: 0;
}
.row-label {
  width: 160rpx;
  color: #666;
  flex-shrink: 0;
}
.row-value {
  flex: 1;
  color: #333;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  word-break: break-all;
}
.amount {
  color: #999;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.tag-success {
  background: #e8f8ee;
  color: #2ea44f;
}
.tag-info {
  background: #f0f0f0;
  color: #888;
}
.tag-default {
  background: #fff5e8;
  color: #d97c00;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.safe-bottom {
  height: 40rpx;
}
