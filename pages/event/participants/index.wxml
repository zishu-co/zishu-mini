<!-- pages/event/participants/index.wxml -->
<view class="page">

  <!-- 加载态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 顶部活动信息卡 -->
  <block wx:if="{{!loading && eventInfo}}">
    <view class="event-header">
      <view
        class="event-poster"
        bindtap="onPosterTap"
      >
        <image
          wx:if="{{eventInfo.poster}}"
          class="poster-img"
          src="{{eventInfo.poster}}"
          mode="aspectFill"
        />
        <view wx:else class="poster-placeholder">
          <text>暂无封面</text>
        </view>
      </view>
      <view class="event-info">
        <view class="info-title">{{eventInfo.title}}</view>
        <view class="info-meta">
          <text>🕐 {{eventInfo._startDateStr || eventInfo.start_time}}</text>
        </view>
        <view class="info-meta">
          <text>📍 {{eventInfo.location || '线上/待定'}}</text>
        </view>
        <view class="info-desc" wx:if="{{eventInfo.desc}}">
          <text>{{eventInfo.desc}}</text>
        </view>
        <view class="info-actions">
          <button class="btn-secondary" bindtap="onGoBack">返回列表</button>
          <button class="btn-primary" bindtap="onSelfSignIn">📍 现场签到</button>
          <button
            class="btn-primary"
            wx:if="{{eventInfo.url}}"
            bindtap="onOpenPromo"
          >宣传文案</button>
        </view>
      </view>
    </view>
  </block>

  <!-- 参与者列表 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-row">
        <text class="section-title">同城搭子名录</text>
        <view class="count-badge">共 {{participants.length}} 人 · 已签到 {{signedInCount}} 人</view>
      </view>

      <!-- 搜索栏 -->
      <view class="participant-search">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="搜索参与者姓名或城市..."
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
        />
        <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && filteredParticipants.length === 0}}">
      <text>{{searchKeyword ? '未找到匹配的参与者' : '暂无参与人'}}</text>
      <view wx:if="{{searchKeyword}}" class="clear-search-btn" bindtap="onClearSearch">清空搜索</view>
    </view>

    <view
      class="participant-card"
      wx:for="{{filteredParticipants}}"
      wx:key="id"
    >
      <view class="participant-top">
        <view
          class="avatar-circle"
          data-userid="{{item.user_id || item.id}}"
          bindtap="onViewParticipantSheet"
        >{{item._avatarInitial}}</view>
        <view
          class="participant-main"
          data-userid="{{item.user_id || item.id}}"
          bindtap="onViewParticipantSheet"
        >
          <view class="name-line">
            <text class="participant-name">{{item.username || '匿名搭子'}}</text>
            <text class="level-tag">{{item._levelTag}}</text>
            <text class="city-tag" wx:if="{{item._cityTag}}">📍 {{item._cityTag}}</text>
          </view>
          <view class="join-time-sub">报名于 {{item._joinTimeStr}} · 点击查看学习单 ›</view>
        </view>
        <view
          class="greet-btn {{item._greeted ? 'greeted' : ''}}"
          data-id="{{item.id}}"
          data-userid="{{item.user_id || item.id}}"
          data-name="{{item.username}}"
          bindtap="onGreetParticipant"
        >{{item._greeted ? '✨ 已约结伴' : '👋 约TA结伴'}}</view>
      </view>

      <view class="participant-badges">
        <view class="tag {{item.is_payed ? 'tag-success' : 'tag-default'}}">
          <text>{{item.is_payed ? '已支付' : '未支付'}}</text>
          <text wx:if="{{item.payed_amount > 0}}"> ¥{{item.payed_amount}}</text>
        </view>
        <view class="tag {{item.is_signed_in ? 'tag-success' : 'tag-info'}}">
          <text>{{item.is_signed_in ? '✓ 已签到' : '待签到'}}</text>
          <text wx:if="{{item.is_signed_in && item._signInTimeStr}}"> {{item._signInTimeStr}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="safe-bottom" />
</view>
