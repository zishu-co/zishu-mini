/* pages/event/index.wxss */
.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
}

/* Banner */
.banner {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  padding: 40rpx 32rpx 36rpx;
  color: #fff;
}
.banner-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.banner-title {
  font-size: 46rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}
.banner-sub {
  font-size: 26rpx;
  opacity: 0.9;
}
.banner-counters {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}
.counter-pill {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(8rpx);
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
}
.counter-pill.subtle {
  background: rgba(0, 0, 0, 0.18);
  font-weight: 500;
}

/* Search Bar */
.event-search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a2e;
  height: 72rpx;
}
.search-placeholder {
  color: #9ca3af;
}
.search-clear {
  font-size: 26rpx;
  color: #9ca3af;
  padding: 8rpx 12rpx;
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
  transition: color 0.2s;
}
.tab-active {
  color: #aa00ff;
  font-weight: 600;
}
.tab-active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #aa00ff;
  border-radius: 3rpx;
}

/* Loading */
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* Empty */
.empty {
  text-align: center;
  padding: 120rpx 32rpx;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.empty-text {
  color: #6b7280;
  font-size: 28rpx;
}
.empty-actions {
  display: flex;
  gap: 20rpx;
}
.retry-btn {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 40rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  border: none;
  margin: 0;
}
.retry-btn.secondary {
  background: #f3e8ff;
  color: #7c3aed;
}
.retry-btn::after {
  border: none;
}

/* Event Card */
.event-card {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.event-card.historical {
  opacity: 0.85;
}

.card-poster {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  background: #f0f0f0;
}
.poster-img {
  width: 100%;
  height: 100%;
  display: block;
}
.poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
  background: #ececec;
}
.poster-overlay {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  opacity: 0.92;
  transition: transform 0.2s, opacity 0.2s;
}
.card-poster:active .poster-overlay {
  opacity: 1;
  transform: scale(0.96);
}
.historical-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.card-body {
  padding: 24rpx;
}
.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.card-meta {
  margin-bottom: 12rpx;
}
.meta-item {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}
.card-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
}
.btn-primary::after {
  border: none;
}
.btn-primary:active {
  opacity: 0.85;
}

.safe-bottom {
  height: 40rpx;
}
