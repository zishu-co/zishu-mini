/* pages/event/index.wxss — 同城与线上活动广场旗舰视觉 */
.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
}

/* Banner */
.banner {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  padding: 40rpx 32rpx 42rpx;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 14rpx 36rpx rgba(91, 33, 182, 0.22);
}
.banner::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}
.banner-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.banner-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  letter-spacing: 1.5rpx;
}
.banner-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.86);
}
.banner-counters {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}
.counter-pill {
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
}
.counter-pill.subtle {
  background: rgba(15, 23, 42, 0.24);
  border-color: rgba(255, 255, 255, 0.15);
  font-weight: 500;
}

/* Search Bar */
.event-search-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 76rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.12);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #0f172a;
  height: 76rpx;
}
.search-placeholder {
  color: #94a3b8;
}
.search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 8rpx 12rpx;
}

/* Tabs */
.tabs {
  display: flex;
  background: rgba(243, 232, 255, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  margin: 22rpx 28rpx 0;
  padding: 8rpx;
  border-radius: 999rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.08), 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
  border: 2rpx solid rgba(168, 85, 247, 0.14);
  position: sticky;
  top: 12rpx;
  z-index: 10;
  gap: 8rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 27rpx;
  font-weight: 700;
  color: #64748b;
  border-radius: 999rpx;
  position: relative;
  transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}
.tab-active {
  background: linear-gradient(135deg, #a855f7 0%, #9333ea 52%, #7c3aed 100%);
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}
.tab-active::after {
  display: none;
}

/* Loading */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #64748b;
  font-size: 28rpx;
}

/* Empty */
.empty {
  text-align: center;
  margin: 28rpx;
  padding: 100rpx 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx dashed #cbd5e1;
  color: #64748b;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.empty-text {
  color: #64748b;
  font-size: 28rpx;
}
.empty-actions {
  display: flex;
  gap: 20rpx;
}
.retry-btn {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 44rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  border: none;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}
.retry-btn.secondary {
  background: #f3e8ff;
  color: #7c3aed;
  box-shadow: none;
}

/* Event Card */
.event-card {
  background: #ffffff;
  margin: 24rpx 28rpx 0;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  transition: transform 0.16s ease;
}
.event-card:active {
  transform: scale(0.99);
}
.event-card.historical {
  opacity: 0.9;
}

.card-poster {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f3e8ff 0%, #ede9fe 100%);
}
.poster-img {
  width: 100%;
  height: 100%;
  display: block;
}
.poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c3aed;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
}
.poster-overlay {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
.historical-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(15, 23, 42, 0.68);
  backdrop-filter: blur(8px);
  color: #ffffff;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.card-body {
  padding: 28rpx 30rpx 30rpx;
}
.card-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 14rpx;
  line-height: 1.4;
}
.card-meta {
  margin-bottom: 14rpx;
  background: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
}
.meta-item {
  display: block;
  font-size: 25rpx;
  color: #475569;
  line-height: 1.75;
  font-weight: 500;
}
.card-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.24);
}
.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.counter-pill.launch-btn {
  background: #ffffff;
  color: #6d28d9;
  font-weight: 800;
  padding: 10rpx 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.14);
}
.btn-primary.signed-btn {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  box-shadow: 0 6rpx 18rpx rgba(16, 185, 129, 0.24);
}

/* 发起活动弹窗 */
.event-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.56);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.event-modal-card {
  width: 100%;
  max-width: 650rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 38rpx 34rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.22);
  border: 1rpx solid rgba(147, 51, 234, 0.12);
}
.event-modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 24rpx;
}
.event-form-field {
  margin-bottom: 20rpx;
}
.event-form-row {
  display: flex;
  gap: 16rpx;
}
.event-form-field.half {
  flex: 1;
}
.event-form-label {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 10rpx;
}
.event-form-input,
.event-form-picker {
  width: 100%;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #0f172a;
  box-sizing: border-box;
}
.event-form-textarea {
  width: 100%;
  height: 148rpx;
  padding: 18rpx 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #0f172a;
  box-sizing: border-box;
  line-height: 1.5;
}
.event-modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.event-modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.event-modal-btn.cancel {
  background: #f1f5f9;
  color: #475569;
}
.event-modal-btn.confirm {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.25);
}
.safe-bottom {
  height: 40rpx;
}
