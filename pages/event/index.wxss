/* pages/event/index.wxss */
.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* Banner */
.banner {
  background: linear-gradient(135deg, #aa00ff 0%, #ff4d8d 100%);
  padding: 48rpx 32rpx 64rpx;
  color: #fff;
}
.banner-title {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.banner-sub {
  font-size: 34rpx;
  opacity: 0.85;
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 34rpx;
  color: #666;
  position: relative;
  transition: color 0.2s;
}
.tab-active {
  color: #aa00ff;
  font-weight: 600;
}
.tab-active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #aa00ff;
  border-radius: 3rpx;
}

/* Loading */
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 36rpx;
}

/* Empty */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 36rpx;
}

/* Event Card */
.event-card {
  background: #fff;
  margin: 16rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.event-card.historical {
  opacity: 0.85;
}

.card-poster {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  background: #f0f0f0;
}
.poster-img {
  width: 100%;
  height: 100%;
  display: block;
}
.poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 36rpx;
  background: #ececec;
}
.poster-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  opacity: 0;
  transition: opacity 0.2s;
}
.card-poster:active .poster-overlay {
  opacity: 1;
}
.historical-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.card-body {
  padding: 24rpx;
}
.card-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.card-meta {
  margin-bottom: 12rpx;
}
.meta-item {
  display: block;
  font-size: 32rpx;
  color: #666;
  line-height: 1.7;
}
.card-desc {
  font-size: 34rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #aa00ff 0%, #ff4d8d 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 34rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
}
.btn-primary::after {
  border: none;
}
.btn-primary:active {
  opacity: 0.85;
}

.safe-bottom {
  height: 40rpx;
}
