/* pages/event/index.wxss — 同城与线上活动广场旗舰视觉 */
.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
}

/* Banner */
.banner {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  padding: 40rpx 32rpx 42rpx;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 14rpx 36rpx rgba(91, 33, 182, 0.22);
}
.banner::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}
.banner-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.banner-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  letter-spacing: 1.5rpx;
}
.banner-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.86);
}
.banner-counters {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}
.counter-pill {
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
  flex-shrink: 0;
}
.counter-pill.subtle {
  background: rgba(15, 23, 42, 0.24);
  border-color: rgba(255, 255, 255, 0.15);
  font-weight: 500;
}

/* Search Bar */
.event-search-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 76rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.12);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #0f172a;
  height: 76rpx;
}
.search-placeholder {
  color: #94a3b8;
}
.search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 8rpx 12rpx;
}

/* Tabs */
.tabs {
  display: flex;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  margin: 22rpx 24rpx 0;
  padding: 8rpx;
  border-radius: 28rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.10), 0 6rpx 18rpx rgba(15, 23, 42, 0.05);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  position: sticky;
  top: 12rpx;
  z-index: 10;
  gap: 8rpx;
}
.tab {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 16rpx 4rpx;
  font-size: 23rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04), inset 0 1rpx 0 #ffffff;
  position: relative;
  white-space: nowrap;
  transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}
.tab-active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.34), inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
}
.tab-active::after {
  display: none;
}

/* Loading */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #64748b;
  font-size: 28rpx;
}

/* Empty */
.empty {
  text-align: center;
  margin: 28rpx;
  padding: 100rpx 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx dashed #cbd5e1;
  color: #64748b;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.empty-text {
  color: #64748b;
  font-size: 28rpx;
}
.empty-actions {
  display: flex;
  gap: 20rpx;
}
.retry-btn {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 44rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  border: none;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}
.retry-btn.secondary {
  background: #f3e8ff;
  color: #7c3aed;
  box-shadow: none;
}

/* Event Card — Candy Bento 奇偶马卡龙果冻卡片 */
.event-card {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  margin: 24rpx 28rpx 0;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
}
.event-card:nth-child(even),
.event-card.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.13),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}
.event-card:active {
  transform: scale(0.99);
}
.event-card.historical {
  opacity: 0.92;
}

.card-poster {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f3e8ff 0%, #ede9fe 100%);
}
.poster-img {
  width: 100%;
  height: 100%;
  display: block;
}
.poster-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c3aed;
  font-size: 28rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
}
.poster-overlay {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, rgba(147, 51, 234, 0.86) 0%, rgba(91, 33, 182, 0.88) 100%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  border: 1.5rpx solid rgba(255, 255, 255, 0.36);
  box-shadow: 0 8rpx 20rpx rgba(91, 33, 182, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.32);
  white-space: nowrap;
}
.historical-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(15, 23, 42, 0.68);
  backdrop-filter: blur(8px);
  color: #ffffff;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
}

.card-body {
  padding: 28rpx 30rpx 30rpx;
}
.card-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 14rpx;
  line-height: 1.4;
}
.card-meta {
  margin-bottom: 14rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1.5rpx solid rgba(192, 132, 252, 0.24);
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  box-shadow: inset 0 2rpx 0 #ffffff;
}
.meta-item {
  display: block;
  font-size: 25rpx;
  color: #475569;
  line-height: 1.75;
  font-weight: 500;
}
.card-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 12rpx;
  margin: 0;
  white-space: nowrap;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.24);
}
.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.counter-pill.launch-btn {
  background: #ffffff;
  color: #6d28d9;
  font-weight: 800;
  padding: 10rpx 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.14);
}
.btn-primary.signed-btn {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  box-shadow: 0 6rpx 18rpx rgba(16, 185, 129, 0.24);
}

/* 发起活动弹窗 — Candy Aurora 极光糖果卡片 */
.event-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(36, 16, 68, 0.42);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.event-modal-card {
  width: 100%;
  max-width: 670rpx;
  max-height: 84vh;
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 88% 0%, rgba(168, 85, 247, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 42%, #faf7ff 100%);
  border-radius: 44rpx;
  padding: 28rpx 34rpx 36rpx;
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow:
    0 28rpx 72rpx -12rpx rgba(109, 40, 217, 0.26),
    0 10rpx 28rpx -6rpx rgba(236, 72, 153, 0.14),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
}
.event-modal-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #3b0764;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}
.event-form-field {
  margin-bottom: 20rpx;
  padding: 22rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10), inset 0 3rpx 0 #ffffff;
}
.event-form-field:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border-color: rgba(129, 140, 248, 0.28);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12), inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}
.event-form-field:focus-within {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border-color: #fb923c;
}
.event-form-row {
  display: flex;
  gap: 16rpx;
}
.event-form-field.half {
  flex: 1;
  padding: 20rpx;
}
.event-form-label {
  display: inline-flex;
  align-items: center;
  font-size: 25rpx;
  font-weight: 800;
  color: #581c87;
  margin-bottom: 12rpx;
}
.event-form-input,
.event-form-picker {
  width: 100%;
  min-height: 82rpx;
  line-height: 82rpx;
  padding: 0 26rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 24rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}
.event-form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 26rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 26rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  box-sizing: border-box;
  line-height: 1.55;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}
.event-modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.event-modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  white-space: nowrap;
}
.event-modal-btn.cancel {
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  color: #6d28d9;
  border: 1.5rpx solid rgba(124, 58, 237, 0.28);
  box-shadow: 0 4rpx 14rpx rgba(124, 58, 237, 0.10), inset 0 2rpx 0 #ffffff;
}
.event-modal-btn.confirm {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 52%, #5b21b6 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.30),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}
.safe-bottom {
  height: 40rpx;
}
