/* pages/agreement/index.wxss */
page {
  background: #f6f5fb;
}

.page {
  padding: 24rpx;
}

.brand-header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  padding: 38rpx 34rpx 44rpx;
  margin: -24rpx -24rpx 28rpx;
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.brand-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.update-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.content,
.zs-card {
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.12) 0%, transparent 48%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 48%, #faf5ff 100%);
  border-radius: 36rpx;
  padding: 36rpx 30rpx;
  box-shadow:
    0 16rpx 40rpx -10rpx rgba(124, 58, 237, 0.14),
    0 6rpx 18rpx rgba(236, 72, 153, 0.08),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.24);
}

.section {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.24);
  box-shadow:
    0 8rpx 22rpx -6rpx rgba(236, 72, 153, 0.10),
    inset 0 2rpx 0 #ffffff;
}

.section:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border-color: rgba(129, 140, 248, 0.28);
  box-shadow:
    0 8rpx 22rpx -6rpx rgba(99, 102, 241, 0.11),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.94);
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #581c87;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 27rpx;
  color: #475569;
  line-height: 1.75;
  margin-bottom: 10rpx;
}

.section-content:last-child {
  margin-bottom: 0;
}

.email-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border: 2rpx solid rgba(251, 146, 60, 0.36);
  padding: 18rpx 26rpx;
  border-radius: 24rpx;
  color: #7c2d12;
  font-weight: 700;
  margin-top: 12rpx;
  box-shadow:
    0 8rpx 20rpx -6rpx rgba(251, 146, 60, 0.18),
    inset 0 2rpx 0 #ffffff;
}

.copy-tag {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.24);
}

.policy-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.policy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  white-space: nowrap;
}

.policy-btn::after {
  border: none;
}

.policy-btn.ghost {
  background: #ffffff;
  color: #7c3aed;
  border: 2rpx solid rgba(124, 58, 237, 0.25);
}

.policy-btn.primary {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.24);
}

.bottom-safe {
  height: 60rpx;
}
