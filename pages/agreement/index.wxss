/* pages/agreement/index.wxss */
page {
  background: #f6f5fb;
}

.page {
  padding: 24rpx;
}

.brand-header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  padding: 38rpx 34rpx 44rpx;
  margin: -24rpx -24rpx 28rpx;
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.brand-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.update-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.content,
.zs-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 34rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.section {
  margin-bottom: 40rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #7c3aed;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.section-content:last-child {
  margin-bottom: 0;
}

.email-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f3ff;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  color: #7c3aed;
  font-weight: 600;
}

.copy-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #7c3aed;
  color: #ffffff;
}

.policy-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.policy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.policy-btn::after {
  border: none;
}

.policy-btn.ghost {
  background: #ffffff;
  color: #7c3aed;
  border: 2rpx solid rgba(124, 58, 237, 0.25);
}

.policy-btn.primary {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.24);
}

.bottom-safe {
  height: 60rpx;
}
