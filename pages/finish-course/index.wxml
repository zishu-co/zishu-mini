<!-- pages/finish-course/index.wxml -->
<!-- spec: specs/miniprogram/active/001-port-finish-course.md -->
<view class="finish-page">
  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="finish-card" wx:if="{{!loading}}">
    <!-- 顶部标题 -->
    <view class="finish-header">
      <view class="congrats-icon">🎓</view>
      <view class="finish-title">恭喜你完成课程！</view>
      <view class="subtitle">《{{courseInfo.course_title}}》</view>
    </view>

    <!-- 祝福语 -->
    <view class="blessing-section">
      <text class="blessing-text">
        祝贺 {{courseInfo.user_name || '自塾学友'}} 成功学完《{{courseInfo.course_title}}》！
        愿你将所学化为笃行，在人生与事业的航程中持续创造价值。
      </text>
    </view>

    <!-- 结课通关 Step 清单 -->
    <view class="checklist-bar">
      <view class="checklist-step done">
        <view class="checklist-dot">✓</view>
        <text class="checklist-label">章节学习</text>
      </view>
      <view class="checklist-line"></view>
      <view class="checklist-step {{courseInfo.quiz_info && courseInfo.quiz_info.is_full_score ? 'done' : 'active'}}">
        <view class="checklist-dot">{{courseInfo.quiz_info && courseInfo.quiz_info.is_full_score ? '✓' : '2'}}</view>
        <text class="checklist-label">结课测验</text>
      </view>
      <view class="checklist-line"></view>
      <view class="checklist-step {{courseInfo.ark_info && courseInfo.ark_info.homework_url ? 'done' : 'active'}}">
        <view class="checklist-dot">{{courseInfo.ark_info && courseInfo.ark_info.homework_url ? '✓' : '3'}}</view>
        <text class="checklist-label">{{courseInfo.is_ark_learning ? '方舟作业' : '荣誉结课'}}</text>
      </view>
    </view>

    <!-- 测验成绩区域（quiz_info 存在时显示） -->
    <view class="quiz-section" wx:if="{{courseInfo.quiz_info}}">
      <view class="section-title">📋 结课测验</view>
      <view class="quiz-score-box {{quizScoreClass}}">
        <view class="quiz-score-inner">
          <text class="quiz-label">当前成绩</text>
          <text class="quiz-score" wx:if="{{courseInfo.quiz_info.has_taken}}">
            {{courseInfo.quiz_info.current_score}} / {{courseInfo.quiz_info.full_score}}
          </text>
          <text class="quiz-score no-attempt" wx:else>未作答</text>
          <text class="quiz-status-tag {{quizScoreClass}}">{{quizStatusText}}</text>
        </view>
      </view>
      <button class="quiz-btn" bindtap="goQuiz">
        {{courseInfo.quiz_info.has_taken ? '重新测验' : '参加测验'}}
      </button>
    </view>

    <!-- 方舟作业链接（方舟学习者填写） -->
    <view class="homework-section" wx:if="{{courseInfo.is_ark_learning}}">
      <view class="section-title">📝 方舟作业</view>
      <view class="homework-tip">请提交你的结课作业（公网可访问的文章或视频链接），由舟长审批：</view>
      <view class="homework-input-row" wx:if="{{courseInfo.ark_info && !courseInfo.ark_info.homework_url}}">
        <input
          class="homework-input"
          type="text"
          placeholder="https://..."
          value="{{homeworkUrl}}"
          bindinput="onHomeworkInput"
          confirm-type="done"
        />
        <button
          class="submit-btn"
          loading="{{hwLoading}}"
          disabled="{{hwLoading}}"
          bindtap="submitHomework"
        >提交</button>
      </view>
      <view class="homework-submitted" wx:elif="{{courseInfo.ark_info && courseInfo.ark_info.homework_url}}">
        <text class="check-icon">✓</text>
        <text>已提交：</text>
        <text class="homework-link" bindtap="stopPropagation">{{courseInfo.ark_info.homework_url}}</text>
      </view>
    </view>

    <!-- 方舟学习提示（无确认结课按钮） -->
    <view class="ark-tip" wx:if="{{courseInfo.is_ark_learning}}" bindtap="onGoArkDetail">
      <text>📌 方舟学习由舟长在方舟详情页统一为大家结课（点击进入方舟舱 ›）</text>
    </view>

    <!-- 结课证书（所有学习者均可预览与生成） -->
    <view class="certificate-section">
      <view class="section-title">🏆 荣誉结课证书</view>
      <view class="certificate-placeholder" bindtap="downloadCertificate">
        <view class="cert-content">
          <view class="cert-title">自塾荣誉结课证书</view>
          <view class="cert-serial">NO. {{certNo}}</view>
          <view class="cert-name">{{courseInfo.user_name || '自塾学友'}}</view>
          <view class="cert-course">已完成《{{courseInfo.course_title}}》全部课程学习</view>
          <view class="cert-date">{{currentDate}} · 自塾共学委员会</view>
        </view>
      </view>
      <button class="download-btn" type="primary" plain bindtap="downloadCertificate">🏅 生成与保存荣誉证书</button>
    </view>

    <!-- 确认结课按钮（单人学习特有） -->
    <view class="confirm-section" wx:if="{{!courseInfo.is_ark_learning}}">
      <button
        class="confirm-btn"
        loading="{{confirmLoading}}"
        disabled="{{confirmLoading || submitting}}"
        bindtap="confirmFinish"
      >确认结课</button>
      <view class="confirm-tip">确认后这门课将从"我的选课"列表中消失</view>
    </view>
  </view>

  <!-- 荣誉证书预览与生成弹窗 -->
  <view class="cert-modal-mask" wx:if="{{showCertModal}}" bindtap="onCloseCertModal"></view>
  <view class="cert-modal" wx:if="{{showCertModal}}">
    <view class="cert-modal-card">
      <view class="cert-modal-badge">🏅 ZISHU ACADEMY CERTIFICATE</view>
      <view class="cert-modal-title">自塾荣誉结课证书</view>
      <view class="cert-modal-serial">证书编号：{{certNo}}</view>
      <view class="cert-modal-divider"></view>
      <view class="cert-modal-recipient">{{courseInfo.user_name || '自塾学友'}}</view>
      <view class="cert-modal-body">
        在自塾以终为始共学体系中，圆满完成
        <text class="cert-modal-course">《{{courseInfo.course_title}}》</text>
        全部章节修习与闯关挑战，特颁此证，以资嘉勉。
      </view>
      <view class="cert-modal-footer">
        <view class="cert-modal-date">颁发日期：{{currentDate}}</view>
        <view class="cert-modal-seal">自塾共学\n荣誉认证</view>
      </view>
    </view>
    <view class="cert-modal-actions">
      <button class="cert-action-btn copy" bindtap="onCopyCertInfo">📋 复制证书喜报</button>
      <button class="cert-action-btn save" bindtap="onSaveCertPoster">💾 保存证书到相册</button>
    </view>
    <view class="cert-modal-close" bindtap="onCloseCertModal">关闭预览</view>
  </view>

  <!-- 离屏绘制证书 Canvas -->
  <canvas type="2d" id="certCanvas" class="offscreen-canvas"></canvas>
</view>
