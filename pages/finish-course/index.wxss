/* pages/finish-course/index.wxss */
/* spec: specs/miniprogram/active/001-port-finish-course.md */

.finish-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.finish-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  max-width: 560rpx;
  width: 100%;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.finish-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.congrats-icon {
  font-size: 96rpx;
  margin-bottom: 10rpx;
  line-height: 1;
}

.finish-title {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.subtitle {
  color: #666;
  font-size: 30rpx;
}

.blessing-section {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.blessing-text {
  color: #444;
  font-size: 28rpx;
  line-height: 1.8;
  text-align: center;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

/* 测验成绩区域 */
.quiz-section,
.homework-section {
  margin-bottom: 24rpx;
}

.quiz-score-box {
  border-radius: 12rpx;
  padding: 3rpx;
  display: inline-block;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.quiz-score-inner {
  background: #fff;
  border-radius: 10rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.quiz-label {
  color: #666;
  font-size: 28rpx;
  margin-right: 8rpx;
}

.quiz-score {
  font-size: 40rpx;
  font-weight: bold;
}

.quiz-score.no-attempt {
  color: #999;
  font-size: 30rpx;
}

.quiz-status-tag {
  font-size: 24rpx;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  margin-left: auto;
}

/* 三色样式 */
.score-none {
  background: #fff0f0;
  border: 1rpx solid #ffadc6;
}
.score-none .quiz-status-tag {
  background: #fff0f0;
  color: #e0396c;
}

.score-partial {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
}
.score-partial .quiz-status-tag {
  background: #fffbe6;
  color: #d48806;
}

.score-full {
  background: #f0fdf4;
  border: 1rpx solid #b7eb8f;
}
.score-full .quiz-status-tag {
  background: #f0fdf4;
  color: #389e0d;
}

.quiz-btn {
  width: 100%;
  margin-top: 16rpx;
  background: #fff;
  color: #667eea;
  border: 1rpx solid #667eea;
}

/* 作业输入 */
.homework-tip {
  color: #666;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.homework-input-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.homework-input {
  flex: 1;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 0 20rpx;
  height: 72rpx;
  font-size: 28rpx;
  background: #fff;
}

.submit-btn {
  background: #667eea;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  min-width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.homework-submitted {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
  flex-wrap: wrap;
}

.check-icon {
  color: #67c23a;
  font-weight: bold;
  font-size: 32rpx;
}

.homework-link {
  color: #667eea;
  word-break: break-all;
  flex: 1;
  min-width: 0;
}

/* 方舟学习提示 */
.ark-tip {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.ark-tip text {
  color: #8a6608;
  font-size: 26rpx;
}

/* 结课证书 */
.certificate-section {
  margin-bottom: 24rpx;
}

.certificate-placeholder {
  background: linear-gradient(135deg, #f5f0e8, #fff8dc);
  border: 2rpx solid #d4af37;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 16rpx;
}

.cert-content {
  text-align: center;
}

.cert-title {
  font-size: 38rpx;
  color: #8a6608;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.cert-name {
  font-size: 36rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: bold;
}

.cert-course {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.cert-date {
  font-size: 24rpx;
  color: #999;
}

.download-btn {
  width: 100%;
  background: #fff;
  color: #d4af37;
  border: 1rpx solid #d4af37;
  margin-bottom: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 确认结课 */
.confirm-section {
  text-align: center;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  background: #67c23a;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  line-height: 88rpx;
}

.confirm-tip {
  color: #999;
  font-size: 22rpx;
}

/* 加载中 */
.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
}
