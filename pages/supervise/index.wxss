.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding-top: 24rpx;
}

.hero-stats {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.22);
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 16rpx;
  padding: 22rpx 14rpx;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #7c3aed;
  line-height: 1.2;
  margin-bottom: 6rpx;
}
.stat-num.danger { color: #e94560; }
.stat-num.warning { color: #f97316; }

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 24rpx 20rpx;
  padding: 18rpx 24rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 4rpx 10rpx;
}

.list-area { padding: 0 24rpx 48rpx; }

.loading-row, .empty-row {
  text-align: center;
  padding: 80rpx 0;
  color: #9a9ab0;
  font-size: 28rpx;
}

.record-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.persons {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.person-tag {
  display: flex;
  flex-direction: column;
}

.role {
  font-size: 22rpx;
  color: #9a9ab0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #7c3aed;
}

.arrow {
  font-size: 32rpx;
  color: #a78bfa;
}

.deadline-badge {
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.deadline-badge.blue { background: rgba(59,130,246,0.10); color: #3b82f6; }
.deadline-badge.orange { background: rgba(249,115,22,0.10); color: #f97316; }
.deadline-badge.purple { background: rgba(124,58,237,0.12); color: #7c3aed; }
.deadline-badge.red { background: rgba(233,69,96,0.10); color: #e94560; }

.record-course {
  margin-bottom: 8rpx;
}

.course-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.record-chapter {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chapter-label {
  font-size: 24rpx;
  color: #9a9ab0;
}

.chapter-title {
  font-size: 24rpx;
  color: #666;
  flex: 1;
}

.serial {
  font-size: 24rpx;
  color: #16a34a;
  font-weight: 600;
}