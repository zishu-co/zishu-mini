<view class="page">
  <!-- 品牌紫统计看板 -->
  <view class="hero-stats">
    <view class="stats-row">
      <view class="stat-card">
        <text class="stat-num">{{listData.length}}</text>
        <text class="stat-label">总记录</text>
      </view>
      <view class="stat-card">
        <text class="stat-num danger">{{overdueCount}}</text>
        <text class="stat-label">已逾期</text>
      </view>
      <view class="stat-card">
        <text class="stat-num warning">{{nearCount}}</text>
        <text class="stat-label">即将到期</text>
      </view>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list-area">
    <view wx:if="{{loading}}">
      <view class="loading-row"><text>加载中...</text></view>
    </view>
    <view wx:elif="{{listData.length === 0}}">
      <view class="empty-row"><text>暂无学习记录</text></view>
    </view>
    <view wx:else>
      <view class="record-card" wx:for="{{listData}}" wx:key="sele_id">
        <view class="record-top">
          <view class="persons">
            <view
              class="person-tag"
              bindtap="onNudgePeer"
              data-userid="{{item.user_id}}"
              data-username="{{item.user_name}}"
              data-course="{{item.course_title}}"
            >
              <text class="role">🌱 塾生（点此加油）</text>
              <text class="name">{{item.user_name}}</text>
            </view>
            <text class="arrow">›</text>
            <view class="person-tag">
              <text class="role">💎 塾师</text>
              <text class="name">{{item.shushi_name}}</text>
            </view>
          </view>
          <view class="deadline-badge {{item._deadlineClass}}">
            <text>{{item._deadlineStr}}</text>
          </view>
        </view>
        <view
          class="record-course"
          bindtap="onGoCourse"
          data-courseid="{{item.course_id}}"
        >
          <text class="course-title">《{{item.course_title}}》 ›</text>
        </view>
        <view class="record-chapter">
          <text class="chapter-label">当前章节：</text>
          <text class="chapter-title">{{item.chapter_title}}</text>
          <text class="serial">第{{item.current_serial}}次</text>
        </view>
      </view>
    </view>
  </view>
</view>