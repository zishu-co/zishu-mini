<view class="page">
  <!-- 顶部统计与筛选栏 -->
  <view class="top-bar">
    <view class="top-summary">
      <text class="summary-count">{{listData.length}}</text>
      <text class="summary-label">个结项项目</text>
    </view>
    <view class="filter-row">
      <button
        class="filter-btn {{!showMine ? 'active' : ''}}"
        bindtap="toggleFilter"
        data-mode="all"
      >
        全部项目
      </button>
      <button
        class="filter-btn {{showMine ? 'active' : ''}}"
        bindtap="toggleFilter"
        data-mode="mine"
      >
        我的结项
      </button>
    </view>
  </view>

  <!-- 实时关键词搜索 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      type="text"
      placeholder="搜索结项项目标题、编号、执行人或塾师..."
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
  </view>

  <!-- 列表 -->
  <view class="list-area">
    <view wx:if="{{loading}}">
      <view class="loading-row"><text>加载中...</text></view>
    </view>
    <view wx:elif="{{filteredList.length === 0}}">
      <view class="empty-row"><text>{{searchKeyword ? '未找到匹配的结项项目' : '暂无结项记录'}}</text></view>
    </view>
    <view wx:else>
      <view
        class="project-card"
        wx:for="{{filteredList}}"
        wx:key="id"
        bindtap="onProjectTap"
        data-id="{{item.id}}"
      >
        <view class="project-top">
          <text class="project-serial">{{item.task_serial}}</text>
          <text class="project-title">{{item.title}}</text>
          <text class="project-arrow">›</text>
        </view>
        <view class="project-persons">
          <view class="person-item">
            <text class="person-role">执行人</text>
            <text class="person-name">{{item.taker}}</text>
          </view>
          <view class="person-item">
            <text class="person-role">塾师</text>
            <text class="person-name">{{item.shushi}}</text>
          </view>
        </view>
        <view class="project-meta">
          <view class="meta-item">
            <text class="meta-label">开始</text>
            <text class="meta-value">{{item._startDate}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-label">截止</text>
            <text class="meta-value deadline">{{item._deadline}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-label">计划</text>
            <text class="meta-value">{{item.planed_hour}}h</text>
          </view>
          <view class="meta-item">
            <text class="meta-label">实际</text>
            <text class="meta-value accent">{{item.actual_hour}}h</text>
          </view>
        </view>
        <view class="project-progress" wx:if="{{item.half_progress || item._finishDate}}">
          <text class="progress-label" wx:if="{{item.half_progress}}">半程进度：{{item.half_progress}}</text>
          <text class="progress-value" wx:if="{{item._finishDate}}">✓ 结项于 {{item._finishDate}}</text>
        </view>
      </view>
    </view>
  </view>
</view>