.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding-top: 24rpx;
}

.top-bar {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 24rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.22);
}

.top-summary {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.summary-count {
  font-size: 48rpx;
  font-weight: 800;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.filter-row {
  display: flex;
  gap: 12rpx;
}

.filter-btn {
  margin: 0;
  padding: 10rpx 26rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  border-radius: 999rpx;
  border: none;
  line-height: 1.5;
}

.filter-btn::after {
  border: none;
}

.filter-btn.active {
  background: #fff;
  color: #7c3aed;
  font-weight: 700;
}

.list-area {
  padding: 0 24rpx 48rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 80rpx 0;
  color: #9a9ab0;
  font-size: 28rpx;
}

.project-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.project-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.project-serial {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  background: rgba(124, 58, 237, 0.1);
  color: #7c3aed;
  border-radius: 100rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.project-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
}

.project-arrow {
  font-size: 36rpx;
  color: #a78bfa;
  flex-shrink: 0;
}

.project-persons {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.person-item {
  display: flex;
  flex-direction: column;
}

.person-role {
  font-size: 22rpx;
  color: #9a9ab0;
  margin-bottom: 2rpx;
}

.person-name {
  font-size: 26rpx;
  color: #7c3aed;
  font-weight: 600;
}

.project-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-label {
  font-size: 22rpx;
  color: #9a9ab0;
  margin-bottom: 2rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #1a1a2e;
  font-weight: 500;
}

.meta-value.deadline {
  color: #f97316;
}

.meta-value.accent {
  color: #16a34a;
}

.project-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f5f9;
}

.progress-label {
  font-size: 24rpx;
  color: #9a9ab0;
}

.progress-value {
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 600;
}