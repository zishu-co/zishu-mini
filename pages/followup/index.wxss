.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-top: 0;
}

.top-bar {
  position: relative;
  overflow: hidden;
  margin: 0 0 24rpx;
  padding: 36rpx 30rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  color: #fff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.top-bar-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.top-badge {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  opacity: 0.85;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.top-title {
  font-size: 36rpx;
  font-weight: 800;
}

.hero-stats-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 22rpx;
  padding: 18rpx 12rpx;
  backdrop-filter: blur(8px);
}

.hero-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-stat-num {
  font-size: 34rpx;
  font-weight: 800;
}

.hero-stat-label {
  font-size: 20rpx;
  opacity: 0.88;
  margin-top: 4rpx;
  white-space: nowrap;
}

.hero-stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.24);
}

.filter-row {
  display: flex;
  gap: 8rpx;
  flex-wrap: nowrap;
  justify-content: flex-end;
}

.filter-btn {
  margin: 0;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: rgba(255, 255, 255, 0.94);
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 999rpx;
  line-height: 1.4;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.filter-btn::after {
  border: none;
}

.filter-btn.active {
  background: #ffffff;
  color: #6d28d9;
  font-weight: 800;
  border-color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.16);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 24rpx 20rpx;
  padding: 18rpx 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.1);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.search-clear {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 4rpx 10rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.list-area {
  padding: 0 24rpx 48rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 80rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}

.project-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.project-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.project-serial {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  background: rgba(124, 58, 237, 0.1);
  color: #7c3aed;
  border-radius: 100rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.project-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
}

.project-arrow {
  font-size: 36rpx;
  color: #a78bfa;
  flex-shrink: 0;
}

.project-persons {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.person-item {
  display: flex;
  flex-direction: column;
}

.person-role {
  font-size: 22rpx;
  color: #9a9ab0;
  margin-bottom: 2rpx;
}

.person-name {
  font-size: 26rpx;
  color: #7c3aed;
  font-weight: 600;
}

.project-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-label {
  font-size: 22rpx;
  color: #9a9ab0;
  margin-bottom: 2rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #1a1a2e;
  font-weight: 500;
}

.meta-value.deadline {
  color: #f97316;
}

.meta-value.accent {
  color: #16a34a;
}

.efficiency-pill {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.efficiency-pill.eff-good {
  background: #ecfdf5;
  color: #059669;
}

.efficiency-pill.eff-deep {
  background: #f5f3ff;
  color: #7c3aed;
}

.hour-progress-wrap {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
}

.hour-progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.hour-progress-label {
  font-size: 22rpx;
  color: #64748b;
}

.hour-progress-val {
  font-size: 22rpx;
  font-weight: 700;
  color: #7c3aed;
}

.hour-progress-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.hour-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #a855f7 0%, #7c3aed 100%);
}

.empty-emoji {
  display: block;
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.project-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.progress-label {
  font-size: 22rpx;
  color: #64748b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-chip {
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.action-chip.greet {
  background: #f5f3ff;
  color: #7c3aed;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
}

.action-chip.detail {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #5b21b6 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.32);
}