/* pages/learn-sheet/index.wxss */
/* 学习单旗舰版样式 */

page {
  background: #f6f4fa;
  color: #1a1a2e;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 80rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #8b859e;
  font-size: 28rpx;
}

/* ========== Hero 概览卡 ========== */
.sheet-hero {
  background: linear-gradient(135deg, #6d28d9 0%, #7c3aed 48%, #aa00ff 100%);
  border-radius: 28rpx;
  padding: 34rpx 32rpx 30rpx;
  color: #fff;
  box-shadow: 0 14rpx 36rpx rgba(124, 58, 237, 0.28);
}

.sheet-hero__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-hero__badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.16);
  margin-bottom: 8rpx;
}

.sheet-hero__title {
  font-size: 36rpx;
  font-weight: 800;
}

.sheet-rate-pill {
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sheet-rate-pill__num {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.1;
}

.sheet-rate-pill__label {
  font-size: 20rpx;
  opacity: 0.85;
}

.sheet-progress-track {
  width: 100%;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
  margin-bottom: 26rpx;
}

.sheet-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #fde047 0%, #ffffff 100%);
  transition: width 0.3s ease;
}

.sheet-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  text-align: center;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  padding: 18rpx 12rpx;
}

.sheet-stat-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sheet-stat-num {
  font-size: 36rpx;
  font-weight: 800;
}

.sheet-stat-label {
  font-size: 22rpx;
  opacity: 0.88;
}

.sheet-stat-divider {
  width: 2rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.22);
}

.sheet-buddy-bar {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-buddy-tip {
  font-size: 24rpx;
  opacity: 0.95;
  flex: 1;
}

.sheet-greet-btn {
  margin: 0;
  padding: 0 26rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 29rpx;
  background: #fff;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.sheet-greet-btn::after {
  border: none;
}

/* ========== 分段筛选 Tabs ========== */
.sheet-tabs {
  display: flex;
  background: #ebe5f7;
  border-radius: 22rpx;
  padding: 8rpx;
  gap: 6rpx;
}

.sheet-tab {
  flex: 1;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b6380;
  transition: all 0.2s ease;
}

.sheet-tab--active {
  background: #ffffff;
  color: #7c3aed;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(124, 58, 237, 0.12);
}

/* ========== 卡片区块 ========== */
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 26, 46, 0.04);
  border: 1rpx solid rgba(170, 0, 255, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 18rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f3f0fa;
}

/* Camp 卡 */
.camp-card {
  padding: 20rpx;
  background: #faf8ff;
  border-radius: 18rpx;
  border: 1rpx solid rgba(170, 0, 255, 0.1);
  margin-bottom: 18rpx;
}

.camp-card:last-child {
  margin-bottom: 0;
}

.camp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.camp-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #7c3aed;
}

.camp-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #aa00ff;
  background: rgba(170, 0, 255, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.camp-meta,
.camp-must {
  font-size: 24rpx;
  color: #6b6380;
  margin-bottom: 6rpx;
}

.course-list {
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(170, 0, 255, 0.1);
  padding-top: 8rpx;
}

/* 课程项 */
.course-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid #f3f0fa;
}

.course-item:last-child {
  border-bottom: none;
}

.course-item:active {
  opacity: 0.8;
}

.course-item.standalone {
  padding: 22rpx 8rpx;
}

.course-item.standalone.done {
  opacity: 0.78;
}

.course-item__main {
  flex: 1;
  min-width: 0;
}

.course-item__arrow {
  font-size: 34rpx;
  color: #a78bfa;
  flex-shrink: 0;
}

.course-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 10rpx;
}

.course-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 24rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 700;
}

.status-learning {
  background: rgba(170, 0, 255, 0.12);
  color: #aa00ff;
}

.status-done {
  background: #d1fae5;
  color: #059669;
}

.status-not-started {
  background: #f3f4f6;
  color: #6b7280;
}

.deadline {
  font-size: 22rpx;
  color: #8b859e;
}

/* 空状态 */
.empty-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(26, 26, 46, 0.04);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 18rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 25rpx;
  color: #8b859e;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.empty-cta-btn {
  margin: 0;
  padding: 0 52rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 22rpx rgba(170, 0, 255, 0.28);
}

.empty-cta-btn::after {
  border: none;
}
