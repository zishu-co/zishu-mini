<view class="page">
  <view class="header">
    <text class="title">师生关系</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num">{{shushiCount}}</text>
      <text class="stat-label">塾师人数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{shushengCount}}</text>
      <text class="stat-label">塾生人数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{listData.length}}</text>
      <text class="stat-label">关系总数</text>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list-area">
    <view wx:if="{{loading}}">
      <view class="loading-row"><text>加载中...</text></view>
    </view>
    <view wx:elif="{{listData.length === 0}}">
      <view class="empty-row"><text>暂无师生关系</text></view>
    </view>
    <view wx:else>
      <view class="relation-card" wx:for="{{listData}}" wx:key="id">
        <view class="relation-top">
          <view class="person-info">
            <text class="person-role">塾师</text>
            <text class="person-name">{{item.shushi_name}}</text>
          </view>
          <text class="arrow">›</text>
          <view class="person-info">
            <text class="person-role">塾生</text>
            <text class="person-name">{{item.shusheng_name}}</text>
          </view>
        </view>
        <view class="relation-course" wx:if="{{item.course_title}}">
          <text class="course-label">课程：</text>
          <text class="course-title">{{item.course_title}}</text>
        </view>
        <view class="relation-meta">
          <text class="status-tag {{item.status === '活跃' ? 'active' : ''}}">{{item.status}}</text>
          <text class="meta-text" wx:if="{{item.start_time}}">{{item.start_time.slice(0,10)}}</text>
        </view>
      </view>
    </view>
  </view>
</view>