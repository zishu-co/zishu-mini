<view class="page">
  <!-- 统计卡片 -->
  <view class="hero-stats">
    <view class="stats-row">
      <view class="stat-card">
        <text class="stat-num">{{shushiCount}}</text>
        <text class="stat-label">领航塾师</text>
      </view>
      <view class="stat-card">
        <text class="stat-num">{{shushengCount}}</text>
        <text class="stat-label">在学塾生</text>
      </view>
      <view class="stat-card">
        <text class="stat-num">{{listData.length}}</text>
        <text class="stat-label">结对共学数</text>
      </view>
    </view>
  </view>

  <!-- 实时关键词搜索 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      type="text"
      placeholder="搜索塾师、塾生或共修课程名称..."
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
  </view>

  <!-- 列表 -->
  <view class="list-area">
    <view wx:if="{{loading}}">
      <view class="loading-row"><text>加载师生结对关系中...</text></view>
    </view>
    <view wx:elif="{{filteredList.length === 0}}">
      <view class="empty-row"><text>{{searchKeyword ? '未找到匹配的师生结对关系' : '暂无师生结对关系'}}</text></view>
    </view>
    <view wx:else>
      <view class="relation-card" wx:for="{{filteredList}}" wx:key="id">
        <view class="relation-top">
          <view
            class="person-info"
            bindtap="onGreetMentor"
            data-userid="{{item.shushi_id}}"
            data-name="{{item.shushi_name}}"
            data-course="{{item.course_title}}"
          >
            <text class="person-role">💎 塾师（点击可约聊）</text>
            <text class="person-name">{{item.shushi_name}}</text>
          </view>
          <text class="arrow">🤝</text>
          <view class="person-info">
            <text class="person-role">🌱 塾生</text>
            <text class="person-name">{{item.shusheng_name}}</text>
          </view>
        </view>
        <view
          class="relation-course"
          wx:if="{{item.course_title}}"
          bindtap="onGoCourse"
          data-courseid="{{item.course_id}}"
        >
          <text class="course-label">共修课程：</text>
          <text class="course-title">《{{item.course_title}}》 ›</text>
        </view>
        <view class="relation-meta">
          <text class="status-tag {{item._isActive ? 'active' : ''}}">{{item.status || '结对中'}}</text>
          <text class="meta-text" wx:if="{{item._startDate}}">结对日期：{{item._startDate}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
