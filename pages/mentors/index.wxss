.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-top: 0;
}

.hero-stats {
  position: relative;
  overflow: hidden;
  margin: 0 0 24rpx;
  padding: 36rpx 28rpx 40rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 22rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.08), inset 0 2rpx 0 #ffffff;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #6d28d9;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

.filter-pills {
  display: flex;
  gap: 10rpx;
  margin: 0 24rpx 20rpx;
  padding: 8rpx;
  background: rgba(243, 232, 255, 0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 999rpx;
  border: 2rpx solid rgba(168, 85, 247, 0.14);
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.08);
}

.filter-pill {
  flex: 1;
  text-align: center;
  padding: 14rpx 16rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 700;
  border: none;
  box-shadow: none;
  transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.filter-pill.active {
  background: linear-gradient(135deg, #a855f7 0%, #9333ea 52%, #7c3aed 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.26), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 24rpx 20rpx;
  padding: 18rpx 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.1);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 4rpx 10rpx;
}

.list-area {
  padding: 0 24rpx 48rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 80rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}

.relation-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.relation-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.person-info {
  flex: 1;
}

.person-role {
  display: block;
  font-size: 22rpx;
  color: #9a9ab0;
  margin-bottom: 4rpx;
}

.person-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.arrow {
  font-size: 36rpx;
  color: #a78bfa;
  flex-shrink: 0;
}

.relation-course {
  margin-bottom: 12rpx;
}

.course-label {
  font-size: 24rpx;
  color: #9a9ab0;
}

.course-title {
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 500;
}

.relation-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f5f9;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  background: #f1f5f9;
  color: #64748b;
}

.status-tag.active {
  background: rgba(34,197,94,0.10);
  color: #16a34a;
}

.meta-text {
  font-size: 24rpx;
  color: #94a3b8;
  flex: 1;
}

.empty-text {
  display: block;
  margin-bottom: 20rpx;
}

.reset-btn {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  border: 1.5rpx solid rgba(124, 58, 237, 0.22);
  color: #6d28d9;
  font-size: 24rpx;
  font-weight: 700;
}

.relation-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: auto;
}

.action-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.action-chip.secondary {
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  color: #6d28d9;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
}

.action-chip.danger {
  background: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
}

.action-chip.primary {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.32);
}