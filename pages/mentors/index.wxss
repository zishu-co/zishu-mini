.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding-top: 24rpx;
}

.hero-stats {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.22);
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 16rpx;
  padding: 22rpx 14rpx;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #7c3aed;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

.list-area {
  padding: 0 24rpx 48rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 80rpx 0;
  color: #9a9ab0;
  font-size: 28rpx;
}

.relation-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.relation-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.person-info {
  flex: 1;
}

.person-role {
  display: block;
  font-size: 22rpx;
  color: #9a9ab0;
  margin-bottom: 4rpx;
}

.person-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.arrow {
  font-size: 36rpx;
  color: #a78bfa;
  flex-shrink: 0;
}

.relation-course {
  margin-bottom: 12rpx;
}

.course-label {
  font-size: 24rpx;
  color: #9a9ab0;
}

.course-title {
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 500;
}

.relation-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f5f9;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  background: #f1f5f9;
  color: #64748b;
}

.status-tag.active {
  background: rgba(34,197,94,0.10);
  color: #16a34a;
}

.meta-text {
  font-size: 24rpx;
  color: #94a3b8;
}