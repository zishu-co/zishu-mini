/* pages/agent/index.wxss */
page {
  height: 100%;
  background: #f6f5fb;
}

.agent-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f5fb;
}

/* 顶部 AI 教练状态栏 */
.agent-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 28rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 36rpx 36rpx;
  color: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(91, 33, 182, 0.24);
}

.agent-topbar-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.agent-topbar-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.agent-topbar-info {
  display: flex;
  flex-direction: column;
}

.agent-topbar-title {
  font-size: 30rpx;
  font-weight: 800;
}

.agent-topbar-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 2rpx;
}

.status-dot {
  color: #4ade80;
  font-size: 18rpx;
}

.agent-clear-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 28rpx 32rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.assistant-avatar {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}

.user-avatar {
  background: #ede9fe;
}

.message-bubble {
  max-width: 72%;
  padding: 22rpx 28rpx;
  border-radius: 26rpx;
  word-break: break-all;
}

.message-bubble.assistant {
  background: #ffffff;
  margin-left: 20rpx;
  border-top-left-radius: 8rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.05);
}

.message-bubble.user {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #fff;
  margin-right: 20rpx;
  border-top-right-radius: 8rpx;
  box-shadow: 0 8rpx 22rpx rgba(124, 58, 237, 0.24);
}

.message-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

.message-bubble.user .message-text {
  color: #fff;
}

.bubble-action-btn {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 1rpx solid rgba(124, 58, 237, 0.24);
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
}

.message-meta-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 8rpx;
}

.copy-hint {
  font-size: 18rpx;
  color: #b4b4c7;
}

.message-time {
  display: block;
  font-size: 20rpx;
  color: #999;
  text-align: right;
}

.message-bubble.user .message-time {
  color: rgba(255, 255, 255, 0.78);
}

/* 加载动画 */
.loading-bubble {
  min-width: 80rpx;
}

.loading-dots {
  font-size: 28rpx;
  color: #7c3aed;
  letter-spacing: 4rpx;
  animation: blink 1.2s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* AI 目标采纳浮条 */
.goal-adopt-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 12rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.3);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.12);
}

.goal-adopt-left {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.goal-adopt-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: #6d28d9;
  background: rgba(124, 58, 237, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-bottom: 6rpx;
}

.goal-adopt-text {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-adopt-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.25);
}

/* 快捷气泡栏 */
.prompt-chips-bar {
  display: flex;
  white-space: nowrap;
  padding: 14rpx 24rpx;
  background: #faf8ff;
  border-top: 1rpx solid rgba(124, 58, 237, 0.08);
}

.prompt-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 1rpx solid rgba(124, 58, 237, 0.22);
  color: #6d28d9;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(124, 58, 237, 0.06);
}

.prompt-chip:active {
  background: #f3e8ff;
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #f1f5f9;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.voice-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.voice-btn.recording {
  background: #ede9fe;
}

.voice-btn.cancel {
  background: #ffe0e0;
}

.voice-icon {
  font-size: 36rpx;
}

.voice-hint {
  font-size: 16rpx;
  color: #6d28d9;
  margin-top: 2rpx;
}

.text-input {
  flex: 1;
  height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 40rpx;
  padding: 0 32rpx;
  margin: 0 16rpx;
  font-size: 30rpx;
}

.send-btn {
  width: 108rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #94a3b8;
}

.send-btn.active {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.25);
}
