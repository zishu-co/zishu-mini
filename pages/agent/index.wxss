/* pages/agent/index.wxss */
page {
  height: 100%;
  background: var(--bg-page, #f8f5ff);
  background-image: var(--bg-page-gradient);
}

.agent-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page-gradient, linear-gradient(165deg, #fdf2f8 0%, #f3e8ff 38%, #eef2ff 72%, #f0f9ff 100%));
}

/* 顶部 AI 教练状态栏 */
.agent-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 28rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 36rpx 36rpx;
  color: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(91, 33, 182, 0.24);
}

.agent-topbar-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.agent-topbar-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.agent-topbar-info {
  display: flex;
  flex-direction: column;
}

.agent-topbar-title {
  font-size: 30rpx;
  font-weight: 800;
}

.agent-topbar-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 2rpx;
}

.status-dot {
  color: #4ade80;
  font-size: 18rpx;
}

.agent-clear-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 28rpx 32rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.assistant-avatar {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}

.user-avatar {
  background: #ede9fe;
}

.message-bubble {
  max-width: 72%;
  padding: 24rpx 30rpx;
  border-radius: 32rpx;
  word-break: break-all;
}

.message-bubble.assistant {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  margin-left: 20rpx;
  border-top-left-radius: 10rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 12rpx 28rpx -8rpx rgba(236, 72, 153, 0.12),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
}

.message-bubble.user {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 52%, #5b21b6 100%);
  color: #fff;
  margin-right: 20rpx;
  border-top-right-radius: 10rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.28);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.message-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

.message-bubble.user .message-text {
  color: #fff;
}

.bubble-action-btn {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 1rpx solid rgba(124, 58, 237, 0.24);
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
}

.message-meta-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 8rpx;
}

.copy-hint {
  font-size: 18rpx;
  color: #b4b4c7;
}

.message-time {
  display: block;
  font-size: 20rpx;
  color: #999;
  text-align: right;
}

.message-bubble.user .message-time {
  color: rgba(255, 255, 255, 0.78);
}

/* 加载动画 */
.loading-bubble {
  min-width: 80rpx;
}

.loading-dots {
  font-size: 28rpx;
  color: #7c3aed;
  letter-spacing: 4rpx;
  animation: blink 1.2s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* AI 目标采纳浮条 */
.goal-adopt-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 12rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.3);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.12);
}

.goal-adopt-left {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.goal-adopt-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: #6d28d9;
  background: rgba(124, 58, 237, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-bottom: 6rpx;
}

.goal-adopt-text {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-adopt-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.25);
}

/* 快捷气泡栏 */
.prompt-chips-bar {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: rgba(255, 250, 254, 0.88);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.prompt-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx !important;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.28);
  color: #6d28d9;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow:
    0 6rpx 16rpx -4rpx rgba(236, 72, 153, 0.12),
    inset 0 2rpx 0 #ffffff;
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
}

.prompt-chip:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%) !important;
  border-color: rgba(129, 140, 248, 0.30) !important;
  color: #4338ca;
}

.prompt-chip:active {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%) !important;
  border-color: #fb923c !important;
  color: #9a3412;
  transform: scale(0.95);
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: linear-gradient(180deg, #fffafe 0%, #faf5ff 100%);
  border-top: 2rpx solid rgba(244, 114, 182, 0.24);
  box-shadow:
    0 -10rpx 32rpx rgba(109, 40, 217, 0.08),
    inset 0 3rpx 0 #ffffff;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}

.voice-btn {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.10), inset 0 2rpx 0 #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.16s ease, background 0.2s;
}

.voice-btn.recording {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border-color: #fb923c;
}

.voice-btn.cancel {
  background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
  border-color: rgba(225, 29, 72, 0.32);
}

.voice-icon {
  font-size: 36rpx;
}

.voice-hint {
  font-size: 16rpx;
  color: #6d28d9;
  margin-top: 2rpx;
}

.text-input {
  flex: 1;
  height: 82rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(192, 132, 252, 0.32);
  border-radius: 999rpx;
  padding: 0 32rpx;
  margin: 0 16rpx;
  font-size: 28rpx;
  color: #1e1b4b;
  box-shadow:
    inset 0 2rpx 6rpx rgba(147, 51, 234, 0.05),
    0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.send-btn {
  width: 116rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 27rpx;
  font-weight: 700;
  color: #8b5cf6;
  box-shadow: inset 0 2rpx 0 #ffffff;
}

.send-btn.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 52%, #5b21b6 100%);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.28);
  box-shadow:
    0 8rpx 20rpx rgba(124, 58, 237, 0.30),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}
