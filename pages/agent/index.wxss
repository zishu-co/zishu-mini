/* pages/agent/index.wxss */
page {
  height: 100%;
  background: #f5f5f5;
}

.agent-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.assistant-avatar {
  background: linear-gradient(135deg, #aa00ff, #6c2aff);
}

.user-avatar {
  background: #e8e8e8;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  word-break: break-all;
}

.message-bubble.assistant {
  background: #ffffff;
  margin-left: 20rpx;
  border-top-left-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.message-bubble.user {
  background: linear-gradient(135deg, #aa00ff, #6c2aff);
  color: #fff;
  margin-right: 20rpx;
  border-top-right-radius: 8rpx;
}

.message-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

.message-bubble.user .message-text {
  color: #fff;
}

.message-time {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
}

/* 加载动画 */
.loading-bubble {
  min-width: 80rpx;
}

.loading-dots {
  font-size: 28rpx;
  color: #aa00ff;
  letter-spacing: 4rpx;
  animation: blink 1.2s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.voice-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.voice-btn.recording {
  background: #f8e6ff;
}

.voice-btn.cancel {
  background: #ffe0e0;
}

.voice-icon {
  font-size: 36rpx;
}

.voice-hint {
  font-size: 16rpx;
  color: #aa00ff;
  margin-top: 2rpx;
}

.text-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 32rpx;
  margin: 0 16rpx;
  font-size: 30rpx;
}

.send-btn {
  width: 100rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #999;
}

.send-btn.active {
  background: linear-gradient(135deg, #aa00ff, #6c2aff);
  color: #fff;
}
