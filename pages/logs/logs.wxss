page {
  background-color: #f6f5fb;
}

.logs-page {
  min-height: 100vh;
  padding-top: 0;
}

.brand-header {
  position: relative;
  overflow: hidden;
  margin: 0 0 20rpx;
  padding: 36rpx 32rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.brand-header-top {
  display: flex;
  flex-direction: column;
}

.brand-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.brand-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.88;
}

.log-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.log-action-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.log-action-btn.danger {
  background: rgba(239, 68, 68, 0.35);
  border-color: rgba(252, 165, 165, 0.45);
}

.empty-logs {
  justify-content: center;
  padding: 48rpx 28rpx;
  color: #64748b;
}

.empty-logs-text {
  font-size: 26rpx;
  color: #94a3b8;
}

.log-list {
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx;
  align-items: stretch;
  box-sizing: border-box;
}

.log-item,
.zs-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 0 16rpx 0;
  padding: 26rpx 30rpx;
  background: #ffffff;
  border-radius: 22rpx;
  font-size: 26rpx;
  color: #334155;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.05);
  border-left: 8rpx solid #7c3aed;
}

.log-seq {
  font-weight: 700;
  color: #7c3aed;
}

.log-date {
  color: #475569;
}
