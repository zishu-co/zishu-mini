/* pages/learn/index.wxss */

page {
  background-color: #f5f5f5;
  font-size: 30rpx;
}

.page {
  padding: 16rpx 20rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* 快速入口 */
.quick-btns {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.quick-btn {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 22rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.quick-btn.primary {
  background: linear-gradient(135deg, #aa00ff, #c6a0ff);
  color: white;
}
.quick-icon {
  font-size: 42rpx;
}
.quick-text {
  font-size: 30rpx;
  font-weight: 600;
}

/* 登录提示 */
.login-tip {
  margin-bottom: 20rpx;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: #666;
  font-size: 36rpx;
}
.login-tip-text {
  text-align: center;
  font-size: 36rpx;
  color: #555;
}
.login-btn {
  background: #aa00ff;
  color: white;
  font-size: 30rpx;
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  border: none;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 36rpx;
}

/* Section */
.section {
  margin-bottom: 20rpx;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  border-left: 6rpx solid #aa00ff;
  padding-left: 16rpx;
}
.section-tip {
  font-size: 30rpx;
  color: #999;
}

/* 课程卡片 */
.course-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.course-info {
  margin-bottom: 16rpx;
}
.course-name {
  font-size: 42rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}
.course-meta {
  font-size: 32rpx;
  color: #888;
  margin-top: 4rpx;
}
.chapter-label {
  color: #555;
}
.course-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}
.mentor-tag {
  background: #f3e8ff;
  color: #aa00ff;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

/* 课程列表项 */
.course-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.course-item.selected {
  border: 2rpx solid #aa00ff;
  background: #f9f0ff;
}
.course-item-left {
  flex: 1;
}
.course-item-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}
.course-item-meta {
  font-size: 32rpx;
  color: #888;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.course-item-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}
.select-btn {
  background: #aa00ff;
  color: white;
  font-size: 30rpx;
  padding: 14rpx 30rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}
.select-btn.selected {
  background: #ff6b6b;
}
.select-btn.disabled {
  background: #c0c0c0;
  color: #888;
}

/* 通用操作按钮 */
.action-btn {
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  text-align: center;
  border: 2rpx solid transparent;
}
.action-btn.primary {
  background: linear-gradient(135deg, #aa00ff, #c6a0ff);
  color: white;
}
.action-btn.secondary {
  background: #f0f0f0;
  color: #555;
}
.action-btn.finish {
  background: linear-gradient(135deg, #67c23a, #85ce61);
  color: white;
}
.action-btn.outline {
  background: transparent;
  color: #aa00ff;
  border-color: #aa00ff;
}
.action-btn.ark {
  background: #aa00ff;
  color: #fff;
}

/* 截止日期颜色 */
.deadline-orange { color: #f59e0b; font-weight: 500; }
.deadline-blue { color: #3b82f6; font-weight: 500; }
.deadline-red { color: #ef4444; font-weight: 500; }
.deadline-brand { color: #aa00ff; font-weight: 500; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 36rpx;
}

/* 安全区 */
.safe-bottom {
  height: 120rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: white;
  border-radius: 20rpx;
  z-index: 101;
  overflow: hidden;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.modal-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.modal-close {
  font-size: 32rpx;
  color: #999;
  padding: 0 10rpx;
}
.modal-body {
  padding: 24rpx 30rpx;
}

/* 塾师列表 */
.mentor-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.mentor-item:last-child {
  border-bottom: none;
}
.mentor-name {
  font-size: 32rpx;
  color: #333;
}
.mentor-select-btn {
  background: #aa00ff;
  color: white;
  font-size: 30rpx;
  padding: 12rpx 26rpx;
  border-radius: 24rpx;
}
.mentor-empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 36rpx;
}

/* 申报表单 */
.report-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 36rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}
.input-row {
  margin-bottom: 20rpx;
}
.input-label {
  font-size: 36rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}
.input-field {
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 32rpx;
  background: #fafafa;
}
.input-tip {
  font-size: 30rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 20rpx;
}
