/* pages/learn/index.wxss */

page {
  background-color: #f5f5f5;
  font-size: 30rpx;
}

/* Banner */
.banner {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  padding: 44rpx 32rpx 64rpx;
  color: white;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.2);
}
.banner-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.banner-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}
.banner-sub {
  font-size: 26rpx;
  opacity: 0.9;
}
.banner-stat-pill {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(8rpx);
  padding: 8rpx 22rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  flex-shrink: 0;
}

/* 快捷入口 */
.quick-btns {
  display: flex;
  gap: 14rpx;
  padding: 0 24rpx;
  margin-top: -36rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 2;
}
.quick-btn {
  flex: 1;
  background: white;
  border-radius: 20rpx;
  padding: 22rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.15s ease;
}
.quick-btn:active {
  transform: scale(0.98);
}
.quick-btn.primary {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(160, 0, 255, 0.25);
}
.quick-icon {
  font-size: 38rpx;
}
.quick-text {
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* 登录提示 */
.login-tip {
  margin: 20rpx 30rpx;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #666;
  font-size: 30rpx;
}
.login-btn {
  background: #aa00ff;
  color: white;
  font-size: 28rpx;
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  border: none;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 30rpx;
}

/* Section */
.section {
  margin: 20rpx 30rpx;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  border-left: 6rpx solid #aa00ff;
  padding-left: 16rpx;
}
.section-tip {
  font-size: 26rpx;
  color: #999;
}

/* 课程卡片 */
.course-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.course-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.course-info {
  flex: 1;
}
.course-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}
.course-meta {
  font-size: 28rpx;
  color: #888;
  margin-top: 4rpx;
}
.chapter-label {
  color: #555;
}
.chapter-label.finish-ready {
  color: #d97706;
  font-weight: 600;
}
.action-btn.finish-btn {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(245, 158, 11, 0.3);
}
.course-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}
.mentor-tag {
  background: #f3e8ff;
  color: #aa00ff;
  font-size: 28rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}
.no-mentor {
  font-size: 28rpx;
  color: #aa00ff;
  border: 1rpx solid #aa00ff;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
}

.ark-link {
  font-size: 28rpx;
  color: #fff;
  background: #aa00ff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 8rpx;
}
.course-card-bottom {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

/* 课程搜索与筛选面板 */
.course-filter-panel {
  margin-bottom: 20rpx;
}
.course-search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.course-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a2e;
  height: 72rpx;
}
.search-clear {
  font-size: 26rpx;
  color: #9ca3af;
  padding: 8rpx 12rpx;
}
.course-filter-pills {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.filter-pill {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  color: #666;
  font-size: 24rpx;
  font-weight: 500;
  border: 2rpx solid #eee;
}
.filter-pill.active {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.22);
}
.reset-course-filter {
  margin-top: 20rpx;
  display: inline-block;
  padding: 12rpx 36rpx;
  border-radius: 30rpx;
  background: #f3e8ff;
  color: #7c3aed;
  font-size: 26rpx;
  font-weight: 600;
}

/* 课程列表项 */
.course-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.course-item.selected {
  border: 2rpx solid #aa00ff;
  background: #f9f0ff;
}
.course-item-left {
  flex: 1;
}
.course-item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}
.course-item-meta {
  font-size: 28rpx;
  color: #888;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.course-item-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}
.select-btn {
  background: #aa00ff;
  color: white;
  font-size: 30rpx;
  padding: 14rpx 30rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}
.select-btn.selected {
  background: #ff6b6b;
}

/* 通用操作按钮 */
.action-btn {
  font-size: 30rpx;
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  text-align: center;
}
.action-btn.primary {
  background: linear-gradient(135deg, #aa00ff, #c6a0ff);
  color: white;
}
.action-btn.secondary {
  background: #f5f5f5;
  color: #555;
}

/* 截止日期颜色 */
.deadline-orange { color: #f59e0b; font-weight: 500; }
.deadline-blue { color: #3b82f6; font-weight: 500; }
.deadline-red { color: #ef4444; font-weight: 500; }
.deadline-brand { color: #aa00ff; font-weight: 500; }

/* 空状态 & 错误状态 */
.empty {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 30rpx;
}
.error-state {
  margin: 24rpx 30rpx;
  padding: 48rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.error-text {
  font-size: 28rpx;
  color: #666;
}
.retry-btn {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 14rpx 40rpx;
  border-radius: 32rpx;
}

/* 安全区 */
.safe-bottom {
  height: calc(env(safe-area-inset-bottom) + 150rpx);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: white;
  border-radius: 20rpx;
  z-index: 101;
  overflow: hidden;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.modal-close {
  font-size: 32rpx;
  color: #999;
  padding: 0 10rpx;
}
.modal-body {
  padding: 24rpx 30rpx;
}

/* 塾师列表 */
.mentor-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.mentor-item:last-child {
  border-bottom: none;
}
.mentor-name {
  font-size: 32rpx;
  color: #333;
}
.mentor-select-btn {
  background: #aa00ff;
  color: white;
  font-size: 28rpx;
  padding: 12rpx 26rpx;
  border-radius: 24rpx;
}
.mentor-empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 30rpx;
}

/* 申报表单 */
.report-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 30rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}
.input-row {
  margin-bottom: 20rpx;
}
.input-label {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}
.input-field {
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 32rpx;
  background: #fafafa;
}
.input-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 20rpx;
}
