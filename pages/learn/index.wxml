<view class="page">

  <!-- 顶部 Banner -->
  <view class="banner">
    <view class="banner-top">
      <view>
        <view class="banner-title">学习中心</view>
        <view class="banner-sub">学本领 上自塾 · 以终为始闯关共学</view>
      </view>
      <view class="banner-stat-pill">已选 {{currentSelections.length}} / 3 门</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-btns">
    <view class="quick-btn primary" bindtap="onGotoExam">
      <text class="quick-icon">📝</text>
      <text class="quick-text">闯关考试</text>
    </view>
    <view class="quick-btn" bindtap="onGotoReport">
      <text class="quick-icon">📊</text>
      <text class="quick-text">成绩单学时</text>
    </view>
    <view class="quick-btn" bindtap="onGotoSocialPlaza">
      <text class="quick-icon">🏫</text>
      <text class="quick-text">共学广场</text>
    </view>
    <view class="quick-btn" bindtap="onGotoSupervise">
      <text class="quick-icon">👀</text>
      <text class="quick-text">督学看板</text>
    </view>
    <view class="quick-btn" bindtap="onOpenCampModal">
      <text class="quick-icon">🏕️</text>
      <text class="quick-text">进阶预备营</text>
    </view>
    <view class="quick-btn" bindtap="onOpenEditCourseModal">
      <text class="quick-icon">🛠️</text>
      <text class="quick-text">共创课程</text>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="login-tip" wx:if="{{!hasLogin}}">
    <text>登录后可使用选课、组方舟与学时申报功能</text>
    <button class="login-btn" bindtap="goToLogin">去登录</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 加载失败状态 -->
  <view class="error-state" wx:if="{{!loading && loadError}}">
    <text class="error-text">{{loadError}}</text>
    <view class="retry-btn" bindtap="loadData">重新加载</view>
  </view>

  <!-- 我的选课 -->
  <view class="section" wx:if="{{!loading && myCourses.length > 0}}">
    <view class="section-header">
      <text class="section-title">我的选课</text>
      <text class="section-tip">在学 {{myCourses.length}} 门</text>
    </view>
    <view class="course-card" wx:for="{{myCourses}}" wx:key="sele_id">
      <view class="course-card-top">
        <view class="course-info" data-id="{{item.course_id}}" data-title="{{item.course_title}}" bindtap="onCourseItemTap">
          <view class="course-name">{{item.course_title}}</view>
          <view class="course-meta" wx:if="{{item.is_last_declared}}">
            <text class="chapter-label finish-ready">🎉 已完成全部 {{item.total_chapters || 1}} 章学时申报，可申请结课</text>
          </view>
          <view class="course-meta" wx:else>
            <text class="chapter-label">第{{item.current_serial}}章：{{item.chapter_title}}</text>
          </view>
          <view class="course-meta">
            <text class="deadline {{item.deadlineClass}}">截止：{{item.deadlineDateStr}}</text>
          </view>
        </view>
        <view class="course-actions">
          <text class="mentor-tag" wx:if="{{item.shushi_name}}">🎓 {{item.shushi_name}}</text>
          <text class="no-mentor" wx:else bindtap="onSelectMentor" data-courseid="{{item.course_id}}">选塾师</text>
          <text class="ark-link" bindtap="onJoinArk" data-courseid="{{item.course_id}}">🚢 组方舟</text>
        </view>
      </view>
      <view class="course-card-bottom">
        <block wx:if="{{item.is_last_declared}}">
          <view class="action-btn secondary" data-id="{{item.course_id}}" data-title="{{item.course_title}}" bindtap="onCourseItemTap">📖 课程详情</view>
          <view class="action-btn finish-btn" data-courseid="{{item.course_id}}" bindtap="onGoFinishCourse">🎓 去结课领证</view>
        </block>
        <block wx:else>
          <view class="action-btn secondary" data-url="{{item.url}}" bindtap="onGoToChapter">📖 去学习</view>
          <view class="action-btn primary" data-course="{{item}}" bindtap="onReportLearn">⏱️ 申报学时</view>
        </block>
      </view>
    </view>
  </view>

  <!-- 全部课程 -->
  <view class="section" wx:if="{{!loading && !loadError}}">
    <view class="section-header">
      <text class="section-title">全部课程</text>
      <text class="section-tip">最多同时选修 3 门课</text>
    </view>

    <!-- 搜索框 + 筛选胶囊 -->
    <view class="course-filter-panel">
      <view class="course-search-box">
        <text class="search-icon">🔍</text>
        <input
          class="course-search-input"
          placeholder="搜索课程名称或塾主姓名..."
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
        />
        <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
      </view>

      <view class="course-filter-pills">
        <view
          class="filter-pill {{courseFilter === 'all' ? 'active' : ''}}"
          data-filter="all"
          bindtap="onFilterChange"
        >全部 ({{tableData.length}})</view>
        <view
          class="filter-pill {{courseFilter === 'hot' ? 'active' : ''}}"
          data-filter="hot"
          bindtap="onFilterChange"
        >🔥 热门共修</view>
        <view
          class="filter-pill {{courseFilter === 'selected' ? 'active' : ''}}"
          data-filter="selected"
          bindtap="onFilterChange"
        >我已选 ({{currentSelections.length}})</view>
        <view
          class="filter-pill {{courseFilter === 'available' ? 'active' : ''}}"
          data-filter="available"
          bindtap="onFilterChange"
        >可报名 ({{availableCount}})</view>
      </view>
    </view>

    <view class="course-item {{item.isSelected ? 'selected' : ''}}" wx:for="{{filteredCourses}}" wx:key="id">
      <view class="course-item-left" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onCourseItemTap">
        <view class="course-item-name">{{item.title}}</view>
        <view class="course-item-meta">
          <text>🎓 塾主：{{item.director_name || '自塾教研组'}}</text>
          <text>🔥 在学 {{item.current_selections_num || 0}} 人 · 🎓 学完 {{item.finish_selections_num || 0}} 人</text>
        </view>
      </view>
      <view class="course-item-right">
        <view
          class="select-btn {{item.isSelected ? 'selected' : ''}}"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          bindtap="onSelectCourse"
        >
          {{item.isSelected ? '退选' : '选课'}}
        </view>
      </view>
    </view>

    <!-- 筛选为空状态 -->
    <view class="empty" wx:if="{{filteredCourses.length === 0}}">
      <text>{{searchKeyword || courseFilter !== 'all' ? '未找到符合筛选条件的课程' : '暂无课程'}}</text>
      <view wx:if="{{searchKeyword || courseFilter !== 'all'}}" class="reset-course-filter" bindtap="onResetCourseFilter">重置筛选</view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>

  <!-- 选塾师弹窗 -->
  <view class="modal-mask" wx:if="{{showMentorModal}}" bindtap="onCloseMentorModal"></view>
  <view class="modal" wx:if="{{showMentorModal}}">
    <view class="modal-header">
      <text class="modal-title">选择塾师</text>
      <text class="modal-close" bindtap="onCloseMentorModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="mentor-item" wx:for="{{mentorList}}" wx:key="shushi_id">
        <text class="mentor-name">{{item.shushi_name}}</text>
        <view
          class="mentor-select-btn"
          data-shushiid="{{item.shushi_id}}"
          data-shushiname="{{item.shushi_name}}"
          bindtap="onConfirmMentor"
        >选择</view>
      </view>
      <view class="mentor-empty" wx:if="{{mentorList.length == 0}}">
        <text>暂无可选塾师</text>
      </view>
    </view>
  </view>

  <!-- 申报学时弹窗 -->
  <view class="modal-mask" wx:if="{{showReportModal}}" bindtap="onCloseReportModal"></view>
  <view class="modal" wx:if="{{showReportModal}}">
    <view class="modal-header">
      <text class="modal-title">申报学时</text>
      <text class="modal-close" bindtap="onCloseReportModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="report-info" wx:if="{{reportCourse}}">
        <text>课程：{{reportCourse.course_title}}</text>
        <text>章节：{{reportCourse.chapter_title}}</text>
      </view>
      <view class="input-row">
        <text class="input-label">学习时长（小时）</text>
        <input
          class="input-field"
          type="digit"
          placeholder="请输入，如 1.5"
          value="{{reportHour}}"
          bindinput="onReportHourInput"
        />
        <text class="input-tip">最多申报5小时</text>
      </view>
      <view class="modal-actions">
        <view class="action-btn secondary" bindtap="onCloseReportModal">取消</view>
        <view class="action-btn primary" bindtap="onConfirmReport">确认申报</view>
      </view>
    </view>
  </view>

  <!-- 102-camp.md: 进阶预备营弹窗（塾员预备营 / 塾师预备营 / 塾主预备营） -->
  <view class="modal-mask" wx:if="{{showCampModal}}" bindtap="onCloseCampModal"></view>
  <view class="modal" wx:if="{{showCampModal}}">
    <view class="modal-header">
      <text class="modal-title">🏕️ 自塾进阶预备营 ({{campInfo ? campInfo.camp_name : '预备营'}})</text>
      <text class="modal-close" bindtap="onCloseCampModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="course-filter-pills" style="margin-bottom: 18rpx;">
        <view
          class="filter-pill {{activeCampId === 1 ? 'active' : ''}}"
          data-campid="1"
          bindtap="onSwitchCampTab"
        >🌱 塾员营</view>
        <view
          class="filter-pill {{activeCampId === 2 ? 'active' : ''}}"
          data-campid="2"
          bindtap="onSwitchCampTab"
        >🎓 塾师营</view>
        <view
          class="filter-pill {{activeCampId === 3 ? 'active' : ''}}"
          data-campid="3"
          bindtap="onSwitchCampTab"
        >👑 塾主营</view>
      </view>

      <view class="report-info" wx:if="{{campInfo}}">
        <text>营主理人：{{campInfo.admin_name || '自塾教务处'}} · 必修课程号：{{campInfo.must_course || '1、2'}}</text>
        <text>在营成员 {{campMembers.length}} 人 · 已毕业 {{campFinishs.length}} 人 · 排队审核 {{campWaitings.length}} 人</text>
      </view>

      <view class="input-row">
        <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx;">
          <text class="input-label">入营承诺书 *</text>
          <text style="color:#7c3aed;font-size:24rpx;font-weight:700;" bindtap="onFillCampPledge">📋 一键填入标准誓词</text>
        </view>
        <textarea
          class="input-field"
          style="height:140rpx;padding:14rpx;"
          placeholder="{{campPledgeExample}}"
          value="{{campForm.commitment}}"
          data-field="commitment"
          bindinput="onCampFormInput"
        />
      </view>

      <view class="input-row">
        <text class="input-label">本人真名签字 *</text>
        <input
          class="input-field"
          placeholder="请输入您的真实姓名确认承诺"
          value="{{campForm.signature}}"
          data-field="signature"
          bindinput="onCampFormInput"
        />
      </view>

      <view class="modal-actions">
        <view class="action-btn secondary" bindtap="onCloseCampModal">关闭</view>
        <view class="action-btn primary" bindtap="onSubmitJoinCamp">
          {{submittingCamp ? '提交中...' : '🚀 申请加入预备营'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 103-edit-course.md: 塾主/塾师共创课程弹窗 -->
  <view class="modal-mask" wx:if="{{showEditCourseModal}}" bindtap="onCloseEditCourseModal">
    <view class="modal-card" catchtap="">
      <view class="modal-header">
        <text class="modal-title">🛠️ 共创与发布自塾课程 (103-edit-course)</text>
        <text class="modal-close" bindtap="onCloseEditCourseModal">✕</text>
      </view>
      <scroll-view scroll-y="true" style="max-height:62vh;">
        <view class="input-row">
          <text class="input-label">课程名称 *</text>
          <input
            class="input-field"
            placeholder="例如：AI 智能体实战与产品创新"
            value="{{courseForm.title}}"
            data-field="title"
            bindinput="onCourseFormInput"
          />
        </view>
        <view class="input-row">
          <text class="input-label">课程简介 *</text>
          <textarea
            class="input-field"
            style="height:110rpx;padding:12rpx;"
            placeholder="简述课程核心目标、收获与适用人群..."
            value="{{courseForm.desc}}"
            data-field="desc"
            bindinput="onCourseFormInput"
          />
        </view>
        <view style="display:flex;justify-content:space-between;align-items:center;margin:14rpx 0 10rpx;">
          <text style="font-size:26rpx;font-weight:700;color:#334155;">课程章节大纲 ({{courseForm.chapters.length}} 章)</text>
          <text style="font-size:24rpx;font-weight:700;color:#7c3aed;" bindtap="onAddCourseChapter">＋ 新增章节</text>
        </view>
        <view
          wx:for="{{courseForm.chapters}}"
          wx:key="index"
          style="background:#f8fafc;border-radius:16rpx;padding:18rpx;margin-bottom:14rpx;border:2rpx solid #e2e8f0;"
        >
          <view style="font-size:22rpx;font-weight:700;color:#7c3aed;margin-bottom:8rpx;">第 {{index + 1}} 章</view>
          <input
            placeholder="章节标题"
            value="{{item.title}}"
            data-index="{{index}}"
            data-field="title"
            bindinput="onChapterFieldInput"
            style="height:64rpx;background:#fff;border:2rpx solid #cbd5e1;border-radius:10rpx;padding:0 14rpx;font-size:24rpx;margin-bottom:10rpx;"
          />
          <view style="display:flex;gap:12rpx;">
            <input
              type="number"
              placeholder="建议天数(如7)"
              value="{{item.period}}"
              data-index="{{index}}"
              data-field="period"
              bindinput="onChapterFieldInput"
              style="flex:1;height:60rpx;background:#fff;border:2rpx solid #cbd5e1;border-radius:10rpx;padding:0 14rpx;font-size:22rpx;"
            />
            <input
              placeholder="关联文章/视频ID"
              value="{{item.url}}"
              data-index="{{index}}"
              data-field="url"
              bindinput="onChapterFieldInput"
              style="flex:1;height:60rpx;background:#fff;border:2rpx solid #cbd5e1;border-radius:10rpx;padding:0 14rpx;font-size:22rpx;"
            />
          </view>
        </view>
      </scroll-view>
      <view class="modal-actions" style="margin-top:16rpx;">
        <view class="action-btn secondary" bindtap="onSaveCourseDraft">💾 存草稿</view>
        <view class="action-btn primary" bindtap="onSubmitSaveCourse">
          {{savingCourse ? '发布中...' : '🚀 立即发布课程'}}
        </view>
      </view>
    </view>
  </view>

</view>
