.page {
  min-height: 100vh;
  background: #f6f5fb;
}

.summary-banner {
  position: relative;
  overflow: hidden;
  margin: 0 0 22rpx;
  padding: 36rpx 32rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.summary-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.summary-title {
  font-size: 38rpx;
  font-weight: 800;
}

.summary-sub {
  font-size: 23rpx;
  opacity: 0.88;
}

.summary-stats {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  padding: 14rpx 24rpx;
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.summary-stat {
  text-align: center;
}

.summary-stat-val {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.2;
}

.summary-stat-lbl {
  display: block;
  font-size: 20rpx;
  opacity: 0.88;
}

.summary-stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.3);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 18rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 4rpx 10rpx;
}

.type-filter-bar {
  display: flex;
  gap: 10rpx;
  margin: 18rpx 24rpx 0;
  padding: 8rpx;
  background: rgba(243, 232, 255, 0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 999rpx;
  border: 2rpx solid rgba(168, 85, 247, 0.14);
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.08);
}

.type-filter-pill {
  flex: 1;
  text-align: center;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: transparent;
  border: none;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 700;
  box-shadow: none;
}

.type-filter-pill.active {
  background: linear-gradient(135deg, #a855f7 0%, #9333ea 52%, #7c3aed 100%);
  border-color: transparent;
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.empty-cta-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.empty-cta-btn.ghost {
  background: #f5f3ff;
  color: #7c3aed;
  border: 2rpx solid rgba(124, 58, 237, 0.24);
  box-shadow: none;
}

.empty-card {
  padding: 72rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.04);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 10rpx;
}

.empty-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 32rpx;
}

.empty-cta-btn {
  width: 340rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 8rpx 22rpx rgba(124, 58, 237, 0.25);
}

.empty-cta-btn::after {
  border: none;
}

.folder-tabs-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 24rpx;
}

.folder-tabs {
  flex: 1;
  min-width: 0;
  display: flex;
  white-space: nowrap;
  background: #fff;
  border-radius: 18rpx;
  padding: 0 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.empty-folder-hint {
  height: 84rpx;
  align-items: center;
  color: #94a3b8;
  font-size: 26rpx;
  padding: 0 24rpx;
}

.new-folder-btn {
  flex-shrink: 0;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.folder-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 22rpx;
  font-size: 28rpx;
  color: #64748b;
  border-bottom: 4rpx solid transparent;
  flex-shrink: 0;
}

.folder-tab.active {
  color: #7c3aed;
  border-bottom-color: #7c3aed;
  font-weight: 600;
}

.tab-count {
  background: rgba(124, 58, 237, 0.12);
  color: #7c3aed;
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.content-area {
  padding: 24rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 80rpx 0;
  color: #9a9ab0;
  font-size: 28rpx;
}

.favor-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.favor-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.favor-info {
  flex: 1;
  overflow: hidden;
}

.favor-title {
  display: block;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.favor-type {
  display: inline-block;
  font-size: 22rpx;
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.1);
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
}

.favor-delete-btn {
  font-size: 24rpx;
  color: #ef4444;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.favor-arrow {
  font-size: 36rpx;
  color: #a78bfa;
  flex-shrink: 0;
}