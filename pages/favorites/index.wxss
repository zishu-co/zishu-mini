.page {
  min-height: 100vh;
  background: #f6f7fb;
}

.summary-banner {
  margin: 24rpx 24rpx 16rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 24rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.2);
}

.summary-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.summary-title {
  font-size: 36rpx;
  font-weight: 700;
}

.summary-sub {
  font-size: 22rpx;
  opacity: 0.86;
}

.summary-stats {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
}

.summary-stat {
  text-align: center;
}

.summary-stat-val {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.2;
}

.summary-stat-lbl {
  display: block;
  font-size: 20rpx;
  opacity: 0.88;
}

.summary-stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.3);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 18rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 4rpx 10rpx;
}

.empty-card {
  padding: 72rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.04);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 10rpx;
}

.empty-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 32rpx;
}

.empty-cta-btn {
  width: 340rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 8rpx 22rpx rgba(124, 58, 237, 0.25);
}

.empty-cta-btn::after {
  border: none;
}

.folder-tabs {
  display: flex;
  white-space: nowrap;
  background: #fff;
  margin: 0 24rpx;
  border-radius: 18rpx;
  padding: 0 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.folder-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 22rpx;
  font-size: 28rpx;
  color: #64748b;
  border-bottom: 4rpx solid transparent;
  flex-shrink: 0;
}

.folder-tab.active {
  color: #7c3aed;
  border-bottom-color: #7c3aed;
  font-weight: 600;
}

.tab-count {
  background: rgba(124, 58, 237, 0.12);
  color: #7c3aed;
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.content-area {
  padding: 24rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 80rpx 0;
  color: #9a9ab0;
  font-size: 28rpx;
}

.favor-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.favor-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.favor-info {
  flex: 1;
  overflow: hidden;
}

.favor-title {
  display: block;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.favor-type {
  display: inline-block;
  font-size: 22rpx;
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.1);
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
}

.favor-delete-btn {
  font-size: 24rpx;
  color: #ef4444;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.favor-arrow {
  font-size: 36rpx;
  color: #a78bfa;
  flex-shrink: 0;
}