<view class="page">
  <view class="summary-banner">
    <view class="summary-left">
      <text class="summary-title">我的收藏夹</text>
      <text class="summary-sub">沉淀优质课程、精选文章与高分试卷</text>
    </view>
    <view class="summary-stats">
      <view class="summary-stat">
        <text class="summary-stat-val">{{folders.length}}</text>
        <text class="summary-stat-lbl">收藏夹</text>
      </view>
      <view class="summary-stat-divider"></view>
      <view class="summary-stat">
        <text class="summary-stat-val">{{totalItemsCount}}</text>
        <text class="summary-stat-lbl">总收藏</text>
      </view>
    </view>
  </view>

  <!-- 文件夹 Tab + 新建收藏夹 -->
  <view class="folder-tabs-row">
    <scroll-view class="folder-tabs" scroll-x wx:if="{{folders.length > 0}}">
      <view
        class="folder-tab {{activeIndex === index ? 'active' : ''}}"
        wx:for="{{folders}}"
        wx:key="folderid"
        bindtap="switchFolder"
        data-index="{{index}}"
      >
        <text>📁 {{item.folder_title}}</text>
        <text class="tab-count">{{item.item_num}}</text>
      </view>
    </scroll-view>
    <view class="folder-tabs empty-folder-hint" wx:else>
      <text>暂未创建收藏夹</text>
    </view>
    <view class="new-folder-btn" bindtap="onCreateFolder">＋ 新建</view>
  </view>

  <!-- 实时关键词搜索 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      type="text"
      placeholder="在当前收藏夹中搜索标题或类型..."
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
  </view>

  <!-- 内容类型筛选胶囊 -->
  <view class="type-filter-bar">
    <view
      class="type-filter-pill {{typeFilter === 'all' ? 'active' : ''}}"
      data-type="all"
      bindtap="onTypeFilterChange"
    >⭐ 全部 ({{items.length}})</view>
    <view
      class="type-filter-pill {{typeFilter === '课程' ? 'active' : ''}}"
      data-type="课程"
      bindtap="onTypeFilterChange"
    >📚 课程</view>
    <view
      class="type-filter-pill {{typeFilter === '文章' ? 'active' : ''}}"
      data-type="文章"
      bindtap="onTypeFilterChange"
    >📄 文章</view>
    <view
      class="type-filter-pill {{typeFilter === '试卷' ? 'active' : ''}}"
      data-type="试卷"
      bindtap="onTypeFilterChange"
    >📝 试卷</view>
  </view>

  <!-- 收藏内容列表 -->
  <view class="content-area">
    <view wx:if="{{loading}}">
      <view class="loading-row"><text>加载中...</text></view>
    </view>
    <view wx:elif="{{filteredItems.length === 0}}">
      <view class="empty-card">
        <view class="empty-icon">⭐</view>
        <text class="empty-title">{{searchKeyword || typeFilter !== 'all' ? '未找到匹配的收藏内容' : '当前收藏夹暂无内容'}}</text>
        <text class="empty-sub">在学习过程中遇到好课、好文或真题，随时收藏到这里</text>
        <view class="empty-cta-row">
          <button class="empty-cta-btn ghost" bindtap="goToLearnCenter">📚 去选课中心</button>
          <button class="empty-cta-btn" bindtap="goToArticles">📄 去读精选文章</button>
        </view>
      </view>
    </view>
    <view wx:else>
      <view
        class="favor-item {{index % 2 === 0 ? 'zs-row-odd' : 'zs-row-even'}}"
        wx:for="{{filteredItems}}"
        wx:key="favorid"
        bindtap="onItemTap"
        bindlongpress="deleteItem"
        data-favorid="{{item.favorid}}"
        data-index="{{index}}"
        data-type="{{item.target_type}}"
        data-targetid="{{item.target_id}}"
      >
        <text class="favor-icon">{{item._typeIcon}}</text>
        <view class="favor-info">
          <text class="favor-title">{{item.target_title || '未命名内容'}}</text>
          <text class="favor-type">{{item.target_type}}</text>
        </view>
        <view
          class="favor-delete-btn"
          catchtap="deleteItem"
          data-favorid="{{item.favorid}}"
          data-index="{{index}}"
        >
          🗑️ 删除
        </view>
        <text class="favor-arrow">›</text>
      </view>
    </view>
  </view>
</view>