<view class="page">
  <view class="header">
    <text class="title">我的收藏</text>
  </view>

  <!-- 文件夹 Tab -->
  <scroll-view class="folder-tabs" scroll-x>
    <view
      class="folder-tab {{activeIndex === index ? 'active' : ''}}"
      wx:for="{{folders}}"
      wx:key="folderid"
      bindtap="switchFolder"
      data-index="{{index}}"
    >
      <text>{{item.folder_title}}</text>
      <text class="tab-count">{{item.item_num}}</text>
    </view>
  </scroll-view>

  <!-- 收藏内容列表 -->
  <view class="content-area">
    <view wx:if="{{loading}}">
      <view class="loading-row"><text>加载中...</text></view>
    </view>
    <view wx:elif="{{items.length === 0}}">
      <view class="empty-row"><text>暂无收藏内容</text></view>
    </view>
    <view wx:else>
      <view class="favor-item" wx:for="{{items}}" wx:key="favorid" bindlongpress="deleteItem" data-favorid="{{item.favorid}}" data-index="{{index}}">
        <text class="favor-icon">{{typeIcon(item.target_type)}}</text>
        <view class="favor-info">
          <text class="favor-title">{{item.target_title}}</text>
          <text class="favor-type">{{item.target_type}}</text>
        </view>
        <text class="favor-arrow">›</text>
      </view>
    </view>
  </view>
</view>