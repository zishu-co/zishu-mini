/* pages/my/my.wxss */
/* 自塾小程序 - 我的页面样式 */

page {
  background-color: #f5f5f5;
}

/* ========== 页面结构 ========== */

.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  position: relative;
}

/* ========== 顶部背景 ========== */

.top-bg {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  box-sizing: border-box;
  padding: 40rpx 36rpx 0;
}

.top-bg-header {
  display: flex;
  flex-direction: column;
  color: #ffffff;
}

.top-bg-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.top-bg-sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 6rpx;
}

/* ========== 用户卡片 ========== */

.user-card {
  position: relative;
  z-index: 2;
  margin: -130rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(124, 58, 237, 0.16);
}

.user-card__top {
  display: flex;
  align-items: center;
  width: 100%;
}

/* 段位进度条 */
.level-progress-box {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.level-progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.level-score-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
}

.level-next-hint {
  font-size: 22rpx;
  color: #9ca3af;
}

.level-track {
  width: 100%;
  height: 12rpx;
  background: #f3e8ff;
  border-radius: 6rpx;
  overflow: hidden;
}

.level-fill {
  height: 100%;
  background: linear-gradient(90deg, #a0f 0%, #7c3aed 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.user-card__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #f0e6ff;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-card__info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
  line-height: 1.3;
}

.level-pill {
  font-size: 20rpx;
  font-weight: 700;
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.sheet-quick-btn {
  margin: 0 0 0 12rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.sheet-quick-btn::after {
  border: none;
}

.phone {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.user-card__arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 40rpx;
  color: #ccc;
}

/* ========== 学习数据统计条 ========== */

.stats-bar {
  position: relative;
  z-index: 2;
  margin: 0 32rpx 24rpx;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #aa00ff;
  line-height: 1;
}

.stats-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #f0f0f0;
}

/* ========== 用户卡片内的登录按钮（未登录时显示） ========== */

.user-card__login-btn {
  flex-shrink: 0;
  width: 140rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #aa00ff 0%, #8b5cf6 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 32rpx;
  padding: 0;
  margin: 0 0 0 28rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.3);
}

.user-card__login-btn::after {
  border: none;
}

.user-card__login-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(139, 92, 246, 0.2);
}

/* ========== 金刚区快捷导航卡片 ========== */

.quick-nav-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin: 0 32rpx 24rpx;
}

.quick-nav-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.quick-nav-card:active {
  transform: scale(0.97);
}

.quick-nav-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.quick-nav-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 4rpx;
}

.quick-nav-sub {
  font-size: 20rpx;
  color: #9ca3af;
}

/* ========== 功能菜单 ========== */

.menu-wrapper {
  padding: 8rpx 32rpx calc(env(safe-area-inset-bottom) + 180rpx);
}

/* ========== 我的方舟区块（spec 002） ========== */

.ark-block {
  margin: 0 32rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.ark-block__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.ark-block__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.ark-block__count {
  font-size: 24rpx;
  color: #999;
}

.ark-loading {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.ark-list {
  margin-top: 8rpx;
}

.ark-item {
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
}

.ark-item:last-child {
  border-bottom: none;
}

.ark-item:active {
  background: #f8f8f8;
}

.ark-item__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.ark-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.ark-item__tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.tag-prep {
  background: #f5f5f5;
  color: #999;
}

.tag-sail {
  background: rgba(170, 0, 255, 0.1);
  color: #aa00ff;
}

.tag-done {
  background: rgba(103, 194, 58, 0.12);
  color: #67c23a;
}

.tag-closed {
  background: rgba(153, 153, 153, 0.12);
  color: #999;
}

.ark-item__course {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ark-item__bottom {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #aa00ff 0%, #c6f 100%);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 22rpx;
  color: #aa00ff;
  font-weight: 600;
  min-width: 64rpx;
  text-align: right;
}

.ark-item__crew {
  font-size: 22rpx;
  color: #999;
  min-width: 80rpx;
  text-align: right;
}

.ark-empty {
  padding: 40rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ark-empty__icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.ark-empty__text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.ark-empty__tip {
  font-size: 22rpx;
  color: #999;
}

.menu-group {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.menu-group__title {
  padding: 24rpx 32rpx 16rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #aa00ff;
  letter-spacing: 2rpx;
}

.menu-group__list {
  /* cells */
}

.menu-cell {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-top: 1rpx solid #f5f5f5;
}

.cell-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.cell-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.cell-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ========== 底部区域 ========== */

.bottom-wrapper {
  padding: 32rpx 32rpx 32rpx;
}

/* ========== 退出登录 ========== */

.logout-wrapper {
  width: 100%;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #fa4126;
  text-align: center;
  border: none;
  font-weight: normal;
}

.logout-btn::after {
  border: none;
}

/* ========== 安全区 ========== */

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

/* 意见反馈弹窗样式 */
.fb-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.56);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 32rpx;
}

.fb-modal-card {
  width: 100%;
  max-width: 640rpx;
  max-height: 82vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 34rpx 30rpx;
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.2);
}

.fb-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.fb-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.fb-modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 4rpx 12rpx;
}

.fb-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
}

.fb-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
}

.fb-tab.active {
  background: #ffffff;
  color: #7c3aed;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.fb-type-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.fb-type-chip {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 23rpx;
  font-weight: 600;
  color: #475569;
}

.fb-type-chip.active {
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
  border-color: transparent;
}

.fb-input {
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.fb-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.5;
}

.fb-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.fb-btn {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.fb-btn.cancel {
  background: #f1f5f9;
  color: #64748b;
}

.fb-btn.confirm {
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
}

.fb-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-height: 460rpx;
  overflow-y: auto;
}

.fb-empty {
  text-align: center;
  padding: 48rpx 20rpx;
  font-size: 25rpx;
  color: #94a3b8;
}

.fb-item {
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e2e8f0;
}

.fb-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.fb-item-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1e293b;
}

.fb-item-status {
  font-size: 22rpx;
  color: #7c3aed;
  font-weight: 600;
}

.fb-item-content {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.fb-item-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #94a3b8;
}

.fb-reward {
  color: #16a34a;
  font-weight: 700;
}
