/* pages/my/my.wxss */
/* 自塾小程序 - 我的页面样式 */

page {
  background-color: #f5f5f5;
}

/* ========== 页面结构 ========== */

.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 32rpx 32rpx 180rpx;
}

/* ========== 用户卡片 ========== */

.user-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

.user-card__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #f0e6ff;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-card__info {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a2e;
  line-height: 1.3;
}

.phone {
  font-size: 32rpx;
  color: #999;
  margin-top: 8rpx;
}

.user-card__arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 40rpx;
  color: #ccc;
}

/* ========== 学习数据统计条 ========== */

.stats-bar {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #aa00ff;
  line-height: 1;
}

.stats-label {
  font-size: 30rpx;
  color: #999;
  margin-top: 8rpx;
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #f0f0f0;
}

/* ========== 用户卡片内的登录按钮（未登录时显示） ========== */

.user-card__login-btn {
  flex-shrink: 0;
  width: 140rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #aa00ff 0%, #8b5cf6 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 32rpx;
  padding: 0;
  margin: 0 0 0 28rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.3);
}

.user-card__login-btn::after {
  border: none;
}

.user-card__login-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(139, 92, 246, 0.2);
}

/* ========== 功能菜单 ========== */

.menu-wrapper {
  /* page 已有 padding */
}

/* ========== 我的方舟区块（spec 002） ========== */

.ark-block {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

.ark-block__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.ark-block__title {
  font-size: 38rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.ark-block__count {
  font-size: 32rpx;
  color: #999;
}

.ark-loading {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 34rpx;
}

.ark-list {
  margin-top: 8rpx;
}

.ark-item {
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
}

.ark-item:last-child {
  border-bottom: none;
}

.ark-item:active {
  background: #f8f8f8;
}

.ark-item__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.ark-item__name {
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.ark-item__tag {
  font-size: 30rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.tag-prep {
  background: #f5f5f5;
  color: #999;
}

.tag-sail {
  background: rgba(170, 0, 255, 0.1);
  color: #aa00ff;
}

.tag-done {
  background: rgba(103, 194, 58, 0.12);
  color: #67c23a;
}

.tag-closed {
  background: rgba(153, 153, 153, 0.12);
  color: #999;
}

.ark-item__course {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ark-item__bottom {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #aa00ff 0%, #c6f 100%);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 30rpx;
  color: #aa00ff;
  font-weight: 600;
  min-width: 64rpx;
  text-align: right;
}

.ark-item__crew {
  font-size: 28rpx;
  color: #999;
  min-width: 80rpx;
  text-align: right;
}

.ark-empty {
  padding: 40rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ark-empty__icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.ark-empty__text {
  font-size: 36rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.ark-empty__tip {
  font-size: 30rpx;
  color: #999;
}

.menu-group {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.menu-group__title {
  padding: 24rpx 32rpx 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #aa00ff;
  letter-spacing: 2rpx;
}

.menu-group__list {
  /* cells */
}

.menu-cell {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-top: 1rpx solid #f5f5f5;
}

.cell-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.cell-text {
  flex: 1;
  font-size: 36rpx;
  color: #333;
}

.cell-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ========== 底部区域 ========== */

.bottom-wrapper {
  padding: 32rpx 32rpx 32rpx;
}

/* ========== 退出登录 ========== */

.logout-wrapper {
  width: 100%;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #fa4126;
  text-align: center;
  border: none;
  font-weight: normal;
}

.logout-btn::after {
  border: none;
}

/* ========== 安全区 ========== */

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
