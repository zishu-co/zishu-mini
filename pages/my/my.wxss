/* pages/my/my.wxss — 个人中心旗舰视觉 */

page {
  background-color: #f6f5fb;
  color: #0f172a;
}

/* ========== 页面结构 ========== */

.page {
  min-height: 100vh;
  background-color: #f6f5fb;
  position: relative;
}

/* ========== 顶部背景 ========== */

.top-bg {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 340rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 48rpx 48rpx;
  box-sizing: border-box;
  padding: 40rpx 36rpx 0;
  box-shadow: 0 14rpx 36rpx rgba(91, 33, 182, 0.22);
}

.top-bg::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.top-bg-header {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  color: #ffffff;
}

.top-bg-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1.5rpx;
}

.top-bg-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
  margin-top: 6rpx;
}

/* ========== 用户卡片 ========== */

.user-card {
  position: relative;
  z-index: 2;
  margin: -140rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 34rpx 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.08);
  border: 1rpx solid rgba(147, 51, 234, 0.1);
}

.user-card__top {
  display: flex;
  align-items: center;
  width: 100%;
}

/* 段位进度条 */
.level-progress-box {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f1f5f9;
}

.level-progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.level-score-text {
  font-size: 25rpx;
  font-weight: 800;
  color: #7c3aed;
}

.level-next-hint {
  font-size: 22rpx;
  color: #64748b;
}

.level-track {
  width: 100%;
  height: 14rpx;
  background: #ede9fe;
  border-radius: 999rpx;
  overflow: hidden;
}

.level-fill {
  height: 100%;
  background: linear-gradient(90deg, #a855f7 0%, #7c3aed 100%);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.user-card__avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 6rpx solid #f3e8ff;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.16);
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-card__info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.3;
}

.level-pill {
  font-size: 21rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.sheet-quick-btn {
  margin: 0 0 0 12rpx;
  padding: 0 22rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(124, 58, 237, 0.25);
}

.phone {
  font-size: 25rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.user-card__arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 40rpx;
  color: #94a3b8;
}

/* ========== 学习数据统计条 ========== */

.stats-bar {
  position: relative;
  z-index: 2;
  margin: 0 28rpx 24rpx;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #7c3aed;
  line-height: 1.1;
}

.stats-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #64748b;
  margin-top: 8rpx;
  white-space: nowrap;
}

.stats-divider {
  width: 2rpx;
  height: 52rpx;
  background-color: #f1f5f9;
}

/* ========== 用户卡片内的登录按钮（未登录时显示） ========== */

.user-card__login-btn {
  flex-shrink: 0;
  width: 148rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 0;
  margin: 0 0 0 24rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.28);
}

.user-card__login-btn:active {
  transform: scale(0.96);
}

/* ========== 金刚区快捷导航卡片 ========== */

.quick-nav-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin: 0 28rpx 24rpx;
}

.quick-nav-card {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 28rpx;
  padding: 22rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.11),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
}

.quick-nav-card:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.13),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.quick-nav-card:active {
  transform: scale(0.96);
}

.quick-nav-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-bottom: 12rpx;
}

.quick-nav-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.quick-nav-sub {
  font-size: 19rpx;
  color: #64748b;
  white-space: nowrap;
}

/* ========== 功能菜单 ========== */

.menu-wrapper {
  padding: 4rpx 28rpx calc(env(safe-area-inset-bottom) + 180rpx);
}

/* ========== 我的方舟区块（spec 002） ========== */

.ark-block {
  margin: 0 28rpx 24rpx;
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.ark-block__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.ark-block__title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.ark-block__count {
  font-size: 23rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.ark-loading {
  padding: 40rpx 0;
  text-align: center;
  color: #64748b;
  font-size: 26rpx;
}

.ark-list {
  margin-top: 16rpx;
}

.ark-item {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10),
    inset 0 3rpx 0 #ffffff;
  transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.18s ease;
}

.ark-item:nth-child(even),
.ark-item.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.ark-item:last-child {
  margin-bottom: 0;
}

.ark-item:active {
  transform: scale(0.985);
}

.ark-item__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.ark-item__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.ark-item__tag {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.tag-prep {
  background: #fef3c7;
  color: #d97706;
}

.tag-sail {
  background: #f3e8ff;
  color: #7c3aed;
}

.tag-done {
  background: #dcfce7;
  color: #15803d;
}

.tag-closed {
  background: #f1f5f9;
  color: #64748b;
}

.ark-item__course {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ark-item__bottom {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.progress-bar {
  flex: 1;
  height: 10rpx;
  background: #ede9fe;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #a855f7 0%, #7c3aed 100%);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 22rpx;
  color: #7c3aed;
  font-weight: 700;
  min-width: 64rpx;
  text-align: right;
}

.ark-item__crew {
  font-size: 22rpx;
  color: #64748b;
  min-width: 80rpx;
  text-align: right;
}

.ark-empty {
  padding: 44rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ark-empty__icon {
  font-size: 76rpx;
  margin-bottom: 12rpx;
}

.ark-empty__text {
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 8rpx;
}

.ark-empty__tip {
  font-size: 23rpx;
  color: #94a3b8;
}

.menu-group {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  padding: 22rpx 24rpx 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow:
    0 12rpx 30rpx rgba(147, 51, 234, 0.06),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(192, 132, 252, 0.22);
}

.menu-group__title {
  padding: 4rpx 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #6d28d9;
  letter-spacing: 1.5rpx;
}

.menu-group__list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.menu-cell {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 8rpx 22rpx -6rpx rgba(236, 72, 153, 0.10),
    inset 0 2rpx 0 #ffffff;
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.16s ease;
}

.menu-cell:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 8rpx 22rpx -6rpx rgba(99, 102, 241, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.94);
}

.menu-cell:active {
  transform: scale(0.985);
}

.cell-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  border: 1.5rpx solid rgba(244, 114, 182, 0.24);
  box-shadow: inset 0 2rpx 0 #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.cell-text {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  color: #1e293b;
}

.cell-arrow {
  font-size: 32rpx;
  color: #94a3b8;
}

/* ========== 底部区域 ========== */

.bottom-wrapper {
  padding: 16rpx 28rpx 32rpx;
}

/* ========== 退出登录 ========== */

.logout-wrapper {
  width: 100%;
}

.logout-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background-color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ef4444;
  text-align: center;
  border: 1rpx solid rgba(239, 68, 68, 0.16);
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
}

/* ========== 安全区 ========== */

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

/* 意见反馈弹窗样式 */
.fb-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(36, 16, 68, 0.44);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 32rpx;
}

.fb-modal-card {
  width: 100%;
  max-width: 660rpx;
  max-height: 84vh;
  overflow-y: auto;
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 88% 0%, rgba(168, 85, 247, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 42%, #faf7ff 100%);
  border-radius: 44rpx;
  padding: 28rpx 34rpx 36rpx;
  box-shadow:
    0 28rpx 72rpx -12rpx rgba(109, 40, 217, 0.26),
    0 10rpx 28rpx -6rpx rgba(236, 72, 153, 0.14),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
}

.fb-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.fb-modal-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #3b0764;
}

.fb-modal-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  color: #9333ea;
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.12), inset 0 2rpx 0 #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.fb-tabs {
  display: flex;
  gap: 8rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  border-radius: 26rpx;
  padding: 8rpx;
  margin-bottom: 22rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.08);
}

.fb-tab {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 6rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  border: 1.5rpx solid rgba(139, 92, 246, 0.20);
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.04), inset 0 1rpx 0 #ffffff;
  white-space: nowrap;
}

.fb-tab.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.32), inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.fb-type-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.fb-type-chip {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 16rpx 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04), inset 0 1rpx 0 #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  color: #4c1d95;
  white-space: nowrap;
}

.fb-type-chip.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.fb-input {
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
  font-size: 27rpx;
  color: #1e1b4b;
  margin-bottom: 18rpx;
}

.fb-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
  font-size: 27rpx;
  color: #1e1b4b;
  line-height: 1.55;
}

.fb-actions {
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 26rpx;
}

.fb-btn {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.fb-btn.cancel {
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  color: #6d28d9;
  border: 1.5rpx solid rgba(124, 58, 237, 0.26);
}

.fb-btn.confirm {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 52%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.fb-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-height: 460rpx;
  overflow-y: auto;
}

.fb-empty {
  text-align: center;
  padding: 48rpx 20rpx;
  font-size: 25rpx;
  color: #94a3b8;
}

.fb-item {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10),
    inset 0 3rpx 0 #ffffff;
}

.fb-item:nth-child(even),
.fb-item.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

