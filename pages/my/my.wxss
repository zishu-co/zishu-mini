/* pages/my/my.wxss */
/* 自塾小程序 - 我的页面样式 */

page {
  background-color: #f5f5f5;
}

/* ========== 页面结构 ========== */

.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  position: relative;
}

/* ========== 顶部背景 ========== */

.top-bg {
  width: 100%;
  height: 360rpx;
  background: linear-gradient(135deg, #c6f 0%, #aa00ff 100%);
  border-radius: 0 0 40rpx 40rpx;
}

/* ========== 用户卡片 ========== */

.user-card {
  position: absolute;
  top: 200rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(170, 0, 255, 0.15);
}

.user-card__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #f0e6ff;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-card__info {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
  line-height: 1.3;
}

.phone {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.user-card__arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 40rpx;
  color: #ccc;
}

/* ========== 学习数据统计条 ========== */

.stats-bar {
  position: absolute;
  top: 380rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #aa00ff;
  line-height: 1;
}

.stats-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #f0f0f0;
}

/* ========== 功能菜单 ========== */

.menu-wrapper {
  padding: 240rpx 32rpx 32rpx;
}

.menu-group {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.menu-group__title {
  padding: 24rpx 32rpx 16rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #aa00ff;
  letter-spacing: 2rpx;
}

.menu-group__list {
  /* cells */
}

.menu-cell {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-top: 1rpx solid #f5f5f5;
}

.cell-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.cell-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.cell-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ========== 退出登录 ========== */

.logout-wrapper {
  padding: 0 32rpx;
  margin-top: 16rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #fa4126;
  text-align: center;
  border: none;
  font-weight: normal;
}

.logout-btn::after {
  border: none;
}

/* ========== 安全区 ========== */

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
