<view class="page">
  <!-- 顶部背景 -->
  <view class="top-bg">
    <view class="top-bg-header">
      <text class="top-bg-title">个人中心</text>
      <text class="top-bg-sub">共学成长档案 · 见证每一次进阶</text>
    </view>
  </view>

  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-card__top">
      <view class="user-card__avatar" bindtap="{{isLoggedIn ? 'goToEditProfile' : 'goToLogin'}}">
        <image
          class="avatar-img"
          src="{{userInfo.avatarUrl || '/img/logo.png'}}"
          mode="aspectFill"
        />
      </view>
      <!-- 已登录：显示昵称 + 段位徽章 + 学习单按钮 -->
      <block wx:if="{{isLoggedIn}}">
        <view class="user-card__info" bindtap="goToEditProfile">
          <view class="nickname-row">
            <text class="nickname">{{userInfo.nickName}}</text>
            <text class="level-pill">{{levelBadge}}</text>
          </view>
          <view class="phone" wx:if="{{userInfo.phoneNumber}}">{{userInfo.phoneNumber}}</view>
          <view class="phone" wx:else>点击编辑个人共学名片 ›</view>
        </view>
        <button class="sheet-quick-btn" catchtap="goToMyLearnSheet">📋 学习单</button>
      </block>
      <!-- 未登录：显示欢迎文案 + 登录按钮 -->
      <block wx:else>
        <view class="user-card__info" bindtap="goToLogin">
          <view class="nickname">欢迎来到自塾</view>
          <view class="phone">登录解锁共学搭子、方舟与闯关勋章</view>
        </view>
        <button class="user-card__login-btn" bindtap="goToLogin">🔑 登录</button>
      </block>
    </view>

    <!-- 段位成长进度条（已登录显示） -->
    <view class="level-progress-box" wx:if="{{isLoggedIn}}">
      <view class="level-progress-header">
        <text class="level-score-text">成长积分 {{levelScore}} 分</text>
        <text class="level-next-hint">{{nextLevelHint}}</text>
      </view>
      <view class="level-track">
        <view class="level-fill" style="width: {{levelProgressPercent}}%;"></view>
      </view>
    </view>
  </view>

  <!-- 学习数据统计条（已登录时显示） -->
  <view class="stats-bar" wx:if="{{isLoggedIn}}">
    <view class="stats-item" bindtap="navigateTo" data-url="/pages/report/index">
      <view class="stats-num">{{stats.reportCount || 0}}</view>
      <view class="stats-label">汇报</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="navigateTo" data-url="/pages/shuzhi/index">
      <view class="stats-num">{{stats.shuzhiCount || 0}}</view>
      <view class="stats-label">塾值</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="switchToTab" data-tab="/pages/learn/index">
      <view class="stats-num">{{stats.courseCount || 0}}</view>
      <view class="stats-label">课程</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="navigateTo" data-url="/pages/favorites/index">
      <view class="stats-num">{{stats.favCount || 0}}</view>
      <view class="stats-label">收藏</view>
    </view>
  </view>

  <!-- 金刚区快捷导航卡片 -->
  <view class="quick-nav-grid">
    <view class="quick-nav-card" bindtap="navigateTo" data-url="/pages/goaltalk/index">
      <text class="quick-nav-icon">🎯</text>
      <text class="quick-nav-title">目标面谈</text>
      <text class="quick-nav-sub">导师1v1对齐</text>
    </view>
    <view class="quick-nav-card" bindtap="navigateTo" data-url="/pages/mentors/index">
      <text class="quick-nav-icon">🤝</text>
      <text class="quick-nav-title">师生关系</text>
      <text class="quick-nav-sub">塾师带教记录</text>
    </view>
    <view class="quick-nav-card" bindtap="navigateTo" data-url="/pages/followup/index">
      <text class="quick-nav-icon">🚀</text>
      <text class="quick-nav-title">创新跟进</text>
      <text class="quick-nav-sub">项目实战进度</text>
    </view>
    <view class="quick-nav-card" bindtap="navigateTo" data-url="/pages/all/index">
      <text class="quick-nav-icon">🏫</text>
      <text class="quick-nav-title">全塾动态</text>
      <text class="quick-nav-sub">实时共学广场</text>
    </view>
  </view>

  <!-- 我的方舟区块（spec 002） -->
  <view class="ark-block" wx:if="{{isLoggedIn}}">
    <view class="ark-block__header">
      <text class="ark-block__title">🚢 我的方舟</text>
      <text class="ark-block__count">{{arkCount}} 个</text>
    </view>

    <!-- 加载中 -->
    <view class="ark-loading" wx:if="{{arkLoading}}">
      <text>加载中...</text>
    </view>

    <!-- 有方舟 -->
    <view class="ark-list" wx:elif="{{arkList.length > 0}}">
      <view
        class="ark-item"
        wx:for="{{arkList}}"
        wx:key="ark_id"
        wx:for-item="ark"
        bindtap="onArkTap"
        data-ark-id="{{ark.ark_id}}"
      >
        <view class="ark-item__top">
          <view class="ark-item__name">{{ark.arkname}}</view>
          <view class="ark-item__tag tag-{{ark.finished ? 'done' : (ark.closed ? 'closed' : (ark.stage === '筹建中' ? 'prep' : 'sail'))}}">
            {{ark.finished ? '已成舟' : (ark.closed ? '已解散' : ark.stage)}}
          </view>
        </view>
        <view class="ark-item__course">{{ark.course_title}}</view>
        <view class="ark-item__bottom">
          <view class="progress-bar">
            <view class="progress-bar__fill" style="width: {{ark.progress_percent}}%;"></view>
          </view>
          <text class="progress-text">{{ark.progress_percent}}%</text>
          <text class="ark-item__crew">{{ark.members_str}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="ark-empty" wx:else>
      <text class="ark-empty__icon">🛶</text>
      <text class="ark-empty__text">暂未加入任何方舟</text>
      <text class="ark-empty__tip">在"学习"页选课后可创建或加入方舟</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-wrapper">

    <!-- 学习与成长 -->
    <view class="menu-group">
      <view class="menu-group__title">学习与成长</view>
      <view class="menu-group__list">
        <view class="menu-cell" bindtap="switchToTab" data-tab="/pages/learn/index">
          <text class="cell-icon">📚</text>
          <text class="cell-text">我的课程</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/report/index">
          <text class="cell-icon">📊</text>
          <text class="cell-text">学习汇报</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/shuzhi/index">
          <text class="cell-icon">💎</text>
          <text class="cell-text">塾值明细</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/supervise/index">
          <text class="cell-icon">📐</text>
          <text class="cell-text">学习监督</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 师生与创新 -->
    <view class="menu-group">
      <view class="menu-group__title">师生与创新</view>
      <view class="menu-group__list">
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/goaltalk/index">
          <text class="cell-icon">💬</text>
          <text class="cell-text">目标面谈</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/mentors/index">
          <text class="cell-icon">🤝</text>
          <text class="cell-text">师生关系</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/followup/index">
          <text class="cell-icon">🚀</text>
          <text class="cell-text">创新项目</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 创作与收藏 -->
    <view class="menu-group">
      <view class="menu-group__title">创作与收藏</view>
      <view class="menu-group__list">
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/favorites/index">
          <text class="cell-icon">❤️</text>
          <text class="cell-text">我的收藏</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/article/index">
          <text class="cell-icon">📝</text>
          <text class="cell-text">我的文章</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/all/index">
          <text class="cell-icon">🏫</text>
          <text class="cell-text">全塾动态</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 账户管理 -->
    <view class="menu-group">
      <view class="menu-group__title">账户管理</view>
      <view class="menu-group__list">
        <view class="menu-cell" bindtap="onOpenFeedbackModal">
          <text class="cell-icon">💡</text>
          <text class="cell-text">意见反馈与共创建议（赢塾值）</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/editprofile/index">
          <text class="cell-icon">✏️</text>
          <text class="cell-text">编辑信息</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/changepass/index">
          <text class="cell-icon">🔑</text>
          <text class="cell-text">修改密码</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="logOut">
          <text class="cell-icon">🚪</text>
          <text class="cell-text">退出登录</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 意见反馈与共创建议弹窗（111-feedback-mine） -->
  <view class="fb-modal-mask" wx:if="{{showFeedbackModal}}" bindtap="onCloseFeedbackModal">
    <view class="fb-modal-card" catchtap="true">
      <view class="fb-modal-header">
        <text class="fb-modal-title">💡 自塾共创反馈中心</text>
        <text class="fb-modal-close" bindtap="onCloseFeedbackModal">✕</text>
      </view>
      <view class="fb-tabs">
        <view
          class="fb-tab {{feedbackTab === 'submit' ? 'active' : ''}}"
          data-tab="submit"
          bindtap="onSwitchFeedbackTab"
        >📝 提交建议</view>
        <view
          class="fb-tab {{feedbackTab === 'mine' ? 'active' : ''}}"
          data-tab="mine"
          bindtap="onSwitchFeedbackTab"
        >📋 我的 ({{myFeedbacks.length}})</view>
        <view
          class="fb-tab {{feedbackTab === 'public' ? 'active' : ''}}"
          data-tab="public"
          bindtap="onSwitchFeedbackTab"
        >🏆 共创墙 ({{publicFeedbacks.length}})</view>
      </view>

      <block wx:if="{{feedbackTab === 'submit'}}">
        <view class="fb-type-row">
          <view
            class="fb-type-chip {{feedbackForm.type === 'feature' ? 'active' : ''}}"
            data-type="feature"
            bindtap="onSelectFeedbackType"
          >✨ 功能建议</view>
          <view
            class="fb-type-chip {{feedbackForm.type === 'ux' ? 'active' : ''}}"
            data-type="ux"
            bindtap="onSelectFeedbackType"
          >🎨 体验优化</view>
          <view
            class="fb-type-chip {{feedbackForm.type === 'bug' ? 'active' : ''}}"
            data-type="bug"
            bindtap="onSelectFeedbackType"
          >🐞 Bug 反馈</view>
        </view>
        <input
          class="fb-input"
          value="{{feedbackForm.title}}"
          placeholder="反馈标题（如：希望方舟增加语音打卡）"
          data-field="title"
          bindinput="onFeedbackInput"
        />
        <textarea
          class="fb-textarea"
          value="{{feedbackForm.content}}"
          placeholder="详细描述您的功能想法或遇到的问题，建议被采纳落地后将直接获赠塾值奖励！"
          maxlength="1000"
          data-field="content"
          bindinput="onFeedbackInput"
        />
        <view class="fb-actions">
          <view class="fb-btn cancel" bindtap="onCloseFeedbackModal">✕ 取消</view>
          <view class="fb-btn confirm" bindtap="onSubmitFeedback">
            {{submittingFeedback ? '⏳ 提交中...' : '🚀 提交共创反馈'}}
          </view>
        </view>
      </block>

      <block wx:elif="{{feedbackTab === 'mine'}}">
        <view class="fb-list">
          <view class="fb-empty" wx:if="{{myFeedbacks.length === 0}}">
            暂无历史反馈记录，快提交第一条共创建议赢取塾值吧！
          </view>
          <view class="fb-item" wx:for="{{myFeedbacks}}" wx:key="id">
            <view class="fb-item-top">
              <text class="fb-item-title">{{item.title}}</text>
              <text class="fb-item-status">{{item._statusText}}</text>
            </view>
            <view class="fb-item-content">{{item.content}}</view>
            <view class="fb-item-meta">
              <text>{{item._dateStr}}</text>
              <text wx:if="{{item.shuzhi_reward > 0}}" class="fb-reward">💰 +{{item.shuzhi_reward}} 塾值</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 100-public.md: 公开共创荣誉墙 -->
      <block wx:else>
        <view class="fb-list">
          <view class="fb-empty" wx:if="{{publicFeedbacks.length === 0}}">
            暂无公开采纳的共创建议，快来成为第一位上榜的共创官！
          </view>
          <view class="fb-item" wx:for="{{publicFeedbacks}}" wx:key="id">
            <view class="fb-item-top">
              <text class="fb-item-title">🏆 {{item.title}}</text>
              <text class="fb-reward" wx:if="{{item.shuzhi_reward > 0}}">💎 +{{item.shuzhi_reward}} 塾值</text>
            </view>
            <view class="fb-item-content">{{item.content}}</view>
            <view class="fb-item-meta">
              <text>共创人：{{item.username || '自塾学友'}}</text>
              <text>{{item._dateStr}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-area-bottom"></view>

</view>
