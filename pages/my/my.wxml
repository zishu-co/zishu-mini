<view class="page">
  <!-- 顶部背景 -->
  <view class="top-bg"></view>

  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-card__avatar" bindtap="goToEditProfile">
      <image
        class="avatar-img"
        src="{{userInfo.avatarUrl || '/img/logo.png'}}"
        mode="aspectFill"
      />
    </view>
    <view class="user-card__info" bindtap="goToEditProfile">
      <view class="nickname">{{userInfo.nickName || "未登录"}}</view>
      <view class="phone" wx:if="{{userInfo.phoneNumber}}">{{userInfo.phoneNumber}}</view>
    </view>
    <view class="user-card__arrow" bindtap="goToEditProfile">
      <text class="arrow-icon">›</text>
    </view>
  </view>

  <!-- 学习数据统计条 -->
  <view class="stats-bar">
    <view class="stats-item" bindtap="navigateTo" data-url="/pages/report/index">
      <view class="stats-num">{{stats.reportCount || 0}}</view>
      <view class="stats-label">汇报</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="navigateTo" data-url="/pages/shuzhi/index">
      <view class="stats-num">{{stats.shuzhiCount || 0}}</view>
      <view class="stats-label">塾值</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="switchToTab" data-tab="/pages/learn/index">
      <view class="stats-num">{{stats.courseCount || 0}}</view>
      <view class="stats-label">课程</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" bindtap="navigateTo" data-url="/pages/favorites/index">
      <view class="stats-num">{{stats.favCount || 0}}</view>
      <view class="stats-label">收藏</view>
    </view>
  </view>

  <!-- 我的方舟区块（spec 002） -->
  <view class="ark-block" wx:if="{{isLoggedIn}}">
    <view class="ark-block__header">
      <text class="ark-block__title">🚢 我的方舟</text>
      <text class="ark-block__count">{{arkCount}} 个</text>
    </view>

    <!-- 加载中 -->
    <view class="ark-loading" wx:if="{{arkLoading}}">
      <text>加载中...</text>
    </view>

    <!-- 有方舟 -->
    <view class="ark-list" wx:elif="{{arkList.length > 0}}">
      <view
        class="ark-item"
        wx:for="{{arkList}}"
        wx:key="ark_id"
        wx:for-item="ark"
        bindtap="onArkTap"
        data-ark-id="{{ark.ark_id}}"
      >
        <view class="ark-item__top">
          <view class="ark-item__name">{{ark.arkname}}</view>
          <view class="ark-item__tag tag-{{ark.finished ? 'done' : (ark.closed ? 'closed' : (ark.stage === '筹建中' ? 'prep' : 'sail'))}}">
            {{ark.finished ? '已成舟' : (ark.closed ? '已解散' : ark.stage)}}
          </view>
        </view>
        <view class="ark-item__course">{{ark.course_title}}</view>
        <view class="ark-item__bottom">
          <view class="progress-bar">
            <view class="progress-bar__fill" style="width: {{ark.progress_percent}}%;"></view>
          </view>
          <text class="progress-text">{{ark.progress_percent}}%</text>
          <text class="ark-item__crew">{{ark.members_str}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="ark-empty" wx:else>
      <text class="ark-empty__icon">🛶</text>
      <text class="ark-empty__text">暂未加入任何方舟</text>
      <text class="ark-empty__tip">在"学习"页选课后可创建或加入方舟</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-wrapper">

    <!-- 学习与成长 -->
    <view class="menu-group">
      <view class="menu-group__title">学习与成长</view>
      <view class="menu-group__list">
        <view class="menu-cell" bindtap="switchToTab" data-tab="/pages/learn/index">
          <text class="cell-icon">📚</text>
          <text class="cell-text">我的课程</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/report/index">
          <text class="cell-icon">📊</text>
          <text class="cell-text">学习汇报</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/shuzhi/index">
          <text class="cell-icon">💎</text>
          <text class="cell-text">塾值明细</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/supervise/index">
          <text class="cell-icon">📐</text>
          <text class="cell-text">学习监督</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 师生与创新 -->
    <view class="menu-group">
      <view class="menu-group__title">师生与创新</view>
      <view class="menu-group__list">
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/goaltalk/index">
          <text class="cell-icon">💬</text>
          <text class="cell-text">目标面谈</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/mentors/index">
          <text class="cell-icon">🤝</text>
          <text class="cell-text">师生关系</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/followup/index">
          <text class="cell-icon">🚀</text>
          <text class="cell-text">创新项目</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 创作与收藏 -->
    <view class="menu-group">
      <view class="menu-group__title">创作与收藏</view>
      <view class="menu-group__list">
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/favorites/index">
          <text class="cell-icon">❤️</text>
          <text class="cell-text">我的收藏</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/article/index">
          <text class="cell-icon">📝</text>
          <text class="cell-text">我的文章</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/all/index">
          <text class="cell-icon">🏫</text>
          <text class="cell-text">全塾动态</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 账户管理 -->
    <view class="menu-group">
      <view class="menu-group__title">账户管理</view>
      <view class="menu-group__list">
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/editprofile/index">
          <text class="cell-icon">✏️</text>
          <text class="cell-text">编辑信息</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="navigateTo" data-url="/pages/changepass/index">
          <text class="cell-icon">🔑</text>
          <text class="cell-text">修改密码</text>
          <text class="cell-arrow">›</text>
        </view>
        <view class="menu-cell" bindtap="logOut">
          <text class="cell-icon">🚪</text>
          <text class="cell-text">退出登录</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 底部安全区 -->
  <view class="safe-area-bottom"></view>

</view>
