/* pages/report-detail/index.wxss — 成绩单详情与错题复盘旗舰视觉 */

.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-bottom: calc(env(safe-area-inset-bottom) + 60rpx);
}

.header-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  color: #ffffff;
  padding: 40rpx 32rpx 34rpx;
  margin: 24rpx 28rpx 20rpx;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 40rpx rgba(91, 33, 182, 0.26);
}

.header-card::before {
  content: '';
  position: absolute;
  top: -70rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.header-top {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.paper-title {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
}

.header-btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.copy-notes-btn {
  margin: 0;
  padding: 10rpx 20rpx;
  line-height: 1.4;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.retake-btn {
  margin: 0;
  padding: 10rpx 22rpx;
  line-height: 1.4;
  font-size: 22rpx;
  font-weight: 800;
  color: #6d28d9;
  background: #ffffff;
  border-radius: 999rpx;
  border: none;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.14);
}

.report-dots-bar {
  position: relative;
  z-index: 1;
  display: flex;
  white-space: nowrap;
  margin-top: 18rpx;
}

.report-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  font-size: 21rpx;
  font-weight: 800;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.report-dot.is-ok {
  background: #34d399;
  color: #064e3b;
}

.report-dot.is-err {
  background: #f87171;
  color: #ffffff;
}

.accuracy-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
  margin-bottom: 10rpx;
}

.acc-pill {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.acc-pill.wrong {
  background: rgba(254, 226, 226, 0.26);
  border-color: rgba(254, 202, 202, 0.35);
}

.filter-bar {
  display: flex;
  gap: 10rpx;
  margin: 4rpx 28rpx 22rpx;
  padding: 8rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  border-radius: 26rpx;
}

.filter-tab {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 16rpx 8rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  white-space: nowrap;
  transition: all 0.18s ease;
}

.filter-tab.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.32);
}

.score-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.score-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-right: 12rpx;
}

.score-value {
  font-size: 52rpx;
  font-weight: 800;
}

.score-value.pass {
  color: #6ee7b7;
}

.score-value.fail {
  color: #fca5a5;
}

.score-percent {
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 14rpx;
  color: rgba(255, 255, 255, 0.9);
}

.test-time {
  position: relative;
  z-index: 1;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 14rpx;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #64748b;
}

.question-list {
  padding: 0 28rpx;
}

.question-card {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 22rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
}

.question-card:nth-child(even),
.question-card.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.13),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.question-card.correct {
  border: 2.5rpx solid rgba(16, 185, 129, 0.38);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(16, 185, 129, 0.14),
    inset 0 3rpx 0 #ffffff;
}

.question-card.wrong {
  border: 2.5rpx solid rgba(244, 63, 94, 0.38);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(244, 63, 94, 0.14),
    inset 0 3rpx 0 #ffffff;
}

.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.question-num {
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
  margin-right: 14rpx;
}

.question-type {
  font-size: 22rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-right: auto;
  white-space: nowrap;
  flex-shrink: 0;
}

.question-result {
  font-size: 23rpx;
  font-weight: 800;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.result-correct {
  color: #15803d;
  background: #dcfce7;
}

.result-wrong {
  color: #dc2626;
  background: #fee2e2;
}

.question-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.55;
  margin-bottom: 22rpx;
}

.options {
  margin-bottom: 20rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  border-radius: 24rpx;
  margin-bottom: 14rpx;
  font-size: 27rpx;
  color: #334155;
  position: relative;
  box-shadow: 0 6rpx 18rpx -6rpx rgba(236, 72, 153, 0.09), inset 0 2rpx 0 #ffffff;
}

.option:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.28);
  box-shadow: 0 6rpx 18rpx -6rpx rgba(99, 102, 241, 0.10), inset 0 2rpx 0 rgba(255, 255, 255, 0.94);
}

.option.has-content {
  border-radius: 24rpx;
}

.option.correct-answer {
  background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
  border: 2.5rpx solid #10b981;
  color: #065f46;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx -6rpx rgba(16, 185, 129, 0.20), inset 0 2rpx 0 #ffffff;
}

.option.user-selected {
  background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
  border: 2.5rpx solid #f43f5e;
  color: #991b1b;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx -6rpx rgba(244, 63, 94, 0.20), inset 0 2rpx 0 #ffffff;
}

.option.correct-answer.user-selected {
  background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
  border: 2.5rpx solid #10b981;
  color: #065f46;
}

.tag-correct {
  margin-left: auto;
  font-size: 22rpx;
  color: #059669;
  font-weight: 800;
  padding-left: 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.tag-wrong {
  margin-left: auto;
  font-size: 22rpx;
  color: #dc2626;
  font-weight: 800;
  padding-left: 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.answer-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  margin-bottom: 14rpx;
  padding-top: 8rpx;
}

.answer-label {
  color: #64748b;
  font-weight: 500;
}

.answer-value {
  font-weight: 800;
}

.text-correct {
  color: #10b981;
}

.text-wrong {
  color: #ef4444;
}

.text-empty {
  color: #94a3b8;
}

.explain-card {
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.25);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-top: 16rpx;
}

.explain-title {
  display: block;
  font-size: 25rpx;
  color: #b45309;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.explain-text {
  font-size: 25rpx;
  color: #78350f;
  line-height: 1.6;
}

.empty {
  text-align: center;
  margin: 28rpx;
  padding: 96rpx 40rpx;
  background: #ffffff;
  border-radius: 28rpx;
  color: #64748b;
  font-size: 28rpx;
}

/* 简答题批阅底部抽屉弹窗 */
.jianda-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(36, 16, 68, 0.44);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.jianda-sheet-card {
  width: 100%;
  max-height: 86vh;
  background:
    radial-gradient(circle at 15% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 85% 0%, rgba(129, 140, 248, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 40%, #f8f7ff 100%);
  border-radius: 48rpx 48rpx 0 0;
  padding: 26rpx 34rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow:
    0 -20rpx 64rpx rgba(109, 40, 217, 0.22),
    inset 0 3rpx 0 #ffffff;
  border-top: 2rpx solid rgba(255, 255, 255, 0.98);
}

.jianda-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.jianda-sheet-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #3b0764;
}

.jianda-sheet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  color: #9333ea;
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.12), inset 0 2rpx 0 #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.jianda-item-card {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 30rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10),
    inset 0 3rpx 0 #ffffff;
}

.jianda-item-card:nth-child(even),
.jianda-item-card.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border: 2rpx solid rgba(129, 140, 248, 0.30);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.jianda-q-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1e1b4b;
  margin-bottom: 14rpx;
  line-height: 1.45;
}

.jianda-reply {
  font-size: 25rpx;
  color: #334155;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.jianda-reply-label {
  font-weight: 700;
  color: #7c3aed;
}

.jianda-ref {
  font-size: 25rpx;
  color: #059669;
  margin-bottom: 14rpx;
  line-height: 1.5;
}

.jianda-ref-label {
  font-weight: 700;
}

.jianda-score-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.jianda-score-label {
  font-size: 25rpx;
  font-weight: 800;
  color: #581c87;
}

.jianda-score-input {
  width: 170rpx;
  height: 76rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 22rpx;
  padding: 0 22rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #1e1b4b;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.jianda-comment-input {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #1e1b4b;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.jianda-submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin: 12rpx 0 0;
  box-shadow: 0 10rpx 26rpx rgba(124, 58, 237, 0.3);
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
