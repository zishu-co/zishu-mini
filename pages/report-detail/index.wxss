/* pages/report-detail/index.wxss */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

.header-card {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  padding: 36rpx 30rpx 32rpx;
  margin: 20rpx 20rpx 16rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.24);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.paper-title {
  font-size: 36rpx;
  font-weight: bold;
  flex: 1;
}

.retake-btn {
  margin: 0;
  padding: 10rpx 24rpx;
  line-height: 1.4;
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #ffffff;
  border-radius: 999rpx;
  border: none;
  flex-shrink: 0;
}

.retake-btn::after {
  border: none;
}

.accuracy-row {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
  margin-bottom: 10rpx;
}

.acc-pill {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  font-weight: 600;
}

.acc-pill.wrong {
  background: rgba(254, 226, 226, 0.24);
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 20rpx 20rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}

.filter-tab.active {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.24);
}

.score-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.score-label {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
}

.score-value.pass {
  color: #4cd964;
}

.score-value.fail {
  color: #ff3b30;
}

.score-percent {
  font-size: 28rpx;
  margin-left: 15rpx;
  opacity: 0.9;
}

.test-time {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 10rpx;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.question-list {
  padding: 0 20rpx;
}

.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.question-card.correct {
  border-left: 8rpx solid #4cd964;
}

.question-card.wrong {
  border-left: 8rpx solid #ff3b30;
}

.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.question-num {
  font-size: 26rpx;
  color: #666;
  margin-right: 15rpx;
}

.question-type {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: auto;
}

.question-result {
  font-size: 26rpx;
  font-weight: bold;
}

.result-correct {
  color: #4cd964;
}

.result-wrong {
  color: #ff3b30;
}

.question-title {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.options {
  margin-bottom: 20rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.option.has-content {
  background: #fff;
  border: 1rpx solid #e0e0e0;
}

.option.correct-answer {
  background: #e8f8ea;
  border: 1rpx solid #4cd964;
  color: #2d8a3e;
}

.option.user-selected {
  background: #fff0f0;
  border: 1rpx solid #ff3b30;
  color: #cc2200;
}

.option.correct-answer.user-selected {
  background: #e8f8ea;
  border: 2rpx solid #4cd964;
  color: #2d8a3e;
}

.tag-correct {
  margin-left: auto;
  font-size: 22rpx;
  color: #4cd964;
  font-weight: bold;
}

.tag-wrong {
  margin-left: auto;
  font-size: 22rpx;
  color: #ff3b30;
  font-weight: bold;
}

.answer-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-bottom: 15rpx;
}

.answer-label {
  color: #666;
}

.answer-value {
  font-weight: bold;
}

.text-correct {
  color: #4cd964;
}

.text-wrong {
  color: #ff3b30;
}

.text-empty {
  color: #999;
}

.explain-card {
  background: #fff8e6;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-top: 15rpx;
}

.explain-title {
  font-size: 26rpx;
  color: #ff9500;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.explain-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.empty {
  text-align: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
