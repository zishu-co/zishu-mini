/* pages/course-detail/index.wxss */
/* 课程详情页样式 */

page {
  background-color: #f5f5f5;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* ========== 加载 / 空状态 ========== */

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-retry {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  color: #aa00ff;
  font-size: 26rpx;
  border: 2rpx solid #aa00ff;
  border-radius: 40rpx;
}

/* ========== 通用卡片 ========== */

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title-bar {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #aa00ff;
  display: inline-block;
}

.empty-section {
  font-size: 26rpx;
  color: #bbb;
  text-align: center;
  padding: 24rpx 0;
}

/* ========== 课程头部 ========== */

.course-header-card {
  background: linear-gradient(135deg, #f3e8ff 0%, #ffffff 100%);
}

.header-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.course-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
  line-height: 1.4;
  flex: 1;
  padding-right: 16rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.action-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.action-btn::after {
  border: none;
}

.select-btn {
  background: linear-gradient(135deg, #c6f, #aa00ff);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(170, 0, 255, 0.25);
}

.quit-btn {
  background-color: #fff0f0;
  color: #fa4126;
  box-shadow: 0 4rpx 12rpx rgba(250, 65, 38, 0.15);
}

.disabled-btn {
  background-color: #f0f0f0;
  color: #999;
}

.course-meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.meta-label {
  font-size: 26rpx;
  color: #999;
}

.meta-value {
  font-size: 26rpx;
  color: #666;
}

.meta-edit {
  font-size: 24rpx;
  color: #aa00ff;
  margin-left: 20rpx;
}

.course-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  margin-top: 8rpx;
}

/* ========== 通用数据表格 ========== */

.data-table {
  width: 100%;
  overflow-x: auto;
}

.table-header {
  display: flex;
  background-color: #f8f4ff;
  border-radius: 8rpx;
  padding: 12rpx 0;
  margin-bottom: 4rpx;
}

.table-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.table-row:last-child {
  border-bottom: none;
}

.th,
.td {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.th {
  font-weight: 600;
  color: #999;
}

.th-index,
.td-index {
  width: 60rpx;
  flex-shrink: 0;
}

.th-name,
.td-name {
  flex: 1;
  min-width: 100rpx;
  padding: 0 8rpx;
}

.th-serial,
.td-serial {
  width: 80rpx;
  flex-shrink: 0;
}

.th-date,
.td-date {
  width: 140rpx;
  flex-shrink: 0;
}

.th-period,
.td-period {
  width: 120rpx;
  flex-shrink: 0;
}

/* 章节名称链接色 */
.td-link {
  color: #aa00ff;
}

/* 可点击的行效果 */
.table-row--link {
  transition: background-color 0.2s;
}

.table-row--link:active {
  background-color: rgba(170, 0, 255, 0.04);
}

/* 日期颜色 */
.text-red { color: #fa4126; }
.text-orange { color: #ff9900; }
.text-blue { color: #0052d9; }
