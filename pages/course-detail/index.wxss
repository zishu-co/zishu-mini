/* pages/course-detail/index.wxss */
/* 课程详情页旗舰版样式 */

page {
  background-color: #f6f5fb;
  color: #0f172a;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
}

/* ========== 加载 / 空状态 ========== */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 220rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #64748b;
}

.empty-retry {
  margin-top: 32rpx;
  padding: 16rpx 52rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.25);
}

/* ========== 品牌紫 Hero 头部卡片 ========== */
.hero-card {
  position: relative;
  overflow: hidden;
  margin: -24rpx -28rpx 28rpx;
  border-radius: 0 0 44rpx 44rpx;
  padding: 38rpx 34rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.28);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.hero-glow--1 {
  width: 240rpx;
  height: 240rpx;
  top: -80rpx;
  right: -60rpx;
}

.hero-glow--2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -50rpx;
  left: -40rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.hero-title-group {
  flex: 1;
  min-width: 0;
}

.director-pill-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.director-pill {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #f3e8ff;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  white-space: nowrap;
}

.director-edit-pill {
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  white-space: nowrap;
}

.course-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.35;
  word-break: break-word;
}

.hero-action {
  flex-shrink: 0;
}

.enroll-btn {
  margin: 0;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  border-radius: 34rpx;
  font-size: 25rpx;
  font-weight: 700;
  border: none;
  white-space: nowrap;
}

.enroll-btn::after {
  border: none;
}

.enroll-btn--select {
  background: #ffffff;
  color: #7c3aed;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}

.enroll-btn--quit {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.enroll-btn--disabled {
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.65);
  text-align: center;
}

.course-desc {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.65;
  margin-bottom: 28rpx;
}

/* 三维数据统计栏 */
.stats-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.stat-label {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
  white-space: nowrap;
}

.stat-divider {
  width: 2rpx;
  height: 28rpx;
  background: rgba(255, 255, 255, 0.24);
}

/* 快捷功能胶囊区 */
.quick-pills {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  font-size: 23rpx;
  font-weight: 600;
  color: #ffffff;
  white-space: nowrap;
  flex-shrink: 0;
  transition: transform 0.15s ease;
}

.quick-pill:active {
  transform: scale(0.97);
  background: rgba(255, 255, 255, 0.28);
}

.quick-pill--quiz {
  background: rgba(250, 204, 21, 0.22);
  border-color: rgba(253, 224, 71, 0.45);
}

.quick-pill__icon {
  font-size: 25rpx;
}

.quick-pill__text {
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
}

.quick-pill__arrow {
  font-size: 26rpx;
  opacity: 0.85;
}

.detail-wrap {
  display: flex;
  flex-direction: column;
}

.tab-panel {
  display: flex;
  flex-direction: column;
}

/* ========== 分段标签栏 Segmented Tabs ========== */
.seg-tabs {
  display: flex;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  border-radius: 28rpx;
  padding: 8rpx;
  gap: 8rpx;
  margin-bottom: 26rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.10);
}

.seg-tab {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 70rpx;
  padding: 0 4rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04), inset 0 1rpx 0 #ffffff;
  white-space: nowrap;
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

.seg-tab__label {
  font-size: 23rpx;
  white-space: nowrap;
}

.seg-tab--active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow:
    0 8rpx 20rpx rgba(124, 58, 237, 0.34),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
}

.seg-tab__count {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(124, 58, 237, 0.12);
  color: #6d28d9;
  white-space: nowrap;
  flex-shrink: 0;
}

.seg-tab--active .seg-tab__count {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
}

/* ========== Tab 1: 纵向章节阶梯卡片 ========== */
.stepper-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chapter-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.16s ease;
}

.chapter-card:nth-child(even),
.chapter-card.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.13),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.chapter-card:active {
  transform: scale(0.98);
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border-color: #fb923c;
}

.chapter-step-badge {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}

.chapter-main {
  flex: 1;
  min-width: 0;
}

.chapter-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.4;
  margin-bottom: 10rpx;
  word-break: break-word;
}

.chapter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chapter-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.chapter-tag--author {
  background: #f5f3ff;
  color: #6d28d9;
}

.chapter-tag--period {
  background: #f1f5f9;
  color: #64748b;
}

.chapter-action {
  flex-shrink: 0;
}

.chapter-action__text {
  font-size: 23rpx;
  font-weight: 700;
  color: #6d28d9;
  background: rgba(124, 58, 237, 0.1);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

/* ========== Tab 2 & 3: 同塾学员卡片 ========== */
.cohort-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cohort-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
}

.cohort-card:nth-child(even),
.cohort-card.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.13),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.cohort-card--finish {
  border-color: rgba(16, 185, 129, 0.14);
}

.cohort-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cohort-avatar--finish {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.cohort-info {
  flex: 1;
  min-width: 0;
}

.cohort-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.cohort-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.cohort-serial-pill {
  font-size: 22rpx;
  font-weight: 600;
  color: #6d28d9;
  background: rgba(124, 58, 237, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.cohort-serial-pill--done {
  color: #059669;
  background: #d1fae5;
}

.cohort-badges-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.cohort-social-pill {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.22);
  white-space: nowrap;
  flex-shrink: 0;
}

.cohort-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10rpx;
}

.cohort-mentor-badge {
  font-size: 23rpx;
  color: #6b7280;
  white-space: nowrap;
}

.cohort-deadline-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.badge-red {
  background: #fef2f2;
  color: #dc2626;
}

.badge-orange {
  background: #fffbeb;
  color: #d97706;
}

.badge-blue {
  background: #eff6ff;
  color: #2563eb;
}

.badge-normal {
  background: #f3f4f6;
  color: #4b5563;
}

.badge-done {
  background: #ecfdf5;
  color: #059669;
}

/* 空面板 */
.panel-empty {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.panel-empty__icon {
  font-size: 72rpx;
}

.panel-empty__text {
  font-size: 26rpx;
  color: #8b859e;
}

/* ========== 塾师选择与编辑弹窗 Modal — Candy Aurora 底部极光抽屉 ========== */
.mentor-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(36, 16, 68, 0.42);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 99;
}

.mentor-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 15% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 85% 0%, rgba(129, 140, 248, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 40%, #f8f7ff 100%);
  border-radius: 48rpx 48rpx 0 0;
  padding: 26rpx 34rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  z-index: 100;
  border-top: 2rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    0 -20rpx 64rpx rgba(109, 40, 217, 0.22),
    inset 0 3rpx 0 #ffffff;
}

.mentor-modal__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
  margin-bottom: 22rpx;
}

.mentor-modal__title {
  font-size: 33rpx;
  font-weight: 800;
  color: #3b0764;
}

.mentor-modal__sub {
  font-size: 24rpx;
  font-weight: 600;
  color: #7c3aed;
  margin-top: 6rpx;
}

.mentor-modal__close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  color: #9333ea;
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.12), inset 0 2rpx 0 #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mentor-modal__body {
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  max-height: 52vh;
}

.mentor-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
}

.mentor-item:nth-child(even),
.mentor-item.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.13),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.mentor-item:active {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%) !important;
  border-color: #fb923c !important;
}

.mentor-item__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mentor-item__info {
  flex: 1;
  min-width: 0;
}

.mentor-item__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.mentor-item__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.mentor-item__role {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: #fef3c7;
  color: #b45309;
  white-space: nowrap;
  flex-shrink: 0;
}

.mentor-item__role--mentor {
  background: rgba(124, 58, 237, 0.1);
  color: #6d28d9;
}

.mentor-item__desc {
  font-size: 22rpx;
  color: #64748b;
}

.mentor-item__cta {
  font-size: 25rpx;
  font-weight: 700;
  color: #6d28d9;
  white-space: nowrap;
  flex-shrink: 0;
}

.mentor-empty {
  text-align: center;
  padding: 48rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}

.mentor-modal__footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.direct-select-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #6d28d9;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.direct-select-btn::after {
  border: none;
}

/* 塾主编辑课程弹窗表单 */
.edit-modal__body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.edit-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 0;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10), inset 0 3rpx 0 #ffffff;
}

.edit-field:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border-color: rgba(129, 140, 248, 0.28);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12), inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.edit-field:focus-within {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border-color: #fb923c;
}

.edit-field__label {
  font-size: 25rpx;
  font-weight: 800;
  color: #581c87;
}

.edit-field__input {
  min-height: 82rpx;
  padding: 0 26rpx;
  border-radius: 24rpx;
