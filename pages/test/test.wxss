/* pages/test/test.wxss */
page {
  background-color: #f6f5fb;
  font-size: 28rpx;
  color: #0f172a;
}

.test-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部试卷横幅 */
.paper-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  padding: 44rpx 32rpx 48rpx;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(91, 33, 182, 0.26);
}

.ptitle {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
  margin-bottom: 12rpx;
}

.paper-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.progress-bar-track {
  margin-top: 18rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #fde047;
  transition: width 0.25s ease;
}

.sheet-dots-bar {
  display: flex;
  white-space: nowrap;
  margin-top: 20rpx;
  gap: 12rpx;
}

.sheet-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.sheet-dot.dot-answered {
  background: #fde047;
  color: #4c1d95;
}

.sheet-dot.dot-correct {
  background: #4ade80;
  color: #064e3b;
}

.sheet-dot.dot-wrong {
  background: #f87171;
  color: #ffffff;
}

.post-filter-tabs {
  display: flex;
  gap: 10rpx;
  margin: 20rpx 28rpx 0;
  padding: 8rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  border-radius: 26rpx;
}

.post-filter-tab {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  font-size: 24rpx;
  font-weight: 700;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  white-space: nowrap;
}

.post-filter-tab.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.32);
}

/* 成绩横幅 */
.score-banner {
  margin: 24rpx 28rpx 0;
  padding: 30rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f5f3ff 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.1);
}

.score-banner__left {
  display: flex;
  flex-direction: column;
}

.score-banner__badge {
  display: inline-block;
  font-size: 23rpx;
  color: #6d28d9;
  background: rgba(124, 58, 237, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  white-space: nowrap;
}

.score-banner__title {
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 700;
}

.score-banner__actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.score-mini-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 54rpx;
  line-height: 54rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  background: #ede9fe;
  color: #6d28d9;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}
.score-mini-btn.buddy {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
}
.score-mini-btn::after {
  border: none;
}

.score-banner__right {
  display: flex;
  align-items: baseline;
  color: #6d28d9;
}

.score-banner__num {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}

.score-banner__unit {
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 6rpx;
}

/* 题目列表与卡片 */
.quiz-list {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.quizblock {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 30rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.question-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.question-index {
  font-size: 26rpx;
  font-weight: 700;
  color: #6d28d9;
}

.type-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.badge-single {
  background: rgba(124, 58, 237, 0.1);
  color: #6d28d9;
}

.badge-multi {
  background: rgba(124, 58, 237, 0.12);
  color: #5b21b6;
}

.badge-slot {
  background: rgba(59, 130, 246, 0.12);
  color: #2563eb;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.55;
  margin-bottom: 24rpx;
}

.itemblock {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.judge-group {
  flex-direction: row;
  gap: 24rpx;
}

.checkitem {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #f5f0ff;
  border: 2rpx solid rgba(109, 40, 217, 0.18);
  border-left: 6rpx solid #a78bfa;
  transition: all 0.2s ease;
}

.checkitem:nth-child(even) {
  background: #e2d9fe;
  border-left: 6rpx solid #6366f1;
}

.checkitem:active,
.checkitem.is-selected {
  background: linear-gradient(135deg, #fef08a 0%, #fde68a 55%, #ffedd5 100%) !important;
  border-color: #d97706 !important;
  border-left: 8rpx solid #d97706 !important;
  box-shadow: 0 6rpx 18rpx rgba(217, 119, 6, 0.22);
}

.judge-item {
  flex: 1;
  justify-content: center;
}

.option-code {
  font-size: 28rpx;
  font-weight: 700;
  color: #6d28d9;
  margin: 0 12rpx 0 8rpx;
}

.option-text {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.45;
  flex: 1;
}

/* 填空题输入行 */
.slot-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.slot-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6d28d9;
  width: 72rpx;
  flex-shrink: 0;
}

.slotinput {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: #faf8ff;
  border: 2rpx solid rgba(124, 58, 237, 0.2);
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #0f172a;
}

/* 判题结果反馈框 */
.feedback-box {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.feedback-box.is-correct {
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
}

.feedback-box.is-wrong {
  background: #fef2f2;
  border: 1rpx solid #fecaca;
}

.checkresult {
  font-weight: 700;
  color: #16a34a;
  margin-bottom: 6rpx;
}

.checkresult.wrong {
  color: #dc2626;
}

.answer-line {
  color: #374151;
}

.answer-val {
  font-weight: 700;
  color: #6d28d9;
}

.explain-line {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 24rpx;
}

.bottomblock {
  height: 180rpx;
}

/* 吸底提交栏 */
.sticky-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  box-shadow: 0 -8rpx 28rpx rgba(15, 23, 42, 0.06);
  z-index: 50;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.28);
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #e5e7eb !important;
  color: #9ca3af !important;
  box-shadow: none !important;
}

.submitted-summary {
  height: 88rpx;
  border-radius: 44rpx;
  background: #f3e8ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submitted-summary__text {
  font-size: 30rpx;
  font-weight: 700;
  color: #7c3aed;
}