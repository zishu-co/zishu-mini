/* pages/exam/index.wxss */
/* 闯关题库大厅旗舰版样式 */

page {
  background-color: #f6f4fa;
  font-size: 28rpx;
  color: #1a1a2e;
}

.page {
  min-height: 100vh;
}

/* ========== Hero Header + 搜索栏 ========== */
.header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #6d28d9 0%, #7c3aed 48%, #aa00ff 100%);
  padding: 40rpx 32rpx 44rpx;
  color: #ffffff;
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(124, 58, 237, 0.26);
}

.header-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.header-glow--1 {
  width: 240rpx;
  height: 240rpx;
  top: -80rpx;
  right: -60rpx;
}

.header-glow--2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -40rpx;
  left: -40rpx;
}

.header-top {
  position: relative;
  z-index: 1;
  margin-bottom: 28rpx;
}

.header-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  margin-bottom: 12rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 10rpx;
}

.header-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.88);
  display: block;
}

/* 搜索框 */
.search-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 40rpx;
  padding: 0 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.12);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #1a1a2e;
}

.search-placeholder {
  color: #9ca3af;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ede9fe;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

/* ========== 试卷卡片列表 ========== */
.paper-list {
  padding: 28rpx 28rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.paper-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 6rpx 22rpx rgba(26, 26, 46, 0.05);
  border: 1rpx solid rgba(170, 0, 255, 0.08);
  transition: transform 0.15s ease;
}

.paper-card:active {
  transform: scale(0.99);
  background: #fcfaff;
}

.paper-seq-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f3e8ff 0%, #ede9fe 100%);
  border: 1rpx solid rgba(170, 0, 255, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.paper-seq-bolt {
  font-size: 24rpx;
  line-height: 1;
}

.paper-seq-num {
  font-size: 24rpx;
  font-weight: 800;
  color: #7c3aed;
  margin-top: 2rpx;
}

.paper-info {
  flex: 1;
  min-width: 0;
}

.paper-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.4;
  margin-bottom: 12rpx;
  word-break: break-word;
}

.paper-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.paper-author-pill {
  font-size: 22rpx;
  color: #7c3aed;
  background: #f5f0ff;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.paper-score-tag {
  font-size: 22rpx;
  color: #d97706;
  background: #fffbeb;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.paper-cta {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(170, 0, 255, 0.24);
}

/* ========== 骨架屏 ========== */
.skeleton-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.skeleton-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: #ede9fe;
  animation: pulse 1.4s ease-in-out infinite;
}

.skeleton-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #f3f0fa;
  animation: pulse 1.4s ease-in-out infinite;
}

.skeleton-line--title {
  width: 75%;
}

.skeleton-line--sub {
  width: 50%;
  height: 22rpx;
}

.skeleton-btn {
  width: 130rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #ede9fe;
  animation: pulse 1.4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

/* ========== 空状态 ========== */
.empty-card {
  margin: 36rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(26, 26, 46, 0.04);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: #8b859e;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(170, 0, 255, 0.25);
}

.safe-bottom {
  height: 120rpx;
}
