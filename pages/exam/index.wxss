/* pages/exam/index.wxss */
/* 闯关题库大厅旗舰版样式 */

page {
  background-color: #f6f5fb;
  font-size: 28rpx;
  color: #1a1a2e;
}

.page {
  min-height: 100vh;
}

/* ========== Hero Header + 搜索栏 ========== */
.header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  padding: 40rpx 32rpx 44rpx;
  color: #ffffff;
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 16rpx 40rpx rgba(91, 33, 182, 0.25);
}

.header-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.header-glow--1 {
  width: 240rpx;
  height: 240rpx;
  top: -80rpx;
  right: -60rpx;
}

.header-glow--2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -40rpx;
  left: -40rpx;
}

.header-top {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 22rpx;
}

.header-quick-btns {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.header-quick-pill {
  padding: 12rpx 4rpx;
  border-radius: 999rpx;
  background: #fde047;
  color: #4c1d95;
  font-size: 21rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
}

.header-quick-pill.outline {
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #ffffff;
  font-weight: 700;
}

.exam-cat-pills {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx 10rpx;
  background: rgba(237, 233, 254, 0.24);
  border: 1.5rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 26rpx;
}

.exam-cat-pill {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 10rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.20);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.exam-cat-pill.active {
  background: linear-gradient(135deg, #ffffff 0%, #faf5ff 100%);
  color: #6d28d9;
  font-weight: 800;
  border-color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.20);
}

.header-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  margin-bottom: 12rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 10rpx;
}

.header-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.88);
  display: block;
}

/* 搜索框 */
.search-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 40rpx;
  padding: 0 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.12);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #1a1a2e;
}

.search-placeholder {
  color: #9ca3af;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ede9fe;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

/* ========== 试卷卡片列表 ========== */
.paper-list {
  padding: 28rpx 28rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.paper-card {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 32rpx;
  padding: 28rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
}

.paper-card:nth-child(even),
.paper-card.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.13),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.paper-card:active {
  transform: scale(0.98);
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%) !important;
  border-color: #fb923c !important;
}

.paper-seq-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f3e8ff 0%, #ede9fe 100%);
  border: 1rpx solid rgba(124, 58, 237, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.paper-seq-bolt {
  font-size: 24rpx;
  line-height: 1;
}

.paper-seq-num {
  font-size: 24rpx;
  font-weight: 800;
  color: #7c3aed;
  margin-top: 2rpx;
}

.paper-info {
  flex: 1;
  min-width: 0;
}

.paper-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.4;
  margin-bottom: 12rpx;
  word-break: break-word;
}

.paper-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.paper-author-pill {
  font-size: 22rpx;
  color: #7c3aed;
  background: #f5f0ff;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
  white-space: nowrap;
}

.paper-score-tag {
  font-size: 22rpx;
  color: #d97706;
  background: #fffbeb;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
  white-space: nowrap;
}

.paper-cta {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}

/* ========== 骨架屏 ========== */
.skeleton-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.skeleton-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: #ede9fe;
  animation: pulse 1.4s ease-in-out infinite;
}

.skeleton-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #f3f0fa;
  animation: pulse 1.4s ease-in-out infinite;
}

.skeleton-line--title {
  width: 75%;
}

.skeleton-line--sub {
  width: 50%;
  height: 22rpx;
}

.skeleton-btn {
  width: 130rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #ede9fe;
  animation: pulse 1.4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

/* ========== 空状态 ========== */
.empty-card {
  margin: 36rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(26, 26, 46, 0.04);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: #8b859e;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.25);
}

.safe-bottom {
  height: 120rpx;
}

/* ========== 共创出题与组卷底部抽屉弹窗 — Candy Aurora 极光糖果抽屉 ========== */
.exam-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(36, 16, 68, 0.42);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  padding: 0;
}

.exam-sheet-card {
  width: 100%;
  max-height: 86vh;
  background:
    radial-gradient(circle at 15% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 85% 0%, rgba(129, 140, 248, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 40%, #f8f7ff 100%);
  border-radius: 48rpx 48rpx 0 0;
  padding: 26rpx 34rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  border-top: 2rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    0 -20rpx 64rpx rgba(109, 40, 217, 0.22),
    inset 0 3rpx 0 #ffffff;
}

.exam-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.exam-sheet-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #3b0764;
}

.exam-sheet-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  color: #9333ea;
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.12), inset 0 2rpx 0 #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exam-type-pills {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 10rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  border-radius: 28rpx;
}

.exam-type-pill {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04), inset 0 1rpx 0 #ffffff;
  white-space: nowrap;
  transition: all 0.18s ease;
}

.exam-type-pill.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.34), inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
}

.exam-form-group {
  margin-bottom: 20rpx;
  padding: 22rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10), inset 0 3rpx 0 #ffffff;
}

.exam-form-group:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border-color: rgba(129, 140, 248, 0.28);
  box-shadow: 0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12), inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.exam-form-group:focus-within {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border-color: #fb923c;
}

.exam-form-group-last {
  margin-bottom: 28rpx;
}

.exam-form-label {
  display: inline-flex;
  align-items: center;
  font-size: 25rpx;
  font-weight: 800;
  color: #581c87;
  margin-bottom: 12rpx;
}

.exam-form-input {
  width: 100%;
  min-height: 82rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 24rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.exam-form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 26rpx;
  padding: 20rpx 26rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  box-sizing: border-box;
  line-height: 1.55;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.exam-options-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.exam-option-input {
  min-height: 82rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.28);
  border-radius: 24rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  color: #1e1b4b;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx -4rpx rgba(236, 72, 153, 0.10), inset 0 2rpx 0 #ffffff;
}

.exam-option-input:nth-child(even) {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
}

.exam-bank-scroll {
  max-height: 400rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(192, 132, 252, 0.24);
  border-radius: 32rpx;
  padding: 16rpx;
  background: rgba(255, 250, 254, 0.72);
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 8rpx rgba(147, 51, 234, 0.05);
}

.exam-bank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  border-radius: 28rpx;
  box-shadow:
    0 8rpx 22rpx -6rpx rgba(236, 72, 153, 0.10),
    inset 0 2rpx 0 #ffffff;
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), background 0.16s ease;
}

.exam-bank-item:nth-child(even),
.exam-bank-item.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 8rpx 22rpx -6rpx rgba(99, 102, 241, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.94);
}

.exam-bank-item:last-child {
  margin-bottom: 0;
}

.exam-bank-item.selected {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%) !important;
  border: 3rpx solid #fb923c !important;
  box-shadow:
    0 12rpx 28rpx -6rpx rgba(251, 146, 60, 0.24),
    0 0 0 4rpx rgba(251, 146, 60, 0.12),
    inset 0 3rpx 0 #ffffff !important;
}

.exam-bank-item-main {
  flex: 1;
  padding-right: 16rpx;
  min-width: 0;
}

.exam-bank-item-type {
  font-size: 22rpx;
  color: #7c3aed;
  font-weight: 800;
  margin-right: 10rpx;
}

.exam-bank-item-title {
  font-size: 25rpx;
  color: #0f172a;
  font-weight: 500;
}

.exam-bank-item-check {
  font-size: 24rpx;
  font-weight: 700;
  color: #94a3b8;
  flex-shrink: 0;
}

.exam-bank-item-check.selected {
  color: #7c3aed;
}

.exam-sheet-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0;
  box-shadow: 0 10rpx 26rpx rgba(124, 58, 237, 0.3);
}
