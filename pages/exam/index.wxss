/* pages/exam/index.wxss */
/* 闯关题库大厅旗舰版样式 */

page {
  background-color: #f6f5fb;
  font-size: 28rpx;
  color: #1a1a2e;
}

.page {
  min-height: 100vh;
}

/* ========== Hero Header + 搜索栏 ========== */
.header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  padding: 40rpx 32rpx 44rpx;
  color: #ffffff;
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 16rpx 40rpx rgba(91, 33, 182, 0.25);
}

.header-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.header-glow--1 {
  width: 240rpx;
  height: 240rpx;
  top: -80rpx;
  right: -60rpx;
}

.header-glow--2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -40rpx;
  left: -40rpx;
}

.header-top {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 22rpx;
}

.header-quick-btns {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.header-quick-pill {
  padding: 12rpx 4rpx;
  border-radius: 999rpx;
  background: #fde047;
  color: #4c1d95;
  font-size: 21rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
}

.header-quick-pill.outline {
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #ffffff;
  font-weight: 700;
}

.exam-cat-pills {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx 10rpx;
  background: rgba(237, 233, 254, 0.24);
  border: 1.5rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 26rpx;
}

.exam-cat-pill {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 10rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.20);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.exam-cat-pill.active {
  background: linear-gradient(135deg, #ffffff 0%, #faf5ff 100%);
  color: #6d28d9;
  font-weight: 800;
  border-color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.20);
}

.header-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  margin-bottom: 12rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 10rpx;
}

.header-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.88);
  display: block;
}

/* 搜索框 */
.search-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 40rpx;
  padding: 0 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.12);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #1a1a2e;
}

.search-placeholder {
  color: #9ca3af;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ede9fe;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

/* ========== 试卷卡片列表 ========== */
.paper-list {
  padding: 28rpx 28rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.paper-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 6rpx 22rpx rgba(26, 26, 46, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  transition: transform 0.15s ease;
}

.paper-card:active {
  transform: scale(0.99);
  background: #fcfaff;
}

.paper-seq-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f3e8ff 0%, #ede9fe 100%);
  border: 1rpx solid rgba(124, 58, 237, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.paper-seq-bolt {
  font-size: 24rpx;
  line-height: 1;
}

.paper-seq-num {
  font-size: 24rpx;
  font-weight: 800;
  color: #7c3aed;
  margin-top: 2rpx;
}

.paper-info {
  flex: 1;
  min-width: 0;
}

.paper-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.4;
  margin-bottom: 12rpx;
  word-break: break-word;
}

.paper-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.paper-author-pill {
  font-size: 22rpx;
  color: #7c3aed;
  background: #f5f0ff;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
  white-space: nowrap;
}

.paper-score-tag {
  font-size: 22rpx;
  color: #d97706;
  background: #fffbeb;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
  white-space: nowrap;
}

.paper-cta {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24);
}

/* ========== 骨架屏 ========== */
.skeleton-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.skeleton-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: #ede9fe;
  animation: pulse 1.4s ease-in-out infinite;
}

.skeleton-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #f3f0fa;
  animation: pulse 1.4s ease-in-out infinite;
}

.skeleton-line--title {
  width: 75%;
}

.skeleton-line--sub {
  width: 50%;
  height: 22rpx;
}

.skeleton-btn {
  width: 130rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #ede9fe;
  animation: pulse 1.4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

/* ========== 空状态 ========== */
.empty-card {
  margin: 36rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(26, 26, 46, 0.04);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: #8b859e;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.25);
}

.safe-bottom {
  height: 120rpx;
}

/* ========== 共创出题与组卷底部抽屉弹窗 ========== */
.exam-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.56);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.exam-sheet-card {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow: 0 -16rpx 48rpx rgba(15, 23, 42, 0.16);
}

.exam-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.exam-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.exam-sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  font-size: 28rpx;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exam-type-pills {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 10rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  border-radius: 26rpx;
}

.exam-type-pill {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  white-space: nowrap;
  transition: all 0.18s ease;
}

.exam-type-pill.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.32);
}

.exam-form-group {
  margin-bottom: 20rpx;
}

.exam-form-group-last {
  margin-bottom: 28rpx;
}

.exam-form-label {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 10rpx;
}

.exam-form-input {
  width: 100%;
  height: 78rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.exam-form-textarea {
  width: 100%;
  height: 148rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #0f172a;
  box-sizing: border-box;
  line-height: 1.5;
}

.exam-options-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.exam-option-input {
  height: 74rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 0 18rpx;
  font-size: 25rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.exam-bank-scroll {
  max-height: 360rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 22rpx;
  padding: 12rpx 16rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.exam-bank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx dashed #e2e8f0;
  border-radius: 16rpx;
  transition: background 0.15s ease;
}

.exam-bank-item:last-child {
  border-bottom: none;
}

.exam-bank-item.selected {
  background: rgba(124, 58, 237, 0.1);
}

.exam-bank-item-main {
  flex: 1;
  padding-right: 16rpx;
  min-width: 0;
}

.exam-bank-item-type {
  font-size: 22rpx;
  color: #7c3aed;
  font-weight: 800;
  margin-right: 10rpx;
}

.exam-bank-item-title {
  font-size: 25rpx;
  color: #0f172a;
  font-weight: 500;
}

.exam-bank-item-check {
  font-size: 24rpx;
  font-weight: 700;
  color: #94a3b8;
  flex-shrink: 0;
}

.exam-bank-item-check.selected {
  color: #7c3aed;
}

.exam-sheet-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0;
  box-shadow: 0 10rpx 26rpx rgba(124, 58, 237, 0.3);
}
