/* pages/exam/index.wxss */
page {
  background-color: #f5f5f5;
  font-size: 28rpx;
}

.header {
  background: linear-gradient(135deg, #c6a0ff, #aa00ff);
  padding: 40rpx 30rpx 50rpx;
  color: white;
}
.header-title {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}
.header-sub {
  font-size: 26rpx;
  opacity: 0.85;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.paper-list {
  padding: 20rpx 30rpx;
}

.paper-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.paper-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.paper-meta {
  font-size: 22rpx;
  color: #888;
}

.paper-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.empty {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 26rpx;
}

.safe-bottom {
  height: 120rpx;
}
