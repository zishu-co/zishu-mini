<view class="page">
  <view class="header">
    <text class="header-title">🏆 闯关答题中心</text>
    <text class="header-sub">共 {{papers.length || 0}} 套精选试卷 · 测验巩固所学，解锁学霸勋章</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>正在加载闯关题库...</text>
  </view>

  <view class="paper-list" wx:if="{{!loading}}">
    <view class="paper-card" wx:for="{{papers}}" wx:key="testpaperid" bindtap="onGoTest" data-testid="{{item.testpaperid}}">
      <view class="paper-info">
        <view class="paper-title">⚡ {{item.testpaper_title}}</view>
        <view class="paper-meta">
          <text>出题塾师：{{item.testpaper_author || '自塾教研组'}} · 100分制闯关</text>
        </view>
      </view>
      <view class="paper-arrow">挑战 ›</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && papers.length == 0}}">
    <text>暂无闯关试卷</text>
  </view>

  <view class="safe-bottom"></view>
</view>
