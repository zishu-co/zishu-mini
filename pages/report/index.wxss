/** pages/report/index.wxss */
page {
  background-color: #f5f5f5;
  font-size: 28rpx;
}

.header {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  padding: 40rpx 30rpx 50rpx;
  color: white;
}
.header-title {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}
.header-sub {
  font-size: 26rpx;
  opacity: 0.85;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.record-list {
  padding: 20rpx 30rpx;
}

.record-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
}

.record-score {
  font-size: 32rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.record-score.score-excellent {
  background: #d1fae5;
  color: #059669;
}
.record-score.score-good {
  background: #dbeafe;
  color: #2563eb;
}
.record-score.score-ok {
  background: #fef3c7;
  color: #d97706;
}
.record-score.score-fail {
  background: #fee2e2;
  color: #dc2626;
}

.record-meta {
  font-size: 22rpx;
  color: #888;
}

.empty {
  text-align: center;
  padding: 80rpx;
  color: #999;
}

.safe-bottom {
  height: 120rpx;
}
