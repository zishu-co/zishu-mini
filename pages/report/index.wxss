/** pages/report/index.wxss */
page {
  background-color: #f6f5fb;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding-top: 24rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx 24rpx;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 32rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(91, 33, 182, 0.26);
}

.hero-card::after {
  content: "";
  position: absolute;
  top: -70rpx;
  right: -50rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.25) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.hero-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.hero-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.hero-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.88;
}

.hero-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
}

.stats-grid {
  display: flex;
  gap: 16rpx;
}

.stat-box {
  flex: 1;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 22rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.08);
}

.stat-val {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #6d28d9;
  margin-bottom: 4rpx;
}

.stat-lbl {
  font-size: 22rpx;
  color: #64748b;
}

.mode-switch-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 20rpx;
}

.mode-switch-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #ffffff;
  color: #475569;
  font-size: 26rpx;
  font-weight: 700;
  border: 2rpx solid rgba(124, 58, 237, 0.12);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}

.mode-switch-btn.active {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.25);
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 20rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.1);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
}

.filter-tab.active {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 700;
  border-color: transparent;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.25);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 24rpx 20rpx;
  padding: 16rpx 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.1);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}

.search-icon {
  font-size: 26rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.search-clear {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 4rpx 8rpx;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #94a3b8;
}

.record-list {
  padding: 0 24rpx;
}

.record-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.grade-badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.grade-badge.grade-s {
  background: #fef3c7;
  color: #b45309;
}

.grade-badge.grade-a {
  background: #ede9fe;
  color: #7c3aed;
}

.grade-badge.grade-b {
  background: #dcfce7;
  color: #15803d;
}

.grade-badge.grade-fail {
  background: #fee2e2;
  color: #dc2626;
}

.record-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 18rpx;
}

.record-score {
  font-size: 30rpx;
  font-weight: 800;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.record-score.score-excellent {
  background: #d1fae5;
  color: #059669;
}
.record-score.score-good {
  background: #ede9fe;
  color: #7c3aed;
}
.record-score.score-ok {
  background: #fef3c7;
  color: #d97706;
}
.record-score.score-fail {
  background: #fee2e2;
  color: #dc2626;
}

.progress-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.progress-track {
  flex: 1;
  height: 14rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7c3aed 0%, #5b21b6 100%);
}

.progress-fill.score-excellent {
  background: linear-gradient(90deg, #10b981 0%, #059669 100%);
}

.progress-fill.score-fail {
  background: linear-gradient(90deg, #f87171 0%, #dc2626 100%);
}

.progress-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
  width: 68rpx;
  text-align: right;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.record-meta {
  font-size: 24rpx;
  color: #94a3b8;
}

.record-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.retake-chip {
  font-size: 22rpx;
  font-weight: 600;
  color: #7c3aed;
  background: #f5f3ff;
  border: 1rpx solid rgba(124, 58, 237, 0.2);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.record-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #7c3aed;
}

.empty-card {
  margin: 24rpx;
  padding: 72rpx 40rpx;
  background: #ffffff;
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 36rpx;
}

.cta-btn {
  width: 360rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.28);
}

.cta-btn::after {
  border: none;
}

.safe-bottom {
  height: 120rpx;
}
