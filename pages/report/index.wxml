<view class="page">
  <!-- 品牌紫旗舰汇总卡片 -->
  <view class="hero-card">
    <view class="hero-head">
      <view>
        <text class="hero-title">学习汇报</text>
        <text class="hero-sub">每一次测评与学时申报都是成长的刻度</text>
      </view>
      <view class="hero-tag" bindtap="{{reportMode === 'hours' ? 'goToLearn' : 'goToExam'}}">
        {{reportMode === 'hours' ? '📚 去申报学时 ›' : '🏆 去题库闯关 ›'}}
      </view>
    </view>

    <view class="stats-grid">
      <view class="stat-box">
        <text class="stat-val">{{records.length}} 次</text>
        <text class="stat-lbl">累计闯关</text>
      </view>
      <view class="stat-box">
        <text class="stat-val">{{avgScore}} 分</text>
        <text class="stat-lbl">平均得分</text>
      </view>
      <view class="stat-box">
        <text class="stat-val">{{totalGrantedHours}}h</text>
        <text class="stat-lbl">获批学时</text>
      </view>
    </view>
  </view>

  <!-- 顶部分栏切换: 107-fetch-trans.md vs 115-report.md -->
  <view class="mode-switch-bar">
    <view
      class="mode-switch-btn {{reportMode === 'exam' ? 'active' : ''}}"
      data-mode="exam"
      bindtap="onSwitchReportMode"
    >🎯 闯关测评成绩 ({{records.length}})</view>
    <view
      class="mode-switch-btn {{reportMode === 'hours' ? 'active' : ''}}"
      data-mode="hours"
      bindtap="onSwitchReportMode"
    >⏱️ 学时汇报详单 ({{hourReports.length}})</view>
  </view>

  <block wx:if="{{reportMode === 'exam'}}">
  <!-- 筛选标签栏 -->
  <view class="filter-tabs">
    <view
      class="filter-tab {{activeFilter === 'all' ? 'active' : ''}}"
      bindtap="switchFilter"
      data-filter="all"
    >
      全部
    </view>
    <view
      class="filter-tab {{activeFilter === 'excellent' ? 'active' : ''}}"
      bindtap="switchFilter"
      data-filter="excellent"
    >
      优秀 ≥80%
    </view>
    <view
      class="filter-tab {{activeFilter === 'pass' ? 'active' : ''}}"
      bindtap="switchFilter"
      data-filter="pass"
    >
      及格 ≥60%
    </view>
    <view
      class="filter-tab {{activeFilter === 'fail' ? 'active' : ''}}"
      bindtap="switchFilter"
      data-filter="fail"
    >
      待提升 &lt;60%
    </view>
  </view>

  <!-- 实时关键词搜索 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      type="text"
      placeholder="搜索测评试卷名称..."
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>正在加载闯关记录...</text>
  </view>

  <!-- 成绩单列表 -->
  <view class="record-list" wx:if="{{!loading && filteredRecords.length > 0}}">
    <view
      class="record-card"
      wx:for="{{filteredRecords}}"
      wx:key="pperformid"
      data-pperformid="{{item.pperformid}}"
      data-paperid="{{item.testpaperid}}"
      bindtap="onViewDetail"
    >
      <view class="record-top">
        <view class="grade-badge {{item._gradeClass}}">{{item._gradeBadge}}</view>
        <text class="record-score {{item._scoreClass}}">
          {{item.test_score}} / {{item.full_score}}
        </text>
      </view>

      <view class="record-title">{{item.testpaper_title || '未命名测评卷'}}</view>

      <view class="progress-wrap">
        <view class="progress-track">
          <view class="progress-fill {{item._scoreClass}}" style="width: {{item._percent}}%"></view>
        </view>
        <text class="progress-pct">{{item._percent}}%</text>
      </view>

      <view class="record-footer">
        <text class="record-meta">完成时间：{{item.test_time || '近期'}}</text>
        <view class="record-actions">
          <text
            wx:if="{{item.testpaperid}}"
            class="retake-chip"
            catchtap="onRetakePaper"
            data-paperid="{{item.testpaperid}}"
          >🔄 再刷本卷</text>
          <text class="record-action">查看解析 ›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 丰富空状态 -->
  <view class="empty-card" wx:if="{{!loading && filteredRecords.length === 0}}">
    <view class="empty-icon">🎯</view>
    <text class="empty-title">暂无符合条件的考试记录</text>
    <text class="empty-desc">快去完成一场闯关测评，检验你的学习成果吧</text>
    <button class="cta-btn" bindtap="goToExam">⚡ 去闯关答题</button>
  </view>
  </block>

  <!-- 115-report.md: 学时汇报详单视图 -->
  <block wx:if="{{reportMode === 'hours'}}">
    <view class="record-list" wx:if="{{!loading && hourReports.length > 0}}">
      <view
        class="record-card"
        wx:for="{{hourReports}}"
        wx:key="id"
      >
        <view class="record-top">
          <view class="grade-badge grade-a">📚 {{item.target_type || '课程学习'}}</view>
          <text class="record-score score-excellent">+{{item.time_granted || 0}}h</text>
        </view>
        <view class="record-title">{{item.target_title || '学时申报事项'}}</view>
        <view class="record-footer">
          <text class="record-meta">获批时间：{{item._grantTimeStr}}</text>
          <text class="record-action" bindtap="goToLearn">继续共学 ›</text>
        </view>
      </view>
    </view>
    <view class="empty-card" wx:if="{{!loading && hourReports.length === 0}}">
      <view class="empty-icon">⏱️</view>
      <text class="empty-title">暂无学时汇报记录</text>
      <text class="empty-desc">前往课程学习页完成章节测试并申报学时，即可在此查看详单</text>
      <button class="cta-btn" bindtap="goToLearn">📚 去选课与申报学时</button>
    </view>
  </block>

  <view class="safe-bottom"></view>
</view>
