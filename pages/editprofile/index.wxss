.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding-top: 24rpx;
  padding-bottom: 48rpx;
}

.preview-card {
  margin: 0 24rpx 24rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 28rpx;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.24);
}

.preview-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 26rpx;
}

.preview-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 3rpx solid rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.preview-avatar-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
}

.preview-info {
  flex: 1;
  overflow: hidden;
}

.preview-name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.preview-name {
  font-size: 36rpx;
  font-weight: 800;
}

.preview-gender-pill,
.preview-region-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
}

.preview-goal {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.completeness-row {
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.completeness-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.completeness-pct {
  font-weight: 700;
}

.completeness-track {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  overflow: hidden;
}

.completeness-fill {
  height: 100%;
  background: #fde047;
  border-radius: 999rpx;
}

.form-card {
  margin: 0 24rpx 32rpx;
  padding: 36rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  background: #f8fafc;
}

.form-input:focus {
  border-color: #7c3aed;
  background: #fff;
}

.radio-group {
  display: flex;
  gap: 24rpx;
}

.radio-item {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #475569;
  background: #f8fafc;
}

.radio-checked {
  border-color: #7c3aed;
  background: #f3e8ff;
  color: #7c3aed;
  font-weight: 600;
}

.social-tag-presets {
  margin-bottom: 24rpx;
}

.social-tag-hint {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 14rpx;
}

.social-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.social-tag-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 600;
}

.social-tag-chip:active {
  background: #ede9fe;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  background: #f8fafc;
  min-height: 200rpx;
  resize: none;
}

.form-textarea:focus {
  border-color: #7c3aed;
  background: #fff;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.error-tip {
  padding: 16rpx 0;
  color: #ef4444;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.25);
}

.submit-btn::after {
  border: none;
}