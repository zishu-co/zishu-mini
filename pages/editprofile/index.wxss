.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-top: 0;
  padding-bottom: 48rpx;
}

.preview-card {
  position: relative;
  overflow: hidden;
  margin: 0 0 28rpx;
  padding: 36rpx 32rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.26);
}

.preview-card::after {
  content: "";
  position: absolute;
  top: -70rpx;
  right: -50rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.25) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.preview-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 26rpx;
}

.preview-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 3rpx solid rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  backdrop-filter: blur(8px);
}

.preview-avatar-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
}

.preview-info {
  flex: 1;
  overflow: hidden;
}

.preview-name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.preview-name {
  font-size: 36rpx;
  font-weight: 800;
}

.preview-gender-pill,
.preview-region-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
}

.preview-goal {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.completeness-row {
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.completeness-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.completeness-pct {
  font-weight: 700;
}

.completeness-track {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  overflow: hidden;
}

.completeness-fill {
  height: 100%;
  background: #fde047;
  border-radius: 999rpx;
}

.form-card {
  margin: 0 24rpx 32rpx;
  padding: 36rpx 30rpx;
  background: #fff;
  border-radius: 28rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 24rpx;
}

.section-title--spaced {
  margin-top: 48rpx;
}

.section-title--photo {
  margin-top: 36rpx;
}

.form-item {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  border: 1.5rpx solid rgba(109, 40, 217, 0.16);
  border-left: 6rpx solid #a78bfa;
  background: #f5f0ff;
  transition: all 0.2s ease;
}

.form-item:nth-child(even) {
  background: #e2d9fe;
  border-left: 6rpx solid #6366f1;
}

.form-item:focus-within {
  background: linear-gradient(135deg, #fef08a 0%, #fde68a 55%, #ffedd5 100%);
  border-color: #d97706;
  border-left: 8rpx solid #d97706;
  box-shadow: 0 6rpx 18rpx rgba(217, 119, 6, 0.20);
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #334155;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  font-size: 28rpx;
  background: #f8fafc;
}

.form-input:focus {
  border-color: #7c3aed;
  background: #fff;
}

.radio-group {
  display: flex;
  gap: 24rpx;
}

.radio-item {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #475569;
  background: #f8fafc;
}

.radio-checked {
  border-color: #7c3aed;
  background: #f5f3ff;
  color: #6d28d9;
  font-weight: 700;
}

.city-preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.city-chip {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 600;
}

.city-chip.active {
  background: #ede9fe;
  border-color: #7c3aed;
  color: #6d28d9;
}

.social-tag-presets {
  margin-bottom: 24rpx;
}

.social-tag-hint {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 14rpx;
}

.social-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.social-tag-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  color: #6d28d9;
  font-size: 24rpx;
  font-weight: 600;
}

.social-tag-chip:active {
  background: #ede9fe;
}

.social-tag-chip.active {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #5b21b6 100%);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  font-size: 28rpx;
  background: #f8fafc;
  min-height: 200rpx;
  resize: none;
}

.form-textarea:focus {
  border-color: #7c3aed;
  background: #fff;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 个人风采照片墙 */
.photo-wall-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 16rpx 0 32rpx;
}

.photo-wall-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid #e2e8f0;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.05);
}

.photo-wall-img {
  width: 100%;
  height: 100%;
}

.photo-wall-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  background: rgba(15, 23, 42, 0.68);
  color: #ffffff;
  border-radius: 50%;
  font-size: 22rpx;
}

.photo-wall-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #a78bfa;
  background: #f5f3ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6d28d9;
  font-size: 22rpx;
  font-weight: 600;
}

.photo-wall-plus {
  font-size: 40rpx;
  line-height: 1;
}

.photo-wall-upload-text {
  margin-top: 8rpx;
}

.error-tip {
  padding: 16rpx 0;
  color: #ef4444;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #5b21b6 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.submit-btn::after {
  border: none;
}