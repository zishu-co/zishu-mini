.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding-top: 24rpx;
}

.form-card {
  margin: 0 24rpx 32rpx;
  padding: 36rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  background: #f8fafc;
}

.form-input:focus {
  border-color: #7c3aed;
  background: #fff;
}

.radio-group {
  display: flex;
  gap: 24rpx;
}

.radio-item {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #475569;
  background: #f8fafc;
}

.radio-checked {
  border-color: #7c3aed;
  background: #f3e8ff;
  color: #7c3aed;
  font-weight: 600;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  background: #f8fafc;
  min-height: 200rpx;
  resize: none;
}

.form-textarea:focus {
  border-color: #7c3aed;
  background: #fff;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.error-tip {
  padding: 16rpx 0;
  color: #ef4444;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.25);
}

.submit-btn::after {
  border: none;
}