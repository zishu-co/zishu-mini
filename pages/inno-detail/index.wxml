<view class="page">
  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <t-loading theme="circular" size="40rpx" text="加载中..." />
  </view>

  <!-- 项目不存在 / 加载失败 -->
  <view class="empty-state" wx:if="{{!loading && !project}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">项目不存在或加载失败</text>
    <button class="retry-btn" bindtap="onRetry">重新加载</button>
  </view>

  <!-- 项目详情 -->
  <view class="detail-wrap" wx:if="{{!loading && project}}">

    <!-- 品牌紫 Hero Header Card -->
    <view class="hero-card">
      <view class="hero-top">
        <view class="serial-tag">{{project.task_serial || '—'}}</view>
        <view class="status-tag status-{{project._statusColor}}">
          {{project._statusText}}
        </view>
      </view>

      <view class="project-title">{{project.title || '无标题'}}</view>

      <view class="hero-bottom">
        <view class="bounty-badge">
          <text class="bounty-text">💰 {{project.bonus || 0}} 塾值</text>
        </view>
        <view class="hero-meta" wx:if="{{project.planed_hour}}">
          <text>⏱️ 建议 {{project.planed_hour}}h</text>
        </view>
      </view>
    </view>

    <!-- 3-Step 里程碑进度条 -->
    <view class="milestone-card">
      <view class="milestone-title">项目里程碑</view>
      <view class="milestone-steps">
        <view class="milestone-step active">
          <view class="step-dot">🚀</view>
          <view class="step-label">开始：{{project._startDate}}</view>
        </view>
        <view class="milestone-line {{project._step2Active ? 'active' : ''}}"></view>
        <view class="milestone-step {{project._step2Active ? 'active' : ''}}">
          <view class="step-dot">⏱️</view>
          <view class="step-label">半程：{{project.half_progress || '进行中'}}</view>
        </view>
        <view class="milestone-line {{project._step3Active ? 'active' : ''}}"></view>
        <view class="milestone-step {{project._step3Active ? 'active' : ''}}">
          <view class="step-dot">🏁</view>
          <view class="step-label {{project._isDeadlinePassed ? 'text-red' : ''}}">截止：{{project._deadline}}</view>
        </view>
      </view>
    </view>

    <!-- 基本信息卡片 -->
    <view class="card">
      <view class="card-title-bar">项目信息</view>
      <view class="info-grid">
        <view
          class="info-row clickable"
          data-role="发布人"
          data-name="{{project.publisher}}"
          data-userid="{{project.publisher_id}}"
          bindtap="onContactProjectPeer"
        >
          <text class="info-label">发布人</text>
          <view class="info-value-with-action">
            <text class="info-value">{{project.publisher || '—'}}</text>
            <text wx:if="{{project.publisher}}" class="peer-contact-pill">👋 联系发布人 ›</text>
          </view>
        </view>
        <view
          class="info-row {{project.taker ? 'clickable' : ''}}"
          data-role="执行人"
          data-name="{{project.taker}}"
          data-userid="{{project.taker_id}}"
          bindtap="onContactProjectPeer"
        >
          <text class="info-label">执行人</text>
          <view class="info-value-with-action">
            <text class="info-value">{{project.taker || '待认领'}}</text>
            <text wx:if="{{project.taker}}" class="peer-contact-pill">🤝 约TA协作 ›</text>
          </view>
        </view>
        <view
          class="info-row clickable"
          wx:if="{{project.shushi}}"
          data-role="指导塾师"
          data-name="{{project.shushi}}"
          data-userid="{{project.shushi_id}}"
          bindtap="onContactProjectPeer"
        >
          <text class="info-label">塾师</text>
          <view class="info-value-with-action">
            <text class="info-value">{{project.shushi}}</text>
            <text class="peer-contact-pill">🎓 请教塾师 ›</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-label">赏金</text>
          <text class="info-value bonus">{{project.bonus || 0}} 塾值</text>
        </view>
        <view class="info-row">
          <text class="info-label">开始日期</text>
          <text class="info-value">{{project._startDate}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">截止日期</text>
          <text class="info-value {{project._isDeadlinePassed ? 'text-red' : ''}}">
            {{project._deadline}}
          </text>
        </view>
        <view class="info-row" wx:if="{{project.planed_hour}}">
          <text class="info-label">建议用时</text>
          <text class="info-value">{{project.planed_hour}} 小时</text>
        </view>
        <view class="info-row" wx:if="{{project.half_progress}}">
          <text class="info-label">半程进度</text>
          <text class="info-value">{{project.half_progress}}</text>
        </view>
        <view class="info-row" wx:if="{{project.required_courses}}">
          <text class="info-label">先修课程</text>
          <text class="info-value">{{project.required_courses}}</text>
        </view>
      </view>
    </view>

    <!-- 任务详情（Markdown 渲染）-->
    <view class="card" wx:if="{{project.task_text}}">
      <view class="card-title-bar">任务详情</view>
      <t-chat-markdown content="{{project.task_text}}" />
    </view>

    <!-- 解决方案（Markdown 渲染）-->
    <view class="card" wx:if="{{project.sln_text}}">
      <view class="card-title-bar">解决方案</view>
      <t-chat-markdown content="{{project.sln_text}}" />
    </view>

    <!-- 吸底操作栏 -->
    <view class="sticky-action-bar">
      <view class="sticky-bounty">
        <text class="sticky-bounty-label">项目赏金</text>
        <text class="sticky-bounty-val">💰 {{project.bonus || 0}} 塾值</text>
      </view>
      <button
        wx:if="{{!project.taker && !project.finish_date}}"
        class="btn-claim"
        disabled="{{claiming}}"
        bindtap="claimProject"
      >
        {{claiming ? '认领中...' : '✨ 立即认领项目'}}
      </button>
      <button
        wx:elif="{{project.finish_date}}"
        class="btn-done"
        disabled
      >
        该项目已结项
      </button>
      <button
        wx:else
        class="btn-done in-progress"
        data-role="执行人"
        data-name="{{project.taker}}"
        data-userid="{{project.taker_id}}"
        bindtap="onContactProjectPeer"
      >
        🤝 进行中 · 联系 {{project.taker}} 协作
      </button>
    </view>

  </view>
</view>

<!-- TDesign toast 组件 -->
<t-toast id="t-toast" />
