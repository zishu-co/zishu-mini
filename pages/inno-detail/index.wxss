/* pages/inno-detail/index.wxss */
/* 创新项目详情页样式 */

page {
  background-color: #f5f5f5;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
}

/* ========== 加载 / 空状态 ========== */

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.retry-btn {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.25);
}
.retry-btn::after {
  border: none;
}

/* ========== Hero Header Card ========== */

.hero-card {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.24);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.serial-tag {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
}

.status-tag {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
}

.status-red {
  color: #fff1ed;
  background-color: rgba(250, 65, 38, 0.85);
}

.status-green {
  color: #e8ffef;
  background-color: rgba(0, 180, 42, 0.85);
}

.status-gray {
  color: #f5f5f5;
  background-color: rgba(0, 0, 0, 0.35);
}

.project-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.45;
  margin-bottom: 24rpx;
}

.hero-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bounty-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.bounty-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #7c3aed;
}

.hero-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ========== 3-Step 里程碑卡片 ========== */

.milestone-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.milestone-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.milestone-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.milestone-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  opacity: 0.55;
}

.milestone-step.active {
  opacity: 1;
}

.step-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3e8ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.step-label {
  font-size: 22rpx;
  color: #4b5563;
  text-align: center;
  font-weight: 500;
}

.milestone-line {
  width: 48rpx;
  height: 4rpx;
  background: #e5e7eb;
  margin-bottom: 32rpx;
}

.milestone-line.active {
  background: linear-gradient(90deg, #a0f 0%, #7c3aed 100%);
}

/* ========== 通用卡片 ========== */

.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* ========== 信息网格 ========== */

.info-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.info-value-with-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.peer-contact-pill {
  font-size: 22rpx;
  font-weight: 600;
  color: #7c3aed;
  background: #f5f3ff;
  border: 1rpx solid rgba(124, 58, 237, 0.25);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.info-value.bonus {
  color: #fa4126;
  font-weight: bold;
}

.info-value.text-red {
  color: #fa4126;
}

/* ========== 描述 / 课程 ========== */

.card-title-bar {
  font-size: 28rpx;
  font-weight: bold;
  color: #aa00ff;
  margin-bottom: 16rpx;
}

/* t-chat-markdown 渲染内容样式 */
.t-chat-markdown {
  font-size: 28rpx !important;
  line-height: 1.8 !important;
  color: #333 !important;
}

/* TDesign markdown 组件自带类名（保证基础可读性）*/
.t-chat-markdown .t-chat-markdown__p {
  margin: 8rpx 0;
}

.t-chat-markdown .t-chat-markdown__h1,
.t-chat-markdown .t-chat-markdown__h2,
.t-chat-markdown .t-chat-markdown__h3 {
  color: #1a1a2e;
  font-weight: bold;
  margin: 16rpx 0 8rpx;
}

.t-chat-markdown .t-chat-markdown__code {
  background-color: #f5f5f5;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-family: monospace;
}

.t-chat-markdown .t-chat-markdown__pre {
  background-color: #1a1a2e;
  padding: 20rpx;
  border-radius: 12rpx;
  overflow-x: auto;
  margin: 12rpx 0;
}

.t-chat-markdown .t-chat-markdown__ul,
.t-chat-markdown .t-chat-markdown__ol {
  padding-left: 40rpx;
  margin: 8rpx 0;
}

.courses-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* ========== 吸底操作栏 ========== */

.sticky-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(16rpx);
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  z-index: 50;
}

.sticky-bounty {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.sticky-bounty-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.sticky-bounty-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #7c3aed;
}

.btn-claim {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 42rpx;
  border: none;
  text-align: center;
  margin: 0;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.3);
}

.btn-claim::after {
  border: none;
}

.btn-done {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background-color: #f3f4f6;
  color: #9ca3af;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  border: none;
  text-align: center;
  margin: 0;
}

.btn-done.in-progress {
  background-color: #f3e8ff;
  color: #7c3aed;
}

.btn-done::after {
  border: none;
}
