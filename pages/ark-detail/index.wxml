<!-- pages/ark-detail/index.wxml -->
<!-- spec: specs/miniprogram/active/004-complete-ark-detail.md -->
<view class="page">
  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载方舟舱信息中...</text>
  </view>

  <block wx:else>
    <!-- 顶部信息卡 -->
    <view class="header-card">
      <view class="ark-name">🚢 {{ark.arkname || '诺亚方舟共学舱'}}</view>
      <view class="status-row">
        <text class="stage-badge {{stageClass}}">{{ark.stage || '筹建中'}}</text>
        <text class="gender-tag gender-male">🚹 男生 {{maleCount}}/2</text>
        <text class="gender-tag gender-female">🚺 女生 {{femaleCount}}/2</text>
        <text class="finished-tag" wx:if="{{ark.finished}}">🏆 已圆满靠岸</text>
      </view>
      <view class="meta-row">
        <text class="teacher-text" wx:if="{{ark.teacher_name}}">👨‍🏫 领航塾师：{{ark.teacher_name}}</text>
        <text class="captain-text" wx:if="{{ark.captain_id}}">⭐ 舟长编号：#{{ark.captain_id}}</text>
      </view>
    </view>

    <!-- 总进度条 -->
    <view class="progress-card">
      <view class="progress-header">
        <text class="progress-title">🔥 全舱共学总进度</text>
        <text class="progress-percent">{{ark.total_progress_percent || 0}}%</text>
      </view>
      <view class="progress-bar">
        <view class="progress-bar__fill" style="width: {{ark.total_progress_percent || 0}}%;"></view>
      </view>
    </view>

    <!-- 成员列表（2男2女黄金搭子） -->
    <view class="section">
      <view class="section-title">🤝 同舟共学搭子（{{ark.members.length || 0}} / 4）</view>
      <view
        class="member-card"
        wx:for="{{ark.members}}"
        wx:key="crew_id"
        wx:for-item="m"
      >
        <view class="member-row">
          <view class="member-info">
            <text class="member-name">{{m.username}}</text>
            <text class="captain-tag" wx:if="{{m.is_captain}}">⭐ 舟长</text>
            <text class="gender-tag {{m._genderClass}}" wx:if="{{m.gender}}">{{m.gender === '男' ? '🚹 男' : '🚺 女'}}</text>
          </view>
          <view class="member-progress">
            <text class="member-progress-text">第 {{m.current_serial}}/{{m.total_chapters}} 章 ({{m.progress_percent}}%)</text>
          </view>
        </view>
        <view class="progress-bar member-progress-bar">
          <view class="progress-bar__fill" style="width: {{m._progressPercent}}%;"></view>
        </view>
        <view class="status-row member-footer-row">
          <view
            class="learn-sheet-link learn-sheet-link--inline"
            bindtap="onGoLearnSheet"
            data-userid="{{m.user_id}}"
          >📖 查看学习单 ›</view>
          <view class="member-action-links">
            <view
              class="learn-sheet-link learn-sheet-link--inline learn-sheet-link--danger"
              wx:if="{{isTeacher && ark.stage !== '已成舟'}}"
              bindtap="onKickCrew"
              data-crewid="{{m.crew_id}}"
              data-username="{{m.username}}"
            >移除</view>
            <view
              class="learn-sheet-link learn-sheet-link--inline"
              wx:if="{{m.user_id !== currentUserId}}"
              bindtap="onGreetMember"
              data-userid="{{m.user_id}}"
              data-username="{{m.username}}"
            >👋 约TA共学</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 三会排期只读卡片（支持一键复制会议号） -->
    <view class="section" wx:if="{{hasMeetings || canEditMeetings}}">
      <view class="section-title">📅 方舟三会排期（点击可复制会议号）</view>
      <view class="meetings-list">
        <view class="meeting-item" bindtap="onCopyMeeting" data-code="{{ark.meet_start}}">
          <text class="meeting-badge">🚀 启动会</text>
          <view class="meeting-detail">
            <text class="meeting-link">{{ark.meet_start || '待舟长/塾师排期'}}</text>
            <text class="meeting-time" wx:if="{{ark.meet_start_time}}">{{ark.meet_start_time}}</text>
          </view>
        </view>
        <view class="meeting-item" bindtap="onCopyMeeting" data-code="{{ark.meet_mid}}">
          <text class="meeting-badge">⛵ 中期会</text>
          <view class="meeting-detail">
            <text class="meeting-link">{{ark.meet_mid || '待舟长/塾师排期'}}</text>
            <text class="meeting-time" wx:if="{{ark.meet_mid_time}}">{{ark.meet_mid_time}}</text>
          </view>
        </view>
        <view class="meeting-item" bindtap="onCopyMeeting" data-code="{{ark.meet_end}}">
          <text class="meeting-badge">🏁 完航会</text>
          <view class="meeting-detail">
            <text class="meeting-link">{{ark.meet_end || '待舟长/塾师排期'}}</text>
            <text class="meeting-time" wx:if="{{ark.meet_end_time}}">{{ark.meet_end_time}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作区 -->
    <view class="actions">
      <button
        class="action-btn primary"
        wx:if="{{isMember && !ark.finished && !ark.closed}}"
        disabled="{{submitting}}"
        bindtap="onReportArkHour"
      >⏱️ 打卡推进下一章节</button>
      <button
        class="action-btn primary"
        wx:if="{{canSelfSetCaptain}}"
        disabled="{{submitting}}"
        loading="{{submitting}}"
        bindtap="onSetCaptain"
      >⭐ 设我为舟长</button>
      <button
        class="action-btn"
        wx:if="{{canEditMeetings}}"
        disabled="{{submitting}}"
        bindtap="onOpenMeetings"
      >📅 编辑三会排期</button>
      <button
        class="action-btn primary"
        wx:if="{{canFinishAllCrews}}"
        disabled="{{submitting}}"
        bindtap="onFinishAllCrews"
      >🎓 全舱100%统一结课</button>
      <button
        class="action-btn danger"
        wx:if="{{canCloseArk}}"
        disabled="{{submitting}}"
        bindtap="onCloseArk"
      >🏆 完结方舟</button>
      <button
        class="action-btn danger"
        wx:if="{{canDeleteEmptyArk}}"
        disabled="{{submitting}}"
        bindtap="onDeleteEmptyArk"
      >🗑️ 删除空方舟</button>
      <button
        class="action-btn ghost"
        wx:if="{{canLeaveArk}}"
        disabled="{{submitting}}"
        bindtap="onLeaveArk"
      >退出方舟</button>
    </view>

    <!-- 三会弹窗 -->
    <view class="modal-mask" wx:if="{{showMeetingsModal}}" bindtap="onCloseMeetings"></view>
    <view class="modal" wx:if="{{showMeetingsModal}}">
      <view class="modal-header">
        <text class="modal-title">📅 三会腾讯会议排期</text>
        <text class="modal-close" bindtap="onCloseMeetings">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-row">
          <text class="form-label">🚀 启动会</text>
          <input class="form-input" type="text" placeholder="腾讯会议号或链接" value="{{meetingsForm.meet_start}}" data-field="meet_start" bindinput="onMeetingsInput" />
          <input class="form-input" type="text" placeholder="时间（如 2026-11-01 20:00）" value="{{meetingsForm.meet_start_time}}" data-field="meet_start_time" bindinput="onMeetingsInput" />
        </view>
        <view class="form-row">
          <text class="form-label">⛵ 中期会</text>
          <input class="form-input" type="text" placeholder="腾讯会议号或链接" value="{{meetingsForm.meet_mid}}" data-field="meet_mid" bindinput="onMeetingsInput" />
          <input class="form-input" type="text" placeholder="时间" value="{{meetingsForm.meet_mid_time}}" data-field="meet_mid_time" bindinput="onMeetingsInput" />
        </view>
        <view class="form-row">
          <text class="form-label">🏁 完航会</text>
          <input class="form-input" type="text" placeholder="腾讯会议号或链接" value="{{meetingsForm.meet_end}}" data-field="meet_end" bindinput="onMeetingsInput" />
          <input class="form-input" type="text" placeholder="时间" value="{{meetingsForm.meet_end_time}}" data-field="meet_end_time" bindinput="onMeetingsInput" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="action-btn ghost" bindtap="onCloseMeetings">取消</view>
        <view class="action-btn primary" bindtap="onSaveMeetings">{{submitting ? '保存中...' : '保存排期'}}</view>
      </view>
    </view>
  </block>
</view>
