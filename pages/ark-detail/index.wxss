/* pages/ark-detail/index.wxss — 方舟共学舱详情旗舰视觉 */

.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 88rpx);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

/* ===== 顶部旗舰 Hero 信息卡 ===== */
.header-card {
  position: relative;
  overflow: hidden;
  margin: -28rpx -28rpx 4rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  padding: 38rpx 34rpx 44rpx;
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.header-card::before {
  content: '';
  position: absolute;
  top: -70rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.ark-name {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 16rpx;
  line-height: 1.35;
}

.status-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.stage-badge {
  font-size: 22rpx;
  font-weight: 800;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.badge-success {
  background: rgba(16, 185, 129, 0.9);
  color: #ecfdf5;
}

.badge-waiting {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: #ffffff;
}

.finished-tag {
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(15, 23, 42, 0.35);
  color: rgba(255, 255, 255, 0.9);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.meta-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.88);
}

.teacher-text,
.captain-text {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
}

.member-progress {
  display: flex;
  align-items: center;
}

/* ===== 总进度 ===== */
.progress-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.progress-percent {
  font-size: 34rpx;
  font-weight: 800;
  color: #7c3aed;
}

.progress-bar {
  width: 100%;
  height: 14rpx;
  background: #ede9fe;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #a855f7 0%, #7c3aed 100%);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.member-progress-bar {
  height: 10rpx;
}

/* ===== 成员卡 ===== */
.section {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.member-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.member-card:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.member-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.member-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.captain-tag {
  font-size: 21rpx;
  font-weight: 700;
  background: #fef3c7;
  color: #b45309;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.gender-tag {
  font-size: 21rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.gender-male {
  background: #dbeafe;
  color: #1d4ed8;
}

.gender-female {
  background: #fce7f3;
  color: #be185d;
}

.member-progress-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
  white-space: nowrap;
  flex-shrink: 0;
}

.learn-sheet-link {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
  margin-top: 10rpx;
  display: inline-block;
  white-space: nowrap;
}

.member-footer-row {
  margin-top: 12rpx;
  margin-bottom: 0;
  justify-content: space-between;
}

.member-action-links {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.learn-sheet-link--inline {
  margin-top: 0;
}

.learn-sheet-link--danger {
  color: #dc2626;
}

/* ===== 三会排期展示 ===== */
.meetings-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meeting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(147, 51, 234, 0.14);
}

.meeting-badge {
  font-size: 24rpx;
  font-weight: 800;
  color: #6d28d9;
  background: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(124, 58, 237, 0.1);
}

.meeting-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  min-width: 0;
}

.meeting-link {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  word-break: break-all;
}

.meeting-time {
  font-size: 22rpx;
  color: #64748b;
}

/* ===== 操作区 ===== */
.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

button.action-btn,
.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
  border: 1.5rpx solid rgba(124, 58, 237, 0.22);
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  color: #6d28d9;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.08), inset 0 2rpx 0 #ffffff;
}

button.action-btn.primary,
.action-btn.primary {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 52%, #6d28d9 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

button.action-btn.danger,
.action-btn.danger {
  background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
  color: #e11d48;
  border: 1.5rpx solid rgba(225, 29, 72, 0.24);
  box-shadow: 0 4rpx 12rpx rgba(225, 29, 72, 0.08), inset 0 1rpx 0 #ffffff;
}

.action-btn.ghost {
  background: #ffffff;
  color: #475569;
  border: 2rpx solid #e2e8f0;
}

/* ===== 三会弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.56);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 99;
}

.modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow-y: auto;
  z-index: 100;
  box-shadow: 0 -16rpx 48rpx rgba(15, 23, 42, 0.16);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 22rpx;
  border-bottom: 1rpx solid #f1f5f9;
  margin-bottom: 22rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  font-size: 28rpx;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 22rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.form-input {
  width: 100%;
  height: 76rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #0f172a;
  background: #ffffff;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.modal-footer .action-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
}
