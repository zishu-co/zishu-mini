/* pages/ark-detail/index.wxss — 方舟共学舱详情旗舰视觉 */

.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 88rpx);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

/* ===== 顶部旗舰 Hero 信息卡 ===== */
.header-card {
  position: relative;
  overflow: hidden;
  margin: -28rpx -28rpx 4rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  padding: 38rpx 34rpx 44rpx;
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.25);
}

.header-card::before {
  content: '';
  position: absolute;
  top: -70rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.ark-name {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 16rpx;
  line-height: 1.35;
}

.status-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.stage-badge {
  font-size: 22rpx;
  font-weight: 800;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.badge-success {
  background: rgba(16, 185, 129, 0.9);
  color: #ecfdf5;
}

.badge-waiting {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: #ffffff;
}

.finished-tag {
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(15, 23, 42, 0.35);
  color: rgba(255, 255, 255, 0.9);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.meta-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.88);
}

.teacher-text,
.captain-text {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
}

.member-progress {
  display: flex;
  align-items: center;
}

/* ===== 总进度 ===== */
.progress-card {
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
}

.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.progress-percent {
  font-size: 34rpx;
  font-weight: 800;
  color: #7c3aed;
}

.progress-bar {
  width: 100%;
  height: 14rpx;
  background: #ede9fe;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #a855f7 0%, #7c3aed 100%);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.member-progress-bar {
  height: 10rpx;
}

/* ===== 成员卡 ===== */
.section {
  background:
    radial-gradient(circle at 12% 0%, rgba(244, 114, 182, 0.12) 0%, transparent 48%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 48%, #faf5ff 100%);
  border-radius: 36rpx;
  padding: 30rpx 28rpx;
  box-shadow:
    0 14rpx 36rpx -10rpx rgba(109, 40, 217, 0.12),
    inset 0 3rpx 0 #ffffff;
  border: 2rpx solid rgba(244, 114, 182, 0.24);
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #3b0764;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.member-card {
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 48%, #f8f0ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(236, 72, 153, 0.11),
    0 4rpx 12rpx rgba(147, 51, 234, 0.05),
    inset 0 3rpx 0 #ffffff;
}

.member-card:nth-child(even),
.member-card.zs-row-even {
  background: linear-gradient(145deg, #f3f0ff 0%, #e8efff 50%, #e6f9ff 100%);
  border-color: rgba(129, 140, 248, 0.30);
  box-shadow:
    0 12rpx 30rpx -8rpx rgba(99, 102, 241, 0.13),
    0 4rpx 12rpx rgba(56, 189, 248, 0.06),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.member-card:last-child {
  margin-bottom: 0;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.member-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.member-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.captain-tag {
  font-size: 21rpx;
  font-weight: 700;
  background: #fef3c7;
  color: #b45309;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.gender-tag {
  font-size: 21rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.gender-male {
  background: #dbeafe;
  color: #1d4ed8;
}

.gender-female {
  background: #fce7f3;
  color: #be185d;
}

.member-progress-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
  white-space: nowrap;
  flex-shrink: 0;
}

.learn-sheet-link {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
  margin-top: 10rpx;
  display: inline-block;
  white-space: nowrap;
}

.member-footer-row {
  margin-top: 12rpx;
  margin-bottom: 0;
  justify-content: space-between;
}

.member-action-links {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.learn-sheet-link--inline {
  margin-top: 0;
}

.learn-sheet-link--danger {
  color: #dc2626;
}

/* ===== 三会排期展示 ===== */
.meetings-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.meeting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 0;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border-radius: 30rpx;
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10),
    inset 0 3rpx 0 #ffffff;
}

.meeting-item:nth-child(even),
.meeting-item.zs-row-even {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border-color: rgba(129, 140, 248, 0.28);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.meeting-badge {
  font-size: 24rpx;
  font-weight: 800;
  color: #6d28d9;
  background: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(124, 58, 237, 0.1);
}

.meeting-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  min-width: 0;
}

.meeting-link {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  word-break: break-all;
}

.meeting-time {
  font-size: 22rpx;
  color: #64748b;
}

/* ===== 操作区 ===== */
.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

button.action-btn,
.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
  border: 1.5rpx solid rgba(124, 58, 237, 0.22);
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  color: #6d28d9;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.08), inset 0 2rpx 0 #ffffff;
}

button.action-btn.primary,
.action-btn.primary {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 52%, #6d28d9 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

button.action-btn.danger,
.action-btn.danger {
  background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
  color: #e11d48;
  border: 1.5rpx solid rgba(225, 29, 72, 0.24);
  box-shadow: 0 4rpx 12rpx rgba(225, 29, 72, 0.08), inset 0 1rpx 0 #ffffff;
}

.action-btn.ghost {
  background: #ffffff;
  color: #475569;
  border: 2rpx solid #e2e8f0;
}

/* ===== 三会弹窗 — Candy Aurora 底部极光抽屉 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(36, 16, 68, 0.42);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 99;
}

.modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-width: 100% !important;
  background:
    radial-gradient(circle at 15% 0%, rgba(244, 114, 182, 0.18) 0%, transparent 48%),
    radial-gradient(circle at 85% 0%, rgba(129, 140, 248, 0.20) 0%, transparent 52%),
    linear-gradient(180deg, #fffafe 0%, #ffffff 40%, #f8f7ff 100%) !important;
  border-radius: 48rpx 48rpx 0 0 !important;
  padding: 28rpx 34rpx calc(36rpx + env(safe-area-inset-bottom)) !important;
  max-height: 84vh;
  overflow-y: auto;
  z-index: 100;
  border-top: 2rpx solid rgba(255, 255, 255, 0.98) !important;
  box-shadow:
    0 -20rpx 64rpx rgba(109, 40, 217, 0.22),
    inset 0 3rpx 0 #ffffff !important;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 18rpx;
  border-bottom: 2rpx dashed rgba(192, 132, 252, 0.24);
  margin-bottom: 22rpx;
}

.modal-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #3b0764;
}

.modal-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fdf2f8 0%, #f3e8ff 100%);
  color: #9333ea;
  border: 2rpx solid rgba(244, 114, 182, 0.30);
  box-shadow: 0 6rpx 16rpx rgba(147, 51, 234, 0.12), inset 0 2rpx 0 #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 0;
  background: linear-gradient(145deg, #ffffff 0%, #fff5fa 52%, #faf5ff 100%);
  border: 2rpx solid rgba(244, 114, 182, 0.26);
  border-radius: 30rpx;
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(236, 72, 153, 0.10),
    inset 0 3rpx 0 #ffffff;
}

.form-row:nth-child(even) {
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 52%, #ecfeff 100%);
  border-color: rgba(129, 140, 248, 0.28);
  box-shadow:
    0 10rpx 26rpx -8rpx rgba(99, 102, 241, 0.12),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.94);
}

.form-row:focus-within {
  background: linear-gradient(145deg, #fffbeb 0%, #fef08a 48%, #ffe4e6 100%);
  border: 2.5rpx solid #fb923c;
}

.form-label {
  font-size: 25rpx;
  font-weight: 800;
  color: #581c87;
}

.form-input {
  width: 100%;
  min-height: 82rpx;
  border: 2rpx solid rgba(192, 132, 252, 0.30);
  border-radius: 24rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
  color: #1e1b4b;
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 6rpx rgba(147, 51, 234, 0.04), 0 2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.modal-footer {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(192, 132, 252, 0.24);
}

.modal-footer .action-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
}
