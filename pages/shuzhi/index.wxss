.page {
  min-height: 100vh;
  background: #f6f5fb;
  padding-top: 0;
}

.hero-card {
  position: relative;
  overflow: hidden;
  margin: 0 0 28rpx;
  padding: 36rpx 32rpx 42rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  border-radius: 0 0 44rpx 44rpx;
  color: #fff;
  box-shadow: 0 18rpx 44rpx rgba(91, 33, 182, 0.26);
}

.hero-card::after {
  content: "";
  position: absolute;
  top: -70rpx;
  right: -50rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.28) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.hero-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}

.hero-balance {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.1;
  text-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.2);
}

.hero-badge,
.level-badge {
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.level-progress-wrap {
  margin-bottom: 24rpx;
}

.level-progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.level-progress-fill {
  height: 100%;
  background: #fde047;
  border-radius: 999rpx;
}

.level-progress-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  opacity: 0.92;
}

.level-hint {
  color: rgba(255, 255, 255, 0.9);
}

.level-pct {
  font-weight: 700;
  color: #fde047;
}

.earn-guide-card {
  margin: 0 24rpx 22rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.earn-guide-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.earn-guide-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.earn-guide-sub {
  font-size: 22rpx;
  color: #6d28d9;
  font-weight: 600;
}

.earn-task-grid {
  display: flex;
  gap: 14rpx;
}

.earn-task-pill {
  flex: 1;
  background: #f5f3ff;
  border-radius: 20rpx;
  padding: 18rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.14);
}

.earn-task-icon {
  font-size: 32rpx;
}

.earn-task-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #1e293b;
}

.earn-task-bonus {
  font-size: 20rpx;
  font-weight: 700;
  color: #6d28d9;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 24rpx 20rpx;
  padding: 16rpx 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.1);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}

.search-icon {
  font-size: 26rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.search-clear {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 4rpx 8rpx;
}

.filter-tabs {
  display: flex;
  gap: 10rpx;
  margin: 0 24rpx 22rpx;
  padding: 10rpx;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 28rpx;
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.10);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  font-size: 25rpx;
  font-weight: 700;
  border-radius: 999rpx;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.filter-tab.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.34), inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 22rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.1), inset 0 2rpx 0 #ffffff;
}

.stat-num {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
  margin-bottom: 6rpx;
}
.stat-num.brand { color: #6d28d9; }
.stat-num.accent { color: #16a34a; }

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

.list-area {
  padding: 0 24rpx 48rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 80rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}

.record-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.type-tag {
  display: inline-block;
  padding: 4rpx 20rpx;
  background: rgba(124, 58, 237, 0.1);
  color: #7c3aed;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.amount-pos {
  color: #16a34a;
  font-weight: 700;
  font-size: 32rpx;
}

.amount-neg {
  color: #ef4444;
  font-weight: 700;
  font-size: 32rpx;
}

.record-title {
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.record-bottom {
  margin-bottom: 8rpx;
}

.record-comment {
  font-size: 24rpx;
  color: #64748b;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f5f9;
}

.record-balance {
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 600;
}

.record-time {
  font-size: 24rpx;
  color: #94a3b8;
}