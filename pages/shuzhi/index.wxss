.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding-top: 24rpx;
}

.hero-card {
  margin: 0 24rpx 28rpx;
  padding: 36rpx 28rpx 28rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  border-radius: 28rpx;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.24);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.hero-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}

.hero-balance {
  display: block;
  font-size: 60rpx;
  font-weight: 800;
  line-height: 1.1;
}

.hero-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 18rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.2;
  margin-bottom: 6rpx;
}
.stat-num.brand { color: #7c3aed; }
.stat-num.accent { color: #16a34a; }

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

.list-area {
  padding: 0 24rpx 48rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 80rpx 0;
  color: #9a9ab0;
  font-size: 28rpx;
}

.record-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.type-tag {
  display: inline-block;
  padding: 4rpx 20rpx;
  background: rgba(124, 58, 237, 0.1);
  color: #7c3aed;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.amount-pos {
  color: #16a34a;
  font-weight: 700;
  font-size: 32rpx;
}

.amount-neg {
  color: #ef4444;
  font-weight: 700;
  font-size: 32rpx;
}

.record-title {
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.record-bottom {
  margin-bottom: 8rpx;
}

.record-comment {
  font-size: 24rpx;
  color: #64748b;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f5f9;
}

.record-balance {
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 600;
}

.record-time {
  font-size: 24rpx;
  color: #94a3b8;
}