.page {
  min-height: 100vh;
  background: #f6f4fb;
  padding-top: 20rpx;
  padding-bottom: 60rpx;
}

.talk-banner {
  margin: 0 24rpx 20rpx;
  padding: 28rpx 26rpx;
  background: linear-gradient(135deg, #aa00ff 0%, #6d28d9 100%);
  border-radius: 24rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.22);
}

.talk-banner-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.talk-banner-title {
  font-size: 32rpx;
  font-weight: 800;
}

.talk-banner-sub {
  font-size: 22rpx;
  opacity: 0.9;
}

.talk-banner-btn {
  background: #ffffff;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.tab-bar {
  display: flex;
  background: #fff;
  margin: 0 24rpx;
  border-radius: 20rpx;
  padding: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #64748b;
  border-radius: 14rpx;
}

.tab-item.active {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.25);
}

.tab-badge {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tab-item:not(.active) .tab-badge {
  background: rgba(124, 58, 237, 0.12);
  color: #7c3aed;
}

.tab-content {
  padding: 24rpx;
}

.loading-row,
.empty-row {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #94a3b8;
  font-size: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
}

.empty-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}

.empty-cta {
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
}

/* 预定面谈卡片 */
.talk-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.talk-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.talk-person-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.person-badge {
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.person-badge.person {
  background: rgba(124, 58, 237, 0.1);
  color: #7c3aed;
}

.person-badge.group {
  background: rgba(249, 115, 22, 0.1);
  color: #f97316;
}

.role-chip {
  font-size: 21rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-badge.pending {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
}

.status-badge.confirmed {
  background: rgba(34, 197, 94, 0.1);
  color: #16a34a;
}

.status-badge.overdue {
  background: rgba(233, 69, 96, 0.1);
  color: #e94560;
}

.talk-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.info-label {
  font-size: 24rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  color: #1a1a2e;
  font-weight: 500;
  text-align: right;
}

.info-value.topic {
  color: #6d28d9;
}

.info-value.success {
  color: #16a34a;
}

.talk-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f1f5f9;
}

.talk-action-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.talk-action-btn.ghost {
  background: #f8fafc;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}

.talk-action-btn.primary {
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
}

/* 目标卡片 */
.goal-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.goal-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.goal-student {
  font-size: 28rpx;
  font-weight: 700;
  color: #7c3aed;
}

.goal-progress {
  font-size: 23rpx;
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.goal-body-preview {
  font-size: 25rpx;
  color: #334155;
  background: #faf5ff;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.goal-dates {
  display: flex;
  gap: 16rpx;
  font-size: 23rpx;
  color: #64748b;
}

/* 历史卡片 */
.history-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.history-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.history-student {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.history-duration {
  font-size: 25rpx;
  color: #16a34a;
  font-weight: 600;
}

.history-time {
  font-size: 23rpx;
  color: #94a3b8;
}

.talk-banner-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.talk-banner-btn.primary {
  background: #ffffff;
  color: #7c3aed;
  font-weight: 700;
}

.talk-action-btn.finish {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
}

/* 弹窗样式 */
.gt-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.56);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 32rpx;
}

.gt-modal-card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.2);
}

.gt-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.gt-modal-sub {
  font-size: 25rpx;
  color: #6d28d9;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.gt-field-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin: 18rpx 0 10rpx;
}

.gt-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  max-height: 180rpx;
  overflow-y: auto;
}

.gt-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 23rpx;
  font-weight: 600;
}

.gt-chip.active {
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
}

.gt-input {
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #1e293b;
}

.gt-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.5;
}

.gt-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 28rpx;
}

.gt-modal-btn {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.gt-modal-btn.cancel {
  background: #f1f5f9;
  color: #64748b;
}

.gt-modal-btn.confirm {
  background: linear-gradient(135deg, #aa00ff 0%, #7c3aed 100%);
  color: #ffffff;
}
