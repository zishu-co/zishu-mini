/* pages/article/index.wxss */

.page {
  min-height: 100vh;
  background: #f6f5fb;
}

.banner {
  position: relative;
  overflow: hidden;
  padding: 48rpx 32rpx 44rpx;
  background: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  color: #fff;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(91, 33, 182, 0.24);
}

.banner::after {
  content: "";
  position: absolute;
  top: -70rpx;
  right: -50rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 180, 254, 0.26) 0%, rgba(216, 180, 254, 0) 70%);
  pointer-events: none;
}

.banner-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.banner-title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.banner-sub {
  font-size: 24rpx;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.85);
}

.article-toolbar {
  padding: 24rpx 32rpx 0;
}

.article-tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.article-tabs {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.22);
  border-radius: 28rpx;
  padding: 10rpx;
  gap: 10rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(91, 33, 182, 0.10);
}

.article-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  color: #4c1d95;
  font-size: 25rpx;
  font-weight: 700;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04), inset 0 1rpx 0 #ffffff;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.article-tab.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: rgba(255, 255, 255, 0.34);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.34), inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
}

.map-search-go {
  font-size: 24rpx;
  font-weight: 700;
  color: #6d28d9;
  padding: 8rpx 20rpx;
  background: #f5f3ff;
  border-radius: 999rpx;
}

.zhuanlan-favor-btn {
  font-size: 22rpx;
  font-weight: 700;
  color: #6d28d9;
  background: #ffffff;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(124, 58, 237, 0.12);
}

.album-intro-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 25rpx;
  color: #475569;
  line-height: 1.65;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
}

.mindmap-outline-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
}

.mindmap-outline-header {
  font-size: 28rpx;
  font-weight: 800;
  color: #4c1d95;
  margin-bottom: 20rpx;
}

.mindmap-node-row {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #f1f5f9;
}

.mindmap-node-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mindmap-node-bullet {
  color: #7c3aed;
  font-size: 26rpx;
  font-weight: 700;
}

.mindmap-node-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.mindmap-node-count {
  font-size: 20rpx;
  color: #6d28d9;
  background: #f5f3ff;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.mindmap-node-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  padding-left: 36rpx;
}

.video-player-box {
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #0f172a;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.16);
}

.video-player {
  width: 100%;
  height: 400rpx;
}

.map-search-results-box {
  margin-bottom: 24rpx;
}

.map-search-results-header {
  font-size: 24rpx;
  font-weight: 700;
  color: #6d28d9;
  margin-bottom: 12rpx;
}

.article-tab.active {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #6d28d9 100%);
  color: #ffffff;
  font-weight: 800;
  border-color: transparent;
  box-shadow:
    0 6rpx 18rpx rgba(124, 58, 237, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.article-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 76rpx;
  border: 2rpx solid rgba(124, 58, 237, 0.1);
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.article-search-icon {
  font-size: 28rpx;
}

.article-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.article-search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 6rpx 10rpx;
}

.login-tip {
  margin: 40rpx 32rpx;
  padding: 60rpx 36rpx;
  background: #fff;
  border-radius: 28rpx;
  text-align: center;
  color: #64748b;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
}

.login-tip-text {
  display: block;
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
}

.login-btn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 18rpx 60rpx;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(124, 58, 237, 0.25);
}

.login-btn::after {
  border: none;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.article-list {
  padding: 28rpx 32rpx;
}

.article-item {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  transition: transform 0.15s ease;
}

.article-item:active {
  transform: scale(0.99);
}

.zhuanlan-card {
  border-left: 8rpx solid #7c3aed;
}

.article-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  flex: 1;
}

.article-arrow {
  font-size: 28rpx;
  font-weight: 700;
  color: #7c3aed;
  margin-left: 16rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.author {
  margin-right: 12rpx;
  color: #6d28d9;
  font-weight: 600;
}

.date,
.reader-date {
  font-size: 23rpx;
  color: #94a3b8;
}

.depth-0 .mindmap-node-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #4c1d95;
}

.depth-1 .mindmap-node-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.depth-2 .mindmap-node-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
}

.read-badge {
  margin-right: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #6d28d9;
  font-size: 22rpx;
  font-weight: 600;
}

.article-preview {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.65;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.empty-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #cbd5e1;
}

/* 阅读器弹窗 */
.reader-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.56);
  backdrop-filter: blur(6px);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.reader-sheet {
  background: #ffffff;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -16rpx 48rpx rgba(15, 23, 42, 0.18);
}

.reader-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
}

.reader-topbar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reader-badge {
  font-size: 24rpx;
  font-weight: 700;
  color: #5b21b6;
  background: rgba(255, 255, 255, 0.85);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.16);
}

.font-size-switch {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 999rpx;
  padding: 4rpx;
  gap: 4rpx;
}

.font-btn {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
}

.font-btn.active {
  background: #7c3aed;
  color: #ffffff;
}

.reader-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 50%;
}

.reader-loading {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #7c3aed;
  font-size: 28rpx;
}

.reader-loading-inline {
  padding: 12rpx 20rpx;
  margin-bottom: 20rpx;
  background: #f5f3ff;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #7c3aed;
}

.reader-scroll {
  flex: 1;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.reader-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.45;
}

.reader-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.reader-author {
  color: #6d28d9;
  font-weight: 700;
}

.reader-dept {
  background: #f1f5f9;
  color: #475569;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.reader-divider {
  height: 1rpx;
  background: #e2e8f0;
  margin: 24rpx 0;
}

.reader-content {
  font-size: 30rpx;
  color: #1e293b;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
  padding-bottom: 32rpx;
}

.reader-content.font-sm {
  font-size: 26rpx;
  line-height: 1.75;
}

.reader-content.font-md {
  font-size: 30rpx;
  line-height: 1.85;
}

.reader-content.font-lg {
  font-size: 36rpx;
  line-height: 1.95;
}

.reader-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f1f5f9;
  background: #ffffff;
}

.reader-action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.reader-action-btn.ghost {
  background: #f1f5f9;
  color: #475569;
}

.reader-action-btn.secondary {
  background: #f5f3ff;
  color: #6d28d9;
  border: 2rpx solid rgba(124, 58, 237, 0.22);
}

.reader-action-btn.primary {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(124, 58, 237, 0.25);
}

.banner-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.banner-write-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f3e8ff 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  color: #6d28d9;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
  box-shadow:
    0 8rpx 20rpx rgba(15, 23, 42, 0.16),
    inset 0 2rpx 0 #ffffff;
  transition: transform 0.16s ease;
}

.banner-write-btn:active {
  transform: scale(0.95);
}

.zhuanlan-back-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 26rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.14);
}

.zhuanlan-back-btn {
  font-size: 24rpx;
  font-weight: 700;
  color: #6d28d9;
}

.zhuanlan-active-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #4c1d95;
}

.editor-field {
  margin-bottom: 28rpx;
}

.editor-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 12rpx;
}

.editor-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.editor-textarea {
  width: 100%;
  min-height: 420rpx;
  padding: 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #0f172a;
  box-sizing: border-box;
}

.safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
