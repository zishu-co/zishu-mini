/* pages/article/index.wxss */

.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.banner {
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #c6f 0%, #aa00ff 100%);
  color: #fff;
}

.banner-title {
  font-size: 40rpx;
  font-weight: bold;
}

.banner-sub {
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.8;
}

.login-tip {
  padding: 32rpx;
  text-align: center;
  color: #666;
}

.login-btn {
  margin-top: 16rpx;
  background: #aa00ff;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  border: none;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}

.article-list {
  padding: 24rpx 32rpx;
}

.article-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.article-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.article-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 16rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.author {
  margin-right: 16rpx;
}

.article-preview {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ccc;
}

.safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
