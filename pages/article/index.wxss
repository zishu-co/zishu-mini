/* pages/article/index.wxss */

.page {
  min-height: 100vh;
  background: #f6f7fb;
}

.banner {
  padding: 44rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.18);
}

.banner-title {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.banner-sub {
  font-size: 24rpx;
  margin-top: 10rpx;
  opacity: 0.88;
}

.article-toolbar {
  padding: 24rpx 32rpx 0;
}

.article-tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.article-tabs {
  display: inline-flex;
  gap: 16rpx;
}

.article-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid #e2e8f0;
  flex-shrink: 0;
}

.map-search-go {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
  padding: 8rpx 18rpx;
  background: #f5f3ff;
  border-radius: 999rpx;
}

.zhuanlan-favor-btn {
  font-size: 22rpx;
  font-weight: 700;
  color: #7c3aed;
  background: #ffffff;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.album-intro-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
}

.mindmap-outline-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.mindmap-outline-header {
  font-size: 28rpx;
  font-weight: 700;
  color: #4c1d95;
  margin-bottom: 20rpx;
}

.mindmap-node-row {
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #f1f5f9;
}

.mindmap-node-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mindmap-node-bullet {
  color: #7c3aed;
  font-size: 26rpx;
  font-weight: 700;
}

.mindmap-node-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.mindmap-node-count {
  font-size: 20rpx;
  color: #7c3aed;
  background: #f5f3ff;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.mindmap-node-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  padding-left: 36rpx;
}

.video-player-box {
  margin-top: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #0f172a;
}

.video-player {
  width: 100%;
  height: 400rpx;
}

.map-search-results-box {
  margin-bottom: 24rpx;
}

.map-search-results-header {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
  margin-bottom: 12rpx;
}

.article-tab.active {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 4rpx 14rpx rgba(124, 58, 237, 0.22);
}

.article-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}

.article-search-icon {
  font-size: 28rpx;
}

.article-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.article-search-clear {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 6rpx 10rpx;
}

.login-tip {
  margin: 40rpx 32rpx;
  padding: 56rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  text-align: center;
  color: #666;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.login-tip-text {
  display: block;
  font-size: 28rpx;
  color: #4b5563;
}

.login-btn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 56rpx;
  border-radius: 44rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 28rpx;
}

.article-list {
  padding: 28rpx 32rpx;
}

.article-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.article-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  flex: 1;
}

.article-arrow {
  font-size: 36rpx;
  color: #a78bfa;
  margin-left: 16rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.author {
  margin-right: 16rpx;
  color: #7c3aed;
  font-weight: 500;
}

.read-badge {
  margin-right: 16rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #7c3aed;
  font-size: 20rpx;
  font-weight: 600;
}

.article-preview {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 28rpx;
}

.empty-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #cbd5e1;
}

/* 阅读器弹窗 */
.reader-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.reader-sheet {
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.16);
}

.reader-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  background: #faf5ff;
}

.reader-topbar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reader-badge {
  font-size: 24rpx;
  font-weight: 600;
  color: #7c3aed;
  background: #ede9fe;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.font-size-switch {
  display: inline-flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 999rpx;
  padding: 4rpx;
  gap: 4rpx;
}

.font-btn {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
}

.font-btn.active {
  background: #7c3aed;
  color: #ffffff;
}

.reader-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 50%;
}

.reader-loading {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #7c3aed;
  font-size: 28rpx;
}

.reader-loading-inline {
  padding: 12rpx 20rpx;
  margin-bottom: 20rpx;
  background: #f5f3ff;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #7c3aed;
}

.reader-scroll {
  flex: 1;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.reader-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.45;
}

.reader-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.reader-author {
  color: #7c3aed;
  font-weight: 600;
}

.reader-dept {
  background: #f1f5f9;
  color: #475569;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
}

.reader-divider {
  height: 1rpx;
  background: #e2e8f0;
  margin: 24rpx 0;
}

.reader-content {
  font-size: 30rpx;
  color: #1e293b;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
  padding-bottom: 32rpx;
}

.reader-content.font-sm {
  font-size: 26rpx;
  line-height: 1.75;
}

.reader-content.font-md {
  font-size: 30rpx;
  line-height: 1.85;
}

.reader-content.font-lg {
  font-size: 36rpx;
  line-height: 1.95;
}

.reader-footer {
  display: flex;
  gap: 14rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f1f5f9;
  background: #ffffff;
}

.reader-action-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.reader-action-btn.ghost {
  background: #f8fafc;
  color: #475569;
  border: 2rpx solid #e2e8f0;
}

.reader-action-btn.secondary {
  background: #f5f3ff;
  color: #7c3aed;
  border: 2rpx solid rgba(124, 58, 237, 0.25);
}

.reader-action-btn.primary {
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(124, 58, 237, 0.25);
}

.banner-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.banner-write-btn {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.zhuanlan-back-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  background: #ede9fe;
  border-radius: 16rpx;
}

.zhuanlan-back-btn {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c3aed;
}

.zhuanlan-active-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #4c1d95;
}

.editor-field {
  margin-bottom: 28rpx;
}

.editor-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 12rpx;
}

.editor-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.editor-textarea {
  width: 100%;
  min-height: 460rpx;
  padding: 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #0f172a;
  box-sizing: border-box;
}

.safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
