/* pages/article/index.wxss */

.page {
  min-height: 100vh;
  background: #f6f7fb;
}

.banner {
  padding: 44rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.18);
}

.banner-title {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.banner-sub {
  font-size: 24rpx;
  margin-top: 10rpx;
  opacity: 0.88;
}

.login-tip {
  margin: 40rpx 32rpx;
  padding: 56rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  text-align: center;
  color: #666;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.login-tip-text {
  display: block;
  font-size: 28rpx;
  color: #4b5563;
}

.login-btn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 56rpx;
  border-radius: 44rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 28rpx;
}

.article-list {
  padding: 28rpx 32rpx;
}

.article-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(124, 58, 237, 0.06);
}

.article-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  flex: 1;
}

.article-arrow {
  font-size: 36rpx;
  color: #a78bfa;
  margin-left: 16rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.author {
  margin-right: 16rpx;
  color: #7c3aed;
  font-weight: 500;
}

.article-preview {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 28rpx;
}

.empty-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #cbd5e1;
}

/* 阅读器弹窗 */
.reader-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.reader-sheet {
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.16);
}

.reader-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  background: #faf5ff;
}

.reader-badge {
  font-size: 24rpx;
  font-weight: 600;
  color: #7c3aed;
  background: #ede9fe;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.reader-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 50%;
}

.reader-loading {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #7c3aed;
  font-size: 28rpx;
}

.reader-loading-inline {
  padding: 12rpx 20rpx;
  margin-bottom: 20rpx;
  background: #f5f3ff;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #7c3aed;
}

.reader-scroll {
  flex: 1;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.reader-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.45;
}

.reader-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.reader-author {
  color: #7c3aed;
  font-weight: 600;
}

.reader-dept {
  background: #f1f5f9;
  color: #475569;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
}

.reader-divider {
  height: 1rpx;
  background: #e2e8f0;
  margin: 24rpx 0;
}

.reader-content {
  font-size: 30rpx;
  color: #1e293b;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
}

.safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
