<view class="page">
  <!-- 顶部 Banner -->
  <view class="banner">
    <view class="banner-top-row">
      <view>
        <view class="banner-title">专栏文章</view>
        <view class="banner-sub">记录学习点滴 · 沉淀思考精华</view>
      </view>
      <view wx:if="{{hasLogin}}" style="display: flex; gap: 12rpx; align-items: center;">
        <view wx:if="{{articleTab === 'zhuanlan'}}" class="banner-write-btn" bindtap="onOpenCreateZhuanlanModal">＋ 新建专栏</view>
        <view wx:if="{{articleTab === 'video'}}" class="banner-write-btn" bindtap="onOpenCreateVideoModal">＋ 发布微课</view>
        <view wx:if="{{articleTab === 'map'}}" class="banner-write-btn" bindtap="onOpenCreateMapModal">＋ 新建脑图</view>
        <view class="banner-write-btn" bindtap="onOpenCreateArticle">＋ 写文章</view>
      </view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="login-tip" wx:if="{{!hasLogin}}">
    <text class="login-tip-text">登录后可查看和阅读专栏文章</text>
    <button class="login-btn" bindtap="goToLogin">去登录</button>
  </view>

  <!-- 顶部筛选与搜索栏 -->
  <view class="article-toolbar" wx:if="{{hasLogin}}">
    <scroll-view class="article-tabs-scroll" scroll-x="true">
      <view class="article-tabs">
        <view
          class="article-tab {{articleTab === 'all' ? 'active' : ''}}"
          data-tab="all"
          bindtap="onTabChange"
        >🌟 全塾精选 ({{allArticles.length}})</view>
        <view
          class="article-tab {{articleTab === 'zhuanlan' ? 'active' : ''}}"
          data-tab="zhuanlan"
          bindtap="onTabChange"
        >📚 专栏合集 ({{zhuanlanList.length}})</view>
        <view
          class="article-tab {{articleTab === 'video' ? 'active' : ''}}"
          data-tab="video"
          bindtap="onTabChange"
        >🎬 微课专辑 ({{videoAlbums.length}})</view>
        <view
          class="article-tab {{articleTab === 'map' ? 'active' : ''}}"
          data-tab="map"
          bindtap="onTabChange"
        >🗺️ 知识脑图 ({{mapList.length}})</view>
        <view
          class="article-tab {{articleTab === 'mine' ? 'active' : ''}}"
          data-tab="mine"
          bindtap="onTabChange"
        >📝 我的创作</view>
      </view>
    </scroll-view>
    <view class="article-search-bar" wx:if="{{articleTab === 'all' || articleTab === 'mine'}}">
      <text class="article-search-icon">🔍</text>
      <input
        class="article-search-input"
        placeholder="搜索文章标题、作者或正文关键词..."
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
      <text wx:if="{{searchKeyword}}" class="article-search-clear" bindtap="onClearSearch">✕</text>
    </view>
    <view class="article-search-bar" wx:if="{{articleTab === 'map' && !activeMap}}">
      <text class="article-search-icon">🧠</text>
      <input
        class="article-search-input"
        placeholder="搜索脑图节点关键词 (102-search-map.md)..."
        value="{{mapSearchQuery}}"
        bindinput="onMapSearchInput"
        bindconfirm="onRunMapSearch"
      />
      <text class="map-search-go" bindtap="onRunMapSearch">检索</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{(loading || zhuanlanLoading || videoLoading || mapLoading) && hasLogin}}">
    <text>加载中...</text>
  </view>

  <!-- 专栏合集视图 (103-list-zhuanlan.md & 101-zhuanlan.md) -->
  <view class="article-list" wx:if="{{!zhuanlanLoading && hasLogin && articleTab === 'zhuanlan'}}">
    <block wx:if="{{!activeZhuanlan}}">
      <view
        class="article-item zhuanlan-card"
        wx:for="{{zhuanlanList}}"
        wx:key="zhuanlanid"
        data-id="{{item.zhuanlanid}}"
        data-item="{{item}}"
        bindtap="onSelectZhuanlan"
      >
        <view class="article-header">
          <text class="article-title">📚 {{item.zhuanlan_title || '未命名专栏'}}</text>
          <text class="article-arrow">进入专栏 ›</text>
        </view>
        <view class="article-meta">
          <text class="author">主理人：{{item.zhuanlan_author || '自塾主理人'}}</text>
          <text class="read-badge">专栏编号 #{{item.zhuanlanid}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{zhuanlanList.length === 0}}">
        <text>暂无专栏合集</text>
      </view>
    </block>

    <block wx:else>
      <view class="zhuanlan-back-bar" bindtap="onBackToZhuanlanList">
        <text class="zhuanlan-back-btn">← 返回全部专栏</text>
        <text class="zhuanlan-active-title">📚 {{activeZhuanlan.zhuanlan_title || '专栏目录'}}</text>
      </view>
      <view
        class="article-item"
        wx:for="{{zhuanlanArticles}}"
        wx:key="articleid"
        bindtap="onViewArticle"
        data-id="{{item.articleid}}"
      >
        <view class="article-header">
          <text class="article-title">{{item.show_title || item.title}}</text>
          <text class="article-arrow">›</text>
        </view>
        <view class="article-meta">
          <text class="author">{{item.author_name || '自塾作者'}}</text>
          <text class="read-badge" wx:if="{{item.zhuanlan_part}}">章节：{{item.zhuanlan_part}}</text>
          <text class="date" wx:if="{{item.create_time}}">{{item.create_time}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{zhuanlanArticles.length === 0}}">
        <text>该专栏下暂无文章</text>
      </view>
    </block>
  </view>

  <!-- 微课视频专辑视图 (104-show-album.md, 103-fetch-album.md, 105-watch-video.md) -->
  <view class="article-list" wx:if="{{!videoLoading && hasLogin && articleTab === 'video'}}">
    <block wx:if="{{!activeAlbum}}">
      <view
        class="article-item"
        wx:for="{{videoAlbums}}"
        wx:key="album_id"
        data-id="{{item.album_id}}"
        data-item="{{item}}"
        bindtap="onSelectVideoAlbum"
      >
        <view class="article-header">
          <text class="article-title">🎬 {{item.album_title || '未命名微课专辑'}}</text>
          <text class="article-arrow">进入专辑 ›</text>
        </view>
        <view class="article-meta">
          <text class="author">主讲：{{item.album_author || '自塾讲师'}}</text>
          <text class="read-badge">总时长 {{item.whole_length || 0}} 分钟</text>
        </view>
      </view>
      <view class="empty" wx:if="{{videoAlbums.length === 0}}">
        <text>暂无微课视频专辑</text>
      </view>
    </block>

    <block wx:else>
      <view class="zhuanlan-back-bar">
        <text class="zhuanlan-back-btn" bindtap="onBackToAlbumList">← 返回微课专辑</text>
        <text class="zhuanlan-active-title">🎬 {{activeAlbum.album_title || '微课目录'}}</text>
        <text class="zhuanlan-favor-btn" bindtap="onFavorAlbum">⭐ 收藏专辑</text>
      </view>
      <view class="album-intro-card" wx:if="{{activeAlbum.album_intro}}">
        <text>{{activeAlbum.album_intro}}</text>
      </view>
      <view
        class="article-item"
        wx:for="{{albumVideos}}"
        wx:key="video_id"
        data-id="{{item.video_id}}"
        data-item="{{item}}"
        bindtap="onWatchVideo"
      >
        <view class="article-header">
          <text class="article-title">▶️ {{item.video_title || '微课视频'}}</text>
          <text class="article-arrow">观看/讲义 ›</text>
        </view>
        <view class="article-meta">
          <text class="read-badge">时长 {{item.video_length || 0}} 分钟</text>
          <text class="date" wx:if="{{item.update_time}}">更新于 {{item.update_time}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{albumVideos.length === 0}}">
        <text>该专辑下暂无微课视频</text>
      </view>
    </block>
  </view>

  <!-- 知识脑图视图 (103-show-maps.md, 101-map.md, 102-search-map.md) -->
  <view class="article-list" wx:if="{{!mapLoading && hasLogin && articleTab === 'map'}}">
    <block wx:if="{{!activeMap}}">
      <view wx:if="{{mapSearchResults.length > 0}}" class="map-search-results-box">
        <view class="map-search-results-header">🔍 脑图节点匹配结果 ({{mapSearchResults.length}})</view>
        <view
          class="article-item"
          wx:for="{{mapSearchResults}}"
          wx:key="index"
          data-id="{{item.map_id}}"
          data-item="{{item}}"
          bindtap="onSelectMindMap"
        >
          <view class="article-header">
            <text class="article-title">🧠 节点：{{item.node?.name || item.node?.title || '匹配节点'}}</text>
            <text class="article-arrow">打开脑图 ›</text>
          </view>
          <view class="article-meta">
            <text class="author">所属脑图：{{item.map_title}}</text>
            <text class="read-badge">作者：{{item.author_name || '自塾共创'}}</text>
          </view>
        </view>
      </view>

      <view
        class="article-item"
        wx:for="{{mapList}}"
        wx:key="mapid"
        data-id="{{item.mapid}}"
        data-item="{{item}}"
        bindtap="onSelectMindMap"
      >
        <view class="article-header">
          <text class="article-title">🗺️ {{item.map_title || '未命名知识脑图'}}</text>
          <text class="article-arrow">展开脑图 ›</text>
        </view>
        <view class="article-meta">
          <text class="author">创建者：{{item.map_author || '自塾共创'}}</text>
          <text class="read-badge">脑图 #{{item.mapid}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{mapList.length === 0}}">
        <text>暂无知识脑图</text>
      </view>
    </block>

    <block wx:else>
      <view class="zhuanlan-back-bar">
        <text class="zhuanlan-back-btn" bindtap="onBackToMapList">← 返回全部脑图</text>
        <text class="zhuanlan-active-title">🗺️ {{activeMap.map_title || '知识脑图'}}</text>
        <text class="zhuanlan-favor-btn" bindtap="onFavorMap">⭐ 收藏脑图</text>
      </view>
      <view class="album-intro-card" wx:if="{{activeMap.map_desc}}">
        <text>{{activeMap.map_desc}}</text>
      </view>
      <view class="mindmap-outline-card">
        <view class="mindmap-outline-header">🌿 结构化脑图节点大纲 ({{activeMapNodes.length}} 个节点)</view>
        <view
          class="mindmap-node-row depth-{{item.depth}}"
          wx:for="{{activeMapNodes}}"
          wx:key="id"
          style="{{item.indentStyle}}"
        >
          <view class="mindmap-node-main">
            <text class="mindmap-node-bullet">{{item.depth === 0 ? '🎯' : item.childrenCount > 0 ? '▾' : '•'}}</text>
            <text class="mindmap-node-name">{{item.name}}</text>
            <text wx:if="{{item.childrenCount > 0}}" class="mindmap-node-count">{{item.childrenCount}} 子项</text>
          </view>
          <view wx:if="{{item.note}}" class="mindmap-node-note">{{item.note}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 文章列表 -->
  <view class="article-list" wx:if="{{!loading && hasLogin && (articleTab === 'all' || articleTab === 'mine')}}">
    <view
      class="article-item"
      wx:for="{{articles}}"
      wx:key="articleid"
      bindtap="onViewArticle"
      data-id="{{item.articleid}}"
    >
      <view class="article-header">
        <text class="article-title">{{item.title}}</text>
        <text class="article-arrow">›</text>
      </view>
      <view class="article-meta">
        <text class="author">{{item.author_name || '自塾作者'}}</text>
        <text class="read-badge" wx:if="{{item._readMins}}">约 {{item._readMins}} 分钟阅读 · {{item._wordCount}} 字</text>
        <text class="date" wx:if="{{item.create_time}}">{{item.create_time}}</text>
      </view>
      <view class="article-preview">{{item._preview || item.fulltext}}</view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{articles.length === 0}}">
      <text>暂无文章</text>
      <view class="empty-tip">开始创作你的第一篇文章吧</view>
    </view>
  </view>

  <!-- 文章详情阅读弹窗 -->
  <view class="reader-mask" wx:if="{{showReaderModal}}" bindtap="closeArticleModal">
    <view class="reader-sheet" catchtap="stopReaderBubble">
      <view class="reader-topbar">
        <view class="reader-topbar-left">
          <view class="reader-badge">专栏阅读</view>
          <view class="font-size-switch">
            <text
              class="font-btn {{readerFontSize === 'sm' ? 'active' : ''}}"
              data-size="sm"
              bindtap="onSetFontSize"
            >A-</text>
            <text
              class="font-btn {{readerFontSize === 'md' ? 'active' : ''}}"
              data-size="md"
              bindtap="onSetFontSize"
            >标准</text>
            <text
              class="font-btn {{readerFontSize === 'lg' ? 'active' : ''}}"
              data-size="lg"
              bindtap="onSetFontSize"
            >A+</text>
          </view>
        </view>
        <view class="reader-close" bindtap="closeArticleModal">✕</view>
      </view>

      <view class="reader-loading" wx:if="{{readerLoading && !currentArticle}}">
        <text>正在加载文章正文...</text>
      </view>

      <scroll-view class="reader-scroll" scroll-y="true" wx:if="{{currentArticle}}">
        <view class="reader-title">{{currentArticle.title}}</view>
        <view class="reader-meta">
          <text class="reader-author">{{currentArticle.author_name}}</text>
          <text class="reader-dept" wx:if="{{currentArticle.bumen}}">{{currentArticle.bumen}}</text>
          <text class="reader-dept" wx:if="{{currentArticle._wordCount}}">📖 {{currentArticle._wordCount}} 字 · 约 {{currentArticle._readMins}} 分钟</text>
          <text class="reader-date" wx:if="{{currentArticle.create_time}}">{{currentArticle.create_time}}</text>
        </view>
        <view class="reader-divider"></view>
        <view class="reader-loading-inline" wx:if="{{readerLoading}}">
          <text>正在同步完整正文...</text>
        </view>
        <view class="reader-content font-{{readerFontSize}}">
          <text user-select="true">{{currentArticle.content || '暂无正文内容'}}</text>
        </view>
      </scroll-view>

      <view class="reader-footer" wx:if="{{currentArticle}}">
        <view class="reader-action-btn ghost" bindtap="onCopyArticle">📋 复制正文</view>
        <view
          wx:if="{{currentUserId && currentArticle.author_id == currentUserId}}"
          class="reader-action-btn secondary"
          bindtap="onOpenEditArticle"
        >✎ 编辑本文</view>
        <view
          wx:else
          class="reader-action-btn secondary"
          bindtap="onGreetAuthor"
        >👋 约作者交流</view>
        <view class="reader-action-btn primary" bindtap="onFavorArticle">⭐ 收藏文章</view>
      </view>
    </view>
  </view>

  <!-- 102-edit.md: 写文章 / 编辑文章弹窗 -->
  <view class="reader-mask" wx:if="{{showEditorModal}}" bindtap="onCloseEditorModal">
    <view class="reader-sheet" catchtap="stopReaderBubble">
      <view class="reader-topbar">
        <view class="reader-topbar-left">
          <view class="reader-badge">{{editorForm.id > 0 ? '✎ 编辑专栏文章' : '✨ 发布专栏文章'}}</view>
        </view>
        <view class="reader-close" bindtap="onCloseEditorModal">✕</view>
      </view>
      <scroll-view class="reader-scroll" scroll-y="true">
        <view class="editor-field">
          <text class="editor-label">文章标题 *</text>
          <input
            class="editor-input"
            placeholder="请输入清晰有吸引力的文章标题"
            value="{{editorForm.title}}"
            data-field="title"
            bindinput="onEditorInput"
          />
        </view>
        <view class="editor-field">
          <text class="editor-label">正文内容 *</text>
          <textarea
            class="editor-textarea"
            placeholder="分享你的共学心得、项目复盘或思考笔记..."
            maxlength="20000"
            value="{{editorForm.content}}"
            data-field="content"
            bindinput="onEditorInput"
          />
        </view>
      </scroll-view>
      <view class="reader-footer">
        <view class="reader-action-btn ghost" bindtap="onCloseEditorModal">取消</view>
        <view
          class="reader-action-btn primary"
          bindtap="onSaveArticle"
        >{{savingArticle ? '保存中...' : (editorForm.id > 0 ? '保存修改' : '立即发布')}}</view>
      </view>
    </view>
  </view>

  <!-- 105-watch-video.md: 微课视频与讲义弹窗 -->
  <view class="reader-mask" wx:if="{{showVideoModal && currentVideo}}" bindtap="onCloseVideoModal">
    <view class="reader-sheet" catchtap="stopReaderBubble">
      <view class="reader-topbar">
        <view class="reader-topbar-left">
          <view class="reader-badge">🎬 微课视频学习</view>
        </view>
        <view class="reader-close" bindtap="onCloseVideoModal">✕</view>
      </view>
      <scroll-view class="reader-scroll" scroll-y="true">
        <view class="reader-title">{{currentVideo.video_title}}</view>
        <view class="reader-meta">
          <text class="reader-author">{{currentVideo.video_author || '自塾讲师'}}</text>
          <text class="reader-dept" wx:if="{{currentVideo.album_title}}">专辑：{{currentVideo.album_title}}</text>
          <text class="reader-dept">时长 {{currentVideo.video_length || 0}} 分钟</text>
          <text class="reader-date" wx:if="{{currentVideo.update_time}}">{{currentVideo.update_time}}</text>
        </view>
        <view class="video-player-box" wx:if="{{currentVideo.video_url}}">
          <video
            class="video-player"
            src="{{currentVideo.video_url}}"
            controls="{{true}}"
            show-fullscreen-btn="{{true}}"
          ></video>
        </view>
        <view class="reader-divider"></view>
        <view class="reader-content font-md">
          <text user-select="true">{{currentVideo.video_fulltext || '暂无配套文字讲义'}}</text>
        </view>
      </scroll-view>
      <view class="reader-footer">
        <view class="reader-action-btn ghost" bindtap="onCopyVideoUrl">🔗 复制视频链接</view>
        <view class="reader-action-btn primary" bindtap="onFavorVideo">⭐ 收藏本节微课</view>
      </view>
    </view>
  </view>

  <!-- 104-edit-zhuanlan.md: 新建专栏合集弹窗 -->
  <view class="reader-mask" wx:if="{{showZhuanlanModal}}" bindtap="onCloseEditorModal">
    <view class="reader-sheet" catchtap="stopReaderBubble">
      <view class="reader-topbar">
        <view class="reader-topbar-left">
          <view class="reader-badge">📚 新建专栏合集 (104-edit-zhuanlan)</view>
        </view>
        <view class="reader-close" bindtap="onCloseEditorModal">✕</view>
      </view>
      <scroll-view class="reader-scroll" scroll-y="true">
        <view class="editor-field">
          <text class="editor-label">专栏合集名称 *</text>
          <input
            class="editor-input"
            placeholder="例如：AI 工程化实战手记"
            value="{{zhuanlanForm.zhuanlan_title}}"
            data-field="zhuanlan_title"
            bindinput="onZhuanlanFormInput"
          />
        </view>
        <view class="editor-field">
          <text class="editor-label">首篇章节标签</text>
          <input
            class="editor-input"
            placeholder="例如：第一篇 / 基础篇"
            value="{{zhuanlanForm.first_part}}"
            data-field="first_part"
            bindinput="onZhuanlanFormInput"
          />
        </view>
      </scroll-view>
      <view class="reader-footer">
        <view class="reader-action-btn ghost" bindtap="onCloseEditorModal">取消</view>
        <view class="reader-action-btn primary" bindtap="onSaveZhuanlan">
          {{savingZhuanlan ? '创建中...' : '创建专栏合集'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 101-edit-album.md & 102-edit-video.md: 发布微课与专辑弹窗 -->
  <view class="reader-mask" wx:if="{{showCreateVideoModal}}" bindtap="onCloseEditorModal">
    <view class="reader-sheet" catchtap="stopReaderBubble">
      <view class="reader-topbar">
        <view class="reader-topbar-left">
          <view class="reader-badge">🎬 发布微课视频与专辑</view>
        </view>
        <view class="reader-close" bindtap="onCloseEditorModal">✕</view>
      </view>
      <scroll-view class="reader-scroll" scroll-y="true">
        <view class="editor-field">
          <text class="editor-label">微课专辑名称</text>
          <input
            class="editor-input"
            placeholder="例如：FastAPI 核心架构微课"
            value="{{videoForm.album_title}}"
            data-field="album_title"
            bindinput="onVideoFormInput"
          />
        </view>
        <view class="editor-field">
          <text class="editor-label">微课视频标题 *</text>
          <input
            class="editor-input"
            placeholder="请输入本节微课标题"
            value="{{videoForm.video_title}}"
            data-field="video_title"
            bindinput="onVideoFormInput"
          />
        </view>
        <view class="editor-field">
          <text class="editor-label">视频地址 (URL)</text>
          <input
            class="editor-input"
            placeholder="https://..."
            value="{{videoForm.video_websrc}}"
            data-field="video_websrc"
            bindinput="onVideoFormInput"
          />
        </view>
        <view class="editor-field">
          <text class="editor-label">配套文字讲义</text>
          <textarea
            class="editor-textarea"
            placeholder="输入本节微课核心知识点与讲义摘要..."
            value="{{videoForm.video_fulltext}}"
            data-field="video_fulltext"
            bindinput="onVideoFormInput"
          />
        </view>
      </scroll-view>
      <view class="reader-footer">
        <view class="reader-action-btn ghost" bindtap="onCloseEditorModal">取消</view>
        <view class="reader-action-btn primary" bindtap="onSaveVideoAndAlbum">
          {{savingVideo ? '发布中...' : '立即发布微课'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 104-edit-map.md: 新建知识脑图弹窗 -->
  <view class="reader-mask" wx:if="{{showCreateMapModal}}" bindtap="onCloseEditorModal">
    <view class="reader-sheet" catchtap="stopReaderBubble">
      <view class="reader-topbar">
        <view class="reader-topbar-left">
          <view class="reader-badge">🗺️ 新建结构化知识脑图</view>
        </view>
        <view class="reader-close" bindtap="onCloseEditorModal">✕</view>
      </view>
      <scroll-view class="reader-scroll" scroll-y="true">
        <view class="editor-field">
          <text class="editor-label">脑图标题 *</text>
          <input
            class="editor-input"
            placeholder="例如：大语言模型 Agent 知识体系"
            value="{{mapForm.map_title}}"
            data-field="map_title"
            bindinput="onMapFormInput"
          />
        </view>
        <view class="editor-field">
          <text class="editor-label">中心根节点主题</text>
          <input
            class="editor-input"
            placeholder="默认与脑图标题一致"
            value="{{mapForm.root_topic}}"
            data-field="root_topic"
            bindinput="onMapFormInput"
          />
        </view>
        <view class="editor-field">
          <text class="editor-label">核心分支节点（逗号或换行分隔）</text>
          <textarea
            class="editor-textarea"
            placeholder="例如：Prompt 工程, RAG 检索增强, 工具调用, 记忆机制"
            value="{{mapForm.children_topics}}"
            data-field="children_topics"
            bindinput="onMapFormInput"
          />
        </view>
      </scroll-view>
      <view class="reader-footer">
        <view class="reader-action-btn ghost" bindtap="onCloseEditorModal">取消</view>
        <view class="reader-action-btn primary" bindtap="onSaveMindMap">
          {{savingMap ? '生成中...' : '生成并保存脑图'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
