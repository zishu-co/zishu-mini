.custom-tab-bar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 4rpx 0;
  transition: transform 0.2s ease;
}

.custom-tab-bar-wrapper .text {
  font-size: 22rpx;
  line-height: 1.2;
  color: #64748b;
  font-weight: 500;
  transition: color 0.2s ease;
}

.custom-tab-bar-wrapper.is-active {
  transform: translateY(-2rpx);
}

.custom-tab-bar-wrapper.is-active .text {
  color: #a0f;
  font-weight: 600;
}
