.zs-tabbar-dock {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 120rpx;
  background: linear-gradient(180deg, rgba(237, 233, 254, 0.96) 0%, rgba(221, 214, 254, 0.96) 100%);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 2rpx solid rgba(124, 58, 237, 0.26);
  border-radius: 999rpx;
  box-shadow:
    0 18rpx 48rpx rgba(91, 33, 182, 0.18),
    0 4rpx 14rpx rgba(124, 58, 237, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.90);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  z-index: 990;
}

.custom-tab-bar-wrapper {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 94rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%);
  border: 1.5rpx solid rgba(139, 92, 246, 0.22);
  box-shadow:
    0 4rpx 10rpx rgba(15, 23, 42, 0.05),
    inset 0 1rpx 0 #ffffff;
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

.custom-tab-bar-wrapper.is-active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%);
  border-color: rgba(255, 255, 255, 0.36);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.38),
    0 2rpx 6rpx rgba(91, 33, 182, 0.22),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.40);
  transform: translateY(-2rpx);
}

.custom-tab-bar-wrapper:active {
  transform: scale(0.94);
}

.active-indicator {
  position: absolute;
  top: 6rpx;
  width: 26rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.55);
}

.tab-icon-pill {
  width: 64rpx;
  height: 46rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-icon-pill--active {
  background: rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.45);
}

.custom-tab-bar-wrapper .text {
  font-size: 21rpx;
  line-height: 1.15;
  color: #4c1d95;
  font-weight: 700;
  margin-top: 2rpx;
  letter-spacing: 0.5rpx;
  transition: color 0.2s ease, font-weight 0.2s ease;
}

.custom-tab-bar-wrapper.is-active .text {
  color: #ffffff !important;
  font-weight: 800;
}

/* C位旗舰「目标」3D 悬浮球 */
.custom-tab-bar-wrapper.is-center-orb {
  margin-top: -24rpx;
  height: 118rpx;
  background: linear-gradient(180deg, #faf5ff 0%, #ede9fe 100%);
  border: 2rpx solid rgba(124, 58, 237, 0.28);
}

.custom-tab-bar-wrapper.is-center-orb.is-active {
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 50%, #5b21b6 100%);
  border-color: rgba(255, 255, 255, 0.45);
}

.orb-halo {
  position: absolute;
  top: 2rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(168, 85, 247, 0.32) 0%, rgba(124, 58, 237, 0) 72%);
  pointer-events: none;
}

.orb-badge {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
  border: 4rpx solid #ffffff;
  box-shadow:
    0 10rpx 24rpx rgba(99, 102, 241, 0.28),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.40);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.24s cubic-bezier(0.16, 1, 0.3, 1);
}

.orb-badge--active {
  background: linear-gradient(135deg, #ec4899 0%, #c026d3 48%, #7c3aed 100%);
  box-shadow:
    0 12rpx 28rpx rgba(192, 38, 211, 0.45),
    0 4rpx 10rpx rgba(124, 58, 237, 0.32),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.50);
  transform: translateY(-4rpx) scale(1.04);
}

.orb-text {
  margin-top: 4rpx !important;
  font-size: 22rpx !important;
  font-weight: 800 !important;
}
