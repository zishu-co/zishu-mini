<t-tab-bar
  value="{{active}}"
  bindchange="onChange"
  split="{{false}}"
>
  <t-tab-bar-item
    wx:for="{{list}}"
    wx:for-item="item"
    wx:for-index="index"
    wx:key="index"
  >
    <view class="custom-tab-bar-wrapper {{active === index ? 'is-active' : ''}}">
      <t-icon name="{{item.icon}}" size="44rpx" color="{{active === index ? '#a0f' : '#64748b'}}" />
      <view class="text">{{ item.text }}</view>
    </view>
  </t-tab-bar-item>
</t-tab-bar>

<!-- AI 助理悬浮按钮 -->
<ai-assistant-btn />
