<view class="zs-tabbar-dock" role="tablist">
  <view
    wx:for="{{list}}"
    wx:for-item="item"
    wx:for-index="index"
    wx:key="index"
    class="custom-tab-bar-wrapper {{active === index ? 'is-active' : ''}}"
    data-index="{{index}}"
    bindtap="onChange"
  >
    <view class="active-indicator" wx:if="{{active === index}}"></view>
    <view class="tab-icon-pill {{active === index ? 'tab-icon-pill--active' : ''}}">
      <t-icon name="{{item.icon}}" size="38rpx" color="{{active === index ? '#ffffff' : '#6d28d9'}}" />
    </view>
    <view class="text">{{ item.text }}</view>
  </view>
</view>

<!-- AI 助理悬浮按钮 -->
<ai-assistant-btn />
