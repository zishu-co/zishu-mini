/**app.wxss — 自塾小程序全局旗舰设计系统 (Flagship Design System Tokens & Utilities)**/
page {
  /* TDesign 主题色覆盖 */
  --td-brand-color: #9333ea;
  --td-tab-bar-active-color: #9333ea;
  --td-tab-bar-color: #64748b;
  --td-tab-bar-bg-color: rgba(255, 255, 255, 0.94);

  /* 自塾品牌与视觉 Token */
  --brand-primary: #9333ea;
  --brand-vivid: #a0f;
  --brand-dark: #7c3aed;
  --brand-deep: #5b21b6;
  --brand-light: #f3e8ff;
  --brand-lighter: #faf5ff;
  --brand-border: rgba(147, 51, 234, 0.16);
  --brand-gradient: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #6d28d9 100%);
  --brand-gradient-hero: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  --brand-gradient-soft: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);

  /* 背景与文字 */
  --bg-page: #f6f5fb;
  --bg-card: #ffffff;
  --bg-subtle: #f8fafc;
  --text-main: #0f172a;
  --text-sec: #475569;
  --text-muted: #94a3b8;
  --border-subtle: rgba(15, 23, 42, 0.06);
  --border-card: rgba(147, 51, 234, 0.08);

  /* 语义色 */
  --color-success: #10b981;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;
  --color-info: #3b82f6;

  /* 圆角与多级立体阴影 */
  --radius-sm: 14rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --radius-full: 9999rpx;
  --shadow-xs: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
  --shadow-sm: 0 6rpx 20rpx rgba(15, 23, 42, 0.05), 0 2rpx 6rpx rgba(15, 23, 42, 0.03);
  --shadow-md: 0 12rpx 36rpx rgba(15, 23, 42, 0.08), 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
  --shadow-lg: 0 24rpx 60rpx rgba(15, 23, 42, 0.14);
  --shadow-brand: 0 10rpx 28rpx rgba(124, 58, 237, 0.26);
  --shadow-brand-lg: 0 16rpx 44rpx rgba(124, 58, 237, 0.34);

  background-color: var(--bg-page);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 全局清除微信原生 button 灰框与伪元素边框 */
button::after {
  border: none !important;
}

/* 自定义 tab-bar 选中态样式 - 穿透 TDesign 组件 */
.t-tab-bar {
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.t-tab-bar-item--selected .t-tab-bar-item__icon,
.t-tab-bar-item--selected .t-tab-bar-item__text,
.t-tab-bar-item--selected .t-icon,
.t-tab-bar-item--selected .custom-tab-bar-wrapper .text {
  color: #7c3aed !important;
  font-weight: 700;
}

.t-tab-bar__active-line {
  background: linear-gradient(90deg, #a855f7, #7c3aed) !important;
}

/* 兼容旧页面 .container，不再加 200rpx 上下内边距破坏布局 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ── 通用卡片与状态样式 ── */
.zs-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-subtle);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.zs-btn-primary {
  background: var(--brand-gradient);
  color: #ffffff;
  border-radius: var(--radius-full);
  font-weight: 600;
  box-shadow: var(--shadow-brand);
  border: none;
  transition: opacity 0.2s ease, transform 0.15s ease;
}

.zs-btn-primary:active {
  opacity: 0.92;
  transform: scale(0.98);
}

/* ── 全局统一弹窗 / 底部抽屉组件库 (Modal & Bottom Sheet) ── */
@keyframes zsFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes zsSlideUp {
  from { transform: translateY(48rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes zsPopIn {
  from { transform: scale(0.94); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.zs-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.56);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  animation: zsFadeIn 0.2s ease-out;
}

.zs-modal-mask--bottom {
  align-items: flex-end;
  padding: 0;
}

.zs-modal-card {
  width: 100%;
  max-width: 660rpx;
  max-height: 84vh;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-lg);
  border: 1rpx solid rgba(147, 51, 234, 0.1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: zsPopIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

.zs-modal-sheet {
  width: 100%;
  max-height: 86vh;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -16rpx 48rpx rgba(15, 23, 42, 0.14);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  animation: zsSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.zs-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.zs-modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.35;
}

.zs-modal-sub {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.5;
}

.zs-modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.zs-modal-close:active {
  background: #e2e8f0;
}

.zs-form-group {
  margin-bottom: 24rpx;
}

.zs-form-label {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 12rpx;
}

.zs-form-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.zs-form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
  line-height: 1.5;
}

.zs-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.zs-btn-cancel {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: #f1f5f9;
  color: #475569;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
}

.zs-btn-submit {
  flex: 1.3;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: var(--brand-gradient);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: var(--shadow-brand);
  margin: 0;
  padding: 0;
}

.zs-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 40rpx;
  text-align: center;
  color: var(--text-muted);
}

.zs-empty__icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.85;
}

.zs-empty__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-sec);
  margin-bottom: 10rpx;
}

.zs-empty__desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

.zs-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  color: var(--text-sec);
  font-size: 26rpx;
}
