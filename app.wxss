/**app.wxss — 自塾小程序全局设计系统 (Design System Tokens & Utilities)**/
page {
  /* TDesign 主题色覆盖 */
  --td-brand-color: #a0f;
  --td-tab-bar-active-color: #a0f;
  --td-tab-bar-color: #64748b;

  /* 自塾品牌与视觉 Token */
  --brand-primary: #a0f;
  --brand-dark: #7c3aed;
  --brand-deep: #6d28d9;
  --brand-light: #f3e8ff;
  --brand-lighter: #faf5ff;
  --brand-border: rgba(160, 0, 255, 0.18);
  --brand-gradient: linear-gradient(135deg, #a0f 0%, #7c3aed 100%);
  --brand-gradient-soft: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);

  /* 背景与文字 */
  --bg-page: #f7f6fb;
  --bg-card: #ffffff;
  --text-main: #1a1a2e;
  --text-sec: #64748b;
  --text-muted: #94a3b8;
  --border-subtle: rgba(26, 26, 46, 0.06);

  /* 语义色 */
  --color-success: #10b981;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;
  --color-info: #3b82f6;

  /* 圆角与阴影 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-full: 9999rpx;
  --shadow-sm: 0 4rpx 16rpx rgba(26, 26, 46, 0.05);
  --shadow-md: 0 8rpx 28rpx rgba(26, 26, 46, 0.08);
  --shadow-brand: 0 8rpx 24rpx rgba(160, 0, 255, 0.22);

  background-color: var(--bg-page);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 自定义 tab-bar 选中态样式 - 穿透 TDesign 组件 */
.t-tab-bar-item--selected .t-tab-bar-item__icon,
.t-tab-bar-item--selected .t-tab-bar-item__text,
.t-tab-bar-item--selected .t-icon,
.t-tab-bar-item--selected .custom-tab-bar-wrapper .text {
  color: #a0f !important;
  font-weight: 600;
}

.t-tab-bar__active-line {
  background-color: #a0f !important;
}

/* 兼容旧页面 .container，不再加 200rpx 上下内边距破坏布局 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ── 通用卡片与状态样式 ── */
.zs-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-subtle);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.zs-btn-primary {
  background: var(--brand-gradient);
  color: #ffffff;
  border-radius: var(--radius-full);
  font-weight: 600;
  box-shadow: var(--shadow-brand);
  border: none;
  transition: opacity 0.2s ease, transform 0.15s ease;
}

.zs-btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.zs-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 40rpx;
  text-align: center;
  color: var(--text-muted);
}

.zs-empty__icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.85;
}

.zs-empty__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-sec);
  margin-bottom: 10rpx;
}

.zs-empty__desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

.zs-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  color: var(--text-sec);
  font-size: 26rpx;
}
