/**app.wxss — 自塾小程序全局旗舰设计系统 (Flagship Design System Tokens & Utilities)**/
page {
  /* TDesign 主题色覆盖 */
  --td-brand-color: #9333ea;
  --td-tab-bar-active-color: #9333ea;
  --td-tab-bar-color: #64748b;
  --td-tab-bar-bg-color: rgba(255, 255, 255, 0.94);

  /* 自塾品牌与视觉 Token */
  --brand-primary: #9333ea;
  --brand-vivid: #a0f;
  --brand-dark: #7c3aed;
  --brand-deep: #5b21b6;
  --brand-light: #f3e8ff;
  --brand-lighter: #faf5ff;
  --brand-border: rgba(124, 58, 237, 0.16);
  --brand-gradient: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 55%, #5b21b6 100%);
  --brand-gradient-hero: linear-gradient(135deg, #2e1065 0%, #5b21b6 48%, #7c3aed 100%);
  --brand-gradient-soft: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);

  /* 背景与文字（专业设计师多层薰衣草/靛蓝微光氛围与斑马纹行色系） */
  --bg-page: #f6f5fb;
  --bg-page-gradient: linear-gradient(180deg, #ede9fe 0%, #f3f0ff 28%, #eef2ff 68%, #f6f5fb 100%);
  --bg-card: #ffffff;
  --bg-subtle: #f8fafc;
  --row-odd-bg: #ffffff;
  --row-even-bg: #f3effe;
  --form-row-odd-bg: #fcfaff;
  --form-row-even-bg: #f2ecff;
  --row-hover-bg: #e9d5ff;
  --row-selected-bg: #ddd6fe;
  --row-selected-gradient: linear-gradient(135deg, #ddd6fe 0%, #e0e7ff 100%);
  --row-selected-border: #7c3aed;
  --text-main: #0f172a;
  --text-sec: #475569;
  --text-muted: #94a3b8;
  --border-subtle: rgba(15, 23, 42, 0.06);
  --border-card: rgba(147, 51, 234, 0.12);

  /* 语义色 */
  --color-success: #10b981;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;
  --color-info: #3b82f6;

  /* 圆角与多级立体阴影 */
  --radius-sm: 14rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --radius-full: 9999rpx;
  --shadow-xs: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
  --shadow-sm: 0 6rpx 20rpx rgba(15, 23, 42, 0.05), 0 2rpx 6rpx rgba(15, 23, 42, 0.03);
  --shadow-md: 0 12rpx 36rpx rgba(15, 23, 42, 0.08), 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
  --shadow-lg: 0 24rpx 60rpx rgba(15, 23, 42, 0.14);
  --shadow-brand: 0 10rpx 28rpx rgba(124, 58, 237, 0.26);
  --shadow-brand-lg: 0 16rpx 44rpx rgba(124, 58, 237, 0.34);

  background-color: var(--bg-page);
  background-image: var(--bg-page-gradient);
  background-attachment: fixed;
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

.page,
.container,
.test-page {
  background-color: var(--bg-page);
  background-image: var(--bg-page-gradient);
  background-attachment: fixed;
}

/* ══════════════════════════════════════════════════════════════════════════
   1. 全局清除微信原生 <button> 毛坯默认样式（保持 (0,0,1) 低权重，不覆盖页面 .btn 类）
   ══════════════════════════════════════════════════════════════════════════ */
button {
  margin: 0;
  padding: 0 32rpx;
  font-size: 27rpx;
  font-weight: 700;
  font-family: inherit;
  border-radius: 999rpx;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
  transition:
    transform 0.16s cubic-bezier(0.16, 1, 0.3, 1),
    box-shadow 0.2s ease,
    opacity 0.2s ease,
    background 0.2s ease;
}

button::after {
  border: none !important;
  display: none !important;
}

button:active {
  transform: scale(0.97);
}

/* ══════════════════════════════════════════════════════════════════════════
   2. 商业级全局按钮视觉体系 (全量覆盖所有按钮类，支持内置图标对齐与高光立体感)
   ══════════════════════════════════════════════════════════════════════════ */
.zs-btn-primary,
.btn-primary,
.confirm-btn,
.submit-btn,
.save-btn,
.login-btn,
.cta-btn,
.user-card__login-btn,
.exam-sheet-submit,
.edit-save-btn,
.direct-select-btn,
.jianda-submit-btn,
.btn-claim,
.create-btn,
.publish-btn,
.action-btn.primary,
.action-pill.primary,
.action-chip.primary,
.talk-action-btn.primary,
.policy-btn.primary,
.paper-cta,
.goal-adopt-btn,
.empty-cta,
.empty-cta-btn:not(.ghost) {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 52%, #5b21b6 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 700;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  box-shadow:
    0 10rpx 24rpx rgba(124, 58, 237, 0.30),
    0 2rpx 6rpx rgba(91, 33, 182, 0.18),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
  letter-spacing: 0.5rpx;
}

.zs-btn-primary:active,
.btn-primary:active,
.submit-btn:active,
.confirm-btn:active,
.save-btn:active,
.action-btn.primary:active,
.action-pill.primary:active,
.action-chip.primary:active,
.talk-action-btn.primary:active,
.paper-cta:active {
  transform: scale(0.96);
  opacity: 0.94;
}

/* 次级轻奢薰衣草胶囊按钮 */
.btn-secondary,
.cancel-btn,
.zs-btn-cancel,
.action-btn.secondary,
.action-pill.secondary,
.action-chip.secondary,
.talk-action-btn.ghost,
.peer-btn.ghost,
.policy-btn.ghost,
.retry-btn,
.retry-btn.secondary,
.empty-cta-btn.ghost,
.goal-action-pill.ghost,
.reset-btn,
.reset-filter-btn,
.mentor-select-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #faf5ff 0%, #ede9fe 100%);
  color: #6d28d9;
  border: 1.5rpx solid rgba(124, 58, 237, 0.28);
  border-radius: 999rpx;
  font-weight: 700;
  box-shadow:
    0 4rpx 14rpx rgba(124, 58, 237, 0.10),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.90);
}

/* 语义绿：结课 / 完结 / 已签到 */
.action-btn.finish-btn,
.talk-action-btn.finish,
.signed-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  font-weight: 700;
  box-shadow:
    0 8rpx 20rpx rgba(16, 185, 129, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.34);
}

/* 语义红：危险 / 退课 / 删除 */
.action-btn.danger,
.action-pill.danger,
.action-chip.danger,
.log-action-btn.danger,
.enroll-btn--quit,
.unfavor-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
  color: #e11d48;
  border: 1.5rpx solid rgba(225, 29, 72, 0.26);
  border-radius: 999rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(225, 29, 72, 0.10);
}

/* ══════════════════════════════════════════════════════════════════════════
   3. 商业级全局页面 Tab 导航栏与胶囊筛选器统一规范
      铁律：1) Tab 栏容器必有默认底色  2) 未选中 Tab 项必有默认底色  3) 选中 Tab 项必有鲜明选中色
   ══════════════════════════════════════════════════════════════════════════ */
/* 3.1 所有 Tab 栏容器轨道 —— 统一薰衣草紫晶槽位默认底色 */
.seg-tabs,
.sheet-tabs,
.zs-seg-tabs,
.tabs,
.tab-bar,
.mode-switch-bar,
.filter-bar,
.post-filter-tabs,
.fb-tabs,
.course-filter-pills,
.inno-domain-tabs,
.status-filter-bar,
.category-tabs,
.type-filter-bar,
.filter-pills,
.filter-tabs,
.exam-cat-pills,
.exam-type-pills,
.article-tabs,
.folder-tabs {
  background: linear-gradient(180deg, #ede9fe 0%, #e4d4fc 100%) !important;
  border: 2rpx solid rgba(124, 58, 237, 0.22) !important;
  border-radius: 28rpx !important;
  padding: 10rpx 12rpx !important;
  box-shadow:
    inset 0 2rpx 6rpx rgba(91, 33, 182, 0.10),
    0 4rpx 14rpx rgba(124, 58, 237, 0.08) !important;
  box-sizing: border-box;
}

/* 3.2 所有未选中 Tab 项 —— 统一珠光白/薰衣草微光默认底色（严禁透明无底色） */
.seg-tab,
.sheet-tab,
.zs-seg-tab,
.tab,
.tab-item,
.mode-switch-btn,
.filter-tab,
.post-tab,
.fb-tab,
.filter-pill,
.domain-tab,
.status-pill,
.cat-tab,
.type-filter-pill,
.exam-pill,
.article-tab,
.folder-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f3ff 100%) !important;
  color: #4c1d95 !important;
  font-weight: 600;
  border-radius: 999rpx !important;
  border: 1.5rpx solid rgba(139, 92, 246, 0.22) !important;
  box-shadow:
    0 2rpx 8rpx rgba(15, 23, 42, 0.05),
    inset 0 1rpx 0 #ffffff !important;
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 3.3 所有选中态 Tab 项 —— 统一皇家紫3D高光渐变选中底色与纯白文字 */
.seg-tab--active,
.seg-tab.active,
.sheet-tab--active,
.sheet-tab.active,
.zs-seg-tab.active,
.tab.active,
.tab.tab-active,
.tab-item.active,
.mode-switch-btn.active,
.filter-tab.active,
.post-tab.active,
.fb-tab.active,
.filter-pill.active,
.filter-pill--active,
.domain-tab.active,
.status-pill.active,
.cat-tab.active,
.type-filter-pill.active,
.exam-pill.active,
.article-tab.active,
.folder-tab.active {
  background: linear-gradient(135deg, #9333ea 0%, #7c3aed 55%, #5b21b6 100%) !important;
  color: #ffffff !important;
  font-weight: 800 !important;
  border-color: rgba(255, 255, 255, 0.32) !important;
  box-shadow:
    0 8rpx 22rpx rgba(124, 58, 237, 0.36),
    0 2rpx 6rpx rgba(91, 33, 182, 0.22),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.38) !important;
  transform: translateY(-1rpx);
}

.seg-tab--active text,
.sheet-tab--active text,
.tab.active text,
.tab.tab-active text,
.tab-item.active text,
.mode-switch-btn.active text,
.filter-tab.active text,
.post-tab.active text,
.fb-tab.active text,
.filter-pill.active text,
.filter-pill--active text,
.domain-tab.active text,
.status-pill.active text,
.cat-tab.active text,
.type-filter-pill.active text,
.exam-pill.active text,
.article-tab.active text,
.folder-tab.active text {
  color: #ffffff !important;
}

/* 自定义 tab-bar 选中态样式 - 兼容穿透 */
.t-tab-bar {
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.t-tab-bar-item--selected .t-tab-bar-item__icon,
.t-tab-bar-item--selected .t-tab-bar-item__text,
.t-tab-bar-item--selected .t-icon,
.t-tab-bar-item--selected .custom-tab-bar-wrapper .text {
  color: #7c3aed !important;
  font-weight: 700;
}

.t-tab-bar__active-line {
  background: linear-gradient(90deg, #a855f7, #7c3aed) !important;
}

/* 兼容旧页面 .container，不再加 200rpx 上下内边距破坏布局 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ── 通用卡片与状态样式 ── */
.zs-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-subtle);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* ── 全局统一弹窗 / 底部抽屉组件库 (Modal & Bottom Sheet) ── */
@keyframes zsFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes zsSlideUp {
  from { transform: translateY(48rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes zsPopIn {
  from { transform: scale(0.94); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.zs-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.56);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  animation: zsFadeIn 0.2s ease-out;
}

.zs-modal-mask--bottom {
  align-items: flex-end;
  padding: 0;
}

.zs-modal-card {
  width: 100%;
  max-width: 660rpx;
  max-height: 84vh;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-lg);
  border: 1rpx solid rgba(147, 51, 234, 0.1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: zsPopIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

.zs-modal-sheet {
  width: 100%;
  max-height: 86vh;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -16rpx 48rpx rgba(15, 23, 42, 0.14);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  animation: zsSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.zs-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.zs-modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.35;
}

.zs-modal-sub {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.5;
}

.zs-modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.zs-modal-close:active {
  background: #e2e8f0;
}

.zs-form-group {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  border: 1.5rpx solid rgba(124, 58, 237, 0.12);
  transition: all 0.2s ease;
}

.zs-form-group:nth-child(odd),
.form-item:nth-child(odd),
.slot-row:nth-child(odd),
.field-row:nth-child(odd),
.info-row:nth-child(odd) {
  background: var(--form-row-odd-bg);
}

.zs-form-group:nth-child(even),
.form-item:nth-child(even),
.slot-row:nth-child(even),
.field-row:nth-child(even),
.info-row:nth-child(even) {
  background: var(--form-row-even-bg);
}

.zs-form-group:focus-within,
.form-item:focus-within,
.slot-row:focus-within,
.zs-form-group.selected,
.form-item.selected,
.form-item.active {
  background: var(--row-selected-gradient) !important;
  border-color: var(--row-selected-border) !important;
  box-shadow: inset 6rpx 0 0 var(--row-selected-border), 0 6rpx 18rpx rgba(124, 58, 237, 0.14) !important;
}

/* ── 专业设计师级：全局列表 / 表格 / 选项 相邻行交替底色与选中行底色 ── */
.menu-cell:nth-child(odd),
.ark-item:nth-child(odd),
.checkitem:nth-child(odd),
.option-item:nth-child(odd),
.member-card:nth-child(odd),
.course-card:nth-child(odd),
.paper-card:nth-child(odd),
.record-card:nth-child(odd),
.camp-card:nth-child(odd),
.chapter-item:nth-child(odd),
.chapter-row:nth-child(odd),
.task-card:nth-child(odd),
.project-card:nth-child(odd),
.talk-card:nth-child(odd),
.supervise-card:nth-child(odd),
.mentor-card:nth-child(odd),
.favor-item:nth-child(odd),
.log-card:nth-child(odd),
.event-card:nth-child(odd),
.participant-card:nth-child(odd) {
  background: linear-gradient(180deg, #ffffff 0%, #fcfaff 100%);
}

.menu-cell:nth-child(even),
.ark-item:nth-child(even),
.checkitem:nth-child(even),
.option-item:nth-child(even),
.member-card:nth-child(even),
.course-card:nth-child(even),
.paper-card:nth-child(even),
.record-card:nth-child(even),
.camp-card:nth-child(even),
.chapter-item:nth-child(even),
.chapter-row:nth-child(even),
.task-card:nth-child(even),
.project-card:nth-child(even),
.talk-card:nth-child(even),
.supervise-card:nth-child(even),
.mentor-card:nth-child(even),
.favor-item:nth-child(even),
.log-card:nth-child(even),
.event-card:nth-child(even),
.participant-card:nth-child(even) {
  background: linear-gradient(180deg, #f3effe 0%, #eef2ff 100%);
}

.checkitem.is-selected,
.checkitem.selected,
.checkitem:active,
.radio-item.radio-checked,
.option-item.selected,
.option-item.active,
.member-card.selected,
.member-card.active,
.course-card.selected,
.course-card.enrolled,
.paper-card.selected,
.paper-card:active,
.record-card.selected,
.record-card:active,
.task-card.selected,
.project-card.selected,
.talk-card.selected,
.favor-item.selected,
.chapter-item.active,
.chapter-row.active,
.menu-cell:active,
.ark-item:active {
  background: var(--row-selected-gradient) !important;
  border-color: var(--row-selected-border) !important;
  box-shadow: inset 8rpx 0 0 var(--row-selected-border), 0 8rpx 22rpx rgba(124, 58, 237, 0.16) !important;
}

.zs-form-label {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 12rpx;
}

.zs-form-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.zs-form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
  line-height: 1.5;
}

.zs-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.zs-btn-cancel {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: #f1f5f9;
  color: #475569;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
}

.zs-btn-submit {
  flex: 1.3;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: var(--brand-gradient);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: var(--shadow-brand);
  margin: 0;
  padding: 0;
}

.zs-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 40rpx;
  text-align: center;
  color: var(--text-muted);
}

.zs-empty__icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.85;
}

.zs-empty__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-sec);
  margin-bottom: 10rpx;
}

