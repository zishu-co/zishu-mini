.fab-container {
  position: fixed;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 148rpx);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
}

.fab-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a855f7 0%, #7c3aed 55%, #5b21b6 100%);
  box-shadow: 0 12rpx 32rpx rgba(124, 58, 237, 0.38), 0 0 0 6rpx rgba(255, 255, 255, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
}

.fab-btn.pressed {
  transform: scale(0.9);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.28), 0 0 0 4rpx rgba(255, 255, 255, 0.9);
}

.fab-icon {
  font-size: 34rpx;
  line-height: 1;
}

.fab-label {
  font-size: 18rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
  letter-spacing: 1rpx;
}

.fab-dot {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ef4444;
  border: 3rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(239, 68, 68, 0.4);
}

.fab-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border: 3rpx solid #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(239, 68, 68, 0.35);
}
